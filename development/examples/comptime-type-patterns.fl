-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Type = .Type'builtin;
typealias Bool = true'type;
typealias Char = 'a''type;
comptime fn SelectType(value: Type) -> Type {
    value match {
        'Bool => Tuple<Bool, Bool>,
        'Char => Tuple<Char, Char>,
        _ => value,
    }
}
comptime fn Same(value: Type, expected: Type) -> Bool {
    value match { 'expected => true, _ => false }
}
comptime fn run() -> Tuple<Bool, Bool, Bool> {
    (Same(Bool, Bool), Same(Bool, Char), Same(SelectType(Bool), Tuple<Bool, Bool>))
}
typealias Selected = SelectType(Char);
fn keep(value: Selected) -> Tuple<Char, Char> { value }
pure comptime fn Opaque<T> -> Type { T }
comptime fn unresolved() -> Bool { Same(Opaque<Bool>, Bool) }
