{- Object methods preserve duplicate entries, payload domains, and old values. -}
comptime fn run() -> bool {
    let source: Object = {flag: true, 'x', flag: false};
    let appended = source.append(true, .key = .flag);
    let changed = appended.replace(1, false);
    let result = changed.remove(0).concat({tail: true});
    source.length() == 3 and result.length() == 4
        and (source.get<bool>(.flag) matches false?)
        and (appended.get<bool>(.flag) matches true?)
        and (source.key(1) matches null)
        and changed.EntryType(1) == bool
        and (changed.value<bool>(1) matches false?)
        and (result.get<bool>(.tail) matches true?)
        and mutable_entries() and nominal_storage()
}


struct Draft { entries: Object }

impl Draft {
    comptime fn reset(self) -> bool {
        self.entries = {fresh: false};
        true
    }
}

comptime fn mutable_entries() -> bool {
    var draft: Object = {flag: false, flag: false};
    let saved = draft;
    draft.set(0, true);
    draft.set(1, 'x');
    let holder = Draft { entries: draft };
    holder.entries.set(0, holder.reset());
    (saved.value<bool>(0) matches false?)
        and (draft.value<bool>(0) matches true?)
        and (draft.get<char>(.flag) matches 'x'?)
        and holder.entries.length() == 1
        and (holder.entries.get<bool>(.fresh) matches true?)
}

struct Item { flag: bool }
comptime fn nominal_storage() -> bool {
    var items: meta.List<Item> = [Item {flag: true}];
    let old_items = items;
    items.append(Item {flag: false});
    let absent: ?Item = null;
    var object = {item: Item {flag: true}, absent: absent, items: items};
    let saved = object;
    object.set(0, Item {flag: false});
    (saved.get<Item>(.item) match {v? => v.flag, null => false})
        and (object.get<Item>(.item) match {v? => not v.flag, null => false})
        and old_items.length() == 1 and items.length() == 2
}
{- Checked comptime observations can feed a native program through staging. -}
test object_observation {
    inline if run() { assumes true; } else { assumes false; };
}
