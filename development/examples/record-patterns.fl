-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Flag = bool;
typealias Letter = 'x''type;

struct Packet where T {
    payload: T,
    ready: Flag = true,
}

enum Message where T {
    empty,
    packet(Packet<Tuple<T, Flag>>),
}

fn read(message: Message<T>, fallback: T) -> T where T {
    message match {
        .packet({ payload: (value, true), ready: true }) => value,
        _ => fallback,
    }
}

fn run() -> Letter {
    let packet = Packet<Tuple<Letter, Flag>> { payload: ('y', true) };
    let { ready } = packet;
    if ready {
        read(Message<Letter>.packet(packet), 'n')
    } else {
        'n'
    }
}
