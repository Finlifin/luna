-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
typealias Type = .Type'builtin;
typealias Char = 'x''type;

-- T is an ordinary comptime input; G is inferred from the other argument.
fn pair(comptime T: Type, value: T, other: G) -> Tuple<T, G> where G {
    (value, other)
}

-- Clause parameters can supply ordinary Type inputs to another function.
fn forward(value: A, other: B) -> Tuple<A, B> where A, B {
    pair(A, value, other)
}

trait Mapper {
    fn pair(self, comptime T: Type, value: T, comptime other: G,
            comptime .copy: G = other) -> Tuple<T, G> where G;
}

struct Host {}
impl Mapper for Host {
    fn pair(self, comptime A: Type, left: A, comptime right: B,
            comptime .copy: B = right) -> Tuple<A, B> where B {
        (left, copy)
    }
}

fn run() -> Tuple<Tuple<bool, Char>, Tuple<Char, bool>, Tuple<bool, Char>> {
    (pair(bool, true, 'x'),
     forward('y', false),
     Host {}.as(Mapper).pair(bool, false, 'z'))
}
