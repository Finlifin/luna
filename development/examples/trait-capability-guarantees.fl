-- Adapter<T> guarantees that T can read its implementation subject.
-- Self is substituted when an implementation is checked and dispatched.
trait Read where S { fn read(self, owner: S) -> true'type; }
trait Adapter where T :- Read<Self> {
    fn run(self, value: T) -> true'type { value.read(self) }
}
struct Host {}
struct Leaf {}
impl Read<Host> for Leaf { fn read(self, owner: Host) -> true'type { true } }
impl Adapter<T> for Host where T :- Read<Host> {}
fn forward(owner: S, value: T) -> true'type where T, S :- Adapter<T> {
    value.read(owner)
}
fn direct() -> true'type { Host {}.as(Adapter<Leaf>).run(Leaf {}) }
fn generic() -> true'type { forward(Host {}, Leaf {}) }
