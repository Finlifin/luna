-- A handler borrows an owned data record, preserving the installer responsibility.
trait Duplicate {}
trait Retire { fn drop(*self); }
impl Duplicate for bool {}
struct Actions { flag: bool, live: bool }
impl Retire for Actions { fn drop(*self) {assumes self.live.*;assumes not self.flag.*;self.live.* = false;} }
effect step() -> bool;
fn subject() -> #step bool {
    let first = step()#;
    let second = step()#;
    first and not second
}
fn run() -> bool {
    var actions = Actions {flag: false, live: true};
    let result = subject()# {
        step() => do {
            actions.flag = not actions.flag;
            resume actions.flag;
        },
    };
    result and not actions.flag and actions.live
}
