-- Build with --build run --copy-protocol Duplicate --drop-protocol Retire.
trait Duplicate {}
trait Retire { fn drop(*self); }
impl Duplicate for bool {}
typealias Count = .u32'builtin;
impl Duplicate for Count {}

struct Token { target: *Count }
impl Retire for Token {
    fn drop(*self) {
        let n = self.target.*.*;
        if n < 10 { self.target.*.* = n + 1; }
    }
}
struct Pair { first: Token, second: Token }
fn consume(token: Token) {}
fn finish(callback: %{pair: Pair} fn(bool)) {}

fn trial(flag: bool) -> bool {
    let count: Count = 0;
    do {
        let pair = Pair {
            first: Token {target: count.ref},
            second: Token {target: count.ref},
        };
        let callback = |take: bool| {
            if take { consume(pair.first); }
        };
        callback(flag);
        -- The remaining environment is cleaned here. The consumed field is
        -- skipped, even when the branch is only known at runtime.
    };
    count == 2
}
fn run() -> bool { trial(true) and trial(false) }
