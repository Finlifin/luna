-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Bool = true'type;
typealias Int = .Integer'builtin;

fn dependent() -> Bool { true }
fn checked(flag: Bool) -> Bool {
    assumes flag;
    dependent()
}

comptime fn checked_value(value: T, accepted: Bool) -> T where T {
    assumes accepted;
    value
}

comptime fn count_checks() -> Int {
    var remaining: Int = 3;
    while remaining > 0 {
        assumes remaining > 0 and remaining <= 3;
        remaining = remaining - 1;
    }
    remaining
}

comptime fn captured(accepted: Bool) -> Bool {
    let check = || { assumes accepted; true };
    check()
}

comptime fn Select(accepted: Bool) -> .Type'builtin {
    assumes accepted;
    Bool
}
typealias Selected = Select(true);

comptime fn run() -> Tuple<Selected, Bool, Bool> {
    assumes true or false;
    (checked_value(true, true), count_checks() == 0, captured(true))
}
