-- Compile-time policy selection uses ordinary trait constraints.
trait Selection {
    comptime fn select(flag: bool) -> bool;
}

struct Direct {}
struct Inverted {}

impl Selection for Direct {
    comptime fn select(flag: bool) -> bool { flag }
}

impl Selection for Inverted {
    comptime fn select(flag: bool) -> bool { not flag }
}

fn materialize(comptime flag: bool) -> bool {
    flag
}

-- Neither Policy nor flag needs a concrete value during definition checking.
fn configured(comptime flag: bool) -> bool
where Policy :- Selection
{
    materialize(Policy.as(Selection).select(flag))
}

fn run() -> (bool, bool) {
    (configured<Direct>(true), configured<Inverted>(true))
}
