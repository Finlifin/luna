-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Flag = true'type;
typealias Letter = 'x''type;

enum Message where T {
    empty,
    payload(Tuple<T, Flag>),
}

fn select(message: Message<T>, fallback: T) -> T where T {
    message match {
        .payload((value, true)) => value,
        .payload((_, false)) or .empty => fallback,
    }
}

fn swap(pair: Tuple<T, U>) -> Tuple<U, T> where T, U {
    let (left, right) = pair;
    (right, left)
}

fn run() -> Tuple<Letter, Flag> {
    let selected = select(Message<Letter>.payload(('y', true)), 'n');
    swap((true, selected))
}
