-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
-- A known tuple entry collects positional inputs; the other entry receives
-- the default record packet. Input evaluation follows this call's source order.
fn render(...children: Tuple<bool, bool>, ...properties: T) -> Tuple<bool, T>
where T
{
    let (first, second) = children;
    (first and second, properties)
}

fn entry() -> bool {
    let (ready, options) = render {
        true,
        enabled: true,
        true,
        label: 'x',
    };
    let (forwarded, options) = render(
        .children = (true, true),
        .properties = options,
    );
    ready and forwarded and options.enabled and options.label == 'x'
}
