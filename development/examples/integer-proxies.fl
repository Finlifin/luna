-- Explicit builtin views are used until ordinary builtin package/prelude loading
-- is connected. Integer suffix protocols are separate from this proxy path.
typealias Byte = .u8'builtin;
typealias Word = .u16'builtin;
typealias Wide = .u128'builtin;
typealias Signed = .i128'builtin;

fn identity(value: T) -> T where T { value }
fn choose(first: T, second: T) -> T where T { first }
fn word() -> Word { 0 }

fn contextual() -> Word { identity(65535) }
fn wide() -> Wide { 340282366920938463463374607431768211455 }
fn minimum() -> Signed { -170141183460469231731687303715884105728 }

fn later_context() -> bool {
    -- The nested integer waits for word() to establish T = Word.
    choose(identity(300), word()) match {
        300 => true,
        _ => false,
    }
}

fn choose_byte(value: Byte, .fallback: Byte = value) -> Byte { fallback }
fn with_default() -> Byte { choose_byte(255) }
