-- Load comparison and resources as separate packages (host_examples.py does this).
use comparison.{Eq, Ord};

fn lower(a: T, b: T) -> T where T :- Ord + resources.Copy {
    if a.as(Ord).lt(b) { a } else { b }
}

fn run() -> bool {
    let low: .i128'builtin = -170141183460469231731687303715884105728;
    let high: .i128'builtin = 170141183460469231731687303715884105727;
    let smaller = lower(high, low);
    let distinct = low.as(Eq).ne(high);
    let ordered = low.as(Ord).cmp(high) matches .Less;
    smaller == low and distinct and ordered and not lower(true, false)
}
