typealias Byte = .u8'builtin;
typealias Bool = true'type;

fn captured(value: Byte) -> Byte {
    assumes value < 255;
    let bump = || value + 1;
    bump()
}
fn snapshot() -> Byte {
    var value: Byte = 4;
    let bump = || value + 1;
    value = 255;
    bump()
}
fn parameter(value: Byte) -> Byte {
    let bump = |input: Byte| {
        assumes input < 255;
        input + 1
    };
    bump(value)
}
fn nested(value: Byte) -> Byte {
    assumes value < 254;
    let outer = || {
        let next = value + 1;
        let inner = || next + 1;
        inner()
    };
    outer()
}
fn body_return() -> Byte {
    let callback = || { let value: Byte = 7; return value; };
    let result: Byte = 1 + 1;
    callback();
    result
}
comptime fn run() -> Byte {
    var value: Byte = 10;
    let callback = || value + 1;
    value = 255;
    callback()
}
comptime fn Select() -> .Type'builtin {
    if run() == 11 { Bool } else { Byte }
}
typealias Chosen = Select();
fn chosen() -> Chosen { true }
comptime fn GetterType() -> .Type'builtin {
    let value: Byte = 0;
    (|| value)'type
}
typealias Getter = GetterType();
comptime fn make(value: Byte) -> Getter {
    assumes value < 255;
    || value + 1
}
const SAVED = make(4);
comptime fn restored() -> Byte { SAVED() }
