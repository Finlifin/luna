use std.prelude.*;

fn demo() -> !std.io.Error void {
    println("你好，Flurry！")!;
    print("answer = ")!;
    let answer: u32 = 42;
    println_value(answer)!;

    print("Linux pid = ")!;
    println_value(std.os.unix.getpid())!;

    print("i128 minimum = ")!;
    let minimum: i128 = -170141183460469231731687303715884105728;
    println_value(minimum)!;
    println("done")
}

fn main() {
    let succeeded = demo() match {
        _! => true,
        error _ => false,
    };
    assumes succeeded;
}
