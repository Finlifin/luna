use std.prelude.*;

fn demo() -> !std.io.Error void {
    println("你好，Flurry！")!;
    let answer: u32 = 42;
    println("answer = {}, ready = {}", answer, true)!;

    println("Linux pid = {}", std.os.unix.getpid())!;

    let minimum: i128 = -170141183460469231731687303715884105728;
    println("i128 minimum = {{{}}}", minimum)!;
    println("done")
}

fn main() {
    let succeeded = demo() match {
        _! => true,
        error _ => false,
    };
    assumes succeeded;
}
