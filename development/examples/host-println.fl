use std.prelude.*;

pure comptime fn status_format(verbose: bool) -> str {
    if verbose {
        "answer = {}, ready = {}"
    } else {
        "answer = {}"
    }
}

fn demo() -> !std.io.Error void {
    println("你好，Flurry！")!;
    let answer: u32 = 42;
    println(status_format(false), answer)!;
    println(status_format(true), answer, true)!;

    println("Linux pid = {}", std.os.unix.getpid())!;

    let minimum: i128 = -170141183460469231731687303715884105728;
    println("i128 minimum = {{{}}}", minimum)!;
    println("done")
}

fn main() {
    let succeeded = demo() match {
        _! => true,
        error _ => false,
    }
    assumes succeeded;
}
