{- Public list-pattern protocol, with host-sized indices and affine owners. -}
struct Repeated { length: usize, value: bool }

impl ListPatternView for Repeated {
    assoc Element: Type = bool;
    fn list_pattern_view_get_len(*self) -> usize { self.length.* }
    fn list_pattern_view_get_element(*self, comptime index: usize) -> bool {
        self.value.*
    }
}

{- The same subject exposes Integer elements only in its comptime phase. -}
comptime impl ComptimeListPatternView for Repeated {
    assoc Element: Type = Integer;
    comptime fn list_pattern_view_get_len(self) -> usize { self.length }
    comptime fn list_pattern_view_get_element(self, index: usize) -> Integer {
        if self.value { 11 } else { 22 }
    }
}

comptime fn staged_contract() -> bool {
    let pair = Repeated {length: 2, value: true};
    let matched = pair match { [11, (second if second == 11)] => true, _ => false };
    let empty = Repeated {length: 0, value: false} match { [] => true, _ => false };
    matched and empty
}

fn exact(value: Repeated) -> bool {
    value match { [a, (b if a == b)] => a, _ => false }
}

fn prefix(value: Repeated) -> bool {
    value match { [true, true, ..._] => true, _ => false }
}

test exact_lengths_and_prefixes {
    let exact_pair = exact(Repeated {length: 2, value: true});
    let short = exact(Repeated {length: 1, value: true});
    let long = exact(Repeated {length: 3, value: true});
    let accepts_prefix = prefix(Repeated {length: 9, value: true});
    let rejects_prefix = prefix(Repeated {length: 1, value: true});
    assumes exact_pair and not short and not long and accepts_prefix and not rejects_prefix;
}

fn retry(value: Repeated) -> bool {
    value match { [true, true] => false, [false, false] => true, _ => false }
}

test failed_candidate_keeps_subject {
    let matched = retry(Repeated {length: 2, value: false});
    let empty = Repeated {length: 0, value: true} match { [] => true, _ => false };
    assumes matched and empty;
    inline if staged_contract() { assumes true; } else { assumes false; };
}

struct Tracked { retired: *bool }
impl Drop for Tracked {
    fn drop(*self) {
        assumes not self.retired.*.*;
        self.retired.*.* = true;
    }
}
impl ListPatternView for Tracked {
    assoc Element: Type = bool;
    fn list_pattern_view_get_len(*self) -> usize { 2 }
    fn list_pattern_view_get_element(*self, comptime index: usize) -> bool { false }
}

fn tracked(value: Tracked) -> bool {
    value match { [true, _] => false, [false, false] => true, _ => false }
}

test failed_observation_retires_owner_once {
    var retired = false;
    let matched = tracked(Tracked {retired: retired.ref});
    assumes matched and retired;
}
