use optional.OptionalOps;
use resources.Drop;

struct State {called: *bool, retired: *bool}
impl Drop for State {
    fn drop(*self) {
        assumes not self.retired.*.*;
        self.retired.*.* = true;
    }
}
fn trial(present: bool) -> bool {
    var called = false;
    var retired = false;
    let state = State {called: called.ref, retired: retired.ref};
    let callback = |value: bool| {
        assumes not state.called.*;
        state.called.* = true;
        value
    };
    let input: ?bool = if present {true} else {null};
    let mapped = input.as(OptionalOps<bool>).map<bool>(callback);
    called == present and retired and mapped.as(OptionalOps<bool>).unwrap_or(true)
}
fn fallback_trial(present: bool) -> bool {
    var called = false;
    var retired = false;
    let state = State {called: called.ref, retired: retired.ref};
    let fallback = || {
        assumes not state.called.*;
        state.called.* = true;
        true
    };
    let input: ?bool = if present {true} else {null};
    let value = input.as(OptionalOps<bool>).unwrap_or_else(fallback);
    value and called == not present and retired
}
fn run() -> bool {
    trial(true) and trial(false) and fallback_trial(true) and fallback_trial(false)
}
