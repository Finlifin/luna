{- Optional and error-qualified values expose the same method names through
   the protocols for their respective execution phases. -}

comptime fn invert(value: bool) -> bool { not value }
comptime fn forbidden() -> bool { assumes false; false }
comptime fn recover(failure: u8) -> bool { failure == 7 }

{- Both protocols are available in these generic definitions. The expression
   stage selects the interface; instantiation keeps that selected identity. -}
comptime fn staged_presence(value: T) -> bool
where T :- OptionalOps<bool> + ComptimeOptionalOps<bool>
{
    value.is_some()
}

fn runtime_presence(value: T) -> bool
where T :- OptionalOps<bool> + ComptimeOptionalOps<bool>
{
    value.is_some()
}

comptime fn staged_success(value: T) -> bool
where T :- ErrorResultOps<bool, u8> + ComptimeErrorResultOps<bool, u8>
{
    value.is_ok()
}

fn runtime_success(value: T) -> bool
where T :- ErrorResultOps<bool, u8> + ComptimeErrorResultOps<bool, u8>
{
    value.is_ok()
}

comptime fn inspect() -> bool {
    let present: ?bool = true;
    let absent: ?bool = null;
    let success: !u8 bool = true;
    let failure: !u8 bool = error 7;
    let mapped = present.map(invert);
    let flipped = success.map(invert);
    staged_presence(present) and staged_success(success)
        and present.unwrap_or_else(forbidden)
        and absent.is_none()
        and not mapped.unwrap_or(true)
        and not flipped.unwrap_or_else(recover)
        and failure.unwrap_or_else(recover)
}

fn run() -> bool {
    let present: ?bool = true;
    let success: !u8 bool = true;
    runtime_presence(present) and runtime_success(success)
}

test {
    const staged = inspect();
    let runtime = run();
    assumes staged and runtime;
}
