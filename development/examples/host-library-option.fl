-- Native optional operations, with resources supplied by a separate package.

fn invert(value: bool) -> bool {not value}
fn choose(value: bool) -> ?bool {
    if value {true} else {null}
}

fn run() -> bool {
    let first: ?bool = false;
    let mapped = first.map<bool>(invert);
    let absent: ?bool = null;
    let mapped_absent = absent.map<bool>(invert);
    let yes: ?bool = true;
    let no: ?bool = false;
    let chained = yes.and_then<bool>(choose);
    let stopped = no.and_then<bool>(choose);
    mapped.unwrap_or(false)
        and mapped_absent.is_none()
        and chained.is_some()
        and stopped.unwrap_or(true)
}

test value_operations {
    let passed = run();
    assumes passed;
}
