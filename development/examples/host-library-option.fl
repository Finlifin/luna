-- Actual Option value operations, with resources supplied by a separate package.
use optional.Option;

fn invert(value: bool) -> bool {not value}
fn choose(value: bool) -> ?bool {
    if value {.Some(true)} else {.None}
}

fn run() -> bool {
    let mapped: ?bool = Option<bool>.Some(false).map<bool>(invert);
    let absent: ?bool = Option<bool>.None;
    let mapped_absent = absent.map<bool>(invert);
    let chained = Option<bool>.Some(true).and_then<bool>(choose);
    let stopped = Option<bool>.Some(false).and_then<bool>(choose);
    mapped.unwrap_or(false)
        and mapped_absent.is_none()
        and chained.is_some()
        and stopped.unwrap_or(true)
}

test value_operations {
    let passed = run();
    assumes passed;
}
