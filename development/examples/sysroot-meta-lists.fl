{-
    Use the complete sysroot and public meta interfaces. The callback state and
    input snapshots belong to this invocation, not to the collection helpers.
    Zero is a probe input for the stateful callbacks below; the source contains
    only positive values. Probes inspect captured state without source pointers.
-}
{- An empty or singleton traversal must never execute this callback path. -}
comptime fn invalid_callback() -> bool {
    let empty: meta.List<bool> = [];
    empty[0]
}

comptime fn select(value: Integer) -> ?Integer {
    if value == 2 { null } else { value * 10 }
}

comptime fn expand(value: Integer) -> meta.List<Integer> {
    if value == 2 { [] } else { [value, value + 10] }
}

comptime fn optional(flag: bool) -> ??Integer {
    let values: meta.List<?Integer> = [null];
    values.find(|value| flag)
}

comptime fn run() -> bool {
    var original: meta.List<Integer> = [1, 2, 3];
    let saved = original;
    var visits: Integer = 0;
    let mapper = |value: Integer| -> ?Integer {
        if value == 0 {visits + original.length()} else {
            visits = visits * 10 + value;
            original = [];
            select(value)
        }
    };
    let selected = saved.filter_map(mapper);
    let trace = mapper(0);
    let flattened = saved.flat_map(expand);
    let nested = meta.List<bool>.filter_map([false, true, false],optional);
    let empty: meta.List<Integer> = [];
    let unused = empty.flat_map(|value| {
        invalid_callback();
        expand(value)
    });
    let unused_filter = empty.filter_map(|value| {
        invalid_callback();
        select(value)
    });
    (trace match {value? => value == 123, null => false})
        and visits == 0 and original.length() == 3 and saved.length() == 3
        and selected.length() == 2 and selected[0] == 10 and selected[1] == 30
        and flattened.length() == 4
        and flattened[0] == 1 and flattened[1] == 11
        and flattened[2] == 3 and flattened[3] == 13
        and nested.length() == 1
        and (nested[0] match { null => true, _? => false })
        and unused.length() == 0 and unused_filter.length() == 0
        and reducers_and_searches() and named_metadata() and stable_sorting()
        and exact_integer_division() and value_receivers() and indexed_pairing() and bulk_extension()
}

comptime fn exact_integer_division() -> bool {
    let q: Integer = 1606938044258990275541962092341162602522202993782792835301376;
    let dividend = q * 17 + 9;
    meta.div_trunc(dividend, 17) == q and meta.rem_trunc(dividend, 17) == 9
        and meta.div_trunc(-dividend, 17) == -q and meta.rem_trunc(-dividend, 17) == -9
        and meta.div_trunc(dividend, -17) == -q and meta.rem_trunc(dividend, -17) == 9
}

comptime fn stable_sorting() -> bool {
    let input: meta.List<Integer> = [12, 1, 11, 3, 2];
    let ordered = input.sort_by(|a, b| {
        let left = meta.rem_trunc(a, 10);
        let right = meta.rem_trunc(b, 10);
        left < right
    });
    let types: meta.List<Type> = [bool, u32, bool];
    let retained = types.sort_by(|a, b| false);
    input[0] == 12 and input[1] == 1
        and ordered[0] == 1 and ordered[1] == 11 and ordered[2] == 12
        and ordered[3] == 2 and ordered[4] == 3
        and retained[0] == bool and retained[1] == u32 and retained[2] == bool
        and ordered.partition_point(|value| meta.rem_trunc(value, 10) < 2) == 2
        and ordered.lower_bound(2, |a, b| meta.rem_trunc(a, 10) < meta.rem_trunc(b, 10)) == 2
        and ordered.upper_bound(2, |a, b| meta.rem_trunc(a, 10) < meta.rem_trunc(b, 10)) == 4
}

comptime fn named_metadata() -> bool {
    let absent: ?Integer = null;
    let input = {enabled: true, 'x', enabled: false, limit: absent};
    let shadowed = {enabled: true, enabled: 'x'};
    var draft = {enabled: false};
    let saved = draft;
    draft = update_metadata(draft, true);
    (meta.Object.get<bool>(input, .enabled) matches false?)
        and (meta.Object.get<bool>(input, .missing) matches null)
        and (meta.Object.get<bool>(shadowed, .enabled) matches null)
        and (meta.Object.get<?Integer>(input, .limit) match {
            value? => value matches null, null => false,
        })
        and (meta.Object.get<bool>(saved, .enabled) matches false?)
        and (meta.Object.get<bool>(draft, .enabled) matches true?)
}

comptime fn update_metadata(output: meta.Object, enabled: bool) -> meta.Object {
    output.replace(0, enabled)
}

comptime fn reducers_and_searches() -> bool {
    var original: meta.List<Integer> = [1, 2, 3];
    let saved = original;
    var calls: Integer = 0;
    let reducer = |left: Integer, right: Integer| {
        if right == 0 {calls + original.length()} else {
            calls += 1;
            original = [];
            left * 10 + right
        }
    };
    let reduced = saved.reduce(reducer);
    let reduction_calls = reducer(0, 0);
    let empty: meta.List<Integer> = [];
    let absent = empty.reduce(|left, right| {
        invalid_callback();
        left + right
    });
    let singles: meta.List<Integer> = [7];
    let singleton = singles.reduce(|left, right| {
        invalid_callback();
        left + right
    });
    let optionals: meta.List<?Integer> = [null];
    let nested = optionals.reduce(|left, right| right);
    var visits: Integer = 0;
    let finder = |value: Integer| -> ?Integer {
        if value == 0 {visits} else {
            visits = visits * 10 + value;
            if value == 2 { value * 10 } else { null }
        }
    };
    let found: ?Integer = saved.find_map(finder);
    let search_trace = finder(0);
    let present_null = meta.List<bool>.find_map([false, true, false],optional);
    let no_match = empty.find_map(|value| {
        invalid_callback();
        select(value)
    });
    reduction_calls == 2 and calls == 0 and visits == 0
        and (search_trace match {value? => value == 12, null => false})
        and original.length() == 3
        and saved.length() == 3
        and (reduced match { value? => value == 123, null => false })
        and (absent match { null => true, _? => false })
        and (singleton match { value? => value == 7, null => false })
        and (nested match { value? => value match { null => true, _? => false }, null => false })
        and (found match { value? => value == 20, null => false })
        and (present_null match { value? => value match { null => true, _? => false }, null => false })
        and (no_match match { null => true, _? => false })
}

test comptime_list_collectors {
    inline if run() {
        assumes true;
    } else {
        assumes false;
    };
}

{- Direct and projected list receivers update their original slots. -}
struct ListHolder { items: meta.List<bool>, tag: bool }

comptime fn value_receivers() -> bool {
    var values: meta.List<bool> = [false];
    let saved = values;
    values.append(true);
    let holder = ListHolder {items: values, tag: false};
    holder.items.append(false);
    let slice = holder.items.slice(1, 3);
    saved.length() == 1 and values.length() == 2
        and holder.items.length() == 3 and not holder.tag
        and (slice match { items? => items.length() == 2 and items[0] and not items[1], null => false })
}

{- Code generators can pair declaration inputs and keep their source indices. -}
comptime fn indexed_pairing() -> bool {
    let widths: meta.List<Integer> = [8, 16, 32];
    let flags: meta.List<bool> = [true, false];
    let indexed = widths.map_indexed(|index, width| index * 100 + width);
    let paired = widths.zip_with(flags, |width, enabled| if enabled {width} else {0});
    let found = widths.position(|width| width == 16);
    let empty: meta.List<Integer> = [];
    let missing = empty.position(|width| true);
    indexed.length() == 3 and indexed[0] == 8 and indexed[2] == 232
        and paired.length() == 2 and paired[0] == 8 and paired[1] == 0
        and (found match { index? => index == 1, null => false })
        and (missing match { null => true, _? => false })
}

comptime fn bulk_extension() -> bool {
    var values: meta.List<Integer> = [1, 2];
    let saved = values;
    values.append_all(values);
    values.append_all([]);
    let holder = ListHolder {items: [true], tag: false};
    holder.items.append_all([false, true]);
    values.length() == 4 and values[0] == 1 and values[2] == 1
        and values[3] == 2 and saved.length() == 2
        and holder.items.length() == 3 and not holder.items[1] and holder.items[2]
}
