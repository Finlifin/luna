{-
    Use the complete sysroot and public meta interfaces. The callback state and
    input snapshots belong to this invocation, not to the collection helpers.
-}
comptime fn select(value: Integer) -> ?Integer {
    if value == 2 { null } else { value * 10 }
}

comptime fn expand(value: Integer) -> meta.List<Integer> {
    if value == 2 { [] } else { [value, value + 10] }
}

comptime fn optional(flag: bool) -> ??Integer {
    let values: meta.List<?Integer> = [null];
    meta.find(values, |value| flag)
}

comptime fn run() -> bool {
    var original: meta.List<Integer> = [1, 2, 3];
    let saved = original;
    var visits: Integer = 0;
    let counter = visits.ref;
    let source = original.ref;
    let selected = meta.filter_map(saved, |value| {
        counter.* = counter.* * 10 + value;
        source.* = [];
        select(value)
    });
    let flattened = meta.flat_map(saved, expand);
    let nested = meta.filter_map([false, true, false], optional);
    let empty: meta.List<Integer> = [];
    let unused = meta.flat_map(empty, |value| {
        counter.* = 999;
        expand(value)
    });
    let unused_filter = meta.filter_map(empty, |value| {
        counter.* = 999;
        select(value)
    });
    visits == 123 and meta.length(original) == 0 and meta.length(saved) == 3
        and meta.length(selected) == 2 and selected[0] == 10 and selected[1] == 30
        and meta.length(flattened) == 4
        and flattened[0] == 1 and flattened[1] == 11
        and flattened[2] == 3 and flattened[3] == 13
        and meta.length(nested) == 1
        and (nested[0] match { null => true, _? => false })
        and meta.length(unused) == 0 and meta.length(unused_filter) == 0
        and reducers_and_searches() and named_metadata() and stable_sorting()
        and exact_integer_division()
}

comptime fn exact_integer_division() -> bool {
    let q: Integer = 1606938044258990275541962092341162602522202993782792835301376;
    let dividend = q * 17 + 9;
    meta.div_trunc(dividend, 17) == q and meta.rem_trunc(dividend, 17) == 9
        and meta.div_trunc(-dividend, 17) == -q and meta.rem_trunc(-dividend, 17) == -9
        and meta.div_trunc(dividend, -17) == -q and meta.rem_trunc(dividend, -17) == 9
}

comptime fn stable_sorting() -> bool {
    let input: meta.List<Integer> = [12, 1, 11, 3, 2];
    let ordered = meta.sort_by(input, |a, b| {
        let left = meta.rem_trunc(a, 10);
        let right = meta.rem_trunc(b, 10);
        left < right
    });
    let types: meta.List<Type> = [bool, u32, bool];
    let retained = meta.sort_by(types, |a, b| false);
    input[0] == 12 and input[1] == 1
        and ordered[0] == 1 and ordered[1] == 11 and ordered[2] == 12
        and ordered[3] == 2 and ordered[4] == 3
        and retained[0] == bool and retained[1] == u32 and retained[2] == bool
        and meta.partition_point(ordered, |value| meta.rem_trunc(value, 10) < 2) == 2
        and meta.lower_bound(ordered, 2, |a, b| meta.rem_trunc(a, 10) < meta.rem_trunc(b, 10)) == 2
        and meta.upper_bound(ordered, 2, |a, b| meta.rem_trunc(a, 10) < meta.rem_trunc(b, 10)) == 4
}

comptime fn named_metadata() -> bool {
    let absent: ?Integer = null;
    let input = {enabled: true, 'x', enabled: false, limit: absent};
    let shadowed = {enabled: true, enabled: 'x'};
    var draft = {enabled: false};
    let saved = draft.ref.*;
    update_metadata(draft.ref, true);
    (meta.object_get<bool>(input, .enabled) matches false?)
        and (meta.object_get<bool>(input, .missing) matches null)
        and (meta.object_get<bool>(shadowed, .enabled) matches null)
        and (meta.object_get<?Integer>(input, .limit) match {
            value? => value matches null, null => false,
        })
        and (meta.object_get<bool>(saved, .enabled) matches false?)
        and (meta.object_get<bool>(draft, .enabled) matches true?)
}

comptime fn update_metadata(output: *meta.Object, enabled: bool) {
    output.* = meta.object_replace(output.*, 0, enabled);
}

comptime fn reducers_and_searches() -> bool {
    var original: meta.List<Integer> = [1, 2, 3];
    let saved = original;
    let source = original.ref;
    var calls: Integer = 0;
    let counter = calls.ref;
    let reduced = meta.reduce(saved, |left, right| {
        counter.* += 1;
        source.* = [];
        left * 10 + right
    });
    let empty: meta.List<Integer> = [];
    let absent = meta.reduce(empty, |left, right| {
        counter.* = 999;
        left + right
    });
    let singles: meta.List<Integer> = [7];
    let singleton = meta.reduce(singles, |left, right| {
        counter.* = 999;
        left + right
    });
    let optionals: meta.List<?Integer> = [null];
    let nested = meta.reduce(optionals, |left, right| right);
    var visits: Integer = 0;
    let trace = visits.ref;
    let found: ?Integer = meta.find_map(saved, |value| {
        trace.* = trace.* * 10 + value;
        if value == 2 { value * 10 } else { null }
    });
    let present_null = meta.find_map([false, true, false], optional);
    let no_match = meta.find_map(empty, |value| {
        trace.* = 999;
        select(value)
    });
    calls == 2 and visits == 12 and meta.length(original) == 0
        and meta.length(saved) == 3
        and (reduced match { value? => value == 123, null => false })
        and (absent match { null => true, _? => false })
        and (singleton match { value? => value == 7, null => false })
        and (nested match { value? => value match { null => true, _? => false }, null => false })
        and (found match { value? => value == 20, null => false })
        and (present_null match { value? => value match { null => true, _? => false }, null => false })
        and (no_match match { null => true, _? => false })
}

test comptime_list_collectors {
    inline if run() {
        assumes true;
    } else {
        assumes false;
    };
}
