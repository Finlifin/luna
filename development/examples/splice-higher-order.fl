-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
-- Intermediate functions and closures stay at comptime.
-- Only the final bool crosses into runtime through Splice.
-- Run with --interpret run --splice-protocol Splice.
typealias Type = .Type'builtin;
trait Splice {
    assoc RuntimeTarget: Type;
    fn splice(comptime data: Self) -> RuntimeTarget;
}
impl Splice for bool {
    assoc RuntimeTarget: Type = Tuple<bool, bool>;
    fn splice(comptime data: bool) -> Tuple<bool, bool> { construct(data) }
}
fn construct(value: bool) -> Tuple<bool, bool> { (value, not value) }
typealias Callback = %{flag: bool} comptime fn() -> bool;
comptime fn capture(flag: bool) -> Callback { || flag }
comptime fn factory() -> comptime fn(bool) -> Callback { capture }

fn forward(comptime flag: bool) -> Tuple<bool, bool> {
    factory()(flag)()
}

fn run() -> Tuple<Tuple<bool, bool>, Tuple<bool, bool>> {
    (forward(true), (do { factory() })(false)())
}
