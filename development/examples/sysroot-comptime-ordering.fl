{- Ordinary comptime ordering shares Order without selecting runtime methods. -}
comptime fn ordered_text() -> bool {
    let small: u8 = 7;
    let larger: u8 = 9;
    let negative: i64 = -3;
    let positive: i64 = 1;
    let pointer_width: usize = 2;
    let signed_pointer_width: isize = -1;
    let character: char = 'é';
    let words: List<str> = ["é", "a", "", "ab", "a"];
    let sorted = words.sort_by(|left, right| left.lt(right));
    let tags: List<Symbol> = [.beta, .alpha, .alphabet, .alpha];
    let ordered_tags = tags.sort_by(|left, right| left.lt(right));
    let groups: List<List<u8>> = [[2], [], [1, 2], [1]];
    let ordered_groups = groups.sort_by(|left, right| left.lt(right));
    let optional_numbers: List<?u8> = [2, null, 1, null];
    let ordered_optional = optional_numbers.sort_by(|left, right| left.lt(right));
    let success: !u8 u8 = 7;
    let failure: !u8 u8 = error 1;
    let results: List<!u8 u8> = [failure, success];
    let ordered_results = results.sort_by(|left, right| left.lt(right));
    sorted.eq(["", "a", "a", "ab", "é"])
        and ordered_tags.eq([.alpha, .alpha, .alphabet, .beta])
        and tags[0].eq(.beta)
        and ordered_groups.eq([[], [1], [1, 2], [2]])
        and groups[0].eq([2])
        and ordered_optional.eq([null, null, 1, 2])
        and optional_numbers[0].eq(2)
        and ordered_results.eq([success, failure])
        and results[0].eq(failure)
        and ("ab".cmp("ac") matches .less)
        and ("same".cmp("same") matches .equal)
        and ("ab".cmp("a") matches .greater)
        and "a".le("a") and "b".gt("a") and "b".ge("b")
        and false.lt(true) and true.gt(false)
        and (small.cmp(larger) matches .less)
        and negative.lt(positive)
        and pointer_width.gt(1) and signed_pointer_width.lt(0)
        and character.gt('a')
        and (10000000000000000000000000000000000000000).gt(1)
}
const checked_ordering = ordered_text();

test comptime_ordering {
    inline if checked_ordering {} else { assumes false; };
    let runtime_value: u8 = 1;
    let runtime_less = runtime_value.lt(2);
    assumes runtime_less;
}
