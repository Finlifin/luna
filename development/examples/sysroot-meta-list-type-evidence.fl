{-
    A branch-dependent list can retain a common Type at a known index.
    The list keeps its meta.List identity; its differing elements remain
    branch-dependent, and normal-form type heads are not unfolded.
-}
comptime fn choose(flag: bool) -> bool {
    let types: meta.List<Type> = if flag {
        [bool, u8]
    } else {
        [bool, u16]
    };
    let T = types[0];
    let value: T = flag;
    value
}

comptime fn prefix_length(flag: bool) -> Integer {
    let types: meta.List<Type> = if flag { [bool, u8] } else { [bool] };
    let T = types[0];
    let value: T = flag;
    types.length()
}

comptime fn run() -> bool {
    choose(true) and not choose(false)
        and prefix_length(true) == 2 and prefix_length(false) == 1
}
