-- A default method may use the capabilities promised by its Type parameters.
trait Read { fn read(self) -> bool; }

struct Leaf where T { value: T }

impl Read for Leaf<T> where T, requires T == bool {
    fn read(self) -> bool { self.value }
}

trait Adapter where T :- Read {
    fn run(value: T) -> bool { value.read() }
}

struct Host {}
impl Adapter<T> for Host where T :- Read {}

fn adapted() -> bool {
    Host.as(Adapter<Leaf<bool>>).run(Leaf<bool> { value: true })
}

-- The declaration's type requirement checks both the body and every instance.
trait Checked where T, requires T == bool {
    fn accept(value: T) -> bool { value }
}

trait Child :- Checked<T> where T, requires T == bool {}
impl Checked<U> for Host where U, requires U == bool {}
impl Child<U> for Host where U, requires U == bool {}

fn forward(value: V) -> bool where V, requires V == bool {
    Host.as(Child<V>).accept(value)
}

fn checked() -> bool { forward(true) }
