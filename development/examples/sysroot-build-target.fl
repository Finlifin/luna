{-
    The embedding driver supplies this package's explicit target snapshot.
    Feature selection stays at comptime; runtime receives only checked branches.
-}
use build.target as selected;
const target = selected;
const enabled = target.features.get(.vector);
const disabled = target.features.get(.disabled);
const absent = target.features.get(.unknown);

comptime fn read_feature(
    query: comptime fn(build.TargetFeatures, Symbol) -> ?bool,
    features: build.TargetFeatures,
    name: Symbol,
) -> ?bool {
    query(features, name)
}

const selected_query = build.TargetFeatures.get;
const queried_enabled = read_feature(selected_query, target.features, .vector);
const queried_disabled = read_feature(selected_query, target.features, .disabled);
const queried_absent = read_feature(selected_query, target.features, .unknown);

test selected_target {
    inline if (target.arch matches .configured_arch)
        and (target.os matches .configured_os)
        and target.pointer_bits == 64 {
        assumes true;
    } else { assumes false; };
}

test selected_features {
    inline if (enabled matches true?) and (disabled matches false?)
        and (absent matches null) and (queried_enabled matches true?)
        and (queried_disabled matches false?) and (queried_absent matches null) {
        assumes true;
    } else { assumes false; };
}
