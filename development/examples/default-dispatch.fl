-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
trait Read {
    fn read(self) -> true'type;
    fn invert(self) -> true'type { not self.as(Read).read() }
}

struct Yes {}
struct No {}

impl Read for Yes {
    fn read(self) -> true'type { true }
}
impl Read for No {
    fn read(self) -> true'type { false }
}

fn run() -> Tuple<true'type, true'type> {
    (Yes {}.as(Read).invert(), No {}.as(Read).invert())
}
