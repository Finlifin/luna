-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Single = .f32'builtin;
typealias Double = .f64'builtin;
typealias Byte = .u8'builtin;
typealias Sign = .BitVec'builtin<1>;
typealias Mantissa = .BitVec'builtin<23>;
typealias Exponent64 = .BitVec'builtin<11>;
typealias Mantissa64 = .BitVec'builtin<52>;

fn decode(value: Single) -> Tuple<Byte, Byte, .u32'builtin> {
    let 0b(sign: Sign) (exponent: Byte) (mantissa: Mantissa) = value'bitvec;
    (sign.as(Byte), exponent, mantissa.as(.u32'builtin))
}
fn decode_double(value: Double) -> Tuple<Byte, .u16'builtin, .u64'builtin> {
    let 0b(sign: Sign) (exponent: Exponent64) (mantissa: Mantissa64) = value'bitvec;
    (sign.as(Byte), exponent.as(.u16'builtin), mantissa.as(.u64'builtin))
}
fn is_nan(value: Single) -> true'type {
    value'bitvec match {
        0b(_: Sign) 11111111 (mantissa: Mantissa) if mantissa != 0 => true,
        _ => false,
    }
}
fn example() -> Tuple<Byte, Byte, .u32'builtin> { decode(13.625) }
fn flipped() -> Single {
    var value: Single = 13.625;
    value'bitvec[31] = 1;
    value
}
fn nan_payload() -> Single {
    var value: Single = 0.0;
    value'bitvec = 0x7FC00042;
    value
}
fn infinity() -> Double {
    var value: Double = 0.0;
    value'bitvec[52..63] = 2047;
    value
}
