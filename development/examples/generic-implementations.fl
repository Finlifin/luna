-- Generic implementation declarations and compile-time candidate substitution.
-- Concrete dispatch instances are selected during compilation. The interpreter
-- only reads the resulting table, including calls in generic forwarding bodies.
typealias Flag = bool;
typealias Letter = 'x''type;

trait Read {
    fn read(self) -> Flag;
}

struct Box where T {
    value: T,
}

impl Read for Box<T> where T, requires T == Flag {
    fn read(self) -> Flag { self.value }
}

impl Read for Box<U> where U, requires U == Letter {
    fn read(self) -> Flag { false }
}

fn read(value: V) -> Flag where V :- Read {
    value.read()
}

fn flag() -> Flag {
    read(Box<Flag> { value: true })
}

fn letter() -> Flag {
    read(Box<Letter> { value: 'x' })
}
