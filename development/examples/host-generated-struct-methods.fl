{-
  Build a concrete record from reflected field descriptions, then use that
  generated type through ordinary methods and affine resource protocols.
  Reflection preserves field Type identities; it does not grant Copy.
-}
use primitives.Type;

struct Source {
    ready: bool,
    enabled: bool,
}

comptime fn Mirrored() -> Type {
    let names = meta.struct_field_names(Source);
    let types = meta.struct_field_types(Source);
    let count = meta.length(names);
    var index = count - count;
    var builder = meta.StructBuilder.new(.name = .Mirrored);
    while index < count {
        builder.add_field(names[index], types[index]);
        index = index + 1;
    }
    builder.Build()
}

typealias Flags = Mirrored();

impl resources.Once for Flags {}
impl resources.Clone for Flags {
    fn clone(*self) -> Self {
        Self { ready: self.ready.*, enabled: self.enabled.* }
    }
}
impl resources.Copy for Flags {}

impl Flags {
    fn toggled(self) -> Self {
        Self { ready: not self.ready, enabled: self.enabled }
    }
}

fn relay(value: T) -> T where T {
    value
}

fn run() -> bool {
    var original = Flags { ready: false, enabled: true };
    let changed = relay(original.toggled());
    let cloned = original.as(resources.Clone).clone();
    original.enabled = false;
    changed.ready and changed.enabled and
        not original.ready and not original.enabled and
        not cloned.ready and cloned.enabled
}
