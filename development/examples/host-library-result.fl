-- Library Result is an ordinary enum, separate from the language error ABI.
use fallible.Result;

fn invert(value: bool) -> bool {not value}
fn choose(value: bool) -> Result<bool, bool> {
    if value {.Ok(true)} else {.Err(true)}
}

struct Recovery {called: *bool, retired: *bool}
impl resources.Drop for Recovery {
    fn drop(*self) {
        assumes not self.retired.*.*;
        self.retired.*.* = true;
    }
}

fn recover_trial(ok: bool, succeed: bool) -> bool {
    var called = false;
    var retired = false;
    let state = Recovery {called: called.ref, retired: retired.ref};
    let recover = |reason: bool| -> Result<bool, .u32'builtin> {
        assumes not state.called.*;
        state.called.* = true;
        if reason {.Ok(true)} else {.Err(42)}
    };
    let input: Result<bool, bool> = if ok {.Ok(true)} else {.Err(succeed)};
    let result = input.or_else<.u32'builtin>(recover);
    let valid = result match {
        .Ok(value) => value and (ok or succeed),
        .Err(reason) => reason == 42 and not ok and not succeed,
    };
    valid and called == not ok and retired
}

fn fallback_trial(ok: bool) -> bool {
    var called = false;
    var retired = false;
    let state = Recovery {called: called.ref, retired: retired.ref};
    let fallback = |reason: bool| {
        assumes not state.called.*;
        state.called.* = true;
        reason
    };
    let input: Result<bool, bool> = if ok {.Ok(true)} else {.Err(true)};
    let value = input.unwrap_or_else(fallback);
    value and called == not ok and retired
}
fn run() -> bool {
    let mapped = Result<bool, bool>.Ok(false).map<bool>(invert);
    let mapped_err = Result<bool, bool>.Err(false).map_err<bool>(invert);
    let chained = Result<bool, bool>.Ok(true).and_then<bool>(choose);
    let rejected = Result<bool, bool>.Ok(false).and_then<bool>(choose);
    let preserved = Result<bool, bool>.Err(true).and_then<bool>(choose);
    (mapped match {.Ok(value) => value, .Err(_) => false})
        and (mapped_err match {.Ok(_) => false, .Err(value) => value})
        and chained.is_ok() and rejected.is_err() and preserved.is_err()
        and recover_trial(true, false) and recover_trial(false, true)
        and recover_trial(false, false) and fallback_trial(true) and fallback_trial(false)
}

test value_operations {
    let passed = run();
    assumes passed;
}
