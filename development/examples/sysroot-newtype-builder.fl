{- Build a nominal boundary from a completed Type using the public meta API. -}
comptime fn Flag() -> Type {
    let draft = meta.NewtypeBuilder.new(bool, .name = .GeneratedFlag);
    draft.Build()
}

typealias Enabled = Flag();
typealias Visible = Flag();
newtype Wrapper<T> = T;
newtype Checked<T:-Representation> = T;

comptime fn ReflectedFlag() -> Type {
    let draft = meta.NewtypeBuilder.from_type(Wrapper<bool>, .name = .ReflectedFlag);
    draft.Build()
}

typealias Reflected = ReflectedFlag();

fn run() -> bool {
    let enabled = true.as(Enabled);
    let visible = false.as(Visible);
    enabled.as(bool) and not visible.as(bool)
        and true.as(Reflected).as(bool) and true.as(Checked<bool>).as(bool)
}

test {
    inline if checked_associated_conversion {
        let result = run();
        assumes result;
    } else {
        assumes false;
    };
}

trait Representation {
    assoc Item: Type;
}

impl Representation for bool {
    assoc Item: Type = bool;
}

comptime fn associated_round_trip(comptime T: Type, value: T.as(Representation).Item) -> T.as(Representation).Item
where requires T :- Representation
{
    let wrapped = value.as(Wrapper<T.as(Representation).Item>);
    wrapped.as(T.as(Representation).Item)
}

comptime fn generated_round_trip() -> bool {
    let wrapped = true.as(Reflected);
    wrapped.as(bool) and associated_round_trip(bool, true)
}

const checked_associated_conversion = generated_round_trip();
