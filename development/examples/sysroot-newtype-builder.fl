{- Build a nominal boundary from a completed Type using the public meta API. -}
comptime fn Flag() -> Type {
    let draft = meta.NewtypeBuilder.new(bool, .name = .GeneratedFlag);
    draft.Build()
}

typealias Enabled = Flag();
typealias Visible = Flag();
newtype Wrapper<T> = T;

comptime fn ReflectedFlag() -> Type {
    let draft = meta.NewtypeBuilder.from_type(Wrapper<bool>, .name = .ReflectedFlag);
    draft.Build()
}

typealias Reflected = ReflectedFlag();

fn run() -> bool {
    let enabled = true.as(Enabled);
    let visible = false.as(Visible);
    enabled.as(bool) and not visible.as(bool) and true.as(Reflected).as(bool)
}

test {
    let result = run();
    assumes result;
}
