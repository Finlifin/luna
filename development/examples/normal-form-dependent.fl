-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Type = .Type'builtin;
pure comptime fn Tagged<T: Type, value: T> -> Type { T }
pure comptime fn Forward<T: Type, value: T> -> Type { Tagged<T, value> }
pure comptime fn Pair<A: Type, left: A, B: Type, right: B> -> Type { Tuple<A, B> }
typealias Byte = Tagged<.u8'builtin, 255>;
typealias SameByte = Tagged<.u8'builtin, 0xff>;
fn same(value: Byte) -> SameByte { value }
comptime fn Observed() -> Type { Pair<true'type, false, .i8'builtin, -128> }
comptime fn IntegerTag() -> Type { Tagged<.Integer'builtin, 2 * 3> }
pure comptime fn EqualForward<A: Type, value: A, B: Type> -> Type where requires A == B {
    Tagged<B, value>
}
typealias EqualByte = EqualForward<.u8'builtin, 255, .u8'builtin>;
comptime fn TypeTag() -> Type { Tagged<Type, .u8'builtin> }
pure comptime fn TypeForward<T: Type> -> Type { Tagged<Type, T> }
