{-
  Ordered heterogeneous metadata participates in a normal-form Type identity.
  Reconstruct the same metadata as a clause input to a comptime consumer.
-}
use primitives.Type;

pure comptime fn Tagged<metadata: meta.Object> -> Type { bool }

comptime fn enabled() -> bool where metadata: meta.Object {
    meta.object_value<bool>(metadata, 0) match { value? => value, null => false }
}

const METADATA = {flag:true, kind:bool, flag:false};
const ENABLED = enabled<METADATA>();

comptime fn configured() -> <|-bool> {
    let original = {flag:true, kind:bool, flag:false};
    let same = {flag:true, kind:bool, flag:false};
    let Original = Tagged<original>;
    let Same = Tagged<same>;
    let changed = meta.object_replace(original, 0, false);
    let result = Original == Same
        and (meta.object_value<bool>(changed, 0) match {v? => not v, null => false})
        and ENABLED;
    '(result)
}

fn run() -> bool { ~<configured()> }
