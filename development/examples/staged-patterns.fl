-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
-- Match chooses the instance input; no matching remains in the runtime body.
fn selected(comptime value: bool) -> bool {
    value
}

fn opposite(comptime flag: bool) -> bool {
    selected(flag match {
        true => false,
        false => true,
    })
}

-- A normal-form head is observed without invoking its body.
typealias Type = .Type'builtin;
pure comptime fn Identity<T> -> Type { T }

fn has_identity_head() -> bool where T {
    selected(T match {
        Identity<Element> => true,
        _ => false,
    })
}

fn run() -> Tuple<bool, bool, bool, bool> {
    (opposite(false), opposite(true),
     has_identity_head<Identity<bool>>(), has_identity_head<bool>())
}
