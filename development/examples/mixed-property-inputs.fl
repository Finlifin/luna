-- Anchored inputs retain their parameter contexts. Properties form one packet;
-- their positions among the explicit inputs determine evaluation order.
fn configure(
    requested: .u8'builtin,
    ...properties: T,
    enabled: bool,
    .limit: .u8'builtin = requested,
) -> (.u8'builtin, T, bool)
where T
{
    (limit, properties, enabled)
}

fn entry() -> bool {
    let (limit, settings, enabled) = configure {
        7,
        label: 'x',
        true,
        retained: true,
    };
    limit == 7 and enabled and settings.retained and settings.label == 'x'
}
