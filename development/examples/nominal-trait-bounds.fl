trait Read {
    fn read(self) -> true'type;
}

struct Box where T :- Read {
    value: T,
}
enum Maybe where T :- Read {
    none,
    some(T),
}
struct Flag {}

fn unwrap(value: Maybe<T>) -> true'type where T :- Read {
    value match {
        Maybe<T>.none => false,
        Maybe<T>.some(item) => item.read(),
    }
}

fn run() -> true'type {
    let boxed = Box<Flag> { value: Flag {} };
    unwrap(Maybe<Flag>.some(boxed.value))
}

-- Formation checks use the whole implementation world, not source order.
impl Read for Flag {
    fn read(self) -> true'type { true }
}
