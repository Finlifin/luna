{-
  Exercise the public Hash protocol from the complete sysroot. Runtime and
  comptime members remain separate implementations with matching results.
-}
comptime fn wide_digest() -> u64 {
    let value: u128 = 18446744073709551616;
    value.as(ComptimeHash).hash()
}

comptime fn symbol_digest() -> u64 {
    let value: Symbol = .foobar;
    value.as(ComptimeHash).hash()
}

test scalar_representations {
    let unsigned: u8 = 255;
    let signed: i8 = -128;
    let character: char = '🦀';
    let unsigned_hash = unsigned.as(Hash).hash();
    let signed_hash = signed.as(Hash).hash();
    let character_hash = character.as(Hash).hash();
    let true_hash = true.as(Hash).hash();
    let false_hash = false.as(Hash).hash();
    assumes unsigned_hash == 255 and signed_hash == 128;
    assumes character_hash == 129408 and true_hash == 1 and false_hash == 0;
}

test wide_values_and_comptime_phase {
    let wide: u128 = 18446744073709551616;
    let signed: i128 = -170141183460469231731687303715884105728;
    let actual = wide.as(Hash).hash();
    let signed_hash = signed.as(Hash).hash();
    inline if wide_digest() == 1 {
        assumes actual == 1;
    } else {
        assumes false;
    };
    assumes signed_hash == 9223372036854775808;
}

test symbol_runtime_and_comptime_phases {
    let first: Symbol = .foobar;
    let second: Symbol = .foobar;
    let different: Symbol = .a;
    assumes first == second and first != different;
    let first_hash = first.as(Hash).hash();
    let second_hash = second.as(Hash).hash();
    let different_hash = different.as(Hash).hash();
    assumes first_hash == second_hash;
    assumes different_hash == 12638187200555641996;
    inline if symbol_digest() == 9625390261332436968 {
        assumes first_hash == 9625390261332436968;
    } else {
        assumes false;
    };
}

comptime fn exact_integer_keys() -> bool {
    let zero: Integer = 0;
    let huge: Integer = 1606938044258990275541962092341162602522202993782792835301376;
    let same: Integer = 0x100000000000000000000000000000000000000000000000000;
    zero.hash() == 590684067820433389
        and huge.hash() == 8424690812682328228
        and (-huge).hash() == 18410723617023889215
        and (huge + 1).hash() == 6053771721358495617
        and huge.eq(same) and huge.ne(-huge)
        and huge.hash() == same.hash()
}

test arbitrary_precision_comptime_keys {
    inline if exact_integer_keys() {assumes true;} else {assumes false;}
}

struct FoldedKey { value: Integer }

comptime impl ComptimeEq for FoldedKey {
    comptime fn eq(self, other: Self) -> bool {
        self.value.rem_euclid(10) == other.value.rem_euclid(10)
    }
}

comptime fn list_protocol_equality() -> bool {
    let empty: List<Integer> = [];
    let first: List<Integer> = [1, 2];
    let same: List<Integer> = [1, 2];
    let different: List<Integer> = [1, 3];
    let short: List<Integer> = [1];
    let left: List<FoldedKey> = [FoldedKey {value: 12}];
    let right: List<FoldedKey> = [FoldedKey {value: 22}];
    let nested: List<List<Integer>> = [empty, first];
    let nested_same: List<List<Integer>> = [empty, same];
    empty.eq(empty) and first.eq(same) and first.ne(different)
        and first.ne(short) and empty.ne(first) and left.eq(right)
        and nested.eq(nested_same)
}

test list_element_equality_protocol {
    inline if list_protocol_equality() {assumes true;} else {assumes false;}
}

comptime impl ComptimeHash for FoldedKey {
    comptime fn hash(self) -> u64 {
        self.value.rem_euclid(10).hash()
    }
}

comptime fn list_protocol_hashing() -> bool {
    let left: List<FoldedKey> = [FoldedKey {value: 12}, FoldedKey {value: 23}];
    let right: List<FoldedKey> = [FoldedKey {value: 22}, FoldedKey {value: 13}];
    let empty: List<FoldedKey> = [];
    let nested_left: List<List<FoldedKey>> = [empty, left];
    let nested_right: List<List<FoldedKey>> = [empty, right];
    left.eq(right) and left.hash() == right.hash()
        and nested_left.eq(nested_right) and nested_left.hash() == nested_right.hash()
        and empty.hash() == 12638227882485885803
}

test list_element_hash_protocol {
    inline if list_protocol_hashing() {assumes true;} else {assumes false;}
}

comptime fn optional_protocol_equality() -> bool {
    let empty: ?FoldedKey = null;
    let left: ?FoldedKey = FoldedKey {value: 12};
    let right: ?FoldedKey = FoldedKey {value: 22};
    let different: ?FoldedKey = FoldedKey {value: 23};
    let nested: ??FoldedKey = left;
    let nested_same: ??FoldedKey = right;
    empty.eq(empty) and empty.ne(left) and left.ne(empty)
        and left.eq(right) and left.ne(different) and nested.eq(nested_same)
}

test optional_payload_equality_protocol {
    inline if optional_protocol_equality() {assumes true;} else {assumes false;}
}

comptime fn optional_protocol_hashing() -> bool {
    let left: ?FoldedKey = FoldedKey {value: 12};
    let right: ?FoldedKey = FoldedKey {value: 22};
    let empty: ?FoldedKey = null;
    left.eq(right) and left.hash() == right.hash()
        and empty.hash() == 12638153115695167455
}

test optional_payload_hash_protocol {
    inline if optional_protocol_hashing() {assumes true;} else {assumes false;}
}
