struct Box where A {
    value: A,
}

impl Box<A> where A {
    fn pair(self, other: B) -> (A, B) where B {
        (self.value, other)
    }

    fn identity(value: B) -> B where B {
        value
    }
}

fn apply(action: fn(T) -> T, value: T) -> T where T {
    action(value)
}

fn entry() -> bool {
    -- The context determines B; A remains the chosen implementation argument.
    let pair: fn(Box<.u8'builtin>, bool) -> (.u8'builtin, bool) =
        Box<.u8'builtin>.pair;
    let (number, flag) = pair(Box<.u8'builtin> { value: 9 }, true);

    -- Explicit method arguments exclude the already fixed implementation A.
    let identity = Box<bool>.identity<.u8'builtin>;
    let result = Box<.u8'builtin> { value: identity(7) }.pair<bool>(true);
    let (other, enabled) = result;
    number == 9 and flag and other == 7 and enabled
        and apply(Box<.u8'builtin>.identity, true)
}
