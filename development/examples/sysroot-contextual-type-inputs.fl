{- Type inputs retain their caller identity through code generation. Expression
   contexts and pattern success bindings remain separate runtime interfaces.
-}
comptime fn identity_code(comptime T: Type) -> <value: T |- T> {
    '(value)
}

comptime fn expression(comptime T: Type,
    .code: <value: T |- T> = identity_code(T)) -> <value: T |- T> {
    code
}

comptime fn binding_code(comptime T: Type) -> <T -| result: T> {
    '<result>
}

comptime fn pattern(comptime T: Type,
    .code: <T -| result: T> = binding_code(T)) -> <T -| result: T> {
    code
}

fn select(comptime T: Type, input: T) -> T {
    const code = expression(T);
    let value = ~[value=input]<code>;
    let ~<pattern(T)> = value;
    result
}

test {
    let yes = select(bool, true);
    let no = select(bool, false);
    let letter = select(char, 'a');
    assumes yes;
    assumes not no;
    assumes letter == 'a';
}

{- A packet retains known Type fields while ordinary data remains invocation
   work. Both generated expression and pattern interfaces use the same input.
-}
comptime fn packet_expression(comptime T: Type) -> <value: T |- T> {
    const packet = (T,);
    identity_code(...packet)
}

comptime fn packet_pattern(comptime T: Type) -> <T -| result: T> {
    const packet = (T,);
    binding_code(...packet)
}

test {
    let input = true;
    let ~<packet_pattern(bool)> = ~[value=input]<packet_expression(bool)>;
    assumes result;
    let input_letter = 'p';
    let letter = ~[value=input_letter]<packet_expression(char)>;
    assumes letter == 'p';
}

comptime fn default_expression(comptime A: Type,
    comptime .T: Type = A, comptime .U: Type = T) -> <value: U |- U> {
    identity_code(U)
}

comptime fn default_pattern(comptime .T: Type = bool) -> <T -| result: T> {
    binding_code(T)
}

fn select_default(comptime T: Type, input: T) -> T {
    ~[value=input]<default_expression(T)>
}

test {
    let ~<default_pattern()> = select_default(bool, true);
    assumes result;
    let letter = select_default(char, 'd');
    assumes letter == 'd';
}
