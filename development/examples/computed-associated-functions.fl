-- These computations choose code identities; they never execute runtime bodies.
fn identity(value: T) -> T where T { value }
fn invert(value: bool) -> bool { not value }

comptime fn choose(flag: bool) -> fn(bool) -> bool {
    if flag { invert } else { identity<bool> }
}
comptime fn forward(callback: fn(bool) -> bool) -> fn(bool) -> bool {
    callback
}

trait Action {
    assoc apply: fn(bool) -> bool = forward(choose(true));
}
struct Inverted {}
struct Unchanged {}
impl Action for Inverted {}
impl Action for Unchanged {
    assoc apply: fn(bool) -> bool = choose(false);
}

fn entry() -> bool {
    Inverted.as(Action).apply(false) and Unchanged.as(Action).apply(true)
}
