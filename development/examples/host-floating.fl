-- python3 -B development/host_examples.py floating --compare-optimization
-- Ordinary arithmetic rounds each operation; fused math.fma is a separate API.
pure fn multiply_add(a: T, b: T, c: T) -> T
where T, requires T == .f32'builtin or T == .f64'builtin {
    a * b + c
}

pure fn divide(numerator: T, denominator: T) -> T
where T, requires T == .f32'builtin or T == .f64'builtin {
    numerator / denominator
}

pure fn interpolate(left: T, right: T, weight: T) -> T
where T, requires T == .f32'builtin or T == .f64'builtin {
    left + (right - left) * weight
}

pure fn ieee_cases()->bool {
    let positive_infinity = divide<.f64'builtin>(1.0, 0.0);
    let negative_infinity = divide<.f64'builtin>(1.0, -0.0);
    let nan = divide<.f32'builtin>(0.0, 0.0);
    positive_infinity > 0.0 and negative_infinity < 0.0
        and nan != nan and not (nan >= 0.0)
}

pure fn run() -> bool {
    interpolate<.f32'builtin>(2.0, 6.0, 0.25) == 3.0
        and interpolate<.f64'builtin>(2.0, 6.0, 0.75) == 5.0
        and multiply_add<.f32'builtin>(4097.0, 4097.0, -16785408.0) == 0.0
        and multiply_add<.f64'builtin>(134217729.0, 134217729.0, -18014398777917440.0) == 0.0
        and ieee_cases()
}
