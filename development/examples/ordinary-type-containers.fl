-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Type=.Type'builtin;
struct Box where T {value:T,}
enum Choice where T {some(T),none,}
fn wrap(comptime T:Type,value:T)->Box<T> {Box<T>{value:value}}
fn unwrap(comptime T:Type,value:Box<T>)->T {let {value:item}=value;item}
fn choice(comptime T:Type,value:T)->Choice<T> {Choice<T>.some(value)}
fn read(comptime T:Type,value:Choice<T>,fallback:T)->T {
 value match {.some(item)=>item,.none=>fallback,}
}
fn replace(comptime T:Type,original:Box<T>,item:T)->Box<T> {var value=original;value.value=item;value}
fn run()->Tuple<bool, bool> {(unwrap(bool,replace(bool,wrap(bool,false),true)),read(bool,choice(bool,true),false))}
