typealias Type = .Type'builtin;
pure comptime fn Identity<T> -> Type { T }

fn selected(comptime flag: bool) -> bool { flag }

fn has_identity_head(comptime T: Type) -> bool {
    selected(T match {
        Identity<Element> => true,
        _ => false,
    })
}

fn run() -> (bool, bool) {
    (has_identity_head(Identity<bool>), has_identity_head(bool))
}
