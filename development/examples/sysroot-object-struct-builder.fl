{- Ordered field descriptions travel through Object and checked publication. -}
pure comptime fn Identity<T> -> Type { T }

comptime fn Schema() -> Type {
    let fields: Object = {ready: bool, count: u32};
    let draft = meta.StructBuilder.from_object(fields, .name = .Packet) match {
        value? => value,
        null => return bool,
    };
    draft.Build()
}

typealias Packet = Schema();

comptime fn describe() -> bool {
    let fields: Object = {ready: bool, wrapped: Identity<bool>};
    let draft = meta.StructBuilder.from_object(fields) match {
        value? => value,
        null => return false,
    };
    let accepted = draft.add_fields_from_object({count: u32});
    let rejected = draft.add_fields_from_object({extra: bool, invalid: true});
    let generated = draft.Build();
    let names = generated.struct_field_names();
    let types = generated.struct_field_types();
    accepted and not rejected and names.length() == 3
        and names[0] == .ready and names[1] == .wrapped and names[2] == .count
        and types[1] == Identity<bool> and types[2] == u32
}

comptime fn edit_description() -> bool {
    let draft = meta.StructBuilder.from_object({ready: bool, old: u32}) match {
        value? => value,
        null => return false,
    };
    let saved = draft;
    let inserted = draft.insert_fields_from_object(1, {wrapped: Identity<bool>});
    let replaced = draft.replace_fields_from_object(2, 3, {count: u32, active: bool});
    let bad_description = draft.replace_fields_from_object(0, 2, {valid: bool, invalid: true});
    let bad_range = draft.replace_fields_from_object(2, 9, {unexpected: bool});
    let negative = draft.insert_fields_from_object(-1, {unexpected: bool});
    let reversed = draft.replace_fields_from_object(2, 1, {});
    let empty = draft.insert_fields_from_object(0, {});
    let removed = draft.replace_fields_from_object(3, 4, {});
    let generated = draft.Build();
    let names = generated.struct_field_names();
    let types = generated.struct_field_types();
    let original = saved.Build();
    let original_names = original.struct_field_names();
    inserted and replaced and empty and removed
        and not bad_description and not bad_range and not negative and not reversed
        and names.length() == 3 and types.length() == 3
        and names[0] == .ready and names[1] == .wrapped and names[2] == .count
        and types[0] == bool and types[1] == Identity<bool> and types[2] == u32
        and original_names.length() == 2 and original_names[1] == .old
}

const edited = edit_description();

const correct = describe();

test {
    inline if edited { assumes true; } else { assumes false; };
    inline if correct { assumes true; } else { assumes false; };
    let packet = Packet {ready: true, count: 23};
    assumes packet.ready;
    assumes packet.count == 23;
}
