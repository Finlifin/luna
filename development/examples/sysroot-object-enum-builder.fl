{- Ordered Object descriptions become named enum payloads through the ordinary
   builder library. Publication checks the resulting nominal definition.
-}
comptime fn EventType() -> Type {
    let draft = meta.EnumBuilder.new(.name = .Event);
    draft.add_unit(.idle);
    draft.add_group(.net);
    let added = draft.add_named_from_object(.packet,
        {flag: bool, count: u32}, .group = [.net]);
    assumes added;
    let inserted = draft.insert_named_from_object(1, .empty, {});
    assumes inserted;
    let replaced = draft.replace_named_from_object(2, .data,
        {ready: bool, count: u32}, .group = [.net]);
    assumes replaced;
    let rejected = draft.replace_named_from_object(2, .broken,
        {ready: bool, invalid: true}, .group = [.net]);
    assumes not rejected;
    draft.Build()
}

typealias Event = EventType();

fn read_event(value: Event) -> bool {
    value match {
        .idle => false,
        .empty {} => true,
        .net.data {ready: ready, count: count} => ready and count == 27,
    }
}

test {
    inline if associated_variants { assumes true; } else { assumes false; };
    let idle = read_event(Event.idle);
    let empty = read_event(Event.empty {});
    let data = read_event(Event.net.data {ready: true, count: 27});
    assumes not idle;
    assumes empty;
    assumes data;
}

trait PayloadType {
    assoc Item: Type;
}
impl PayloadType for bool {
    assoc Item: Type = bool;
}
enum Choice where T {
    item(T),
    empty,
}
comptime fn choose(comptime T: Type, value: T.as(PayloadType).Item) -> Choice<T.as(PayloadType).Item>
where requires T :- PayloadType
{
    Choice<T.as(PayloadType).Item>.item(value)
}
comptime fn absent(comptime T: Type) -> Choice<T.as(PayloadType).Item>
where requires T :- PayloadType
{
    Choice<T.as(PayloadType).Item>.empty
}
comptime fn associated_choices() -> bool {
    let chosen = choose(bool, true) match {
        .item(value) => value,
        .empty => false,
    };
    let missing = absent(bool) match {
        .item(_) => false,
        .empty => true,
    };
    let built = Event.net.data {ready: chosen and missing, count: 27};
    built match {
        .net.data {ready: ready, count: count} => ready and count == 27,
        _ => false,
    }
}
const associated_variants = associated_choices();
