typealias Type = .Type'builtin;
typealias Int = .Integer'builtin;
comptime fn IdentityType(value: Type) -> Type { value }
comptime fn MapperType(input: Type, output: Type) -> Type { (fn(input) -> output) }
comptime fn ComptimeMapperType(input: Type, output: Type) -> Type {
    (comptime fn(input) -> output)
}
typealias Mapper<T> = fn(IdentityType(T)) -> IdentityType(T);
typealias ComputedMapper<T> = MapperType(T, T);
typealias ComputedComptimeMapper<T> = ComptimeMapperType(T, T);
fn apply(callback: ComputedMapper<bool>, value: bool) -> bool { callback(value) }
fn run() -> bool {
    let callback: Mapper<bool> = |value| not value;
    apply(callback, false)
}
comptime fn run_comptime() -> Int {
    let callback: ComputedComptimeMapper<Int> = |value| value + 1;
    callback(8)
}
