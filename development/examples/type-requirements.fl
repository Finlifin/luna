-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
typealias Flag = bool;
typealias Character = 'x''type;

fn convert(value: T) -> Flag
where T, requires:representation T == Flag {
    value
}

fn forward(value: U) -> Flag
where U, requires U == Flag {
    convert(value)
}

fn keep(value: T) -> T
where T, requires T == Flag or T == Character {
    value
}

fn run() -> Tuple<Flag, Character> {
    (forward(true), keep('x'))
}
