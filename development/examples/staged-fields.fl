-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
struct Flags { enabled: bool, tracing: bool }
struct Configuration { flags: Flags, ready: bool }

fn selected(comptime enabled: bool) -> bool { enabled }

fn configured(comptime enabled: bool) -> bool {
    selected(do {
        var config = Configuration {
            flags: Flags { enabled: false, tracing: true },
            ready: true,
        };
        config.flags.enabled = enabled;
        config.flags.tracing = false;
        config.ready and config.flags.enabled and not config.flags.tracing
    })
}

fn run() -> Tuple<bool, bool> {
    (configured(false), configured(true))
}
