typealias Byte = .u8'builtin;
typealias Bool = true'type;
struct Pair { start: Byte, end: Byte }
fn distance(start: Byte, end: Byte) -> Byte
where requires start <= end {
    end - start
}
fn checked(start: Byte, end: Byte) -> Byte {
    assumes start <= end;
    distance(start, end)
}
fn ordered(value: Pair) -> Byte
where requires value.start <= value.end {
    value.end - value.start
}
fn fields(start: Byte, end: Byte) -> Byte {
    assumes start <= end;
    ordered(Pair { start: start, end: end })
}
fn defaults(start: Byte, .end: Byte = 255) -> Byte
where requires start <= end {
    end - start
}
fn default_call(start: Byte) -> Byte { defaults(start) }
fn enabled(flag: Bool) -> Byte
where requires flag { 1 }
fn checked_flag(flag: Bool) -> Byte {
    assumes flag;
    enabled(flag)
}
fn next(value: Byte) -> Byte
where requires value < 255 { value + 1 }
fn relay(value: Byte) -> Byte
where requires value < 255 { next(value) }
fn recurse(value: Byte) -> Byte
where requires value <= 100 {
    if value == 0 { 0 } else { recurse(value - 1) }
}
fn snapshot(start: Byte, end: Byte) -> Byte {
    var current = start;
    assumes current <= end;
    distance(current, do { current = 255; end })
}
comptime fn ct_distance(start: Byte, end: Byte) -> Byte
where requires start <= end { end - start }
comptime fn run() -> Byte {
    ct_distance(100, 255)
}
fn preserve(value: T, flag: Bool) -> T
where T, requires flag { value }
fn generic_call(value: Byte, flag: Bool) -> Byte {
    assumes flag;
    preserve(value, flag)
}
fn limited(start: Byte, end: Byte) -> Byte
where requires start <= end,
    requires end - start <= 100 { end - start }
fn limited_call(start: Byte, end: Byte) -> Byte {
    assumes start <= end and end <= 100;
    limited(start, end)
}
comptime fn Selected(flag: Bool) -> .Type'builtin
where requires flag { Byte }
typealias SelectedByte = Selected(true);
comptime fn required_type() -> SelectedByte { 7 }
fn negated_flag(flag: Bool) -> Byte {
    assumes not flag;
    enabled(not flag)
}
fn compared_flag(a: Byte, b: Byte) -> Byte {
    assumes a <= b;
    enabled(a <= b)
}
fn short_circuit(flag: Bool) -> Byte
where requires true or flag {
    enabled(true or flag)
}
fn mixed(value: T, flag: Bool) -> Bool
where T, requires T == Bool,
    requires flag { value }
fn mixed_call(flag: Bool) -> Bool {
    assumes flag;
    mixed(true, flag)
}
