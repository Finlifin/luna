-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
-- Run with --interpret run --splice-protocol Splice.
-- The driver binds this trait explicitly; its spelling is not magical.
typealias Type = .Type'builtin;

trait Splice {
    assoc RuntimeTarget: Type;
    fn splice(comptime data: Self) -> RuntimeTarget;
}

impl Splice for bool {
    assoc RuntimeTarget: Type = Tuple<bool, bool>;
    fn splice(comptime data: bool) -> Tuple<bool, bool> {
        construct(data)
    }
}

-- An ordinary runtime call must survive specialization of the staged input.
fn construct(value: bool) -> Tuple<bool, bool> {
    (value, not value)
}

const FLAG = true;
const OTHER = false;

fn run() -> Tuple<Tuple<bool, bool>, Tuple<bool, bool>> {
    (FLAG, OTHER)
}
