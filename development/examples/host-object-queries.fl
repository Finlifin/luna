{-
  A library consumer inspects heterogeneous metadata at comptime and connects
  only the chosen Boolean expression to runtime code.
-}
use primitives.Type;

comptime fn configured() -> <|-bool> {
    let metadata = {enabled:true, .example, enabled:false};
    let first = meta.object_value<bool>(metadata, 0);
    let last = meta.object_value<bool>(metadata, 2);
    let result = meta.object_length(metadata) == 3
        and meta.ObjectEntryType(metadata, 0) == bool
        and (meta.object_key(metadata, 1) match {_? => false, null => true})
        and (first match {value? => value, null => false})
        and (last match {value? => not value, null => false});
    '(result)
}

fn run() -> bool { ~<configured()> }
