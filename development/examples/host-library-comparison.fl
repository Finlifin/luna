-- Load comparison.fl and resources.fl as explicit dependencies.
use comparison.{Eq, Ord};

fn lower(a: T, b: T) -> T where T :- Ord + resources.Copy {
    if a.as(Ord).lt(b) { a } else { b }
}

test boolean_order {
    let a = false;
    let b = true;
    let ordered = a.as(Ord).lt(b);
    let equal = a.as(Eq).eq(a);
    let distinct = a.as(Eq).ne(b);
    assumes ordered and equal and distinct;
}

test signed_boundaries {
    let low: .i128'builtin = -170141183460469231731687303715884105728;
    let high: .i128'builtin = 170141183460469231731687303715884105727;
    let smaller = lower(low, high);
    let forward = low.as(Ord).cmp(high) matches .less;
    let backward = high.as(Ord).cmp(low) matches .greater;
    assumes smaller == low and forward and backward;
}

test default_methods {
    let a: .u32'builtin = 7;
    let b: .u32'builtin = 9;
    let smaller = lower(b, a);
    let reflexive = a.as(Ord).le(a) and a.as(Ord).ge(a);
    let strict = b.as(Ord).gt(a) and not a.as(Ord).gt(b);
    assumes smaller == a and reflexive and strict;
}

test unicode_characters {
    let smaller = lower('😀', '中');
    let same = smaller.as(Eq).eq('中');
    let ordered = '中'.as(Ord).lt('😀');
    assumes same and ordered;
}

test symbolic_names {
    let state: .Symbol'builtin = .ready;
    let same = state.as(Eq).eq(.ready);
    let other = state.as(Eq).ne(.waiting);
    assumes same and other;
}

test platform_integers {
    let negative: .isize'builtin = -7;
    let positive: .isize'builtin = 9;
    let signed = lower(positive, negative);
    let zero: .usize'builtin = 0;
    let other: .usize'builtin = 9;
    let unsigned = lower(other, zero);
    let distinct = other.as(Eq).ne(zero);
    assumes signed == negative and unsigned == zero and distinct;
}
