-- Bind --meta-list-type input::TupleElements --tuple-type input::Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
typealias Type = .Type'builtin;
typealias Char = 'x''type;

-- Both Type inputs and both values come from one evaluated packet.
comptime fn packet() -> Tuple<Type, bool, Type, Char> {
    (bool, true, Char, 'x')
}

fn pair(comptime A: Type, left: A, comptime B: Type, right: B) -> Tuple<A, B> {
    (left, right)
}

comptime fn flags() -> Tuple<bool, bool> { (false, true) }

comptime fn Select(flag: bool) -> Type {
    if flag { bool } else { Char }
}

-- A packet can supply the configuration that determines a default Type.
fn configured(comptime flag: bool, other: bool,
              comptime .T: Type = Select(flag), value: T) -> Tuple<bool, bool, T> {
    (flag, other, value)
}

fn run() -> Tuple<Tuple<bool, Char>, Tuple<bool, bool, Char>> {
    (pair(...packet()), configured(...flags(), 'y'))
}
