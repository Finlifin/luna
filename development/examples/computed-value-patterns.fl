-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:TupleElements<.Type'builtin>> -> .Type'builtin {bool}
typealias Int = .Integer'builtin;
typealias Byte = .u8'builtin;
typealias Text = ""'type;
comptime fn first() -> Int { 11 }
comptime fn second() -> Int { 17 }
comptime fn choose(value: Int) -> Int {
    value match { < first() > => 1, < second() > => 2, _ => 0 }
}
comptime fn same(value: Int, expected: Int) -> bool {
    value match { 'expected => true, _ => false }
}
comptime fn same_text(value: Text, expected: Text) -> bool {
    value match { 'expected => true, _ => false }
}
comptime fn same_byte(value: Byte, expected: Byte) -> bool {
    value match { 'expected => true, _ => false }
}
comptime fn rollback(value: Tuple<Int, Int>) -> Int {
    value match { (bound, < first() > ) or ( < first() > , bound) => bound, _ => 0 }
}
comptime fn run() -> Tuple<Int, Int, Int, bool, bool, bool, bool, Int> {
    (choose(11), choose(17), choose(23), same(29, 29), same(29, 31),
     same_text("flurry", "flurry"), same_byte(127, 127), rollback((11, 37)))
}
comptime fn scalar_equal() -> Tuple<bool, bool, bool, bool, bool, bool> {
    let byte: Byte = 255;
    let signed: .i8'builtin = -128;
    (true == true, true != false, 'a' != 'b', "hello" == "hello",
     byte == 255, signed != 127)
}
comptime fn early(value: bool) -> bool {
    value match { < do { return true; } > => false, _ => false }
}
comptime fn unreachable_pattern() -> bool {
    true match { _ => true, < do { while true {} false } > => false }
}
comptime fn first_text() -> Text { "same" }
comptime fn second_text() -> Text { "same" }
comptime fn ordered_equal() -> bool { first_text() == second_text() }
