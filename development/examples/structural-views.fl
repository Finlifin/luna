typealias Flag = true'type;

struct Box where T {
    value: T,
}

enum Choice where T {
    none,
    some(T),
}

-- The signature retains T; the body obtains structure from its type contract.
fn change(value: T, replacement: U) -> U
where T, U, requires T == Box<U> {
    value.value = replacement;
    let { value: result } = value;
    result
}

fn inspect(value: T) -> Flag
where T, requires T == Choice<(Flag, Flag)> {
    value match {
        .none => false,
        .some((true, _)) => true,
        .some((false, true)) => true,
        .some((false, false)) => false,
    }
}

fn run() -> Flag {
    let selected = change<Box<Flag>, Flag>(Box<Flag> { value: false }, true);
    inspect(Choice<(Flag, Flag)>.some((false, selected)))
}
