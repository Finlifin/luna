-- Bind --meta-list-type input.TupleElements --tuple-type input.Tuple.
pure comptime fn TupleElements<T> -> .Type'builtin { T }
pure comptime fn Tuple<...Es: TupleElements<.Type'builtin>> -> .Type'builtin { bool }
-- Type-parameter definitions are checked before any concrete call.
fn keep(value: T) -> T where T { value }

fn apply(value: T, transform: fn(T) -> T) -> T where T {
    transform(value)
}

fn recur(value: T, again: bool) -> T where T {
    if again {
        recur(value, false)
    } else {
        let capture = || value;
        capture()
    }
}

fn negate(value: bool) -> bool { not value }

fn run() -> Tuple<bool, 'x''type> {
    (apply(keep(false), negate), recur('x', true))
}

fn explicit_and_contextual() -> bool {
    let explicit = keep<bool>;
    let contextual: fn(bool) -> bool = keep;
    explicit(true) and contextual(true) and apply<bool>(true, |value| value)
}

fn inferred_callbacks() -> bool {
    apply(true, |value| value) and apply(true, keep)
}

fn configured(value: T, .first: bool = false, .second: bool = first)
    -> Tuple<T, bool> where T {
    (value, second)
}

fn configured_example() -> Tuple<'x''type, bool> {
    configured('x', .first = true)
}
