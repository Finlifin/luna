-- Panic-dependent elimination of a native result with one error type.
pub trait ErrorResultUnwrap where T, E {
    fn unwrap(self) -> T;
    fn unwrap_err(self) -> E;
}

impl ErrorResultUnwrap<T, E> for !E T where T, E {
    fn unwrap(self) -> T = self match {
        value! => value,
        error _ => panic("called unwrap on an error result"),
    };

    fn unwrap_err(self) -> E = self match {
        _! => panic("called unwrap_err on a successful result"),
        error failure => failure,
    };
}
