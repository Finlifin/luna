{-
    Expected: run returns true. Transporting Factory.make through comptime
    must preserve its public contract without executing its runtime body.

    Regression: reconstruct the inner method with its public associated return
    type, then expose the observed callable type to the receiving context.
    The cmtt_methods source test compiles and executes this file, and checks
    the retained NIR signature. See development/comptime-value-admission.md,
    section 33.

    A second acceptance case replaces make's body with:
        while true {} false
    Compiling that variant must terminate; do not execute run in that case.
-}

trait Factory {
    assoc Item: Type;
    fn make() -> Item;
}

impl Factory for bool {
    assoc Item: Type = bool;
    fn make() -> bool { true }
}

comptime fn wrapper(callback: fn() -> bool) -> <|- bool> { '(callback()) }

fn run() -> bool { ~<wrapper(bool.as(Factory).make)> }
