{-
  With the standard sysroot, run should return true. Definition checking
  needs the field description assembled by the preceding generator statements.
  Replacing true in the field initializer with a character must be rejected.
-}

comptime fn generate() -> < |- bool > {
    var builder = meta.StructBuilder.new(.name = .QuoteLocal);
    builder.add_field(.flag, bool);
    let T = builder.Build();
    '(T { flag: true }.flag)
}

fn run() -> bool {
    ~<generate()>
}
