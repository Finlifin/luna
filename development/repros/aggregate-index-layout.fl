{-
    Intended result: run returns true with the real sysroot.
    Regression: IIR value admission must obtain registered field domains from
    the receiving world, including aggregate indices nested in nominal inputs.
    The original 3298e6b5 probe failed with "layout requires a nominal type".
-}
struct Packet where state: Tuple<bool, bool> {}

struct Holder where flag: bool {
    value: Packet<(flag, false)>,
}

fn run() -> bool {
    let holder = Holder<true> { value: Packet<(true, false)> {} }
    true
}
