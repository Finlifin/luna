{-
    The receiving Factory interface names its complete collection Items.
    Each selected implementation gives that same slot a different name.
-}
typealias Factory = pure comptime fn<...Items: meta.List<Type>> -> Type;

pure comptime fn First<...Left: meta.List<Type>> -> Type { bool }
pure comptime fn Second<...Right: meta.List<Type>> -> Type { bool }

comptime fn select(flag: bool) -> Factory {
    if flag { First } else { Second }
}

comptime fn forward(factory: Factory) -> Factory { factory }

comptime fn Apply(factory: Factory, items: meta.List<Type>) -> Type {
    factory<.Items = items>
}

comptime fn verify() -> bool {
    let items: meta.List<Type> = [bool, u8];
    let first = Apply(forward(select(true)), items);
    let second = Apply(forward(select(false)), items);
    first == First<.Left = items> and second == Second<.Right = items>
}

fn run() -> bool {
    const accepted = verify();
    accepted
}
