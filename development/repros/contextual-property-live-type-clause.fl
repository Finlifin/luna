{-
    Regression: run returns true. The explicit Type clause toggles flag once,
    before the property fields read it. Required Type evaluation must use the
    generator's live input frame and publish the update to the following field.
-}
comptime fn schema(...fields: T) -> T where T { fields }
const SAMPLE = schema { enabled: true };
typealias Options = SAMPLE'type;

comptime fn pack(code: <|-bool>, ...props: T) -> T where T { props }

comptime fn forward(code: <|-bool>) -> bool {
    var flag = false;
    const props = pack<do { flag = not flag; Options }> { code, enabled: flag };
    flag and props.enabled
}

fn run() -> bool {
    const value = forward('(true));
    value
}
