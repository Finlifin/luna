{- Regression: inherent method selection retains the caller's ordinary Type
   binder when a collection element domain is an associated projection.
   Reproduce with luna check and the repository sysroot. -}
trait Source {
    assoc Item: Type;
}
impl Source for bool {
    assoc Item: Type = bool;
}
comptime fn count(comptime T: Type, values: meta.List<T.as(Source).Item>) -> Integer
where requires T :- Source
{
    values.length()
}
const count_result = count(bool, [true, false]);
