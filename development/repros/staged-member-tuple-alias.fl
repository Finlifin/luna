pure comptime fn Elements<T> -> .Type'builtin {T}
pure comptime fn Tuple<...Es:Elements<.Type'builtin>> -> .Type'builtin {bool}
struct Outer {
    pub struct Inner where T {pub typealias Payload = T;}
}
comptime fn Make() -> .Type'builtin {Outer}
fn configured(comptime flag: bool) -> bool {
    const Container = Make();
    const (Selected, unused) = (Container, flag);
    let value: Selected.Inner<bool>.Payload = flag;
    value
}
fn run() -> bool {configured(true) and not configured(false)}
