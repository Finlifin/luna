{- A local callable must be applied when its enclosing comptime invocation runs.
   Elaborating the body must not execute Select early to discover the head.
   This currently fails with "explicit instantiation requires a resolved generic
   function"; the expected result is an opaque Identity<bool> Type value.
-}
typealias Type = .Type'builtin;
typealias bool = .bool'builtin;

pure comptime fn Identity<T> -> Type { T }
pure comptime fn Alternate<T> -> Type { T }

comptime fn Select(flag: bool) -> pure comptime fn<Type> -> Type {
    if flag { Identity } else { Alternate }
}

comptime fn Apply(flag: bool) -> Type {
    const factory = Select(flag);
    factory<bool>
}

comptime fn Run() -> Type { Apply(true) }
