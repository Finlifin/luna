{- Quoted local data requires the selected RuntimeTarget.
   Expected: convert;(bool true). -}
struct Seed {
    byte: u8,
}

impl Splice for Seed {
    assoc RuntimeTarget: Type = u8;

    fn splice(comptime data: Seed) -> u8 {
        let emitted = std.fmt.print("convert;") match {
            _! => true,
            error _ => false,
        }
        assumes emitted;
        data.byte
    }
}

pure comptime fn quoted(data: Seed) -> < |- u8 > {
    '(data)
}

fn run() -> bool {
    let generated: u8 = ~<quoted(Seed { byte: 42 })>;
    generated == 42
}
