-- 表面语法速查；列表分隔符、空白和词法细节见 grammar/index.md 与 basics/lexical.md。
-- * 列表在产生式中省略分隔符；各构造的可用位置、阶段与组合限制由对应章节规定。

-- multi 语法元素列表的通用前缀规则：每个元素可带任意层属性；分隔符仍由基本元素决定。
-- base_element 是该列表允许的元素元记号，不是新增源构造；不将此规则推广到原始 token*。
multi_element -> base_element
    | ^expr multi_element

-- expr 与 pattern 的入口保留外层结构边界，防止后缀扩展应用吞掉 if 等构造的主体。
-- matches 将该边界传入 pattern；括号及其他已封闭内部范围使用自己的上下文。

-- expressions
expr -> id
    | literal
    | literal_suffix
    | unit_expr
    | null_construct
    | undefined_expr
    | wildcard
    | self_expr
    | parenthesized_expr
    | prefix
    | infix
    | postfix
    | type
    | statement_expr

literal -> integer
    | float
    | char
    | str
    | bool
    | symbol

integer -> decimal | binary | octal | hex
decimal -> digit (digit | _)*
binary -> 0b (bindigit | _)*
octal -> 0o (octdigit | _)*
hex -> 0x (hexdigit | _)*
float -> digits . digits
    | digits . digits exp
exp -> (e | E) (+ | -)? digits
char -> ' char_body '
str -> " str_body "
bool -> true | false
-- 字符内容、转义、数字分隔符与前缀的词法限制见字面量章。

literal_suffix -> (integer | float | char | str) id
unit_expr -> ()
null_construct -> null
undefined_expr -> undefined
wildcard -> _
self_expr -> Self | self | Itself | itself
parenthesized_expr -> (expr)
-- _ 与反身名称的合法位置由模式、参数和所属上下文约束。

prefix -> symbol
    | list_of
    | tuple
    | object
    | lambda
    | bool_not
    | error_new
    | negative
    | range_to
    | range_to_inclusive
    | atomic_block
    | do_block
    | async_block
    | unsafe_block
    | comptime_block
    | range_all
    | bool_forall
    | bool_exists
    | splice_expr
    | defer_expr
    | token_buffer
    | quote_expr
    | quote_pattern

symbol -> .id
list_of -> [expr*]
tuple -> (expr, expr*)
object -> { (property | expr)* }
lambda -> |anchored_parameter*| (-> expr)? expr
anchored_parameter -> id | id : expr
bool_not -> not expr
-- not 在 bool 与 BitVec 上分别按各自契约解释；BitVec 的 and/or 为同宽逐位运算，两侧均求值。
error_new -> error expr
negative -> -expr
range_to -> .. expr
range_to_inclusive -> ..= expr
atomic_block -> atomic(id*) { statement* }
do_block -> do { statement* }
async_block -> async { statement* }
unsafe_block -> unsafe { statement* }
comptime_block -> comptime { (definition | statement)* }
range_all -> ..
bool_forall -> forall type_bound_param* => expr
bool_exists -> exists type_bound_param* => expr
splice_expr -> ~<expr> | ~[ substitution* ] <expr>
quote_expr -> '(expr) | '[ substitution* ] (expr)
substitution -> id = id
defer_expr -> defer expr


infix -> expr + expr
    | expr - expr
    | expr * expr
    | expr / expr
    | expr % expr
    | expr == expr
    | expr != expr
    | expr < expr
    | expr > expr
    | expr <= expr
    | expr >= expr
    | expr and expr
    | expr or expr
    | expr ++ expr
    | expr ==> expr
    | expr | expr
    | expr |> expr
    | expr -> expr
    | expr : expr
    | expr :- expr
    | expr <: expr
    | expr .. expr
    | expr ..= expr

postfix -> projection
    | take_view
    | range_from
    | post_match
    | post_lambda
    | application
    | normal_form_head_application
    | extended_application
    | index_application
    | type_cast
    | dyn_cast
    | handler_application
    | async_await
    | bool_matches
    | deref
    | refer
    | effect_elimination
    | error_elimination
    | option_propagation
    | effect_propagation
    | error_propagation

projection -> expr . id
take_view -> expr ' id
range_from -> expr ..
post_match -> expr match { match_entry* }
post_lambda -> expr do (lambda | block | expr)
application -> expr (argument*)
normal_form_head_application -> expr<argument*>
extended_application -> expr { (property | extend_arg | expr)* }
index_application -> expr [expr]
-- BitVec 下标可为索引或半开范围；结果位宽必须在 comptime 确定，位置可以来自 runtime。
-- 直接作用于合法可写位置的 bitvec 位段可赋值；读出的 BitVec 值不持续关联源存储。
type_cast -> expr.as(expr)
-- intrinsic 调用复用 take_view 与 application；以下是组合形式，不是新增关键字。
intrinsic_application -> expr'intrinsic(argument*)
typed_intrinsic_application -> intrinsic_application.as(expr)
-- 紧接 intrinsic 调用的 as 指定输出类型；缺省为 void，外围期望类型不替代它。
dyn_cast -> expr.dyn(expr)
handler_application -> expr.use(expr)
async_await -> expr.await
bool_matches -> expr matches pattern
deref -> expr.*
refer -> expr.ref
effect_elimination -> expr# { case_arm* }
error_elimination -> expr! { error_arm* }
error_arm -> case_arm | catch_arm
catch_arm -> catch pattern => (block | statement)
option_propagation -> expr?
effect_propagation -> expr#
error_propagation -> expr!

argument -> expr_arg
    | extend_arg
    | named_arg

expr_arg -> expr
extend_arg -> ... expr
named_arg -> .id = expr
-- 命名供应适用于 optional、implicit、变参与拓展变参；直接供应完整值。


type -> optional_type
    | error_qualified_type
    | effect_qualified_type
    | reachability_qualified_type
    | closure_qualified_type
    | trait_object_type
    | pointer_type
    | fn_type
    | refinement_type
    | for_type
    | lift_type
    | contextual_expr_type
    | contextual_pattern_type

optional_type -> ?expr
error_qualified_type -> !expr expr
effect_qualified_type -> #expr expr
-- error/effect 行复用表达式及其各自类型契约。
reachability_qualified_type -> &expr expr
closure_qualified_type -> %closure_context expr
trait_object_type -> dyn expr
pointer_type -> *expr
fn_type -> pure? comptime? inline? (unsafe | spec | verified)? fn(parameter_type*) (-> expr)?
refinement_type -> refines { expr } expr
for_type -> for<parameter*> expr
lift_type -> lift expr
contextual_expr_type -> < runtime_binding* |- expr >
contextual_pattern_type -> < expr -| runtime_binding* >
runtime_binding -> id : expr
closure_context -> expr | { environment_binding* }
environment_binding -> id : expr (= expr)?

parameter_type -> type_param_type
    | decl_param_type
    | optional_decl_param_type
    | vararg_decl_param_type
    | itself_param_type
    | itself_ref_param_type
    | comptime_param_type
    | error_param_type
    | catch_param_type
    | lambda_param_type
    | implicit_param_type
    | quote_param_type
    | assoc_param_type

type_param_type -> expr
decl_param_type -> decl_clause
optional_decl_param_type -> .decl_clause
vararg_decl_param_type -> ...decl_clause
itself_param_type -> itself
itself_ref_param_type -> *itself
comptime_param_type -> comptime parameter_type
error_param_type -> error parameter_type
catch_param_type -> catch parameter_type
lambda_param_type -> lambda parameter_type
implicit_param_type -> implicit parameter_type
quote_param_type -> quote parameter_type
assoc_param_type -> assoc parameter_type

statement_expr -> return_statement
    | resume_statement
    | break_statement
    | continue_statement
    | if_statement
    | when_statement
    | if_is_match
    | if_match
    | inline_statement


-- definitions
parameter -> trivial_param
    | type_bound_param
    | optional_param
    | vararg_param
    | self_param
    | self_ref_param
    | comptime_param
    | error_param
    | catch_param
    | lambda_param
    | implicit_param
    | quote_param
    | attr_param
    | case_param

trivial_param -> id
type_bound_param -> id : expr
optional_param -> .id : expr = expr
vararg_param -> ...id : expr
self_param -> self
self_ref_param -> *self
comptime_param -> comptime parameter
error_param -> error parameter
catch_param -> catch parameter
lambda_param -> lambda parameter
implicit_param -> implicit parameter
quote_param -> quote parameter
attr_param -> ^expr parameter
case_param -> case pattern
-- lambda 只接收 anchored_parameter；parameter 的递归前缀不表示任意组合均合法。

clauses -> where clause*
clause -> decl_clause | verification_clause | outcome_clause
decl_clause -> type_decl_clause
    | trait_bound_decl_clause
    | type_bound_decl_clause
    | optional_decl_clause
    | vararg_decl_clause
    | quote_decl_clause
    
type_decl_clause -> id
trait_bound_decl_clause -> id :- expr
-- 此处 expr 可用 A + B + C 组合正向 trait 约束；否定约束写入 requires 子句。
type_bound_decl_clause -> id : expr
optional_decl_clause -> .id : expr = expr
vararg_decl_clause -> ...id : expr
quote_decl_clause -> quote decl_clause

verification_clause -> requires_clause
    | ensures_clause
    | decreases_clause

requires_clause -> requires expr
ensures_clause -> ensures expr
decreases_clause -> decreases expr

outcome_clause -> outcomes expr


definition -> function
    | quote_function
    | template_definition
    | template_instance
    | normal_form_head_def
    | algebraic_effect
    | effect_enum
    | case_def
    | const_def
    | newtype_def
    | typealias_def
    | trait_def
    | impl_def
    | impl_trait_def
    | derive_def
    | deriver_def
    | test_def
    | module_def
    | struct_def
    | enum_def
    | union_def
    | attr_def
    | visibility_definition
    | program_predicate
    | comptime_predicate
    
result -> (id :)? expr
-- 函数 ABI 通过属性指定，例如 ^attrs.abi(.c)，复用 attr_def。
function -> pure? comptime? inline? (unsafe | spec | verified | atomic)? fn id ( parameter* ) (-> result)? clauses? (block | (= expr))?
quote_function -> quote fn id(parameter*) (-> result)? clauses? (block | (= expr))?
template_definition -> template function
    | template quote_function
    | template test id clauses block
-- template 的 function 必须是非 comptime 函数；保留实例所用修饰的原有要求。
template_instance -> pure? inline? (unsafe | spec | verified | atomic)? fn id use expr block
    | quote fn id use expr block
    | quote fn id(parameter*) use expr block
    | test id use expr block
normal_form_head_def -> pure comptime fn id<parameter*> (-> result)? clauses? (block | (= expr))
algebraic_effect -> async? inline? effect id(parameter*) (-> result)? clauses?
effect_enum -> effect enum id clauses? { effect_variant* }
effect_variant -> attribute* async? inline? id(parameter*) (-> result)?
-- effect 签名以分号结束，省略结果为 void；组内各项是独立操作。
case_def -> case id (parameter*) -> result clauses? block
const_def -> const id (: expr)? = expr
newtype_def -> newtype id(<parameter*>)? = expr
typealias_def -> typealias id(<parameter*>)? = expr
-- 无主体的签名声明以分号结束；函数类别与所在上下文决定其合法性。
trait_def -> trait id (:- expr)? clauses? { (assoc_decl | definition | statement)* }
-- 父 trait 的 expr 同样接受 A + B + C；复用表达式组合，不限于单一 trait。
assoc_decl -> assoc id(<parameter*>)?: expr (= expr)? clauses?
impl_def -> comptime? impl expr clauses? { (definition | statement)* }
impl_trait_def -> comptime? impl expr for expr clauses? { (assoc_decl | definition | statement)* }
derive_def -> comptime? derive expr for expr clauses?
deriver_def -> derive fn id (parameter*)? for expr clauses? { (assoc_decl | definition | statement)* }
test_def -> test id? block
module_def -> mod id { (configuration | definition | statement)* }
struct_def -> struct id clauses? { (configuration | struct_field | definition | statement)* }
struct_field -> id : expr (= expr)?
enum_def -> enum id clauses? { (configuration | enum_variant | definition | statement)* }
enum_variant -> trivial_enum_variant
    | tuple_enum_variant
    | struct_enum_variant
    | pattern_enum_variant
    | expr_enum_variant
    | sub_enum_enum_variant
trivial_enum_variant -> id
tuple_enum_variant -> id (expr*)
struct_enum_variant -> id { struct_field* }
pattern_enum_variant -> id: pattern
expr_enum_variant -> id = expr
sub_enum_enum_variant -> id.{ enum_variant* }
union_def -> union id clauses? { (configuration | union_variant | definition | statement)* }
union_variant -> id : expr

attr_def -> ^expr definition
attribute -> ^expr
visibility -> pub | private
visibility_definition -> visibility definition
-- 一项至多指定一档显式可见性；可见性不为任意构造新增成员或导出资格。
program_predicate -> predicate id(parameter*) (-> expr)? clauses? block
comptime_predicate -> comptime predicate id(parameter*) block
-- 程序 predicate 与 PTC comptime predicate 由各自规格体系解释。


statement -> expr_statement
    | assignment
    | add_assignment
    | sub_assignment
    | mul_assignment
    | div_assignment
    | rem_assignment
    | let_decl
    | var_decl
    | const_decl
    | while_statement
    | while_is_match
    | while_match
    | for_statement
    | return_statement
    | resume_statement
    | break_statement
    | continue_statement
    | if_statement
    | when_statement
    | if_is_match
    | if_match
    | inline_statement
    | assert_statement
    | asserts_statement
    | assumes_statement
    | invariant_statement
    | decreases_statement
    | use_statement
    | attributed_statement

expr_statement -> expr
assignment -> expr = expr
add_assignment -> expr += expr
sub_assignment -> expr -= expr
mul_assignment -> expr *= expr
div_assignment -> expr /= expr
rem_assignment -> expr %= expr
const_decl -> const_def
assumes_statement -> assumes expr
attributed_statement -> ^expr statement

for_statement -> for label? pattern in expr block
while_statement -> while label? expr block
while_is_match -> while label? expr is pattern do block
while_match -> while label? expr is do { case_arm* }
label -> : id
let_decl -> let pattern (: expr)? = expr (else block)?
var_decl -> var pattern (: expr)? = expr (else block)?
return_statement -> return expr? (while expr)?
resume_statement -> resume expr? (while expr)?
break_statement -> break id? (while expr)?
continue_statement -> continue id? (while expr)?
if_statement -> if expr block (else (block | if_statement))?
when_statement -> when { (condition_arm | else_arm)* }
if_is_match -> if expr is pattern do block (else (block | if_is_match))?
if_match -> if expr is do { match_entry* }
inline_statement -> inline_if
    | inline_when
    | inline_if_is
    | inline_if_match
    | inline_for
inline_if -> inline if expr block (else block)?
inline_when -> inline when { condition_arm* else_arm? }
inline_if_is -> inline if expr is pattern do block (else block)?
inline_if_match -> inline if expr is do { match_entry* }
inline_for -> inline for label? pattern in expr block

case_arm -> pattern => (block | statement)
    | attributed_case_arm
match_entry -> case_arm | arm_import
arm_import -> use expr
-- 具有 arm 接入协议的 match 可用 use 接入 quoted arm；普通模块导入不因此变成分支。
condition_arm -> expr => (block | statement)
    | attributed_condition_arm
else_arm -> else => (block | statement)
attributed_case_arm -> ^expr case_arm
attributed_condition_arm -> ^expr condition_arm


-- patterns
pattern -> id
    | wildcard
    | unit_expr
    | null_construct
    | literal_pattern
    | prefix_pattern
    | infix_pattern 
    | postfix_pattern
    | parenthesized_pattern
    | handler_bind
    | splice_pattern

parenthesized_pattern -> (pattern)
handler_bind -> pattern handles expr
quote_pattern -> '<pattern> | '[ substitution* ] <pattern>
splice_pattern -> ~<expr> | ~[ substitution* ] <expr>
-- pattern splice 的操作数为 comptime 表达式；(pattern) 是分组，(pattern,) 是单元素元组。

literal_pattern -> literal
    | literal_suffix

prefix_pattern -> symbol
    | error_pattern
    | not_pattern
    | list_pattern
    | list_rest_pattern
    | tuple_pattern
    | struct_pattern
    | property_pattern
    | range_all_pattern
    | range_to_pattern
    | range_to_inclusive_pattern
    | ref_pattern
    | async_pattern
    | bit_vec_bin_pattern
    | bit_vec_oct_pattern
    | bit_vec_hex_pattern

error_pattern -> error pattern
not_pattern -> not pattern
list_pattern -> [pattern*]
list_rest_pattern -> ...id
tuple_pattern -> (pattern, pattern*)
struct_pattern -> { (property_pattern | pattern)* }
property_pattern -> id : pattern
range_all_pattern -> ..
range_to_pattern -> .. pattern
range_to_inclusive_pattern -> ..= pattern
ref_pattern -> ref pattern
async_pattern -> async pattern

-- 比如0b1110(xs: BitVec<4>) 10(ys: BitVec<6>) 10(zs: BitVec<6>)
-- segment 中 id/integer：分析阶段溯源回源码字形，再按前缀进制解释
bit_vec_bin_pattern -> 0b segment+
bit_vec_oct_pattern -> 0o segment+
bit_vec_hex_pattern -> 0x segment+
segment -> id
    | integer
    | <expr>
    | (pattern : expr)

infix_pattern -> or_pattern
    | range_from_to_pattern
    | range_from_to_inclusive_pattern

or_pattern -> pattern or pattern
range_from_to_pattern -> pattern .. pattern
range_from_to_inclusive_pattern -> pattern ..= pattern

postfix_pattern -> option_some_pattern
    | error_ok_pattern
    | if_guard_pattern
    | and_is_pattern
    | as_bind_pattern
    | application_pattern
    | normal_form_head_application_pattern
    | extended_application_pattern

option_some_pattern -> pattern?
error_ok_pattern -> pattern!
if_guard_pattern -> pattern if expr
and_is_pattern -> pattern and expr is pattern
as_bind_pattern -> pattern as id
application_pattern -> pattern (pattern*)
-- 注意这里是expr哦
normal_form_head_application_pattern -> expr<type_pattern_argument*>
type_pattern_argument -> id: pattern
    | type_pattern_expression
    | pattern
type_pattern_expression -> 'id
extended_application_pattern -> pattern { (property_pattern | pattern)* }

-- modules and use paths
use_statement -> visibility? use path

path -> id
    | projection_path
    | projection_multi_path
    | projection_all_path
    | super_path
    | path_as_bind

projection_path -> path . id
projection_multi_path -> path . { path* }
projection_all_path -> path . *
super_path -> . path
path_as_bind -> path as id

-- token macros；先接回调用位置，再按该位置的普通语法检查。
template_macro_definition -> define id integer { token* }
    | define id integer ... { token* }
    | define id(id*) { token* }
fixed_template_call -> $id token*
repeated_template_call -> $id token* $
named_template_call -> $id(token*)
template_macro_parameter -> $integer
    | $id

macro_import -> @use path
ast_macro_call -> @path(argument*)
block_macro_call -> @path { macro_input }
token_buffer -> {{ token_part* }}
token_part -> token
    | $expr
ast_macro_definition -> @define_macro1 { mapping_definition }
peg_macro_definition -> @define_macro2 { peg_rule* mapping_definition }
-- mapping_definition、peg_rule、macro_input 按相应构造宏的输入契约读取。
raw_str -> @builtin.str.raw { raw_source }


-- others
property -> id: expr
configuration -> .id expr
block -> { (definition | statement)* }
filescope -> (configuration | definition | statement)*
