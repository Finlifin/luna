{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "flurry",
      "camelcase": "Flurry",
      "title": "Flurry",
      "scope": "source.flurry",
      "file-types": [
        "fl"
      ],
      "injection-regex": "^flurry$",
      "class-name": "TreeSitterFlurry",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Flurry programming language",
    "authors": [
      {
        "name": "Flurry Contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/flurry-lang/luna"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
