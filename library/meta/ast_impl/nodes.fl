{- Arena node backing `PegNode` so custom PEG trees remain acyclic data. -}
pub struct PegTreeNode {
    rule: Symbol,
    span: SourceSpan,
    text: str,
    tokens: TokenBuffer,
    child_indices: List<Integer>,
}

pub struct PegNode {
    tree: List<PegTreeNode>,
    root: Integer,
}

impl PegNode {
    pub pure comptime fn new(tree: List<PegTreeNode>, root: Integer) -> PegNode {
        PegNode {
            tree: tree,
            root: root,
        }
    }

    pub pure comptime fn current_entry(self) -> ?PegTreeNode {
        self.tree.get(self.root)
    }

    pub pure comptime fn rule(self) -> Symbol {
        self.current_entry() match {
            entry? => entry.rule,
            null => .invalid,
        }
    }

    pub pure comptime fn span(self) -> SourceSpan {
        self.current_entry() match {
            entry? => entry.span,
            null => SourceSpan.synthetic(),
        }
    }

    pub pure comptime fn text(self) -> str {
        self.current_entry() match {
            entry? => entry.text,
            null => "",
        }
    }

    pub pure comptime fn children(self) -> List<PegNode> {
        let entry = self.current_entry() match {
            value? => value,
            null => return [],
        }
        var out: List<PegNode> = [];
        let count = entry.child_indices.length();
        var i: Integer = 0;
        while i < count {
            out.append(PegNode {
                tree: self.tree,
                root: entry.child_indices[i],
            });
            i = i + 1;
        }
        out
    }

    pub pure comptime fn to_tokens(self) -> TokenBuffer {
        self.current_entry() match {
            entry? => entry.tokens,
            null => TokenBuffer.empty(),
        }
    }
}
