use List;
use ast_impl.span.SourceSpan;
use ast_impl.token_buffer.TokenBuffer;
use builtin.{Integer, Symbol, Type, str}

{- Generic list alias used by AST and PEG macro signatures. -}
pub typealias Repetition<T: Type> = List<T>;

{- Single arena node inside a `SyntaxTree` AST snapshot. -}
pub struct SyntaxNode {
    kind: Symbol,
    span: SourceSpan,
    children: List<Integer>,
    text: str,
}

{- Arena-backed AST snapshot with an exact source token sequence. -}
pub struct SyntaxTree {
    nodes: List<SyntaxNode>,
    root: Integer,
    tokens: TokenBuffer,
}

impl SyntaxTree {
    pub pure comptime fn new(
        nodes: List<SyntaxNode>,
        root: Integer,
        tokens: TokenBuffer,
    ) -> SyntaxTree {
        SyntaxTree {
            nodes: nodes,
            root: root,
            tokens: tokens,
        }
    }

    pub pure comptime fn empty() -> SyntaxTree {
        SyntaxTree {
            nodes: [],
            root: 0,
            tokens: TokenBuffer.empty(),
        }
    }

    pub pure comptime fn node(self, index: Integer) -> ?SyntaxNode {
        self.nodes.get(index)
    }

    pub pure comptime fn root_node(self) -> ?SyntaxNode {
        self.nodes.get(self.root)
    }

    pub pure comptime fn children_of(self, index: Integer) -> List<SyntaxNode> {
        let target = self.nodes.get(index) match {
            n? => n,
            null => return [],
        }
        var out: List<SyntaxNode> = [];
        let child_count = target.children.length();
        var i: Integer = 0;
        while i < child_count {
            self.nodes.get(target.children[i]) match {
                child? => {
                    out.append(child);
                },
                null => {},
            }
            i = i + 1;
        }
        out
    }

    pub pure comptime fn to_tokens(self) -> TokenBuffer {
        self.tokens
    }

    pub pure comptime fn source_text(self) -> str {
        self.root_node() match {
            n? => n.text,
            null => "",
        }
    }
}

pub struct FlurryPattern {
    tree: SyntaxTree,
    node: Integer,
}

impl FlurryPattern {
    pub pure comptime fn from_tree(tree: SyntaxTree) -> FlurryPattern {
        FlurryPattern {
            tree: tree,
            node: tree.root,
        }
    }

    pub pure comptime fn syntax_tree(self) -> SyntaxTree {
        self.tree
    }

    pub pure comptime fn syntax_node(self) -> ?SyntaxNode {
        self.tree.node(self.node)
    }

    pub pure comptime fn span(self) -> SourceSpan {
        self.syntax_node() match {
            n? => n.span,
            null => SourceSpan.synthetic(),
        }
    }

    pub pure comptime fn text(self) -> str {
        self.syntax_node() match {
            n? => n.text,
            null => "",
        }
    }

    pub pure comptime fn to_tokens(self) -> TokenBuffer {
        self.tree.tokens
    }
}

