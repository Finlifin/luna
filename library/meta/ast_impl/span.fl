use bindings.{implicit_src, to_isize, to_usize}
use builtin.{CallDescription, Clone, Context, Copy, ImplicitPassing, Integer, Splice, Type, bool, isize, str, usize}
use numeric.equality.ComptimeEq;

{-
    Byte-offset source span carried by AST tokens, syntax tree nodes, and PEG
    captures during macro expansion, and by `implicit __src__` call-site traces.
-}
pub struct SourceSpan {
    file: str,
    start: usize,
    end: usize,
    expansion_id: isize,
}

impl SourceSpan {
    pub pure comptime fn synthetic() -> SourceSpan {
        SourceSpan {
            file: "<synthetic>",
            start: to_usize(0),
            end: to_usize(0),
            expansion_id: to_isize(0),
        }
    }

    pub pure comptime fn new(
        file: str,
        start: Integer,
        end: Integer,
        expansion_id: Integer,
    ) -> SourceSpan {
        SourceSpan {
            file: file,
            start: to_usize(start),
            end: to_usize(end),
            expansion_id: to_isize(expansion_id),
        }
    }

    pub pure comptime fn is_synthetic(self) -> bool {
        self.file == "<synthetic>" and self.start == to_usize(0) and self.end == to_usize(0)
    }

    pub pure comptime fn merge(self, other: SourceSpan) -> SourceSpan {
        if self.is_synthetic() {
            return other;
        }
        if other.is_synthetic() {
            return self;
        }
        let lo = if self.start < other.start {
            self.start
        } else {
            other.start
        }
        let hi = if self.end > other.end {
            self.end
        } else {
            other.end
        }
        SourceSpan {
            file: self.file,
            start: lo,
            end: hi,
            expansion_id: self.expansion_id,
        }
    }
}

impl Splice for SourceSpan {
    assoc RuntimeTarget: Type = SourceSpan;

    fn splice(comptime data: SourceSpan) -> SourceSpan {
        data
    }
}

impl ImplicitPassing<.__src__> for SourceSpan {
    assoc ArgType: Type = SourceSpan;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- SourceSpan > {
        let span_val = implicit_src(calling);
        '( span_val )
    }
}

comptime impl ComptimeEq for SourceSpan {
    comptime fn eq(self, other: Self) -> bool {
        self.file == other.file
            and self.start == other.start
            and self.end == other.end
            and self.expansion_id == other.expansion_id
    }
}

impl Clone for SourceSpan {
    fn clone(*self) -> Self {
        SourceSpan {
            file: self.file.*,
            start: self.start.*,
            end: self.end.*,
            expansion_id: self.expansion_id.*,
        }
    }
}

impl Copy for SourceSpan {}

pub trait SourceSpanOps {
    pure fn file(self) -> str;
    pure fn start(self) -> usize;
    pure fn end(self) -> usize;
    pure fn expansion_id(self) -> isize;
}

impl SourceSpanOps for SourceSpan {
    pure fn file(self) -> str {
        self.file
    }

    pure fn start(self) -> usize {
        self.start
    }

    pure fn end(self) -> usize {
        self.end
    }

    pure fn expansion_id(self) -> isize {
        self.expansion_id
    }
}

pub pure comptime trait ComptimeSourceSpanOps {
    pure comptime fn file(self) -> str;
    pure comptime fn start(self) -> usize;
    pure comptime fn end(self) -> usize;
    pure comptime fn expansion_id(self) -> isize;
}

comptime impl ComptimeSourceSpanOps for SourceSpan {
    pure comptime fn file(self) -> str {
        self.file
    }

    pure comptime fn start(self) -> usize {
        self.start
    }

    pure comptime fn end(self) -> usize {
        self.end
    }

    pure comptime fn expansion_id(self) -> isize {
        self.expansion_id
    }
}
