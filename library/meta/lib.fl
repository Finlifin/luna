{-
  Compiler-bound comptime data. Object preserves heterogeneous ordered entries.
  List applications retain their normal-form head; the driver supplies the
  value representation. List<Type> supports Tuple's variadic type inputs.
-}

-- Heterogeneous ordered metadata, available only during comptime invocation.
pub typealias Object = .Object'builtin;

{-
  Observe ordered Object entries without merging duplicate keys. Indices are
  checked; an out-of-range index fails the invocation. A positional entry has
  no key. Typed reads return an absent optional only for a domain mismatch.
-}
pub pure comptime fn object_length(value: Object) -> .Integer'builtin {
    .object_length'builtin(value)
}

pub pure comptime fn object_key(value: Object, index: .Integer'builtin) -> ?.Symbol'builtin {
    .object_key'builtin(value, index)
}

pub pure comptime fn ObjectEntryType(value: Object, index: .Integer'builtin) -> .Type'builtin {
    .object_entry_type'builtin(value, index)
}

pub pure comptime fn object_value(value: Object, index: .Integer'builtin) -> ?T where T {
    .object_value'builtin(T, value, index)
}

{-
  Editing returns a new ordered Object. Duplicate keys remain distinct entries.
  Replacement preserves the entry key and position, and records the new domain.
-}
pub pure comptime fn object_concat(left: Object, right: Object) -> Object {
    .object_concat'builtin(left, right)
}

pub pure comptime fn object_append(object: Object, value: T, .key: ?.Symbol'builtin = null) -> Object where T {
    .object_append'builtin(object, key, value)
}

pub pure comptime fn object_replace(object: Object, index: .Integer'builtin, value: T) -> Object where T {
    .object_replace'builtin(object, index, value)
}

pub pure comptime fn object_remove(object: Object, index: .Integer'builtin) -> Object {
    .object_remove'builtin(object, index)
}

pub pure comptime fn List<T> -> .Type'builtin {
    List<T>
}

{-
  Immutable list operations execute at comptime. Concatenation preserves the
  element domain and order, including empty lists and nested List values.
-}
pub pure comptime fn length(values: List<T>) -> .Integer'builtin where T {
    .list_length'builtin(values)
}

pub pure comptime fn concat(left: List<T>, right: List<T>) -> List<T> where T {
    .list_concat'builtin(left, right)
}

{-
  Replace a list slot with its old contents followed by one value. Existing
  snapshots remain independent. The VM may reuse the slot's owned buffer;
  element admission and representation limits still apply before completion.
-}
pub comptime fn append(target: *List<T>, value: T) where T {
    target.* = .list_concat'builtin(target.*, [value]);
}

{-
  Traverse a fixed input snapshot in index order. The callback retains its
  comptime closure environment between calls; an empty input never calls it.
  Cache the length once, independently of callback effects.
-}
pub comptime fn foreach(values: List<T>, visit: %c comptime fn(T))
where T, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    inline for index in 0..count {
        visit(values[index]);
    }
}

pub comptime fn fold(values: List<T>, initial: A, combine: %c comptime fn(A, T) -> A) -> A
where T, A, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    var accumulator = initial;
    inline for index in 0..count {
        accumulator = combine(accumulator, values[index]);
    }
    accumulator
}

{-
  Seed from the first element without invoking combine. Later elements visit
  the callback once in order; empty input has no accumulator. An optional
  element remains present even when its payload is null.
-}
pub comptime fn reduce(values: List<T>, combine: %c comptime fn(T, T) -> T) -> ?T
where T, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    if count == 0 { return null; }
    var accumulator = values[0];
    inline for index in 1..count {
        accumulator = combine(accumulator, values[index]);
    }
    accumulator
}

{-
  Mapping preserves order and calls transform exactly once per input element.
  Append through the output slot to permit buffer reuse. Full immutable data
  validation is still required; this is not yet a linear-time builder.
-}
pub comptime fn map(values: List<T>, transform: %c comptime fn(T) -> U) -> List<U>
where T, U, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    var output: List<U> = [];
    inline for index in 0..count {
        append(output.ref, transform(values[index]));
    }
    output
}

{-
  Transform each input once in order. filter_map discards only the outer null;
  flat_map appends every inner list in order, including empty inner results.
  Both retain the input snapshot when callbacks replace the caller's list.
-}
pub comptime fn filter_map(values: List<T>, transform: %c comptime fn(T) -> ?U) -> List<U>
where T, U, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    var output: List<U> = [];
    inline for index in 0..count {
        transform(values[index]) match {
            value? => append(output.ref, value),
            null => {},
        };
    }
    output
}

pub comptime fn flat_map(values: List<T>, transform: %c comptime fn(T) -> List<U>) -> List<U>
where T, U, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    var output: List<U> = [];
    inline for index in 0..count {
        let inner = transform(values[index]);
        output = concat(output, inner);
    }
    output
}

{-
  Queries visit a fixed snapshot in order and stop as soon as the answer is
  known. Empty inputs satisfy all and fail any; find returns an absent outer
  optional. A matching optional element retains its own presence layer.
-}
pub comptime fn any(values: List<T>, pred: %c comptime fn(T) -> bool) -> bool
where T, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    inline for index in 0..count {
        if pred(values[index]) { return true; }
    }
    false
}

pub comptime fn all(values: List<T>, pred: %c comptime fn(T) -> bool) -> bool
where T, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    inline for index in 0..count {
        if not pred(values[index]) { return false; }
    }
    true
}

pub comptime fn find(values: List<T>, pred: %c comptime fn(T) -> bool) -> ?T
where T, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    inline for index in 0..count {
        let value = values[index];
        if pred(value) { return value; }
    }
    null
}

{- Stop at the first present transformed result, preserving inner nulls. -}
pub comptime fn find_map(values: List<T>, transform: %c comptime fn(T) -> ?U) -> ?U
where T, U, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    inline for index in 0..count {
        transform(values[index]) match {
            value? => { return value; },
            null => {},
        };
    }
    null
}

{-
  Filtering preserves retained elements and their order. Like map, it reuses
  the output slot while retaining the full immutable validation checks.
-}
pub comptime fn filter(values: List<T>, pred: %c comptime fn(T) -> bool) -> List<T>
where T, c: (.Type'builtin).vars.Closure {
    let count = length(values);
    var output: List<T> = [];
    inline for index in 0..count {
        let value = values[index];
        if pred(value) {
            append(output.ref, value);
        }
    }
    output
}

{-
  Select a half-open interval [start, end). Bounds are exact comptime Integers;
  invalid bounds return null, while a valid empty interval returns a present
  empty list. Elements retain their domains and the input remains unchanged.
-}
pub comptime fn slice(values: List<T>, start: .Integer'builtin, end: .Integer'builtin)
    -> ?List<T> where T {
    let count = length(values);
    if start < 0 or end < start or end > count { return null; }
    var output: List<T> = [];
    append_range(output.ref, values, start, end);
    output
}

{-
  Replace [start, end) with a list of the same element domain. Empty intervals
  insert; empty replacements remove. All inputs are ordinary once-evaluated
  arguments. Invalid bounds return null without constructing an output list.
-}
pub comptime fn replace_range(values: List<T>, start: .Integer'builtin,
    end: .Integer'builtin, replacement: List<T>) -> ?List<T> where T {
    let count = length(values);
    if start < 0 or end < start or end > count { return null; }
    var output: List<T> = [];
    append_range(output.ref, values, 0, start);
    append_range(output.ref, replacement, 0, length(replacement));
    append_range(output.ref, values, end, count);
    output
}

-- Internal traversal; callers establish the half-open interval bounds first.
comptime fn append_range(target: *List<T>, values: List<T>,
    start: .Integer'builtin, end: .Integer'builtin) where T {
    inline for index in start..end {
        append(target, values[index]);
    }
}

{-
  Observe an applied struct in declaration order. Reflection grants neither
  field access nor layout permission, and never unfolds opaque type factories.
-}
pub pure comptime fn struct_field_types(subject: .Type'builtin) -> List<.Type'builtin> {
    .struct_field_types'builtin(subject)
}

pub pure comptime fn struct_field_names(subject: .Type'builtin) -> List<.Symbol'builtin> {
    .struct_field_names'builtin(subject)
}

{-
  Private construction data for a concrete struct. Fields retain their supplied
  Type identities and declaration order. Build validates and publishes through
  the compiler's checked definition service; drafts are not observable Types.
-}
pub struct StructBuilder {
    name: .Symbol'builtin,
    field_names: List<.Symbol'builtin>,
    field_types: List<.Type'builtin>,
}

impl StructBuilder {
    pub comptime fn new(.name: .Symbol'builtin = .Generated) -> Self {
        Self { name: name, field_names: [], field_types: [] }
    }

    pub comptime fn from_type(subject: .Type'builtin, .name: .Symbol'builtin = .Generated) -> Self {
        Self {
            name: name,
            field_names: struct_field_names(subject),
            field_types: struct_field_types(subject),
        }
    }

    pub comptime fn add_field(*self, name: .Symbol'builtin, field_type: .Type'builtin) {
        append(self.field_names, name);
        append(self.field_types, field_type);
    }

    {-
        Edit by declaration-order index. Invalid bounds leave both snapshots
        unchanged. Names and Types are prepared together before either write;
        Build remains responsible for duplicate names and layout admission.
    -}
    pub comptime fn insert_field(*self, index: .Integer'builtin,
        name: .Symbol'builtin, field_type: .Type'builtin) -> bool {
        self.edit_fields(index, index, [name], [field_type])
    }

    pub comptime fn replace_field(*self, index: .Integer'builtin,
        name: .Symbol'builtin, field_type: .Type'builtin) -> bool {
        self.edit_fields(index, index + 1, [name], [field_type])
    }

    pub comptime fn remove_field(*self, index: .Integer'builtin) -> bool {
        self.edit_fields(index, index + 1, [], [])
    }

    comptime fn edit_fields(*self, start: .Integer'builtin, end: .Integer'builtin,
        names: List<.Symbol'builtin>, types: List<.Type'builtin>) -> bool {
        let next_names = replace_range<.Symbol'builtin>(self.field_names.*, start, end, names) match {
            value? => value,
            null => return false,
        };
        let next_types = replace_range<.Type'builtin>(self.field_types.*, start, end, types) match {
            value? => value,
            null => return false,
        };
        self.field_names.* = next_names;
        self.field_types.* = next_types;
        true
    }

    pub comptime fn Build(self) -> .Type'builtin {
        .build_struct'builtin(self.name, self.field_names, self.field_types)
    }
}

{-
  Logical enum structure in declaration order. Paths are lists of Symbol
  segments; indices do not describe discriminant values or storage encoding.
-}
pub pure comptime fn enum_group_paths(subject: .Type'builtin) -> List<List<.Symbol'builtin>> {
    .enum_group_paths'builtin(subject)
}

pub pure comptime fn enum_variant_paths(subject: .Type'builtin) -> List<List<.Symbol'builtin>> {
    .enum_variant_paths'builtin(subject)
}

pub pure comptime fn enum_variant_shapes(subject: .Type'builtin) -> List<.Symbol'builtin> {
    .enum_variant_shapes'builtin(subject)
}

pub pure comptime fn enum_variant_field_names(subject: .Type'builtin) -> List<List<.Symbol'builtin>> {
    .enum_variant_field_names'builtin(subject)
}

pub pure comptime fn enum_variant_field_types(subject: .Type'builtin) -> List<List<.Type'builtin>> {
    .enum_variant_field_types'builtin(subject)
}

{-
  A concrete enum draft. Variant paths and groups retain declaration order;
  Build checks payload Types and publishes one fresh nominal identity.
-}
pub struct EnumBuilder {
    name: .Symbol'builtin,
    groups: List<List<.Symbol'builtin>>,
    variant_names: List<List<.Symbol'builtin>>,
    shapes: List<.Symbol'builtin>,
    field_names: List<List<.Symbol'builtin>>,
    field_types: List<List<.Type'builtin>>,
}

impl EnumBuilder {
    pub comptime fn new(.name: .Symbol'builtin = .Generated) -> Self {
        Self { name: name, groups: [], variant_names: [], shapes: [], field_names: [], field_types: [] }
    }

    pub comptime fn from_type(subject: .Type'builtin, .name: .Symbol'builtin = .Generated) -> Self {
        Self {
            name: name,
            groups: enum_group_paths(subject),
            variant_names: enum_variant_paths(subject),
            shapes: enum_variant_shapes(subject),
            field_names: enum_variant_field_names(subject),
            field_types: enum_variant_field_types(subject),
        }
    }

    pub comptime fn add_group(*self, name: .Symbol'builtin, .parent: List<.Symbol'builtin> = []) {
        append(self.groups, concat(parent, [name]));
    }

    pub comptime fn add_unit(*self, name: .Symbol'builtin, .group: List<.Symbol'builtin> = []) {
        append(self.variant_names, concat(group, [name]));
        append(self.shapes, .unit);
        append(self.field_names, []);
        append(self.field_types, []);
    }

    pub comptime fn add_tuple(*self, name: .Symbol'builtin, fields: List<.Type'builtin>, .group: List<.Symbol'builtin> = []) {
        append(self.variant_names, concat(group, [name]));
        append(self.shapes, .tuple);
        append(self.field_names, []);
        append(self.field_types, fields);
    }

    pub comptime fn add_named(*self, name: .Symbol'builtin, names: List<.Symbol'builtin>, fields: List<.Type'builtin>, .group: List<.Symbol'builtin> = []) {
        append(self.variant_names, concat(group, [name]));
        append(self.shapes, .named);
        append(self.field_names, names);
        append(self.field_types, fields);
    }

    {-
        Indices refer to logical declaration order, never encoded tags. Editing
        validates bounds; Build validates paths, payloads and group references.
        Prepare all parallel lists before committing any part of a variant.
    -}
    pub comptime fn insert_unit(*self, index: .Integer'builtin, name: .Symbol'builtin,
        .group: List<.Symbol'builtin> = []) -> bool {
        self.edit_variants(index, index, [concat(group, [name])], [.unit], [[]], [[]])
    }

    pub comptime fn insert_tuple(*self, index: .Integer'builtin, name: .Symbol'builtin, fields: List<.Type'builtin>,
        .group: List<.Symbol'builtin> = []) -> bool {
        self.edit_variants(index, index, [concat(group, [name])], [.tuple], [[]], [fields])
    }

    pub comptime fn insert_named(*self, index: .Integer'builtin, name: .Symbol'builtin, names: List<.Symbol'builtin>, fields: List<.Type'builtin>,
        .group: List<.Symbol'builtin> = []) -> bool {
        self.edit_variants(index, index, [concat(group, [name])], [.named], [names], [fields])
    }

    pub comptime fn replace_unit(*self, index: .Integer'builtin, name: .Symbol'builtin,
        .group: List<.Symbol'builtin> = []) -> bool {
        self.edit_variants(index, index + 1, [concat(group, [name])], [.unit], [[]], [[]])
    }

    pub comptime fn replace_tuple(*self, index: .Integer'builtin, name: .Symbol'builtin, fields: List<.Type'builtin>,
        .group: List<.Symbol'builtin> = []) -> bool {
        self.edit_variants(index, index + 1, [concat(group, [name])], [.tuple], [[]], [fields])
    }

    pub comptime fn replace_named(*self, index: .Integer'builtin, name: .Symbol'builtin, names: List<.Symbol'builtin>, fields: List<.Type'builtin>,
        .group: List<.Symbol'builtin> = []) -> bool {
        self.edit_variants(index, index + 1, [concat(group, [name])], [.named], [names], [fields])
    }

    pub comptime fn remove_variant(*self, index: .Integer'builtin) -> bool {
        self.edit_variants(index, index + 1, [], [], [], [])
    }

    comptime fn edit_variants(*self, start: .Integer'builtin, end: .Integer'builtin,
        paths: List<List<.Symbol'builtin>>, shapes: List<.Symbol'builtin>,
        names: List<List<.Symbol'builtin>>, types: List<List<.Type'builtin>>) -> bool {
        let next_paths = replace_range<List<.Symbol'builtin>>(self.variant_names.*, start, end, paths) match {
            value? => value, null => return false,
        };
        let next_shapes = replace_range<.Symbol'builtin>(self.shapes.*, start, end, shapes) match {
            value? => value, null => return false,
        };
        let next_names = replace_range<List<.Symbol'builtin>>(self.field_names.*, start, end, names) match {
            value? => value, null => return false,
        };
        let next_types = replace_range<List<.Type'builtin>>(self.field_types.*, start, end, types) match {
            value? => value, null => return false,
        };
        self.variant_names.* = next_paths;
        self.shapes.* = next_shapes;
        self.field_names.* = next_names;
        self.field_types.* = next_types;
        true
    }

    {-
        Group edits change only the group declaration list. Descendant paths
        remain explicit; repair them before Build if a parent was renamed or
        removed. This permits coordinated edits without silently moving cases.
    -}
    pub comptime fn insert_group(*self, index: .Integer'builtin, name: .Symbol'builtin,
        .parent: List<.Symbol'builtin> = []) -> bool {
        self.edit_groups(index, index, [concat(parent, [name])])
    }

    pub comptime fn replace_group(*self, index: .Integer'builtin, name: .Symbol'builtin,
        .parent: List<.Symbol'builtin> = []) -> bool {
        self.edit_groups(index, index + 1, [concat(parent, [name])])
    }

    pub comptime fn remove_group(*self, index: .Integer'builtin) -> bool {
        self.edit_groups(index, index + 1, [])
    }

    comptime fn edit_groups(*self, start: .Integer'builtin, end: .Integer'builtin,
        paths: List<List<.Symbol'builtin>>) -> bool {
        let next = replace_range<List<.Symbol'builtin>>(self.groups.*, start, end, paths) match {
            value? => value, null => return false,
        };
        self.groups.* = next;
        true
    }

    pub comptime fn Build(self) -> .Type'builtin {
        .build_enum_paths'builtin(self.name, self.groups, self.variant_names, self.shapes, self.field_names, self.field_types)
    }

    {- Codes correspond to leaf variants in declaration order. Symbol encoding
       requires unit variants and rejects repeated codes during BuildSymbol. -}
    pub comptime fn BuildSymbol(self, codes: List<.Symbol'builtin>) -> .Type'builtin {
        .build_symbol_enum_paths'builtin(self.name, self.groups, self.variant_names,
            self.shapes, self.field_names, self.field_types, codes)
    }

    {-
        Fixed bits and payload slots must partition each variant's representation.
        Offsets follow payload declaration order and count from the least bit.
    -}
    pub comptime fn BuildBits(self, width: .Integer'builtin,
        masks: List<.Integer'builtin>, values: List<.Integer'builtin>,
        offsets: List<List<.Integer'builtin>>, .base_type: ?.Type'builtin = null) -> .Type'builtin {
        .build_bits_enum_paths'builtin(self.name, self.groups, self.variant_names,
            self.shapes, self.field_names, self.field_types, width, base_type, masks, values, offsets)
    }

}

pub mod prelude {
    pub use .List;
    pub use .Object;
}
