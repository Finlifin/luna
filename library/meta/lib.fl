use builtin.{Type, bool}

{- Keep the compiler-bound normal-form head at the public meta.List path. -}
pub const List: pure comptime fn<T: Type> -> Type = .List'builtin;

{- Comptime data, arithmetic, reflection, AST tokens, and checked definition builders. -}
use ast_impl;
use code.{combinators as code_combinators, types as code_types};
use data.{
    errors,
    hashing,
    integer,
    list,
    list_equality,
    list_hashing,
    list_ordering,
    map,
    object,
    optional,
    patterns as data_patterns,
    set,
    text,
}
use definitions.{enums, newtypes, structs}
use macros_impl;
use numeric.{conversions, equality, ordering, scalar_math}
use reflection.structure;
use types.equality as type_equality;

pub use ast_impl.*;
pub use code_combinators.{
    count_exprs,
    first_expr,
    keep,
    keep_expr,
    last_expr,
    select_any,
    select_expr,
}
pub use code_types.{
    CodeContext,
    CodeErr,
    CodeInterfaceSummary,
    CodeKind,
    ContextEntry,
    Substitution,
}
pub use conversions.{ComptimeTryFrom, ComptimeTryInto}
pub use enums.*;
pub use equality.ComptimeEq;
pub use errors.ComptimeErrorResultOps;
pub use hashing.ComptimeHash;
pub use integer.*;
pub use map.{Map, MapEntry}
pub use newtypes.*;
pub use object.*;
pub use optional.ComptimeOptionalOps;
pub use ordering.ComptimeOrd;
pub use data_patterns.{ComptimeListPatternView, ComptimeStableListPatternView}
pub use set.Set;
pub use structs.*;
pub use structure.*;
pub use text.{ComptimeTextBytes, str_from_char}

pub mod ast {
    pub use ast_impl.*;
}

pub mod macros {
    pub use macros_impl.*;
}

pub mod math {
    pub use scalar_math.*;
}

pub mod patterns {
    use builtin.Type;

    {- Error reasons produced by comptime pattern-view elaboration protocols. -}
    pub enum PatternViewErr {
        InvalidArity,
        ExpectedConstantSlot,
        InvalidPatternInput,
        TypeMismatch,
        UnsupportedSlotShape,
        DisallowedContextEscape,
    }

    {- Structural classification of a pattern slot supplied to custom pattern views. -}
    pub enum PatternShape {
        wildcard,
        binding,
        constant,
        tuple,
        record,
        list,
        typed_binding,
        complex,
    }

    {- Protocol for custom comptime type constructors that expose destructuring
       without unfolding normal-form head definitions. Returning `null` indicates a
       pattern mismatch and transfers control to the next match arm. -}
    pub pure comptime trait TypePatternView {
        assoc Args: Type;

        pure comptime fn type_pattern_view_destructure(target: Type) -> ?Args;
    }
}

pub mod prelude {
    pub use .List;
    pub use .Map;
    pub use .MapEntry;
    pub use .Object;
    pub use .Set;
    pub use ast_impl.{ComptimeSourceSpanOps, SourceSpanOps}
    pub use conversions.{ComptimeTryFrom, ComptimeTryInto}
    pub use equality.ComptimeEq;
    pub use errors.ComptimeErrorResultOps;
    pub use hashing.ComptimeHash;
    pub use optional.ComptimeOptionalOps;
    pub use ordering.ComptimeOrd;
    pub use data_patterns.{ComptimeListPatternView, ComptimeStableListPatternView}
    pub use text.ComptimeTextBytes;
}
