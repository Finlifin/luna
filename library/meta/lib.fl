use builtin.{Type, bool};

{- Keep the compiler-bound normal-form head at the public meta.List path. -}
pub const List: pure comptime fn<T: Type> -> Type = .List'builtin;

{- Comptime data, arithmetic, reflection, and checked definition builders. -}
use data.{object, integer, list, optional, errors, text, patterns, hashing};
use definitions.{structs, enums};
use numeric.{scalar_math, equality};
use reflection.structure;

pub use object.*;
pub use optional.ComptimeOptionalOps;
pub use errors.ComptimeErrorResultOps;
pub use text.ComptimeTextBytes;
pub use patterns.ComptimeListPatternView;
pub use equality.ComptimeEq;
pub use hashing.ComptimeHash;
pub use integer.*;
pub use structure.*;
pub use structs.*;
pub use enums.*;

pub mod math {
    pub use scalar_math.*;
}

pub mod prelude {
    pub use .List;
    pub use optional.ComptimeOptionalOps;
    pub use errors.ComptimeErrorResultOps;
    pub use text.ComptimeTextBytes;
    pub use patterns.ComptimeListPatternView;
    pub use equality.ComptimeEq;
    pub use hashing.ComptimeHash;
    pub use .Object;
}
