use List;
use ast_impl.span.SourceSpan;
use bindings;
use bindings.Object;
use builtin.{Integer, Symbol, Type, bool, u128}

{-
    Observe declaration order through the checked Type value. Reflection grants
    neither field access nor layout permission and does not unfold opaque heads.
    Enum paths consist of Symbol segments, not encoded discriminants.
-}
pub use bindings.declaration_span;
pub use bindings.enum_bit_base_type;
pub use bindings.enum_bit_masks;
pub use bindings.enum_bit_offsets;
pub use bindings.enum_bit_values;
pub use bindings.enum_bit_width;
pub use bindings.enum_group_paths;
pub use bindings.enum_symbol_values;
pub use bindings.enum_variant_field_names;
pub use bindings.enum_variant_field_spans;
pub use bindings.enum_variant_field_types;
pub use bindings.enum_variant_paths;
pub use bindings.enum_variant_shapes;
pub use bindings.enum_variant_spans;
pub use bindings.record_field_names;
pub use bindings.record_field_spans;
pub use bindings.record_field_types;
pub use bindings.struct_field_names;
pub use bindings.struct_field_spans;
pub use bindings.struct_field_types;
pub use bindings.type_id;

{- Structured reflection failures returned by reflect_struct, reflect_record, and reflect_enum. -}
pub enum ReflectErr {
    NotStruct,
    NotRecord,
    NotEnum,
    GenericTemplate,
    MissingField,
    InvalidVariant,
    ComptimeOnlyType,
}

{- Declaration-order field descriptor for structs, anonymous records, and enum variants. -}
pub struct FieldInfo {
    raw_name: ?Symbol,
    raw_index: Integer,
    raw_field_type: Type,
    raw_span: SourceSpan,
}

impl FieldInfo {
    pub pure comptime fn FieldType(self) -> Type {
        self.raw_field_type
    }

    pub pure comptime fn name(self) -> ?Symbol {
        self.raw_name
    }

    pub pure comptime fn index(self) -> Integer {
        self.raw_index
    }

    pub pure comptime fn span(self) -> SourceSpan {
        self.raw_span
    }

    pub pure comptime fn field_type(self) -> Type {
        self.raw_field_type
    }
}

pub struct RecordInfo {
    raw_subject: Type,
    raw_fields: List<FieldInfo>,
    raw_span: SourceSpan,
}

impl RecordInfo {
    pub pure comptime fn subject(self) -> Type {
        self.raw_subject
    }

    pub pure comptime fn fields(self) -> List<FieldInfo> {
        self.raw_fields
    }

    pub pure comptime fn span(self) -> SourceSpan {
        self.raw_span
    }
}

pub struct StructInfo {
    raw_subject: Type,
    raw_fields: List<FieldInfo>,
    raw_span: SourceSpan,
}

impl StructInfo {
    pub pure comptime fn subject(self) -> Type {
        self.raw_subject
    }

    pub pure comptime fn fields(self) -> List<FieldInfo> {
        self.raw_fields
    }

    pub pure comptime fn span(self) -> SourceSpan {
        self.raw_span
    }
}

pub enum VariantKind {
    unit,
    tuple,
    named,
}

pub enum EnumEncoding {
    ordinary,
    symbol_enum,
    fixed_bits,
}

pub struct VariantInfo {
    raw_path: List<Symbol>,
    raw_name: Symbol,
    raw_index: Integer,
    raw_kind: VariantKind,
    raw_fields: List<FieldInfo>,
    raw_span: SourceSpan,
}

impl VariantInfo {
    pub pure comptime fn path(self) -> List<Symbol> {
        self.raw_path
    }

    pub pure comptime fn name(self) -> Symbol {
        self.raw_name
    }

    pub pure comptime fn index(self) -> Integer {
        self.raw_index
    }

    pub pure comptime fn kind(self) -> VariantKind {
        self.raw_kind
    }

    pub pure comptime fn fields(self) -> List<FieldInfo> {
        self.raw_fields
    }

    pub pure comptime fn span(self) -> SourceSpan {
        self.raw_span
    }
}

pub struct EnumInfo {
    raw_subject: Type,
    raw_groups: List<List<Symbol>>,
    raw_variants: List<VariantInfo>,
    raw_encoding: EnumEncoding,
    raw_span: SourceSpan,
}

impl EnumInfo {
    pub pure comptime fn subject(self) -> Type {
        self.raw_subject
    }

    pub pure comptime fn groups(self) -> List<List<Symbol>> {
        self.raw_groups
    }

    pub pure comptime fn variants(self) -> List<VariantInfo> {
        self.raw_variants
    }

    pub pure comptime fn encoding(self) -> EnumEncoding {
        self.raw_encoding
    }

    pub pure comptime fn span(self) -> SourceSpan {
        self.raw_span
    }
}

pure comptime fn build_field_list(
    names: List<Symbol>,
    types: List<Type>,
    spans: List<SourceSpan>,
    fallback_span: SourceSpan,
) -> List<FieldInfo> {
    var fields: List<FieldInfo> = [];
    let count = types.length();
    inline for index in 0..count {
        let span = spans.get(index) match {
            s? => s,
            null => fallback_span,
        };
        fields.append(FieldInfo {
            raw_name: names.get(index),
            raw_index: index,
            raw_field_type: types[index],
            raw_span: span,
        });
    }
    fields
}

pub pure comptime fn reflect_record(subject: Type) -> !ReflectErr RecordInfo {
    if not Type.predicates.is_anonymous_record(subject) {
        return error ReflectErr.NotRecord;
    }
    let decl_span = bindings.declaration_span(subject);
    let names = bindings.record_field_names(subject);
    let types = bindings.record_field_types(subject);
    let spans = bindings.record_field_spans(subject);
    RecordInfo {
        raw_subject: subject,
        raw_fields: build_field_list(names, types, spans, decl_span),
        raw_span: decl_span,
    }
}

pub pure comptime fn reflect_struct(subject: Type) -> !ReflectErr StructInfo {
    if not Type.predicates.is_struct(subject) {
        return error ReflectErr.NotStruct;
    }
    let decl_span = bindings.declaration_span(subject);
    let names = bindings.struct_field_names(subject);
    let types = bindings.struct_field_types(subject);
    let spans = bindings.struct_field_spans(subject);
    StructInfo {
        raw_subject: subject,
        raw_fields: build_field_list(names, types, spans, decl_span),
        raw_span: decl_span,
    }
}

pub pure comptime fn reflect_enum(subject: Type) -> !ReflectErr EnumInfo {
    if not Type.predicates.is_enum(subject) {
        return error ReflectErr.NotEnum;
    }
    let decl_span = bindings.declaration_span(subject);
    let groups = bindings.enum_group_paths(subject);
    let paths = bindings.enum_variant_paths(subject);
    let shapes = bindings.enum_variant_shapes(subject);
    let names = bindings.enum_variant_field_names(subject);
    let types = bindings.enum_variant_field_types(subject);
    let v_spans = bindings.enum_variant_spans(subject);
    let vf_spans = bindings.enum_variant_field_spans(subject);
    var variants: List<VariantInfo> = [];
    let vcount = paths.length();
    inline for v in 0..vcount {
        let path = paths[v];
        let vname = path.last() match {
            sym? => sym,
            null => .unknown,
        };
        let shape = shapes[v];
        let kind = if shape == .unit {
            VariantKind.unit
        } else if shape == .tuple {
            VariantKind.tuple
        } else {
            VariantKind.named
        };
        let vspan = v_spans.get(v) match {
            s? => s,
            null => decl_span,
        };
        let fspans = vf_spans.get(v) match {
            ls? => ls,
            null => [],
        };
        variants.append(VariantInfo {
            raw_path: path,
            raw_name: vname,
            raw_index: v,
            raw_kind: kind,
            raw_fields: build_field_list(names[v], types[v], fspans, vspan),
            raw_span: vspan,
        });
    }
    EnumInfo {
        raw_subject: subject,
        raw_groups: groups,
        raw_variants: variants,
        raw_encoding: EnumEncoding.ordinary,
        raw_span: decl_span,
    }
}

pub pure comptime fn enum_variant_index(value: E) -> Integer
where
    E: Type,
{
    bindings.comptime_enum_variant_index(value)
}

pub pure comptime fn enum_variant_field_values(value: E) -> Object
where
    E: Type,
{
    bindings.comptime_enum_variant_field_values(value)
}

{-
    Observation of an applied callable Type without exposing closure
    environment storage or executing user code. `Signature()` returns the
    unwrapped `fn(...) -> ...` signature Type, while `Callable()` retains
    comptime/unsafe modifiers and resolved closure environment metadata.
-}
pub struct CallableReflection {
    raw_subject: Type,
    raw_callable: Type,
    raw_signature: Type,
    raw_is_comptime: bool,
    raw_is_unsafe: bool,
}

impl CallableReflection {
    pub pure comptime fn Subject(self) -> Type {
        self.raw_subject
    }

    pub pure comptime fn Callable(self) -> Type {
        self.raw_callable
    }

    pub pure comptime fn Signature(self) -> Type {
        self.raw_signature
    }

    pub pure comptime fn is_comptime(self) -> bool {
        self.raw_is_comptime
    }

    pub pure comptime fn is_unsafe(self) -> bool {
        self.raw_is_unsafe
    }
}

pure comptime fn build_callable_reflection(subject: Type) -> CallableReflection {
    let data = bindings.reflect_callable_object(subject);
    CallableReflection {
        raw_subject: data.get<Type>(.subject) match {
            value? => value,
            null => subject,
        },
        raw_callable: data.get<Type>(.callable) match {
            value? => value,
            null => subject,
        },
        raw_signature: data.get<Type>(.signature) match {
            value? => value,
            null => subject,
        },
        raw_is_comptime: data.get<bool>(.is_comptime) match {
            value? => value,
            null => false,
        },
        raw_is_unsafe: data.get<bool>(.is_unsafe) match {
            value? => value,
            null => false,
        },
    }
}

pub pure comptime fn reflect_callable(subject: Type) -> CallableReflection {
    build_callable_reflection(subject)
}

{-
    Compose the checked parallel reflection lists into ordered field entries.
    Tuple payloads have no names; named payloads retain their original keys.
    Object stores each field's Type value, without erasing it to Any.
-}
pure comptime fn field_object(names: List<Symbol>, types: List<Type>) -> Object {
    var fields: Object = {}
    let count = types.length();
    inline for index in 0..count {
        fields = fields.append(types[index], .key = names.get(index));
    }
    fields
}

impl Type {
    {- Read one declared representation edge without changing nominal identity. -}
    pub pure comptime fn NewtypeRepresentation(self) -> Type {
        bindings.NewtypeRepresentation(self)
    }

    {- Explicit fixed-bit encoding only; no layout or base type is inferred. -}
    pub pure comptime fn enum_bit_width(self) -> Integer {
        bindings.enum_bit_width(self)
    }

    pub pure comptime fn enum_bit_base_type(self) -> ?Type {
        bindings.enum_bit_base_type(self)
    }

    pub pure comptime fn enum_bit_masks(self) -> List<Integer> {
        bindings.enum_bit_masks(self)
    }

    pub pure comptime fn enum_bit_values(self) -> List<Integer> {
        bindings.enum_bit_values(self)
    }

    pub pure comptime fn enum_bit_offsets(self) -> List<List<Integer>> {
        bindings.enum_bit_offsets(self)
    }

    {-
        Read explicit Symbol codes in leaf-variant declaration order. Ordinary
        and fixed-bit enums have no Symbol codes and reject this observation.
    -}
    pub pure comptime fn enum_symbol_values(self) -> List<Symbol> {
        bindings.enum_symbol_values(self)
    }

    pub pure comptime fn struct_fields(self) -> Object {
        field_object(self.struct_field_names(), self.struct_field_types())
    }

    pub pure comptime fn record_field_names(self) -> List<Symbol> {
        bindings.record_field_names(self)
    }

    pub pure comptime fn record_field_types(self) -> List<Type> {
        bindings.record_field_types(self)
    }

    pub pure comptime fn record_fields(self) -> Object {
        field_object(self.record_field_names(), self.record_field_types())
    }

    pub pure comptime fn reflect_callable(self) -> CallableReflection {
        build_callable_reflection(self)
    }

    pub pure comptime fn type_id(self) -> u128 {
        bindings.type_id(self)
    }

    {-
        One Object per variant, in the same order as enum_variant_paths().
        Unit cases yield an empty Object; tuple fields are positional entries.
        These descriptions carry fields only, not default code or attributes.
    -}
    pub pure comptime fn enum_variant_fields(self) -> List<Object> {
        let names = self.enum_variant_field_names();
        let types = self.enum_variant_field_types();
        var variants: List<Object> = [];
        let count = types.length();
        inline for index in 0..count {
            variants.append(field_object(names[index], types[index]));
        }
        variants
    }

    pub pure comptime fn struct_field_names(self) -> List<Symbol> {
        bindings.struct_field_names(self)
    }

    pub pure comptime fn struct_field_types(self) -> List<Type> {
        bindings.struct_field_types(self)
    }

    pub pure comptime fn enum_group_paths(self) -> List<List<Symbol>> {
        bindings.enum_group_paths(self)
    }

    pub pure comptime fn enum_variant_paths(self) -> List<List<Symbol>> {
        bindings.enum_variant_paths(self)
    }

    pub pure comptime fn enum_variant_shapes(self) -> List<Symbol> {
        bindings.enum_variant_shapes(self)
    }

    pub pure comptime fn enum_variant_field_names(self) -> List<List<Symbol>> {
        bindings.enum_variant_field_names(self)
    }

    pub pure comptime fn enum_variant_field_types(self) -> List<List<Type>> {
        bindings.enum_variant_field_types(self)
    }

    {- Report the merged packed layout mode (`.byte` or `.bit`), or `null` for default layout. -}
    pub pure comptime fn packed_mode(self) -> ?Symbol {
        self'attribute.get<Symbol>(.__flurry_packed_mode) match {
            mode? => {
                if mode == .byte or mode == .bit {
                    mode
                } else {
                    null
                }
            },
            null => null,
        }
    }

    {- Report whether the merged packed attribute enables byte- or bit-packed layout. -}
    pub pure comptime fn is_packed(self) -> bool {
        self.packed_mode() match {
            _? => true,
            null => false,
        }
    }
}
