use builtin.{Integer, Symbol, Type, usize};
use List;

pub typealias Object = .Object'builtin;

const compiler_list_length: comptime fn(comptime T: Type, List<T>) -> Integer = .list_length'builtin;
pub const compiler_list_concat: comptime fn(comptime T: Type, List<T>, List<T>) -> List<T> = .list_concat'builtin;
const compiler_to_usize: comptime fn(Integer) -> usize = .comptime_integer_convert'builtin;
const compiler_from_usize: comptime fn(usize) -> Integer = .comptime_integer_convert'builtin;
const compiler_comptime_integer_div_trunc: comptime fn(Integer, Integer) -> Integer = .comptime_integer_div_trunc'builtin;
const compiler_comptime_integer_rem_trunc: comptime fn(Integer, Integer) -> Integer = .comptime_integer_rem_trunc'builtin;
pub const compiler_object_length: comptime fn(Object) -> Integer = .object_length'builtin;
pub const compiler_object_key: comptime fn(Object, Integer) -> ?Symbol = .object_key'builtin;
pub const CompilerObjectEntryType: comptime fn(Object, Integer) -> Type = .object_entry_type'builtin;
pub const compiler_object_value: comptime fn(comptime T: Type, Object, Integer) -> ?T = .object_value'builtin;
pub const compiler_object_get: comptime fn(comptime T: Type, Object, Symbol) -> ?T = .object_get'builtin;
const compiler_object_concat: comptime fn(Object, Object) -> Object = .object_concat'builtin;
const compiler_object_append: comptime fn(comptime T: Type, Object, ?Symbol, T) -> Object = .object_append'builtin;
const compiler_object_replace: comptime fn(comptime T: Type, Object, Integer, T) -> Object = .object_replace'builtin;
const compiler_object_remove: comptime fn(Object, Integer) -> Object = .object_remove'builtin;
pub const compiler_object_slice: comptime fn(Object, Integer, Integer) -> Object = .object_slice'builtin;
const compiler_struct_field_types: comptime fn(Type) -> List<Type> = .struct_field_types'builtin;
const compiler_struct_field_names: comptime fn(Type) -> List<Symbol> = .struct_field_names'builtin;
const compiler_enum_group_paths: comptime fn(Type) -> List<List<Symbol>> = .enum_group_paths'builtin;
const compiler_enum_variant_paths: comptime fn(Type) -> List<List<Symbol>> = .enum_variant_paths'builtin;
const compiler_enum_variant_shapes: comptime fn(Type) -> List<Symbol> = .enum_variant_shapes'builtin;
const compiler_enum_variant_field_names: comptime fn(Type) -> List<List<Symbol>> = .enum_variant_field_names'builtin;
const compiler_enum_variant_field_types: comptime fn(Type) -> List<List<Type>> = .enum_variant_field_types'builtin;
const compiler_enum_symbol_values: comptime fn(Type) -> List<Symbol> = .enum_symbol_values'builtin;
const compiler_enum_bit_width: comptime fn(Type) -> Integer = .enum_bit_width'builtin;
const compiler_enum_bit_base_type: comptime fn(Type) -> ?Type = .enum_bit_base_type'builtin;
const compiler_enum_bit_masks: comptime fn(Type) -> List<Integer> = .enum_bit_masks'builtin;
const compiler_enum_bit_values: comptime fn(Type) -> List<Integer> = .enum_bit_values'builtin;
const compiler_enum_bit_offsets: comptime fn(Type) -> List<List<Integer>> = .enum_bit_offsets'builtin;
const CompilerNewtypeRepresentation: comptime fn(Type) -> Type = .newtype_representation'builtin;
const CompilerBuildNewtype: comptime fn(Symbol, Type) -> Type = .build_newtype'builtin;
const CompilerBuildStruct: comptime fn(Symbol, List<Symbol>, List<Type>) -> Type = .build_struct'builtin;
const CompilerBuildEnumPaths: comptime fn(Symbol, List<List<Symbol>>,
    List<List<Symbol>>, List<Symbol>, List<List<Symbol>>, List<List<Type>>) -> Type
    = .build_enum_paths'builtin;
const CompilerBuildSymbolEnumPaths: comptime fn(Symbol, List<List<Symbol>>,
    List<List<Symbol>>, List<Symbol>, List<List<Symbol>>, List<List<Type>>,
    List<Symbol>) -> Type = .build_symbol_enum_paths'builtin;
const CompilerBuildBitsEnumPaths: comptime fn(Symbol, List<List<Symbol>>,
    List<List<Symbol>>, List<Symbol>, List<List<Symbol>>, List<List<Type>>,
    Integer, ?Type, List<Integer>, List<Integer>, List<List<Integer>>) -> Type
    = .build_bits_enum_paths'builtin;

{-
    Named compiler-operation bindings for comptime data and definitions.
    Library algorithms use these ordinary functions; raw compiler symbols stay
    at this boundary. Type parameters retain the List normal-form identity.
-}
pub pure comptime fn list_length(values: List<T>) -> Integer where T {
    compiler_list_length(T, values)
}

pub pure comptime fn list_concat(left: List<T>, right: List<T>) -> List<T> where T {
    compiler_list_concat(T, left, right)
}

pub pure comptime fn to_usize(value: Integer) -> usize {
    compiler_to_usize(value)
}

pub pure comptime fn from_usize(value: usize) -> Integer {
    compiler_from_usize(value)
}

pub const div_trunc: comptime fn(Integer, Integer) -> Integer = compiler_comptime_integer_div_trunc;

pub const rem_trunc: comptime fn(Integer, Integer) -> Integer = compiler_comptime_integer_rem_trunc;

pub pure comptime fn object_length(value: Object) -> Integer {
    compiler_object_length(value)
}

pub pure comptime fn object_key(value: Object, index: Integer) -> ?Symbol {
    compiler_object_key(value, index)
}

pub pure comptime fn ObjectEntryType(value: Object, index: Integer) -> Type {
    CompilerObjectEntryType(value, index)
}

pub pure comptime fn object_value(value: Object, index: Integer) -> ?T where T {
    compiler_object_value(T, value, index)
}

pub pure comptime fn object_get(value: Object, key: Symbol) -> ?T where T {
    compiler_object_get(T, value, key)
}

pub pure comptime fn object_concat(left: Object, right: Object) -> Object {
    compiler_object_concat(left, right)
}

pub pure comptime fn object_append(object: Object, value: T, .key: ?Symbol = null) -> Object where T {
    compiler_object_append(T, object, key, value)
}

pub pure comptime fn object_replace(object: Object, index: Integer, value: T) -> Object where T {
    compiler_object_replace(T, object, index, value)
}

pub pure comptime fn object_remove(object: Object, index: Integer) -> Object {
    compiler_object_remove(object, index)
}

pub pure comptime fn object_slice(object: Object, start: Integer, end: Integer) -> Object {
    compiler_object_slice(object, start, end)
}

pub pure comptime fn struct_field_types(subject: Type) -> List<Type> {
    compiler_struct_field_types(subject)
}

pub pure comptime fn struct_field_names(subject: Type) -> List<Symbol> {
    compiler_struct_field_names(subject)
}

pub pure comptime fn enum_group_paths(subject: Type) -> List<List<Symbol>> {
    compiler_enum_group_paths(subject)
}

pub pure comptime fn enum_variant_paths(subject: Type) -> List<List<Symbol>> {
    compiler_enum_variant_paths(subject)
}

pub pure comptime fn enum_variant_shapes(subject: Type) -> List<Symbol> {
    compiler_enum_variant_shapes(subject)
}

pub pure comptime fn enum_variant_field_names(subject: Type) -> List<List<Symbol>> {
    compiler_enum_variant_field_names(subject)
}

pub pure comptime fn enum_variant_field_types(subject: Type) -> List<List<Type>> {
    compiler_enum_variant_field_types(subject)
}

pub const BuildStruct: comptime fn(Symbol, List<Symbol>, List<Type>) -> Type = CompilerBuildStruct;

pub comptime fn BuildEnum(name: Symbol, groups: List<List<Symbol>>,
    paths: List<List<Symbol>>, shapes: List<Symbol>,
    names: List<List<Symbol>>, types: List<List<Type>>) -> Type {
    CompilerBuildEnumPaths(name, groups, paths, shapes, names, types)
}

pub comptime fn BuildSymbolEnum(name: Symbol, groups: List<List<Symbol>>,
    paths: List<List<Symbol>>, shapes: List<Symbol>,
    names: List<List<Symbol>>, types: List<List<Type>>, codes: List<Symbol>) -> Type {
    CompilerBuildSymbolEnumPaths(name, groups, paths, shapes, names, types, codes)
}

pub comptime fn BuildBitsEnum(name: Symbol, groups: List<List<Symbol>>,
    paths: List<List<Symbol>>, shapes: List<Symbol>,
    names: List<List<Symbol>>, types: List<List<Type>>, width: Integer,
    base_type: ?Type, masks: List<Integer>, values: List<Integer>,
    offsets: List<List<Integer>>) -> Type {
    CompilerBuildBitsEnumPaths(name, groups, paths, shapes, names, types,
        width, base_type, masks, values, offsets)
}


pub pure comptime fn enum_symbol_values(subject: Type) -> List<Symbol> {
    compiler_enum_symbol_values(subject)
}

pub pure comptime fn enum_bit_width(subject: Type) -> Integer {
    compiler_enum_bit_width(subject)
}

pub pure comptime fn enum_bit_base_type(subject: Type) -> ?Type {
    compiler_enum_bit_base_type(subject)
}

pub pure comptime fn enum_bit_masks(subject: Type) -> List<Integer> {
    compiler_enum_bit_masks(subject)
}

pub pure comptime fn enum_bit_values(subject: Type) -> List<Integer> {
    compiler_enum_bit_values(subject)
}

pub pure comptime fn enum_bit_offsets(subject: Type) -> List<List<Integer>> {
    compiler_enum_bit_offsets(subject)
}


pub const BuildNewtype: comptime fn(Symbol, Type) -> Type = CompilerBuildNewtype;


pub pure comptime fn NewtypeRepresentation(subject: Type) -> Type {
    CompilerNewtypeRepresentation(subject)
}
