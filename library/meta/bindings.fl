use List;
use ast_impl.span.SourceSpan;
use builtin.{
    CallDescription,
    Integer,
    Symbol,
    Type,
    i8,
    i16,
    i32,
    i64,
    i128,
    isize,
    u8,
    u16,
    u32,
    u64,
    u128,
    usize,
}
use numeric.bindings.{
    integer_div_trunc as compiler_comptime_integer_div_trunc,
    integer_rem_trunc as compiler_comptime_integer_rem_trunc,
    isize_representation as compiler_isize_representation,
    usize_representation as compiler_usize_representation,
}

pub use types.bindings.Object;

const compiler_list_length: comptime fn(comptime T: Type, List<T>) -> Integer =
    .list_length'builtin;
pub const compiler_list_concat: comptime fn(comptime T: Type, List<T>, List<T>) -> List<T> =
    .list_concat'builtin;
const compiler_to_usize: comptime fn(Integer) -> usize = .comptime_integer_convert'builtin;
const compiler_from_usize: comptime fn(usize) -> Integer = .comptime_integer_convert'builtin;
const compiler_to_isize: comptime fn(Integer) -> isize = .comptime_integer_convert'builtin;
const compiler_from_isize: comptime fn(isize) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_u8: comptime fn(u8) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_u16: comptime fn(u16) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_u32: comptime fn(u32) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_u64: comptime fn(u64) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_u128: comptime fn(u128) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_i8: comptime fn(i8) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_i16: comptime fn(i16) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_i32: comptime fn(i32) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_i64: comptime fn(i64) -> Integer = .comptime_integer_convert'builtin;
const compiler_from_i128: comptime fn(i128) -> Integer = .comptime_integer_convert'builtin;
pub const compiler_object_length: comptime fn(Object) -> Integer = .object_length'builtin;
pub const compiler_object_key: comptime fn(Object, Integer) -> ?Symbol = .object_key'builtin;
pub const CompilerObjectEntryType: comptime fn(Object, Integer) -> Type =
    .object_entry_type'builtin;
pub const compiler_object_value: comptime fn(comptime T: Type, Object, Integer) -> ?T =
    .object_value'builtin;
pub const compiler_object_get: comptime fn(comptime T: Type, Object, Symbol) -> ?T =
    .object_get'builtin;
const compiler_object_concat: comptime fn(Object, Object) -> Object = .object_concat'builtin;
const compiler_object_append: comptime fn(comptime T: Type, Object, ?Symbol, T) -> Object =
    .object_append'builtin;
const compiler_object_replace: comptime fn(comptime T: Type, Object, Integer, T) -> Object =
    .object_replace'builtin;
const compiler_object_remove: comptime fn(Object, Integer) -> Object = .object_remove'builtin;
pub const compiler_object_slice: comptime fn(Object, Integer, Integer) -> Object =
    .object_slice'builtin;
const compiler_struct_field_types: comptime fn(Type) -> List<Type> = .struct_field_types'builtin;
const compiler_struct_field_names: comptime fn(Type) -> List<Symbol> = .struct_field_names'builtin;
const compiler_record_field_types: comptime fn(Type) -> List<Type> = .record_field_types'builtin;
const compiler_record_field_names: comptime fn(Type) -> List<Symbol> = .record_field_names'builtin;
const compiler_reflect_callable: comptime fn(Type) -> Object = .reflect_callable'builtin;
const compiler_type_id: comptime fn(Type) -> u128 = .type_id'builtin;
const compiler_enum_group_paths: comptime fn(Type) -> List<List<Symbol>> =
    .enum_group_paths'builtin;
const compiler_enum_variant_paths: comptime fn(Type) -> List<List<Symbol>> =
    .enum_variant_paths'builtin;
const compiler_enum_variant_shapes: comptime fn(Type) -> List<Symbol> =
    .enum_variant_shapes'builtin;
const compiler_enum_variant_field_names: comptime fn(Type) -> List<List<Symbol>> =
    .enum_variant_field_names'builtin;
const compiler_enum_variant_field_types: comptime fn(Type) -> List<List<Type>> =
    .enum_variant_field_types'builtin;
const compiler_enum_symbol_values: comptime fn(Type) -> List<Symbol> = .enum_symbol_values'builtin;
const compiler_enum_bit_width: comptime fn(Type) -> Integer = .enum_bit_width'builtin;
const compiler_enum_bit_base_type: comptime fn(Type) -> ?Type = .enum_bit_base_type'builtin;
const compiler_enum_bit_masks: comptime fn(Type) -> List<Integer> = .enum_bit_masks'builtin;
const compiler_enum_bit_values: comptime fn(Type) -> List<Integer> = .enum_bit_values'builtin;
const compiler_enum_bit_offsets: comptime fn(Type) -> List<List<Integer>> =
    .enum_bit_offsets'builtin;
const CompilerNewtypeRepresentation: comptime fn(Type) -> Type = .newtype_representation'builtin;
const CompilerBuildNewtype: comptime fn(Symbol, Type) -> Type = .build_newtype'builtin;
const CompilerBuildStruct: comptime fn(Symbol, List<Symbol>, List<Type>) -> Type =
    .build_struct'builtin;
const CompilerBuildEnumPaths: comptime fn(
    Symbol,
    List<List<Symbol>>,
    List<List<Symbol>>,
    List<Symbol>,
    List<List<Symbol>>,
    List<List<Type>>,
)
    -> Type =
    .build_enum_paths'builtin;
const CompilerBuildSymbolEnumPaths: comptime fn(
    Symbol,
    List<List<Symbol>>,
    List<List<Symbol>>,
    List<Symbol>,
    List<List<Symbol>>,
    List<List<Type>>,
    List<Symbol>,
)
    -> Type =
    .build_symbol_enum_paths'builtin;
const CompilerBuildBitsEnumPaths: comptime fn(
    Symbol,
    List<List<Symbol>>,
    List<List<Symbol>>,
    List<Symbol>,
    List<List<Symbol>>,
    List<List<Type>>,
    Integer,
    ?Type,
    List<Integer>,
    List<Integer>,
    List<List<Integer>>,
)
    -> Type =
    .build_bits_enum_paths'builtin;

{-
    Named compiler-operation bindings for comptime data and definitions.
    Library algorithms use these ordinary functions; raw compiler symbols stay
    at this boundary. Type parameters retain the List normal-form identity.
-}
pub pure comptime fn list_length(values: List<T>) -> Integer where T {
    compiler_list_length(T, values)
}

pub pure comptime fn list_concat(left: List<T>, right: List<T>) -> List<T> where T {
    compiler_list_concat(T, left, right)
}

pub pure comptime fn to_usize(value: Integer) -> usize {
    compiler_to_usize(value)
}

pub pure comptime fn from_usize(value: usize) -> Integer {
    compiler_from_usize(value)
}

pub pure comptime fn to_isize(value: Integer) -> isize {
    compiler_to_isize(value)
}

pub pure comptime fn from_isize(value: isize) -> Integer {
    compiler_from_isize(value)
}

pub pure comptime fn from_u8(value: u8) -> Integer {
    compiler_from_u8(value)
}

pub pure comptime fn from_u16(value: u16) -> Integer {
    compiler_from_u16(value)
}

pub pure comptime fn from_u32(value: u32) -> Integer {
    compiler_from_u32(value)
}

pub pure comptime fn from_u64(value: u64) -> Integer {
    compiler_from_u64(value)
}

pub pure comptime fn from_u128(value: u128) -> Integer {
    compiler_from_u128(value)
}

pub pure comptime fn from_i8(value: i8) -> Integer {
    compiler_from_i8(value)
}

pub pure comptime fn from_i16(value: i16) -> Integer {
    compiler_from_i16(value)
}

pub pure comptime fn from_i32(value: i32) -> Integer {
    compiler_from_i32(value)
}

pub pure comptime fn from_i64(value: i64) -> Integer {
    compiler_from_i64(value)
}

pub pure comptime fn from_i128(value: i128) -> Integer {
    compiler_from_i128(value)
}

pub const div_trunc: comptime fn(Integer, Integer) -> Integer = compiler_comptime_integer_div_trunc;

pub const rem_trunc: comptime fn(Integer, Integer) -> Integer = compiler_comptime_integer_rem_trunc;

pub pure comptime fn usize_representation(value: usize) -> u128 {
    compiler_usize_representation(value)
}

pub pure comptime fn isize_representation(value: isize) -> u128 {
    compiler_isize_representation(value)
}

pub pure comptime fn object_length(value: Object) -> Integer {
    compiler_object_length(value)
}

pub pure comptime fn object_key(value: Object, index: Integer) -> ?Symbol {
    compiler_object_key(value, index)
}

pub pure comptime fn ObjectEntryType(value: Object, index: Integer) -> Type {
    CompilerObjectEntryType(value, index)
}

pub pure comptime fn object_value(value: Object, index: Integer) -> ?T where T {
    compiler_object_value(T, value, index)
}

pub pure comptime fn object_get(value: Object, key: Symbol) -> ?T where T {
    compiler_object_get(T, value, key)
}

pub pure comptime fn object_concat(left: Object, right: Object) -> Object {
    compiler_object_concat(left, right)
}

pub pure comptime fn object_append(
    object: Object,
    value: T,
    .key: ?Symbol = null,
) -> Object where T {
    compiler_object_append(T, object, key, value)
}

pub pure comptime fn object_replace(object: Object, index: Integer, value: T) -> Object where T {
    compiler_object_replace(T, object, index, value)
}

pub pure comptime fn object_remove(object: Object, index: Integer) -> Object {
    compiler_object_remove(object, index)
}

pub pure comptime fn object_slice(object: Object, start: Integer, end: Integer) -> Object {
    compiler_object_slice(object, start, end)
}

pub pure comptime fn struct_field_types(subject: Type) -> List<Type> {
    compiler_struct_field_types(subject)
}

pub pure comptime fn struct_field_names(subject: Type) -> List<Symbol> {
    compiler_struct_field_names(subject)
}

pub pure comptime fn record_field_types(subject: Type) -> List<Type> {
    compiler_record_field_types(subject)
}

pub pure comptime fn record_field_names(subject: Type) -> List<Symbol> {
    compiler_record_field_names(subject)
}

pub pure comptime fn reflect_callable_object(subject: Type) -> Object {
    compiler_reflect_callable(subject)
}

pub pure comptime fn type_id(subject: Type) -> u128 {
    compiler_type_id(subject)
}

pub pure comptime fn enum_group_paths(subject: Type) -> List<List<Symbol>> {
    compiler_enum_group_paths(subject)
}

pub pure comptime fn enum_variant_paths(subject: Type) -> List<List<Symbol>> {
    compiler_enum_variant_paths(subject)
}

pub pure comptime fn enum_variant_shapes(subject: Type) -> List<Symbol> {
    compiler_enum_variant_shapes(subject)
}

pub pure comptime fn enum_variant_field_names(subject: Type) -> List<List<Symbol>> {
    compiler_enum_variant_field_names(subject)
}

pub pure comptime fn enum_variant_field_types(subject: Type) -> List<List<Type>> {
    compiler_enum_variant_field_types(subject)
}

pub const BuildStruct: comptime fn(Symbol, List<Symbol>, List<Type>) -> Type = CompilerBuildStruct;

pub comptime fn BuildEnum(
    name: Symbol,
    groups: List<List<Symbol>>,
    paths: List<List<Symbol>>,
    shapes: List<Symbol>,
    names: List<List<Symbol>>,
    types: List<List<Type>>,
) -> Type {
    CompilerBuildEnumPaths(name, groups, paths, shapes, names, types)
}

pub comptime fn BuildSymbolEnum(
    name: Symbol,
    groups: List<List<Symbol>>,
    paths: List<List<Symbol>>,
    shapes: List<Symbol>,
    names: List<List<Symbol>>,
    types: List<List<Type>>,
    codes: List<Symbol>,
) -> Type {
    CompilerBuildSymbolEnumPaths(name, groups, paths, shapes, names, types, codes)
}

pub comptime fn BuildBitsEnum(
    name: Symbol,
    groups: List<List<Symbol>>,
    paths: List<List<Symbol>>,
    shapes: List<Symbol>,
    names: List<List<Symbol>>,
    types: List<List<Type>>,
    width: Integer,
    base_type: ?Type,
    masks: List<Integer>,
    values: List<Integer>,
    offsets: List<List<Integer>>,
) -> Type {
    CompilerBuildBitsEnumPaths(
        name,
        groups,
        paths,
        shapes,
        names,
        types,
        width,
        base_type,
        masks,
        values,
        offsets,
    )
}

pub pure comptime fn enum_symbol_values(subject: Type) -> List<Symbol> {
    compiler_enum_symbol_values(subject)
}

pub pure comptime fn enum_bit_width(subject: Type) -> Integer {
    compiler_enum_bit_width(subject)
}

pub pure comptime fn enum_bit_base_type(subject: Type) -> ?Type {
    compiler_enum_bit_base_type(subject)
}

pub pure comptime fn enum_bit_masks(subject: Type) -> List<Integer> {
    compiler_enum_bit_masks(subject)
}

pub pure comptime fn enum_bit_values(subject: Type) -> List<Integer> {
    compiler_enum_bit_values(subject)
}

pub pure comptime fn enum_bit_offsets(subject: Type) -> List<List<Integer>> {
    compiler_enum_bit_offsets(subject)
}

pub const BuildNewtype: comptime fn(Symbol, Type) -> Type = CompilerBuildNewtype;

pub pure comptime fn NewtypeRepresentation(subject: Type) -> Type {
    CompilerNewtypeRepresentation(subject)
}

const compiler_implicit_src: comptime fn(CallDescription) -> SourceSpan = .implicit_src'builtin;
const compiler_struct_field_spans: comptime fn(Type) -> List<SourceSpan> =
    .struct_field_spans'builtin;
const compiler_record_field_spans: comptime fn(Type) -> List<SourceSpan> =
    .record_field_spans'builtin;
const compiler_declaration_span: comptime fn(Type) -> SourceSpan = .declaration_span'builtin;
const compiler_enum_variant_spans: comptime fn(Type) -> List<SourceSpan> =
    .enum_variant_spans'builtin;
const compiler_enum_variant_field_spans: comptime fn(Type) -> List<List<SourceSpan>> =
    .enum_variant_field_spans'builtin;

pub pure comptime fn implicit_src(calling: CallDescription) -> SourceSpan {
    compiler_implicit_src(calling)
}

pub pure comptime fn struct_field_spans(subject: Type) -> List<SourceSpan> {
    compiler_struct_field_spans(subject)
}

pub pure comptime fn record_field_spans(subject: Type) -> List<SourceSpan> {
    compiler_record_field_spans(subject)
}

pub pure comptime fn declaration_span(subject: Type) -> SourceSpan {
    compiler_declaration_span(subject)
}

pub pure comptime fn enum_variant_spans(subject: Type) -> List<SourceSpan> {
    compiler_enum_variant_spans(subject)
}

pub pure comptime fn enum_variant_field_spans(subject: Type) -> List<List<SourceSpan>> {
    compiler_enum_variant_field_spans(subject)
}

pub pure comptime fn FieldType(comptime S: Type, comptime name: Symbol) -> Type
where
    requires Type.predicates.has_field(S, name),
{
    .struct_field_type'builtin(S, name)
}

pub pure comptime fn VariantFieldType(
    comptime E: Type,
    comptime v: usize,
    comptime f: usize,
) -> Type {
    .variant_field_type'builtin(E, v, f)
}

pub pure comptime fn TupleAppend(comptime T: Type, comptime E: Type) -> Type {
    .tuple_append_type'builtin(T, E)
}

pub pure fn field_ptr(
    ptr: *S,
    comptime name: Symbol,
) -> *FieldType(S, name)
where
    S: Type,
    requires Type.predicates.has_field(S, name),
{
    .field_ptr'builtin(ptr, name)
}

pub pure comptime fn field_value(
    value: S,
    comptime name: Symbol,
) -> FieldType(S, name)
where
    S: Type,
    requires Type.predicates.has_field(S, name),
{
    .field_value'builtin(value, name)
}

pub fn tuple_append(tuple: T, element: E) -> TupleAppend(T, E)
where
    T: Type,
    E: Type,
{
    .tuple_append'builtin(tuple, element)
}

pub pure comptime fn comptime_tuple_append(tuple: T, element: E) -> TupleAppend(T, E)
where
    T: Type,
    E: Type,
{
    .tuple_append'builtin(tuple, element)
}

pub fn construct_struct(comptime S: Type, fields: F) -> S
where
    F: Type,
{
    .construct_struct'builtin(S, fields)
}

pub pure comptime fn comptime_construct_struct(comptime S: Type, fields: F) -> S
where
    F: Type,
{
    .construct_struct'builtin(S, fields)
}

pub fn enum_variant_index(ptr: *E) -> usize
where
    E: Type,
{
    .enum_variant_index'builtin(ptr)
}

pub fn enum_variant_field_ptr(
    comptime E: Type,
    ptr: *E,
    comptime v: usize,
    comptime f: usize,
) -> ?*VariantFieldType(E, v, f) {
    .enum_variant_field_ptr'builtin(E, ptr, v, f)
}

pub fn construct_enum(comptime E: Type, comptime v: usize, fields: F) -> E
where
    F: Type,
{
    .construct_enum'builtin(E, v, fields)
}

pub pure comptime fn comptime_construct_enum(comptime E: Type, comptime v: usize, fields: F) -> E
where
    F: Type,
{
    .construct_enum'builtin(E, v, fields)
}

pub pure comptime fn comptime_enum_variant_index(value: E) -> Integer
where
    E: Type,
{
    .comptime_enum_variant_index'builtin(value)
}

pub pure comptime fn comptime_enum_variant_field_values(value: E) -> Object
where
    E: Type,
{
    .comptime_enum_variant_field_values'builtin(value)
}

pub pure comptime fn comptime_field_entry(
    value: S,
    name: Symbol,
    field_ty: Type,
) -> Object
where
    S: Type,
{
    .comptime_field_entry'builtin(value, name, field_ty)
}
