use List;
use builtin.{
    Float,
    Integer,
    Type,
    bf16,
    bool,
    f16,
    f32,
    f64,
    str,
    void,
}
use data.text.ComptimeTextBytes;

{- Comptime operator protocol companions for meta.ops.
   All comptime operator traits use value-reference `self` semantics with no pointers. -}

pub pure comptime trait ComptimeAdd
where
    .Rhs: Type = Self,
{
    assoc Output: Type;

    pure comptime fn add(self, rhs: Rhs) -> Output;
}

pub pure comptime trait ComptimeSub
where
    .Rhs: Type = Self,
{
    assoc Output: Type;

    pure comptime fn sub(self, rhs: Rhs) -> Output;
}

pub pure comptime trait ComptimeMul
where
    .Rhs: Type = Self,
{
    assoc Output: Type;

    pure comptime fn mul(self, rhs: Rhs) -> Output;
}

pub pure comptime trait ComptimeDiv
where
    .Rhs: Type = Self,
{
    assoc Output: Type;

    pure comptime fn div(self, rhs: Rhs) -> Output;
}

pub pure comptime trait ComptimeRem
where
    .Rhs: Type = Self,
{
    assoc Output: Type;

    pure comptime fn rem(self, rhs: Rhs) -> Output;
}

pub pure comptime trait ComptimeNeg {
    assoc Output: Type;

    pure comptime fn neg(self) -> Output;
}

pub pure comptime trait ComptimeNot {
    assoc Output: Type;

    pure comptime fn invert(self) -> Output;
}

pub pure comptime trait ComptimeImplies
where
    .Rhs: Type = Self,
{
    assoc Output: Type;

    pure comptime fn implies(self, rhs: Rhs) -> Output;
}

pub pure comptime trait ComptimeAddAssign
where
    .Rhs: Type = Self,
{
    comptime fn add_assign(self, rhs: Rhs) -> void;
}

pub pure comptime trait ComptimeSubAssign
where
    .Rhs: Type = Self,
{
    comptime fn sub_assign(self, rhs: Rhs) -> void;
}

pub pure comptime trait ComptimeMulAssign
where
    .Rhs: Type = Self,
{
    comptime fn mul_assign(self, rhs: Rhs) -> void;
}

pub pure comptime trait ComptimeDivAssign
where
    .Rhs: Type = Self,
{
    comptime fn div_assign(self, rhs: Rhs) -> void;
}

pub pure comptime trait ComptimeRemAssign
where
    .Rhs: Type = Self,
{
    comptime fn rem_assign(self, rhs: Rhs) -> void;
}

pub pure comptime trait ComptimeConcat
where
    .Rhs: Type = Self,
{
    assoc Output: Type;

    pure comptime fn concat(self, rhs: Rhs) -> Output;
}

pub pure comptime trait ComptimeIndex
where
    Idx: Type,
{
    assoc Output: Type;

    comptime fn index(self, idx: Idx) -> Output;
}

comptime impl ComptimeConcat<.Rhs = str> for str {
    assoc Output: Type = str;

    pure comptime fn concat(self, rhs: str) -> str {
        self.as(ComptimeTextBytes).concat(rhs)
    }
}

comptime impl ComptimeConcat<.Rhs = List<T>> for List<T> where T: Type {
    assoc Output: Type = List<T>;

    pure comptime fn concat(self, rhs: List<T>) -> List<T> {
        List<T>.concat(self, rhs)
    }
}

-- ── Standard Comptime Primitive Implementations ─────────────────────────────

comptime impl ComptimeNot for bool {
    assoc Output: Type = bool;

    pure comptime fn invert(self) -> bool {
        not self
    }
}

comptime impl ComptimeAdd for Integer {
    assoc Output: Type = Integer;

    pure comptime fn add(self, rhs: Integer) -> Integer {
        self + rhs
    }
}

comptime impl ComptimeSub for Integer {
    assoc Output: Type = Integer;

    pure comptime fn sub(self, rhs: Integer) -> Integer {
        self - rhs
    }
}

comptime impl ComptimeMul for Integer {
    assoc Output: Type = Integer;

    pure comptime fn mul(self, rhs: Integer) -> Integer {
        self * rhs
    }
}

comptime impl ComptimeNeg for Integer {
    assoc Output: Type = Integer;

    pure comptime fn neg(self) -> Integer {
        -self
    }
}

