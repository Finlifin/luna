use bindings;
use builtin.{Integer, Symbol, Type};

use List;
use bindings.Object;
use definitions.fields.FieldDescription;

{-
  Private construction data for a concrete struct. Fields retain their supplied
  Type identities and declaration order. Build validates and publishes through
  the compiler's checked definition service; drafts are not observable Types.
-}
pub struct StructBuilder {
    name: Symbol,
    field_names: List<Symbol>,
    field_types: List<Type>,
}

impl StructBuilder {
    pub comptime fn new(.name: Symbol = .Generated) -> Self {
        Self { name: name, field_names: [], field_types: [] }
    }

    pub comptime fn from_type(subject: Type, .name: Symbol = .Generated) -> Self {
        Self {
            name: name,
            field_names: subject.struct_field_names(),
            field_types: subject.struct_field_types(),
        }
    }

    {-
        A field description is an ordered Object of named Type values.
        Positional entries or other value domains reject the entire input.
        Duplicate field names remain visible to checked publication at Build.
    -}
    pub comptime fn from_object(fields: Object, .name: Symbol = .Generated) -> ?Self {
        let draft = Self.new(.name = name);
        if draft.add_fields_from_object(fields) { draft } else { null }
    }

    pub comptime fn add_fields_from_object(self, fields: Object) -> bool {
        let end = self.field_names.length();
        self.replace_fields_from_object(end, end, fields)
    }

    {- Parse the complete ordered description before editing either field list.
       Invalid descriptions or ranges preserve the draft and saved snapshots.
    -}
    pub comptime fn insert_fields_from_object(self, index: Integer,
        fields: Object) -> bool {
        self.replace_fields_from_object(index, index, fields)
    }

    pub comptime fn replace_fields_from_object(self, start: Integer, end: Integer,
        fields: Object) -> bool {
        let description = FieldDescription.from_object(fields) match {
            value? => value,
            null => return false,
        };
        self.replace_fields(start, end, description.names, description.types)
    }

    pub comptime fn add_field(self, name: Symbol, field_type: Type) {
        self.field_names.append(name);
        self.field_types.append(field_type);
    }

    {-
        Batch operations keep reflected names and Types aligned. A mismatched
        input or invalid range leaves the draft unchanged; publication still
        validates field names and storage Types.
    -}
    pub comptime fn add_fields(self, names: List<Symbol>, types: List<Type>) -> bool {
        let end = self.field_names.length();
        self.replace_fields(end, end, names, types)
    }

    pub comptime fn replace_fields(self, start: Integer, end: Integer,
        names: List<Symbol>, types: List<Type>) -> bool {
        if names.length() != types.length() { return false; };
        self.edit_fields(start, end, names, types)
    }

    {-
        Edit by declaration-order index. Invalid bounds leave both snapshots
        unchanged. Names and Types are prepared together before either write;
        Build remains responsible for duplicate names and layout admission.
    -}
    pub comptime fn insert_field(self, index: Integer,
        name: Symbol, field_type: Type) -> bool {
        self.edit_fields(index, index, [name], [field_type])
    }

    pub comptime fn replace_field(self, index: Integer,
        name: Symbol, field_type: Type) -> bool {
        self.edit_fields(index, index + 1, [name], [field_type])
    }

    pub comptime fn remove_field(self, index: Integer) -> bool {
        self.edit_fields(index, index + 1, [], [])
    }

    comptime fn edit_fields(self, start: Integer, end: Integer,
        names: List<Symbol>, types: List<Type>) -> bool {
        let next_names = self.field_names.replace_range(start, end, names) match {
            value? => value,
            null => return false,
        };
        let next_types = self.field_types.replace_range(start, end, types) match {
            value? => value,
            null => return false,
        };
        self.field_names = next_names;
        self.field_types = next_types;
        true
    }

    pub comptime fn Build(self) -> Type {
        bindings.BuildStruct(self.name, self.field_names, self.field_types)
    }
}
