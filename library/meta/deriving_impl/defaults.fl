use builtin.{Symbol, Type};
use data.object.Object;
use numeric.conversions.ComptimeDefault;
use reflection_impl.structure.struct_field_names;
use structs_impl as structs;

^{__flurry_derivation_default: true}
pub derive fn by_fields for ComptimeDefault
where
    requires Type.predicates.is_struct(Self),
{
    pure comptime fn default() -> Self {
        const NAMES = struct_field_names(Self);
        var acc: Object = {}
        inline for i in 0..NAMES.length() {
            const sym: Symbol = NAMES[i];
            inline if Type.predicates.has_field(Self, sym) {
                const fty = structs.FieldType(Self, sym);
                let val = fty.as(ComptimeDefault).default();
                acc = acc.append<fty>(val, .key = sym);
            }
        }
        structs.comptime_construct_struct(Self, acc)
    }
}
