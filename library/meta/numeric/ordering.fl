comptime impl ComptimeOrd for Integer {
    comptime fn cmp(self, other: Self) -> Order {
        if self < other { .less } else if self == other { .equal } else { .greater }
    }
}

comptime impl ComptimeOrd for char {
    comptime fn cmp(self, other: Self) -> Order {
        if self < other { .less } else if self == other { .equal } else { .greater }
    }
}

comptime impl ComptimeOrd for bool {
    comptime fn cmp(self, other: Self) -> Order {
        if self == other { .equal } else if self { .greater } else { .less }
    }
}

{-
    Text and symbols share lexicographic UTF-8 byte order. The callbacks retain
    their ordinary comptime identities; no host string ordering is substituted.
-}
comptime fn compare_bytes(left: T, right: T,
    length: comptime fn(T) -> u64,
    byte: comptime fn(T, u64) -> ?u8) -> Order
where T
{
    let left_length = length(left);
    let right_length = length(right);
    let count = if left_length < right_length { left_length } else { right_length };
    var index: u64 = 0;
    while index < count {
        let left_byte = byte(left, index);
        let right_byte = byte(right, index);
        left_byte match {
            a? => right_byte match {
                b? => {
                    if a < b { return .less; };
                    if a > b { return .greater; };
                },
                null => { assumes false; },
            },
            null => { assumes false; },
        };
        index = index + 1;
    };
    if left_length < right_length { .less }
    else if left_length == right_length { .equal }
    else { .greater }
}

comptime impl ComptimeOrd for str {
    comptime fn cmp(self, other: Self) -> Order {
        compare_bytes(self, other, bindings.byte_length, bindings.byte)
    }
}

comptime impl ComptimeOrd for Symbol {
    comptime fn cmp(self, other: Self) -> Order {
        compare_bytes(self, other, bindings.symbol_byte_length, bindings.symbol_byte)
    }
}
