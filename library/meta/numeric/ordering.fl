use builtin.{Order, Integer, bool, char, str, Symbol, u8, u16, u32, u64, u128,
    i8, i16, i32, i64, i128, usize, isize};
use equality.ComptimeEq;
use text_impl.bindings;

{-
    Total ordering has a separate comptime protocol. It shares Order with the
    runtime interface, while method discovery prefers this trait at comptime.
    Floating-point values are excluded because ordinary NaN comparison is not
    a total order.
-}
pub pure comptime trait ComptimeOrd :- ComptimeEq {
    comptime fn cmp(self, other: Self) -> Order;
    comptime fn lt(self, other: Self) -> bool = self.cmp(other) match {
        .less => true,
        _ => false,
    };
    comptime fn le(self, other: Self) -> bool = self.cmp(other) match {
        .greater => false,
        _ => true,
    };
    comptime fn gt(self, other: Self) -> bool = self.cmp(other) match {
        .greater => true,
        _ => false,
    };
    comptime fn ge(self, other: Self) -> bool = self.cmp(other) match {
        .less => false,
        _ => true,
    };
}

comptime impl ComptimeOrd for u8 {
    comptime fn cmp(self, other: Self) -> Order {
        if self < other { .less } else if self == other { .equal } else { .greater }
    }
}

comptime impl ComptimeOrd for u16 {
    comptime fn cmp(self, other: Self) -> Order {
        if self < other { .less } else if self == other { .equal } else { .greater }
    }
}

