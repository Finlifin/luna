comptime impl ComptimeTryFrom<i8> for u8 {
    assoc Err: Type = ConversionErr;

    pure comptime fn try_from(source: i8) -> !ConversionErr Self {
        bindings.try_i8_to_u8(source) match {
            value? => value,
            null => if source < 0 { return error ConversionErr.Underflow; } else { return error ConversionErr.Overflow; },
        }
    }
}

comptime impl ComptimeTryFrom<i16> for u8 {
    assoc Err: Type = ConversionErr;

