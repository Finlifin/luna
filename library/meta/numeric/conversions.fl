use builtin.{i128, i16, i32, i64, i8, isize, u128, u16, u32, u64, u8, usize}
use numeric.bindings;

-- Checked machine-integer conversions for comptime contexts.
pub pure comptime trait ComptimeTryInto where Target {
    pure comptime fn try_into(self) -> ?Target;
}

pub pure comptime trait ComptimeTryFrom where Source {
    pure comptime fn try_from(source: Source) -> ?Self;
}

comptime impl ComptimeTryInto<Target> for Source where Source, Target :- ComptimeTryFrom<Source> {
    pure comptime fn try_into(self) -> ?Target {
        Target.as(ComptimeTryFrom<Source>).try_from(self)
    }
}

comptime impl ComptimeTryFrom<u8> for u8 {
    pure comptime fn try_from(source: u8) -> ?Self {
        source
    }
}

comptime impl ComptimeTryFrom<u16> for u8 {
    pure comptime fn try_from(source: u16) -> ?Self {
        bindings.try_u16_to_u8(source)
    }
}

comptime impl ComptimeTryFrom<u32> for u8 {
    pure comptime fn try_from(source: u32) -> ?Self {
        bindings.try_u32_to_u8(source)
    }
}

comptime impl ComptimeTryFrom<u64> for u8 {
    pure comptime fn try_from(source: u64) -> ?Self {
