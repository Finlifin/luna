use builtin.{
    ConversionErr,
    InfallibleErr,
    Type,
    bool,
    char,
    i128,
    i16,
    i32,
    i64,
    i8,
    isize,
    u128,
    u16,
    u32,
    u64,
    u8,
    usize,
}
use numeric.bindings;

-- Checked and infallible conversions for comptime contexts.
pub pure comptime trait ComptimeFrom where Source {
    pure comptime fn from(source: Source) -> Self;
}

pub pure comptime trait ComptimeInto where Target {
    pure comptime fn into(self) -> Target;
}

pub pure comptime trait ComptimeTryInto where Target {
    assoc Err: Type;

    pure comptime fn try_into(self) -> !Err Target;
}

pub pure comptime trait ComptimeTryFrom where Source {
    assoc Err: Type;

    pure comptime fn try_from(source: Source) -> !Err Self;
}

pub pure comptime trait ComptimeDefault {
    pure comptime fn default() -> Self;
}

comptime impl ComptimeFrom<T> for T where T {
    pure comptime fn from(source: T) -> Self {
        source
    }
}

comptime impl ComptimeInto<Target> for Source
where
    Source,
    Target,
    requires Target :- ComptimeFrom<Source>,
{
    pure comptime fn into(self) -> Target {
        Target.as(ComptimeFrom<Source>).from(self)
    }
}

comptime impl ComptimeTryFrom<Source> for Target
where
    Source,
    Target,
    requires Source :- ComptimeInto<Target>,
{
    assoc Err: Type = InfallibleErr;

    pure comptime fn try_from(source: Source) -> !InfallibleErr Self {
        source.as(ComptimeInto<Target>).into()
    }
}

comptime impl ComptimeTryInto<Target> for Source
where
    Source,
    Target,
    requires Target :- ComptimeTryFrom<Source>,
{
    assoc Err: Type = Target.as(ComptimeTryFrom<Source>).Err;

    pure comptime fn try_into(self) -> !Err Target {
        Target.as(ComptimeTryFrom<Source>).try_from(self)
    }
}

comptime impl ComptimeFrom<bool> for u8 {
    pure comptime fn from(source: bool) -> Self {
        if source { 1 } else { 0 }
    }
}

comptime impl ComptimeFrom<char> for u32 {
    pure comptime fn from(source: char) -> Self {
        source'bitvec.as(u32)
    }
}

comptime impl ComptimeTryFrom<u16> for u8 {
    assoc Err: Type = ConversionErr;

    pure comptime fn try_from(source: u16) -> !ConversionErr Self {
        bindings.try_u16_to_u8(source) match {
            value? => value,
            null => return error ConversionErr.Overflow,
        }
    }
}

comptime impl ComptimeTryFrom<u32> for u8 {
    assoc Err: Type = ConversionErr;

    pure comptime fn try_from(source: u32) -> !ConversionErr Self {
        bindings.try_u32_to_u8(source) match {
            value? => value,
            null => return error ConversionErr.Overflow,
        }
    }
}

