use bindings;
use builtin.{Integer, Type};

use List;
use integer.div_trunc;

impl List<T> where T {
    {-
      Immutable list operations execute at comptime. Concatenation preserves the
      element domain and order, including empty lists and nested List values.
    -}
    pub pure comptime fn length(self) -> Integer {
        bindings.list_length(self)
    }

    pub pure comptime fn concat(self, right: List<T>) -> List<T> {
        bindings.list_concat(self, right)
    }

    {-
      Replace a list slot with its old contents followed by one value. Existing
      snapshots remain independent. The VM may reuse the slot's owned buffer;
      element admission and representation limits still apply before completion.
    -}
    pub comptime fn append(*self, value: T) {
        self.* = bindings.list_concat(self.*, [value]);
    }

    {-
      Traverse a fixed input snapshot in index order. The callback retains its
      comptime closure environment between calls; an empty input never calls it.
      Cache the length once, independently of callback effects.
    -}
    pub comptime fn foreach(self, visit: %c comptime fn(T))
    where c: Type.vars.Closure
    {
        let count = self.length();
        inline for index in 0..count {
            visit(self[index]);
        }
    }

    pub comptime fn fold(self, initial: A, combine: %c comptime fn(A, T) -> A) -> A
    where A, c: Type.vars.Closure
    {
        let count = self.length();
        var accumulator = initial;
        inline for index in 0..count {
            accumulator = combine(accumulator, self[index]);
        }
        accumulator
    }

    {-
      Seed from the first element without invoking combine. Later elements visit
      the callback once in order; empty input has no accumulator. An optional
      element remains present even when its payload is null.
    -}
    pub comptime fn reduce(self, combine: %c comptime fn(T, T) -> T) -> ?T
    where c: Type.vars.Closure
    {
        let count = self.length();
        if count == 0 { return null; }
        var accumulator = self[0];
        inline for index in 1..count {
            accumulator = combine(accumulator, self[index]);
        }
        accumulator
    }

    {-
      Mapping preserves order and calls transform exactly once per input element.
      Append through the output slot to permit buffer reuse. Full immutable data
      validation is still required; this is not yet a linear-time builder.
    -}
    pub comptime fn map(self, transform: %c comptime fn(T) -> U) -> List<U>
    where U, c: Type.vars.Closure
    {
        let count = self.length();
        var output: List<U> = [];
        inline for index in 0..count {
            output.append(transform(self[index]));
        }
        output
    }

    {-
      Transform each input once in order. filter_map discards only the outer null;
      flat_map appends every inner list in order, including empty inner results.
      Both retain the input snapshot when callbacks replace the caller's list.
    -}
    pub comptime fn filter_map(self, transform: %c comptime fn(T) -> ?U) -> List<U>
    where U, c: Type.vars.Closure
    {
        let count = self.length();
        var output: List<U> = [];
        inline for index in 0..count {
            transform(self[index]) match {
                value? => output.append(value),
                null => {},
            };
        }
        output
    }

    pub comptime fn flat_map(self, transform: %c comptime fn(T) -> List<U>) -> List<U>
    where U, c: Type.vars.Closure
    {
        let count = self.length();
        var output: List<U> = [];
        inline for index in 0..count {
            let inner = transform(self[index]);
            output = output.concat(inner);
        }
        output
    }

    {-
      Queries visit a fixed snapshot in order and stop as soon as the answer is
      known. Empty inputs satisfy all and fail any; find returns an absent outer
      optional. A matching optional element retains its own presence layer.
    -}
    pub comptime fn any(self, pred: %c comptime fn(T) -> bool) -> bool
    where c: Type.vars.Closure
    {
        let count = self.length();
        inline for index in 0..count {
            if pred(self[index]) { return true; }
        }
        false
    }

    pub comptime fn all(self, pred: %c comptime fn(T) -> bool) -> bool
    where c: Type.vars.Closure
    {
        let count = self.length();
        inline for index in 0..count {
            if not pred(self[index]) { return false; }
        }
        true
    }

    pub comptime fn find(self, pred: %c comptime fn(T) -> bool) -> ?T
    where c: Type.vars.Closure
    {
        let count = self.length();
        inline for index in 0..count {
            let value = self[index];
            if pred(value) { return value; }
        }
        null
    }

    {- Stop at the first present transformed result, preserving inner nulls. -}
    pub comptime fn find_map(self, transform: %c comptime fn(T) -> ?U) -> ?U
    where U, c: Type.vars.Closure
    {
        let count = self.length();
        inline for index in 0..count {
            transform(self[index]) match {
                value? => { return value; },
                null => {},
            };
        }
        null
    }

    {-
      Filtering preserves retained elements and their order. Like map, it reuses
      the output slot while retaining the full immutable validation checks.
    -}
    pub comptime fn filter(self, pred: %c comptime fn(T) -> bool) -> List<T>
    where c: Type.vars.Closure
    {
        let count = self.length();
        var output: List<T> = [];
        inline for index in 0..count {
            let value = self[index];
            if pred(value) {
                output.append(value);
            }
        }
        output
    }

    {-
      Select a half-open interval [start, end). Bounds are exact comptime Integers;
      invalid bounds return null, while a valid empty interval returns a present
      empty list. Elements retain their domains and the input remains unchanged.
    -}
    pub comptime fn slice(self, start: Integer, end: Integer)
        -> ?List<T> {
        let count = self.length();
        if start < 0 or end < start or end > count { return null; }
        var output: List<T> = [];
        append_range(output.ref, self, start, end);
        output
    }

    {-
      Replace [start, end) with a list of the same element domain. Empty intervals
      insert; empty replacements remove. All inputs are ordinary once-evaluated
      arguments. Invalid bounds return null without constructing an output list.
    -}
    pub comptime fn replace_range(self, start: Integer,
        end: Integer, replacement: List<T>) -> ?List<T> {
        let count = self.length();
        if start < 0 or end < start or end > count { return null; }
        var output: List<T> = [];
        append_range(output.ref, self, 0, start);
        append_range(output.ref, replacement, 0, replacement.length());
        append_range(output.ref, self, end, count);
        output
    }

    {-
        Stable ascending merge sort. less(a, b) describes a strict ordering; equal
        items retain input order. Each comparison receives the right candidate
        first: only a strict right-before-left result displaces the left item.
        Input snapshots remain unchanged, including when a callback fails.
    -}
    pub comptime fn sort_by(self, less: %c comptime fn(T, T) -> bool) -> List<T>
        where c: Type.vars.Closure
    {
        let count = self.length();
        var ordered = self;
        var width: Integer = 1;
        while width < count {
            var output: List<T> = [];
            var start: Integer = 0;
            while start < count {
                let middle = if start + width < count {start + width} else {count};
                let end = if middle + width < count {middle + width} else {count};
                var left = start;
                var right = middle;
                while left < middle and right < end {
                    if less(ordered[right], ordered[left]) {
                        output.append(ordered[right]);
                        right = right + 1;
                    } else {
                        output.append(ordered[left]);
                        left = left + 1;
                    }
                }
                append_range(output.ref, ordered, left, middle);
                append_range(output.ref, ordered, right, end);
                start = end;
            }
            ordered = output;
            width = width * 2;
        }
        ordered
    }

    {-
        Find the first false item in a true-prefix/false-suffix partition. The
        caller supplies this monotonic predicate contract; the search does not
        scan the list to verify it. Empty input returns zero without invoking pred.
        Bounds and the result are exact Integers, independent of target width.
    -}
    pub comptime fn partition_point(self, pred: %c comptime fn(T) -> bool)
        -> Integer where c: Type.vars.Closure
    {
        var first: Integer = 0;
        var last = self.length();
        while first < last {
            let middle = first + div_trunc(last - first, 2);
            if pred(self[middle]) {
                first = middle + 1;
            } else {
                last = middle;
            }
        }
        first
    }

    {-
        On a list sorted by less, lower_bound selects the first item not less than
        needle; upper_bound selects the first item strictly greater than needle.
        Equal items occupy [lower_bound, upper_bound). Missing items yield an
        insertion position, including self.length() after the final item.
    -}
    pub comptime fn lower_bound(self, needle: T,
        less: %c comptime fn(T, T) -> bool) -> Integer
        where c: Type.vars.Closure
    {
        self.partition_point(|value| less(value, needle))
    }

    pub comptime fn upper_bound(self, needle: T,
        less: %c comptime fn(T, T) -> bool) -> Integer
        where c: Type.vars.Closure
    {
        self.partition_point(|value| not less(needle, value))
    }

}

-- Internal traversal; callers establish the half-open interval bounds first.
comptime fn append_range(target: *List<T>, values: List<T>,
    start: Integer, end: Integer) where T
{
    inline for index in start..end {
        target.*.append(values[index]);
    }
}
