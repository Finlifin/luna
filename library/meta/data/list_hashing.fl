use List;
use builtin.{Integer, Type}
use hashing.{ComptimeHash, ComptimeHasher}

{-
    Hash a fixed snapshot in index order by feeding a length prefix followed by
    each element into the caller-supplied ComptimeHasher. Hash collisions still
    require the element-based ComptimeEq implementation.
-}
comptime impl ComptimeHash for List<T> where T :- ComptimeHash {
    comptime fn hash(self, state: H) -> H
    where
        H: Type,
        requires H :- ComptimeHasher,
    {
        var acc = state;
        let input = self;
        let count = input.length();
        acc.as(ComptimeHasher).write_u8(76);
        acc = count.as(ComptimeHash).hash(acc);
        T.as(ComptimeHash).hash_slice(input, acc)
    }
}
