comptime impl ComptimeHash for Symbol {
    comptime fn hash(self, state: H) -> H
    where
        H: Type,
        requires H :- ComptimeHasher,
    {
        var acc = state;
        let name = self;
        let length = hash_symbol_byte_length(name);
        var index: u64 = 0;
        while index < length {
            let byte = hash_symbol_byte(name, index) match {
                value? => value,
                null => break,
            }
            acc.as(ComptimeHasher).write_u8(byte);
            index = index + 1;
        }
        acc.as(ComptimeHasher).write_u8(255);
        acc
    }
}

comptime impl ComptimeHash for Integer {
    {-
        Canonical sign byte (zero or one), then unsigned magnitude bytes in
        little-endian order. Zero has one zero magnitude byte; no high zero
        bytes or target-width conversions participate in the encoding.
    -}
    comptime fn hash(self, state: H) -> H
    where
        H: Type,
        requires H :- ComptimeHasher,
    {
        var acc = state;
        let negative = self < 0;
        var magnitude = if negative { -self } else { self }
        acc.as(ComptimeHasher).write_u8(if negative { 1 } else { 0 });
        while magnitude >= 256 {
            acc.as(ComptimeHasher).write_u8(integer_byte(integer_rem_trunc(magnitude, 256)));
            magnitude = integer_div_trunc(magnitude, 256);
        }
        acc.as(ComptimeHasher).write_u8(integer_byte(magnitude));
        acc
    }
}
