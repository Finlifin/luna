}

{-
    Comptime streaming hashing traits and FNV-1a default implementation.

    Comptime has no pointers: `ComptimeHasher.write*` mutates `self` via
    comptime value-reference semantics, and `ComptimeHash.hash(self, state: H)`
    threads `H` explicitly without `.ref` or `*H`.
-}

pub pure comptime fn mix_byte(state: u64, byte: u8) -> u64 {
    let bits = state'bitvec;
    let widened = byte'bitvec.as(u64);
    let input = widened'bitvec;
    let mixed = ((bits and not input) or (not bits and input)).as(u128);
    assumes mixed <= 18446744073709551615;
    let product = mixed * 1099511628211;
    product'bitvec[0..64].as(u64)
}

pub pure comptime fn mix_digest(state: u64, digest: u64) -> u64 {
    var mixed = state;
    mixed = mix_byte(mixed, digest'bitvec[0..8].as(u8));
    mixed = mix_byte(mixed, digest'bitvec[8..16].as(u8));
    mixed = mix_byte(mixed, digest'bitvec[16..24].as(u8));
    mixed = mix_byte(mixed, digest'bitvec[24..32].as(u8));
    mixed = mix_byte(mixed, digest'bitvec[32..40].as(u8));
    mixed = mix_byte(mixed, digest'bitvec[40..48].as(u8));
    mixed = mix_byte(mixed, digest'bitvec[48..56].as(u8));
    mixed = mix_byte(mixed, digest'bitvec[56..64].as(u8));
    mixed
}

pub pure comptime trait ComptimeHasher {
    pure comptime fn finish(self) -> u64;

    comptime fn write(self, bytes: List<u8>) -> void;

    comptime fn write_u8(self, value: u8) -> void {
        self.write([value]);
    }

    comptime fn write_u16(self, value: u16) -> void {
        let bits = value'bitvec;
        self.write_u8(bits[0..8].as(u8));
        self.write_u8(bits[8..16].as(u8));
    }

    comptime fn write_u32(self, value: u32) -> void {
        let bits = value'bitvec;
        self.write_u8(bits[0..8].as(u8));
        self.write_u8(bits[8..16].as(u8));
        self.write_u8(bits[16..24].as(u8));
        self.write_u8(bits[24..32].as(u8));
    }

    comptime fn write_u64(self, value: u64) -> void {
        let bits = value'bitvec;
        self.write_u8(bits[0..8].as(u8));
        self.write_u8(bits[8..16].as(u8));
        self.write_u8(bits[16..24].as(u8));
        self.write_u8(bits[24..32].as(u8));
        self.write_u8(bits[32..40].as(u8));
        self.write_u8(bits[40..48].as(u8));
        self.write_u8(bits[48..56].as(u8));
        self.write_u8(bits[56..64].as(u8));
    }

    comptime fn write_u128(self, value: u128) -> void {
        let bits = value'bitvec;
        self.write_u64(bits[0..64].as(u64));
        self.write_u64(bits[64..128].as(u64));
    }

    comptime fn write_usize(self, value: usize) -> void {
        self.write_u128(hash_usize_representation(value));
    }

    comptime fn write_i8(self, value: i8) -> void {
        self.write_u8(value'bitvec.as(u8));
    }

    comptime fn write_i16(self, value: i16) -> void {
        self.write_u16(value'bitvec.as(u16));
    }

    comptime fn write_i32(self, value: i32) -> void {
        self.write_u32(value'bitvec.as(u32));
    }

    comptime fn write_i64(self, value: i64) -> void {
        self.write_u64(value'bitvec.as(u64));
    }

    comptime fn write_i128(self, value: i128) -> void {
        self.write_u128(value'bitvec.as(u128));
    }

    comptime fn write_isize(self, value: isize) -> void {
        self.write_u128(hash_isize_representation(value));
    }

    comptime fn write_length_prefix(self, len: usize) -> void {
        self.write_usize(len);
    }

    comptime fn write_str(self, value: str) -> void {
        let length = hash_str_byte_length(value);
        var index: u64 = 0;
        while index < length {
            let byte = hash_str_byte(value, index) match {
                v? => v,
                null => break,
            }
            self.write_u8(byte);
            index = index + 1;
        }
        self.write_u8(255);
    }
}

pub pure comptime trait ComptimeHash {
    comptime fn hash(self, state: H) -> H
    where
        H: Type,
        requires H :- ComptimeHasher;

    comptime fn hash_slice(data: List<Self>, state: H) -> H
    where
        H: Type,
        requires H :- ComptimeHasher,
    {
        var acc = state;
        let count = data.length();
        var index: Integer = 0;
        while index < count {
            acc = data[index].as(ComptimeHash).hash(acc);
            index = index + 1;
        }
        acc
    }
}

pub pure comptime trait ComptimeBuildHasher {
    assoc HasherTy: Type;

    pure comptime fn build_hasher(self) -> HasherTy
    where
        requires HasherTy :- ComptimeHasher;

    comptime fn hash_one(self, value: T) -> u64
    where
        T: Type,
        requires T :- ComptimeHash,
        requires HasherTy :- ComptimeHasher,
    {
        let h0 = self.build_hasher();
        let h1 = value.as(ComptimeHash).hash(h0);
        h1.as(ComptimeHasher).finish()
    }
}

pub struct DefaultComptimeHasher {
    state: u64,
}

impl DefaultComptimeHasher {
    pub pure comptime fn new() -> Self {
        DefaultComptimeHasher {
            state: 14695981039346656037,
        }
    }
}

comptime impl ComptimeDefault for DefaultComptimeHasher {
    pure comptime fn default() -> Self {
        DefaultComptimeHasher.new()
    }
}

comptime impl ComptimeHasher for DefaultComptimeHasher {
    pure comptime fn finish(self) -> u64 {
        self.state
    }

    comptime fn write_u8(self, value: u8) -> void {
        self.state = mix_byte(self.state, value);
    }

    comptime fn write(self, bytes: List<u8>) -> void {
        let count = bytes.length();
        var index: Integer = 0;
        while index < count {
            self.write_u8(bytes[index]);
            index = index + 1;
        }
    }
}

comptime impl ComptimeBuildHasher for DefaultComptimeHasher {
    assoc HasherTy: Type = DefaultComptimeHasher;

    pure comptime fn build_hasher(self) -> DefaultComptimeHasher {
        DefaultComptimeHasher.new()
    }
}

comptime impl ComptimeHash for bool {
    comptime fn hash(self, state: H) -> H
    where
        H: Type,
        requires H :- ComptimeHasher,
    {
        var acc = state;
        acc.as(ComptimeHasher).write_u8(if self { 1 } else { 0 });
        acc
    }
}

