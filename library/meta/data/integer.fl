use bindings;

{-
  Exact host-pipeline size conversion during comptime invocation. to_usize
  rejects negatives and values outside the configured target width; from_usize
  retains the complete value. Neither operation guesses the compiler's width.
-}
pub use bindings.to_usize;

pub use bindings.from_usize;

{-
    Explicit arbitrary-precision division toward zero. The remainder has the
    dividend's sign (or is zero), and a == div_trunc(a,b) * b + rem_trunc(a,b).
    Zero divisors fail the invocation. These functions do not install an
    implicit rounding policy for Integer operators.
-}
pub use bindings.div_trunc;
pub use bindings.rem_trunc;
