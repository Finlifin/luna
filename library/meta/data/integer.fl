{-
  Exact host-pipeline size conversion during comptime invocation. to_usize
  rejects negatives and values outside the configured target width; from_usize
  retains the complete value. Neither operation guesses the compiler's width.
-}
pub pure comptime fn to_usize(value: .Integer'builtin) -> .usize'builtin {
    .comptime_integer_convert'builtin(.usize'builtin, value)
}

pub pure comptime fn from_usize(value: .usize'builtin) -> .Integer'builtin {
    .comptime_integer_convert'builtin(.Integer'builtin, value)
}

{-
    Explicit arbitrary-precision division toward zero. The remainder has the
    dividend's sign (or is zero), and a == div_trunc(a,b) * b + rem_trunc(a,b).
    Zero divisors fail the invocation. These functions do not install an
    implicit rounding policy for Integer operators.
-}
pub pure comptime fn div_trunc(left: .Integer'builtin, right: .Integer'builtin)
    -> .Integer'builtin {
    .comptime_integer_div_trunc'builtin(left, right)
}

pub pure comptime fn rem_trunc(left: .Integer'builtin, right: .Integer'builtin)
    -> .Integer'builtin {
    .comptime_integer_rem_trunc'builtin(left, right)
}
