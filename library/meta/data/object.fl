use builtin.{Integer, Symbol, Type};
use bindings;

pub use bindings.Object;

impl Object {
    {-
        Observe ordered entries without merging duplicate keys. Indices are
        checked; an out-of-range index fails the invocation. A positional entry
        has no key. Typed reads return null only for a domain mismatch.
    -}
    pub pure comptime fn length(self) -> Integer {
        bindings.compiler_object_length(self)
    }

    pub pure comptime fn key(self, index: Integer) -> ?Symbol {
        bindings.compiler_object_key(self, index)
    }

    pub pure comptime fn EntryType(self, index: Integer) -> Type {
        bindings.CompilerObjectEntryType(self, index)
    }

    pub pure comptime fn value(self, index: Integer) -> ?T where T {
        bindings.compiler_object_value(T, self, index)
    }

    {-
        Read the last named entry. A missing key or a different stored domain
        returns null; a mismatched last entry never reveals an earlier duplicate.
    -}
    pub pure comptime fn get(self, key: Symbol) -> ?T where T {
        bindings.compiler_object_get(T, self, key)
    }

    {-
        Editing returns a new ordered Object and preserves the input snapshot.
        Duplicate keys remain distinct entries. Replacement retains the entry's
        key and position while recording the new value's domain.
    -}
    pub pure comptime fn concat(self, right: Object) -> Object {
        bindings.object_concat(self, right)
    }

    pub pure comptime fn append(self, value: T, .key: ?Symbol = null) -> Object where T {
        bindings.object_append<T>(self, value, .key = key)
    }

    pub pure comptime fn replace(self, index: Integer, value: T) -> Object where T {
        bindings.object_replace<T>(self, index, value)
    }

    {-
        Replace one entry through the receiver's value reference. The checked
        replacement is prepared before writeback; saved Objects stay unchanged.
    -}
    pub comptime fn set(self, index: Integer, value: T) where T {
        self = bindings.object_replace<T>(self, index, value);
    }

    pub pure comptime fn remove(self, index: Integer) -> Object {
        bindings.object_remove(self, index)
    }
}
