use builtin.{Integer, Symbol, bool, char, isize, str, u8, u16, u32, u64, u128, usize}
use builtin.fmt.options.{
    FormatOptions,
    parse_comptime_int_options,
    parse_int_options,
    parse_plain_options,
    parse_text_options,
}
use data.text.str_from_char;
use formatting.helpers.{
    format_integer_comptime,
    format_signed_comptime,
    format_unsigned_comptime,
    pad_comptime_str,
    truncate_comptime_str,
}
use numeric.bindings.{
    isize_representation as comptime_isize_representation,
    usize_representation as comptime_usize_representation,
}

{-
    Comptime-only human-facing formatting protocol. Shares the `fmt` method name
    with `builtin.fmt.Display` and produces a compile-time `str` directly.
-}
pub pure comptime trait ComptimeDisplay {
    comptime fn fmt(self, .format: str = "") -> str;
}

comptime impl ComptimeDisplay for bool {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_plain_options(format);
        let text = if self { "true" } else { "false" };
        pad_comptime_str("", text, opts, false, false)
    }
}

comptime impl ComptimeDisplay for u8 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        format_unsigned_comptime(self'bitvec.as(u128), opts)
    }
}

comptime impl ComptimeDisplay for u16 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        format_unsigned_comptime(self'bitvec.as(u128), opts)
    }
}

comptime impl ComptimeDisplay for u32 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        format_unsigned_comptime(self'bitvec.as(u128), opts)
    }
}

comptime impl ComptimeDisplay for u64 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        format_unsigned_comptime(self'bitvec.as(u128), opts)
    }
}

comptime impl ComptimeDisplay for u128 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        format_unsigned_comptime(self'bitvec.as(u128), opts)
    }
}

comptime impl ComptimeDisplay for usize {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        format_unsigned_comptime(comptime_usize_representation(self), opts)
    }
}

comptime impl ComptimeDisplay for i8 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        let twos = self'bitvec.as(u128);
        if self < 0 {
            let inv = (-(self + 1))'bitvec.as(u128);
            assumes inv < 340282366920938463463374607431768211455;
            format_signed_comptime(true, inv + 1, twos, opts)
        } else {
            format_signed_comptime(false, twos, twos, opts)
        }
    }
}

comptime impl ComptimeDisplay for i16 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        let twos = self'bitvec.as(u128);
        if self < 0 {
            let inv = (-(self + 1))'bitvec.as(u128);
            assumes inv < 340282366920938463463374607431768211455;
            format_signed_comptime(true, inv + 1, twos, opts)
        } else {
            format_signed_comptime(false, twos, twos, opts)
        }
    }
}

comptime impl ComptimeDisplay for i32 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        let twos = self'bitvec.as(u128);
        if self < 0 {
            let inv = (-(self + 1))'bitvec.as(u128);
            assumes inv < 340282366920938463463374607431768211455;
            format_signed_comptime(true, inv + 1, twos, opts)
        } else {
            format_signed_comptime(false, twos, twos, opts)
        }
    }
}

comptime impl ComptimeDisplay for i64 {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        let twos = self'bitvec.as(u128);
        if self < 0 {
            let inv = (-(self + 1))'bitvec.as(u128);
            assumes inv < 340282366920938463463374607431768211455;
            format_signed_comptime(true, inv + 1, twos, opts)
        } else {
