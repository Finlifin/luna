comptime impl ComptimeDisplay for isize {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        let twos = comptime_isize_representation(self);
        if self < 0 {
            let inv = comptime_isize_representation(-(self + 1));
            assumes inv < 340282366920938463463374607431768211455;
            format_signed_comptime(true, inv + 1, twos, opts)
        } else {
            format_signed_comptime(false, twos, twos, opts)
        }
    }
}

comptime impl ComptimeDisplay for Integer {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_comptime_int_options(format);
        format_integer_comptime(self, opts)
    }
}

comptime impl ComptimeDisplay for char {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_plain_options(format);
        pad_comptime_str("", str_from_char(self), opts, false, false)
    }
}

comptime impl ComptimeDisplay for str {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_text_options(format);
        pad_comptime_str("", truncate_comptime_str(self, opts), opts, false, false)
    }
}

comptime impl ComptimeDisplay for Symbol {
    comptime fn fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_plain_options(format);
        pad_comptime_str("", self'tag_name, opts, false, false)
    }
}
