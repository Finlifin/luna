{-
    Attribute constructors produce ordinary comptime Objects. Consumers check
    the target and supported values before applying metadata to generated code.
-}

pub pure comptime fn abi(name: .Symbol'builtin) -> .Object'builtin {
    let metadata = {abi: name};
    metadata
}

{-
    Trait membership phase is independent of a function's execution keyword.
-}
pub const comptime_phase = {comptime_phase: true};

pub mod prelude {
    pub use .abi;
    pub use .comptime_phase;
}
