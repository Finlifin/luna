{-
    Contextual constant: each resolved read observes the build input of its
    source definition. The driver must supply a configuration for that package.
-}
pub const mode: .Symbol'builtin = .build_mode'builtin;

{-
    An immutable snapshot of the source package's host pipeline target. These
    values describe compilation, not the machine running the compiler.
-}
pub struct Target {
    arch: .Symbol'builtin,
    os: .Symbol'builtin,
    pointer_bits: .Integer'builtin,
    features: TargetFeatures,
}

pub struct TargetFeatures {
    entries: .Object'builtin,
}

impl TargetFeatures {
    -- Missing is null; an explicitly disabled feature is false?.
    pub pure comptime fn get(self, name: .Symbol'builtin) -> ?bool {
        let count = .object_length'builtin(self.entries);
        inline for index in 0..count {
            let key = .object_key'builtin(self.entries, index);
            if key match { value? => value == name, null => false } {
                return .object_value'builtin(bool, self.entries, index);
            }
        }
        null
    }
}

pub const target: Target = .build_target'builtin;

pub mod prelude {}
