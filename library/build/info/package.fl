use bindings.Object;
use builtin.{Symbol, Type, bool}
use meta.List;

pub struct PackageMetadata {
    features: MetadataFeatures,
}

pub struct MetadataFeatures {
    entries: Object,
}

impl MetadataFeatures {
    -- Missing fields and mismatched domains return null.
    pub pure comptime fn get(self, name: Symbol, comptime T: Type) -> ?T {
        self.entries.get<T>(name)
    }

    pub pure comptime fn has(self, name: Symbol) -> bool {
        self.entries.has_key(name)
    }

    pub pure comptime fn keys(self) -> List<Symbol> {
        self.entries.keys()
    }
}

{-
    The callable captures its source definition's direct dependency mapping.
    Saving or forwarding it does not change the package that owns the lookup.
-}
pub use bindings.package_metadata;
