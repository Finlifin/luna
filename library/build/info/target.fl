use builtin.bool;

typealias Symbol = .Symbol'builtin;
typealias Integer = .Integer'builtin;
typealias Object = .Object'builtin;

const target_object_get = .object_get'builtin;

{-
    An immutable snapshot of the source package's host pipeline target. These
    values describe compilation, not the machine running the compiler.
-}
pub struct Target {
    arch: Symbol,
    os: Symbol,
    pointer_bits: Integer,
    features: TargetFeatures,
}

pub struct TargetFeatures {
    entries: Object,
}

impl TargetFeatures {
    -- Missing is null; an explicitly disabled feature is false?.
    pub pure comptime fn get(self, name: Symbol) -> ?bool {
        target_object_get(bool, self.entries, name)
    }
}

pub const target: Target = .build_target'builtin;
