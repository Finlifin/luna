use bindings.Object;
use builtin.{Integer, Symbol, bool}
use meta.List;

{-
    An immutable snapshot of the source package's host pipeline target. These
    values describe compilation, not the machine running the compiler.
-}
pub struct Target {
    arch: Symbol,
    os: Symbol,
    pointer_bits: Integer,
    features: TargetFeatures,
}

impl Target {
    pub pure comptime fn is_64_bit(self) -> bool {
        self.pointer_bits == 64
    }

    pub pure comptime fn is_32_bit(self) -> bool {
        self.pointer_bits == 32
    }

    pub pure comptime fn pointer_bytes(self) -> Integer {
        self.pointer_bits.div_euclid(8)
    }

    pub pure comptime fn is_arch(self, expected: Symbol) -> bool {
        self.arch == expected
    }

    pub pure comptime fn is_os(self, expected: Symbol) -> bool {
        self.os == expected
    }

    pub pure comptime fn has_feature(self, name: Symbol) -> bool {
        self.features.is_enabled(name)
    }
}

pub struct TargetFeatures {
    entries: Object,
}

impl TargetFeatures {
    -- Missing is null; an explicitly disabled feature is false?.
    pub pure comptime fn get(self, name: Symbol) -> ?bool {
        self.entries.get<bool>(name)
    }

    pub pure comptime fn is_enabled(self, name: Symbol) -> bool {
        self.get(name) matches true?
    }

    pub pure comptime fn is_disabled(self, name: Symbol) -> bool {
        self.get(name) matches false?
    }

    pub pure comptime fn keys(self) -> List<Symbol> {
        self.entries.keys()
    }
}

pub use bindings.target;
