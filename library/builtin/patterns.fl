{-
    Finite list syntax observes the length before extracting elements in order.
    Extraction returns Element by value; borrowing the receiver does not grant
    Copy to its payload. Ordinary call and resource contracts remain required.
-}
pub trait ListPatternView {
    assoc Element: .Type'builtin;
    fn list_pattern_view_get_len(*self) -> .usize'builtin;
    fn list_pattern_view_get_element(*self, comptime index: .usize'builtin) -> Element;

    ^attrs.comptime_phase
    assoc ElementComptime: .Type'builtin;
    ^attrs.comptime_phase
    comptime fn list_pattern_view_get_len_comptime(self) -> .usize'builtin;
    ^attrs.comptime_phase
    comptime fn list_pattern_view_get_element_comptime(self, index: .usize'builtin) -> ElementComptime;
}
