-- builtin package root. Sibling .fl files are discovered as modules.
-- Public root re-exports also supply names to builtin's own child modules.
-- Only builtin.prelude is imported by default into other packages.

pub use primitives.*;
pub use tuple.Tuple;
pub use traits.*;
pub use option.Option;
pub use result.Result;
pub use iterator.{Iterator, FromIterator};
pub use ops.*;

pub mod prelude {
    pub use primitives.*;
    pub use tuple.Tuple;
    pub use traits.*;
    pub use option.Option;
    pub use result.Result;
    pub use iterator.{Iterator, FromIterator};
    pub use ops.*;
}
