{-
  builtin package root. Files and directories are discovered as modules.
  Public root re-exports also supply names to builtin's own child modules.
  The prelude supplies default imports to other packages.
-}

use protocols.{resources, native_resources, conversion, patterns, meta_list_patterns, ops, iterator, traits};
use types.{tuple, option, result};
use numeric.{comparison, math_intrinsics};

pub use primitives.*;
pub use tuple.Tuple;
pub use option.OptionalOps;
pub use text_impl.bytes.TextBytes;
pub use result.ErrorResultOps;
pub use traits.*;
pub use patterns.ListPatternView;
pub use iterator.{Iterator, IntoIterator, FromIterator, emit_item, MapIterator, MapWhileIterator, ScanIterator, FilterIterator, FilterMapIterator, FlatMapIterator, FlattenIterator, TakeWhileIterator, SkipWhileIterator, TakeIterator, SkipIterator, ChainIterator, InspectIterator, IntersperseWithIterator};
pub use ops.*;

pub mod text {
    pub use text_impl.bytes.*;
}

pub mod math {
    pub use comparison.{Eq, Ord, Order};
    pub use math_intrinsics.*;
}

pub mod prelude {
    pub use .math;
    pub use primitives.*;
    pub use tuple.Tuple;
    pub use option.OptionalOps;
    pub use text_impl.bytes.TextBytes;
    pub use result.ErrorResultOps;
    pub use traits.*;
    pub use patterns.ListPatternView;
    pub use iterator.{Iterator, IntoIterator, FromIterator};
    pub use ops.*;
}
