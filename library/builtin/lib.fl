{-
  builtin package root. Files and directories are discovered as modules.
  Public root re-exports also supply names to builtin's own child modules.
  The prelude supplies default imports to other packages.
-}
use numeric.{comparison, conversions, literals, math_intrinsics}
use mem_impl.{align, array, layout, manually_drop, marker, maybe_uninit, non_null, slice, slice_ops};
use protocols.capabilities.{effects as capability_effects, errors as capability_errors}
use protocols.formatting.{debug, display, float, options as formatting_options, radix, writer}
use protocols.{conversion, deriving as deriving_impl, hash as hash_protocol, implicit_passing, iterator, native_resources, ops, patterns, resources, traits}
use range;
use types.{equality, hashing, option, ordering, result, tuple}

pub use capability_effects.{HandleCapturingEffect, HandleEffect};
pub use capability_errors.HandleError;
pub use implicit_passing.{CallDescription, Context, ImplicitPassing};
pub use iterator.{
    ChainIterator,
    EnumerateIterator,
    FilterIterator,
    FilterMapIterator,
    FlatMapIterator,
    FlattenIterator,
    FromIterator,
    InspectIterator,
    IntersperseWithIterator,
    IntoIterator,
    Iterator,
    MapIterator,
    MapWhileIterator,
    ScanIterator,
    SkipIterator,
    SkipWhileIterator,
    StepByIterator,
    TakeIterator,
    TakeWhileIterator,
    emit_item,
}
pub use ops.*;
pub use option.OptionalOps;
pub use range.{
    Bound,
    Range,
    RangeBounds,
    RangeFrom,
    RangeFull,
    RangeInclusive,
    RangeTo,
    RangeToInclusive,
}
pub use patterns.{
    ConcatPatternView,
    ListPatternView,
    ListPatternViewEndless,
    MapPatternView,
    RangeEnd,
    RangePatternView,
    StableConcatPatternView,
    StableListPatternView,
    StableListPatternViewEndless,
    StableMapPatternView,
    StableRangePatternView,
    StableStructPatternView,
    StructPatternView,
}
pub use primitives.*;
pub use protocols.staging.{Splice, splice_auto};

pub mod deriving {
    pub mod clone {
        pub use ..deriving_impl.clone.*;
    }
    pub mod copy {
        pub use ..deriving_impl.copy.*;
    }
    pub mod debug {
        pub use ..deriving_impl.debug.*;
    }
    pub mod defaults {
        pub use ..deriving_impl.defaults.*;
    }
    pub mod eq {
        pub use ..deriving_impl.eq.*;
    }
    pub mod hash {
        pub use ..deriving_impl.hash.*;
    }
    pub mod ord {
        pub use ..deriving_impl.ord.*;
    }
}
pub use result.ErrorResultOps;
pub use slice.Slice;
pub use array.{Array, ArrayIter, VariadicArrayBuffer};
pub use text_impl.bytes.TextBytes;
pub use traits.*;
pub use tuple.Tuple;

{- Shared operation identities for the other builtin packages; not a prelude. -}
pub mod compiler {
    pub use bindings.*;
}

pub mod hash {
    pub use hash_protocol.{BuildHasher, Hash, Hasher};
}

pub mod convert {
    pub use conversion.{AsMut, AsRef, ConversionErr, From, InfallibleErr, Into, LiteralInto, TryFrom, TryInto};
    pub use traits.Default;
}

pub mod mem {
    pub use mem_impl.align.Align;
    pub use mem_impl.layout.Layout;
    pub use mem_impl.manually_drop.ManuallyDrop;
    pub use mem_impl.marker.{TypeMarker, make_type_marker};
    pub use mem_impl.maybe_uninit.MaybeUninit;
    pub use mem_impl.non_null.NonNull;
    pub use mem_impl.raw.*;
    pub use slice.Slice;
    pub use slice_ops.SliceBounds;
    pub use array.{Array, ArrayIter, VariadicArrayBuffer};
}

pub mod fmt {
    pub use debug.Debug;
    pub use display.Display;
    pub use formatting_options.FormatOptions;
    pub use writer.ByteWriter;

    pub mod options {
        pub use formatting_options.*;
    }
}

pub mod text {
    pub use text_impl.bytes.*;
}

pub mod math {
    pub use comparison.{Eq, Ord, Order, TotalFloat, TotalOrd}
    pub use math_intrinsics.*;
}

pub mod staging {
    pub use protocols.staging.*;
}

pub mod capabilities {
    pub use capability_effects.{HandleCapturingEffect, HandleEffect};
    pub use capability_errors.HandleError;
}

pub mod prelude {
    pub use .math;
    pub use capability_effects.{HandleCapturingEffect, HandleEffect};
    pub use capability_errors.HandleError;
pub use implicit_passing.{CallDescription, Context, ImplicitPassing};
    pub use debug.Debug;
    pub use display.Display;
    pub use iterator.{FromIterator, IntoIterator, Iterator}
    pub use ops.*;
    pub use option.OptionalOps;
    pub use range.{
        Bound,
        Range,
        RangeBounds,
        RangeFrom,
        RangeFull,
        RangeInclusive,
        RangeTo,
        RangeToInclusive,
    }
    pub use patterns.{
        ConcatPatternView,
        ListPatternView,
        ListPatternViewEndless,
        MapPatternView,
        RangeEnd,
        RangePatternView,
        StableConcatPatternView,
        StableListPatternView,
        StableListPatternViewEndless,
        StableMapPatternView,
        StableRangePatternView,
        StableStructPatternView,
        StructPatternView,
    }
    pub use primitives.*;
    pub use protocols.staging.{Splice, splice_auto};
    pub use result.ErrorResultOps;
    pub use slice.Slice;
    pub use array.Array;
    pub use text_impl.bytes.TextBytes;
    pub use traits.*;
    pub use tuple.Tuple;
}
