{-
  builtin package root. Files and directories are discovered as modules.
  Public root re-exports also supply names to builtin's own child modules.
  The prelude supplies default imports to other packages.
-}
use numeric.{comparison, conversions, math_intrinsics}
use protocols.capabilities.{effects as capability_effects, errors as capability_errors}
use protocols.formatting.{debug, display, float, options as formatting_options, radix, writer}
use protocols.{conversion, iterator, native_resources, ops, patterns, resources, traits}
use types.{equality, hashing, option, ordering, result, tuple}

pub use capability_effects.{HandleCapturingEffect, HandleEffect};
pub use capability_errors.HandleError;
pub use iterator.{
    ChainIterator,
    EnumerateIterator,
    FilterIterator,
    FilterMapIterator,
    FlatMapIterator,
    FlattenIterator,
    FromIterator,
    InspectIterator,
    IntersperseWithIterator,
    IntoIterator,
    Iterator,
    MapIterator,
    MapWhileIterator,
    ScanIterator,
    SkipIterator,
    SkipWhileIterator,
    StepByIterator,
    TakeIterator,
    TakeWhileIterator,
    emit_item,
}
pub use ops.*;
pub use option.OptionalOps;
pub use patterns.{ListPatternView, StableListPatternView}
pub use primitives.*;
pub use protocols.staging.{Splice, splice_auto};
pub use result.ErrorResultOps;
pub use text_impl.bytes.TextBytes;
pub use traits.*;
pub use tuple.Tuple;

{- Shared operation identities for the other builtin packages; not a prelude. -}
pub mod compiler {
    pub use bindings.*;
}

pub mod mem {
    pub use mem_impl.raw.*;
}

pub mod fmt {
    pub use debug.Debug;
    pub use display.Display;
    pub use formatting_options.FormatOptions;
    pub use writer.ByteWriter;

    pub mod options {
        pub use formatting_options.*;
    }
}

pub mod text {
    pub use text_impl.bytes.*;
}

pub mod math {
    pub use comparison.{Eq, Ord, Order}
    pub use math_intrinsics.*;
}

pub mod capabilities {
    pub use capability_effects.{HandleCapturingEffect, HandleEffect};
    pub use capability_errors.HandleError;
}

pub mod prelude {
    pub use .math;
    pub use capability_effects.{HandleCapturingEffect, HandleEffect};
    pub use capability_errors.HandleError;
    pub use debug.Debug;
    pub use display.Display;
    pub use iterator.{FromIterator, IntoIterator, Iterator}
    pub use ops.*;
    pub use option.OptionalOps;
    pub use patterns.{ListPatternView, StableListPatternView}
    pub use primitives.*;
    pub use protocols.staging.{Splice, splice_auto};
    pub use result.ErrorResultOps;
    pub use text_impl.bytes.TextBytes;
    pub use traits.*;
    pub use tuple.Tuple;
}
