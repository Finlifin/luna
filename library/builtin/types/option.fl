{-
    Operations on the language's optional type. Each ?T layer preserves the
    complete T value; no library enum or declaration binding defines this type.
    Panic-dependent unwrap remains a draft in development/library-prototypes.
-}

use primitives.Type;

impl ?T where T {
    pub fn is_some(self) -> bool = self match {
        _? => true,
        null => false,
    };

    pub fn is_none(self) -> bool = not self.is_some();

    pub fn unwrap_or(self, fallback: T) -> T = self match {
        value? => value,
        null => fallback,
    };

    -- Construct a fallback only when this layer is absent.
    pub fn unwrap_or_else(self, fallback: %c fn() -> T) -> T where c: Type.vars.Closure = self match {
        value? => value,
        null => fallback(),
    };

    pub fn map(self, f: %c fn(T) -> U) -> ?U where U, c: Type.vars.Closure = self match {
        value? => f(value),
        null => null,
    };

    pub fn and_then(self, f: %c fn(T) -> ?U) -> ?U where U, c: Type.vars.Closure = self match {
        value? => f(value),
        null => null,
    };

    {- Observe the owned payload in place before deciding whether to retain it.
       A rejected payload is cleaned up by the ordinary resource rules. -}
    pub fn filter(self, pred: %c fn(*T) -> bool) -> ?T where c: Type.vars.Closure = self match {
        value? => if pred(value.ref) {value} else {null},
        null => null,
    };

    pub fn inspect(self, observer: %c fn(*T)) -> ?T where c: Type.vars.Closure = self match {
        value? => do {observer(value.ref); value},
        null => null,
    };

    -- Invoke the alternative only when this outer optional layer is absent.
    pub fn or_else(self, fallback: %c fn() -> ?T) -> ?T where c: Type.vars.Closure = self match {
        value? => value,
        null => fallback(),
    };

    {- Both inputs are ordinary, eagerly evaluated arguments. Only combination
       is conditional; an unmatched payload still has its normal cleanup. -}
    pub fn zip_with(self, other: ?U, combine: %c fn(T, U) -> V) -> ?V where U, V, c: Type.vars.Closure = self match {
        left? => other match {
            right? => combine(left, right),
            null => null,
        },
        null => null,
    };
}
