use comparison.Eq;
use primitives.bool;
use traits.Copy;

{-
    Runtime comparison borrows wrappers via `*self` / `*Self`. Tagged-union
    pointer projection (`*?T -> ?*T` / `*!E T -> !*E *T`) does not exist yet
    in NIR/IIR/backend, so `T :- Copy + Eq` (and `E :- Copy + Eq`) is kept to
    read payloads out and borrow those local copies.
-}
impl Eq for ?T
where
    T :- Copy + Eq,
{
    fn eq(*self, other: *Self) -> bool =
        self.* match {
            left? =>
                other.* match {
                    right? => left.ref.as(Eq).eq(right.ref),
                    null => false,
                },
            null => other.* matches null,
        }
}

impl Eq for !E T
where
    T :- Copy + Eq,
    E :- Copy + Eq,
{
    fn eq(*self, other: *Self) -> bool =
        self.* match {
            left! =>
                other.* match {
                    right! => left.ref.as(Eq).eq(right.ref),
                    error _ => false,
                },
            error left =>
                other.* match {
                    _! => false,
                    error right => left.ref.as(Eq).eq(right.ref),
                },
        }
}
