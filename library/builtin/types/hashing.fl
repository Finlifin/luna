use protocols.hash.{Hash, Hasher}
use primitives.Type;
use traits.Copy;

impl Hash for ?T
where
    T :- Copy + Hash,
{
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        self.* match {
            value? => {
                state.as(Hasher).write_u8(1);
                value.ref.as(Hash).hash(state);
            },
            null => state.as(Hasher).write_u8(0),
        }
    }
}

impl Hash for !E T
where
    T :- Copy + Hash,
    E :- Copy + Hash,
{
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        self.* match {
            value! => {
                state.as(Hasher).write_u8(0);
                value.ref.as(Hash).hash(state);
            },
            error failure => {
                state.as(Hasher).write_u8(1);
                failure.ref.as(Hash).hash(state);
            },
        }
    }
}
