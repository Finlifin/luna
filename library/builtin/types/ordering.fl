use comparison.{Ord, Order}
use traits.Copy;

{-
    Absence precedes presence. Compare payloads only when both outer layers are
    present, retaining nested optional layers and the payload's own ordering.
    Tagged-union pointer projection (`*?T -> ?*T` / `*!E T -> !*E *T`) does
    not exist yet in NIR/IIR/backend, so `T :- Copy + Ord` (and `E :- Copy + Ord`)
    is kept to read payloads out and borrow those local copies.
-}
impl Ord for ?T
where
    T :- Copy + Ord,
{
    fn cmp(*self, other: *Self) -> Order =
        self.* match {
            left? =>
                other.* match {
                    right? => left.ref.as(Ord).cmp(right.ref),
                    null => .greater,
                },
            null =>
                other.* match {
                    _? => .less,
                    null => .equal,
                },
        }
}

{-
    Single-label error results order success before failure. Matching branches
    compare payloads using their Ord implementation without comparing across
    different branches.
-}
impl Ord for !E T
where
    T :- Copy + Ord,
    E :- Copy + Ord,
{
    fn cmp(*self, other: *Self) -> Order =
        self.* match {
            left! =>
                other.* match {
                    right! => left.ref.as(Ord).cmp(right.ref),
                    error _ => .less,
                },
            error left =>
                other.* match {
                    _! => .greater,
                    error right => left.ref.as(Ord).cmp(right.ref),
                },
        }
}
