-- ==========================================================================
-- builtin/traits – fundamental traits
-- ==========================================================================
--
-- These traits form the core protocol system of Flurry. Many of them are
-- lang items that the compiler desugars syntax into.

-- ── Equality ───────────────────────────────────────────────────────────────

-- #[lang = "eq"]
pub trait Eq {
    fn eq(self, other: Self) -> Bool;
    fn ne(self, other: Self) -> Bool = not self.eq(other);
}

-- ── Ordering ───────────────────────────────────────────────────────────────

-- #[lang = "ord"]
pub trait Ord :- Eq {
    fn cmp(self, other: Self) -> Ordering;
    fn lt(self, other: Self) -> Bool = self.cmp(other) match {
        .Less => true,
        _ => false,
    };
    fn le(self, other: Self) -> Bool = self.cmp(other) match {
        .Greater => false,
        _ => true,
    };
    fn gt(self, other: Self) -> Bool = self.cmp(other) match {
        .Greater => true,
        _ => false,
    };
    fn ge(self, other: Self) -> Bool = self.cmp(other) match {
        .Less => false,
        _ => true,
    };
}

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

-- ── Display / Debug ────────────────────────────────────────────────────────

-- #[lang = "display"]
pub trait Display {
    fn fmt(self) -> String;
}

-- #[lang = "debug"]
pub trait Debug {
    fn debug_fmt(self) -> String;
}

-- ── Once / Clone / Copy ────────────────────────────────────────────────────

pub trait Once {}

-- #[lang = "clone"]
pub trait Clone :- Once {
    fn clone(*self) -> Self;
}

-- #[lang = "copy"]
pub trait Copy :- Clone {}

-- ── Drop ───────────────────────────────────────────────────────────────────

-- #[lang = "drop"]
pub trait Drop {
    fn drop(*self);
}

-- ── Hash ───────────────────────────────────────────────────────────────────

-- #[lang = "hash"]
pub trait Hash {
    fn hash(self) -> u64;
}

-- ── Conversion ─────────────────────────────────────────────────────────────

-- #[lang = "into"]
pub trait Into where Target {
    fn into(self) -> Target;
}

-- #[lang = "from"]
pub trait From where Source {
    fn from(source: Source) -> Self;
}

-- ── Default ────────────────────────────────────────────────────────────────

pub trait Default {
    -- default is reserved; the method uses an ordinary identifier.
    fn default_value() -> Self;
}
