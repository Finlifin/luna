-- ==========================================================================
-- builtin/traits – fundamental traits
-- ==========================================================================
--
-- These traits form the core protocol system of Flurry. Many of them are
-- lang items that the compiler desugars syntax into.

-- Comparison protocols can be loaded without formatting/owned strings.
pub use comparison.{Eq, Ord, Ordering};

-- ── Display / Debug ────────────────────────────────────────────────────────

-- #[lang = "display"]
pub trait Display {
    fn fmt(self) -> String;
}

-- #[lang = "debug"]
pub trait Debug {
    fn debug_fmt(self) -> String;
}

-- Resource protocols live separately from formatting and owned strings.
pub use resources.{Once, Clone, Copy, Drop};

-- ── Hash ───────────────────────────────────────────────────────────────────

-- #[lang = "hash"]
pub trait Hash {
    fn hash(self) -> u64;
    ^{comptime_phase: true}
    comptime fn comptime_hash(self) -> u64;
}

{-
    Scalar hashes preserve all representation bits up to 64 bits. Wider
    integers fold both 64-bit halves with xor. Equal values must hash equally;
    collisions are resolved with Eq. These are not cryptographic hashes.
-}
impl Hash for bool {
    fn hash(self) -> u64 {
        if self { 1 } else { 0 }
    }
}
impl Hash for .u8'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u16'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u32'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u64'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i8'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i16'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i32'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i64'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u128'builtin {
    fn hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}
impl Hash for .i128'builtin {
    fn hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}
comptime impl Hash for bool {
    comptime fn comptime_hash(self) -> u64 {
        if self { 1 } else { 0 }
    }
}
comptime impl Hash for .u8'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u16'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u32'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u64'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i8'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i16'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i32'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i64'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u128'builtin {
    comptime fn comptime_hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}
comptime impl Hash for .i128'builtin {
    comptime fn comptime_hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}

impl Hash for .char'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}

comptime impl Hash for .char'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}

-- ── Conversion ─────────────────────────────────────────────────────────────

pub use conversion.{Into, From};

-- ── Default ────────────────────────────────────────────────────────────────

pub trait Default {
    -- default is reserved; the method uses an ordinary identifier.
    fn default_value() -> Self;
}
