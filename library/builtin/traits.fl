-- ==========================================================================
-- builtin/traits – fundamental traits
-- ==========================================================================
--
-- These traits form the core protocol system of Flurry. Many of them are
-- lang items that the compiler desugars syntax into.

-- Comparison protocols can be loaded without formatting/owned strings.
pub use comparison.{Eq, Ord, Ordering};

-- Resource protocols live separately from formatting and owned strings.
pub use resources.{Once, Clone, Copy, Drop};

-- ── Hash ───────────────────────────────────────────────────────────────────

-- #[lang = "hash"]
pub trait Hash {
    fn hash(self) -> u64;
    ^{comptime_phase: true}
    comptime fn comptime_hash(self) -> u64;
}

{-
    Scalar hashes preserve all representation bits up to 64 bits. Wider
    integers fold both 64-bit halves with xor. Equal values must hash equally;
    collisions are resolved with Eq. These are not cryptographic hashes.
-}
impl Hash for bool {
    fn hash(self) -> u64 {
        if self { 1 } else { 0 }
    }
}
impl Hash for .u8'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u16'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u32'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u64'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i8'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i16'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i32'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .i64'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
impl Hash for .u128'builtin {
    fn hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}
impl Hash for .i128'builtin {
    fn hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}
comptime impl Hash for bool {
    comptime fn comptime_hash(self) -> u64 {
        if self { 1 } else { 0 }
    }
}
comptime impl Hash for .u8'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u16'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u32'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u64'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i8'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i16'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i32'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .i64'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}
comptime impl Hash for .u128'builtin {
    comptime fn comptime_hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}
comptime impl Hash for .i128'builtin {
    comptime fn comptime_hash(self) -> u64 {
        let bits = self'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}

impl Hash for .char'builtin {
    fn hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}

comptime impl Hash for .char'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'bitvec.as(u64)
    }
}

{-
    Text hashes use FNV-1a over UTF-8 bytes, never backing storage addresses.
    Multiplication is widened to u128 and the low 64 bits are selected
    explicitly. This deterministic hash is not collision-resistant; Eq must
    still decide equality. Runtime and comptime use the same recurrence.
-}
impl Hash for .str'builtin {
    fn hash(self) -> u64 {
        let name = self;
        let length = .str_byte_length'builtin(name);
        var index: u64 = 0;
        var state: u64 = 14695981039346656037;
        while index < length {
            let byte = .str_byte'builtin(name, index) match {
                value? => value,
                null => return state,
            };
            let bits = state'bitvec;
            let widened = byte'bitvec.as(u64);
            let input = widened'bitvec;
            let mixed = ((bits and not input) or (not bits and input)).as(u128);
            assumes mixed <= 18446744073709551615;
            let product = mixed * 1099511628211;
            state = product'bitvec[0..64].as(u64);
            index = index + 1;
        }
        state
    }
}

comptime impl Hash for .str'builtin {
    comptime fn comptime_hash(self) -> u64 {
        let name = self;
        let length = .str_byte_length'builtin(name);
        var index: u64 = 0;
        var state: u64 = 14695981039346656037;
        while index < length {
            let byte = .str_byte'builtin(name, index) match {
                value? => value,
                null => return state,
            };
            let bits = state'bitvec;
            let widened = byte'bitvec.as(u64);
            let input = widened'bitvec;
            let mixed = ((bits and not input) or (not bits and input)).as(u128);
            assumes mixed <= 18446744073709551615;
            let product = mixed * 1099511628211;
            state = product'bitvec[0..64].as(u64);
            index = index + 1;
        }
        state
    }
}

impl Hash for .Symbol'builtin {
    fn hash(self) -> u64 {
        self'tag_name.as(Hash).hash()
    }
}

comptime impl Hash for .Symbol'builtin {
    comptime fn comptime_hash(self) -> u64 {
        self'tag_name.as(Hash).comptime_hash()
    }
}

{-
    Target-sized integers retain their target representation width. Widening
    to u128 zero-extends those bits; folding handles every supported width,
    including targets wider than 64 bits, without assuming host pointer size.
-}
impl Hash for .usize'builtin {
    fn hash(self) -> u64 {
        let widened = .integer_representation'builtin(self);
        let bits = widened'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}

comptime impl Hash for .usize'builtin {
    comptime fn comptime_hash(self) -> u64 {
        let widened = .integer_representation'builtin(self);
        let bits = widened'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}

impl Hash for .isize'builtin {
    fn hash(self) -> u64 {
        let widened = .integer_representation'builtin(self);
        let bits = widened'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}

comptime impl Hash for .isize'builtin {
    comptime fn comptime_hash(self) -> u64 {
        let widened = .integer_representation'builtin(self);
        let bits = widened'bitvec;
        let low = bits[0..64];
        let high = bits[64..128];
        ((low and not high) or (not low and high)).as(u64)
    }
}

-- ── Conversion ─────────────────────────────────────────────────────────────

pub use conversion.{Into, From};

-- ── Default ────────────────────────────────────────────────────────────────

pub trait Default {
    -- default is reserved; the method uses an ordinary identifier.
    fn default_value() -> Self;
}
