use resources.{Clone, Copy};

-- Native half precision scalars copy their representation unchanged.
impl Clone for f16 {
    fn clone(*self) -> Self { self.* }
}
impl Copy for f16 {}

impl Clone for bf16 {
    fn clone(*self) -> Self { self.* }
}
impl Copy for bf16 {}

{-
    Copyable payloads allow copying the complete native wrapper. All possible
    payloads must satisfy Copy, including the inactive error branch. Cloning
    here copies the value; it does not call a payload's user-defined clone.
    Clone-only payloads need a separate borrowed reconstruction implementation.
-}
impl Clone for ?T where T :- Copy {
    fn clone(*self) -> Self { self.* }
}
impl Copy for ?T where T :- Copy {}

impl Clone for !E T where E :- Copy, T :- Copy {
    fn clone(*self) -> Self { self.* }
}
impl Copy for !E T where E :- Copy, T :- Copy {}
