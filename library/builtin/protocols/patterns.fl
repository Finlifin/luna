{-
    Finite list syntax observes the length before extracting elements in order.
    Extraction returns Element by value; borrowing the receiver does not grant
    Copy to its payload. Ordinary call and resource contracts remain required.
-}
pub trait ListPatternView {
    assoc Element: Type;
    assoc Rest: Type = Self;

    fn list_pattern_view_get_len(*self) -> usize;
    fn list_pattern_view_get_element(*self, comptime index: usize) -> Element;

    fn list_pattern_view_rest(*self, comptime start: usize) -> Rest {
        assumes false;
        while true {}
    }

    ^attrs.comptime_phase
    assoc ElementComptime: Type;
    ^attrs.comptime_phase
    assoc RestComptime: Type = Self;

    ^attrs.comptime_phase
    comptime fn list_pattern_view_get_len_comptime(self) -> usize;
    ^attrs.comptime_phase
    comptime fn list_pattern_view_get_element_comptime(self, index: usize) -> ElementComptime;

    ^attrs.comptime_phase
    comptime fn list_pattern_view_rest_comptime(self, start: usize) -> RestComptime {
        assumes false;
        while true {}
    }
}

{-
    Marker protocol guaranteeing that list length observation and indexing/slicing
    are referentially stable across match arms without side effects, authorizing
    single-observation decision DAGs and length-interval exhaustiveness proofs.
-}
pub trait StableListPatternView :- ListPatternView {}

{-
    Endless sequence (stream, generator, lazy sequence) pattern view.
    Declares no length query; every endless list pattern arm must end with
    `..._` or `...rest`.
-}
pub trait ListPatternViewEndless {
    assoc Element: Type;
    assoc Rest: Type = Self;

    fn list_pattern_view_get_element(*self, comptime index: usize) -> Element;

    fn list_pattern_view_rest(*self, comptime start: usize) -> Rest {
        assumes false;
        while true {}
    }

    ^attrs.comptime_phase
    assoc ElementComptime: Type;
    ^attrs.comptime_phase
    assoc RestComptime: Type = Self;

    ^attrs.comptime_phase
    comptime fn list_pattern_view_get_element_comptime(self, index: usize) -> ElementComptime;

    ^attrs.comptime_phase
    comptime fn list_pattern_view_rest_comptime(self, start: usize) -> RestComptime {
        assumes false;
        while true {}
    }
}

{-
    Marker protocol guaranteeing that endless sequence indexing and slicing are
    referentially stable across match arms without side effects, authorizing
    single-observation decision DAGs and prefix exhaustiveness proofs.
-}
pub trait StableListPatternViewEndless :- ListPatternViewEndless {}

{-
    Unified range endpoint descriptor used by `RangePatternView` to cover all
    five bounded and half-bounded range pattern forms (`..hi`, `..=hi`,
    `lo..`, `lo..hi`, `lo..=hi`).
-}
pub enum RangeEnd where T {
    unbounded,
    inclusive(T),
    exclusive(T),
}

{-
    Range pattern view protocol (single-trait two-phase).
    Runtime context invokes `range_pattern_view_contains` with `*self` and
    `RangeEnd<Bound>`; comptime context invokes
    `range_pattern_view_contains_comptime` with `self` and
    `RangeEnd<BoundComptime>`.
-}
pub trait RangePatternView {
    assoc Bound: Type = Self;

    fn range_pattern_view_contains(
        *self,
        start: RangeEnd<Bound>,
        end: RangeEnd<Bound>,
    ) -> bool;

    ^attrs.comptime_phase
    assoc BoundComptime: Type = Self;

    ^attrs.comptime_phase
    comptime fn range_pattern_view_contains_comptime(
        self,
        start: RangeEnd<BoundComptime>,
        end: RangeEnd<BoundComptime>,
    ) -> bool;
}

{-
    Marker protocol guaranteeing that range pattern containment is
    referentially stable and monotonic across match arms without side effects,
    authorizing decision-DAG deduplication when endpoints are static
    constants.
-}
pub trait StableRangePatternView :- RangePatternView {}
