use primitives.*;
use protocols.formatting.writer.ByteWriter;

{-
    Zero-allocation integer radix formatting traits. Receivers are borrowed so
    formatting follows the same protocol ownership convention as Debug. Signed
    types format their two's-complement bit representation within their width.
-}
pub trait LowerHex {
    fn write_lower_hex(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter;
}

pub trait UpperHex {
    fn write_upper_hex(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter;
}

pub trait Binary {
    fn write_binary(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter;
}

pub trait Octal {
    fn write_octal(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter;
}

fn hex_byte(nibble: u8, uppercase: bool) -> u8 {
    if nibble <= 9 {
        48 + nibble
    } else if nibble <= 15 {
        if uppercase { 55 + nibble } else { 87 + nibble }
    } else {
        48
    }
}

fn write_unsigned_hex(
    value: u128,
    uppercase: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 16 {
        write_unsigned_hex(value / 16, uppercase, output)!;
    }
    let nibble = (value % 16)'bitvec[0..8].as(u8);
    output.write_byte(hex_byte(nibble, uppercase))
}

fn write_unsigned_binary(value: u128, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 2 {
        write_unsigned_binary(value / 2, output)!;
    }
    let bit = (value % 2)'bitvec[0..8].as(u8);
    assumes bit <= 1;
    output.write_byte(48 + bit)
}

fn write_unsigned_octal(value: u128, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 8 {
        write_unsigned_octal(value / 8, output)!;
    }
    let digit = (value % 8)'bitvec[0..8].as(u8);
    assumes digit <= 7;
    output.write_byte(48 + digit)
}

impl LowerHex for u8 {
    fn write_lower_hex(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        write_unsigned_hex(self.*'bitvec.as(u128), false, output)
    }
}

impl UpperHex for u8 {
    fn write_upper_hex(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        write_unsigned_hex(self.*'bitvec.as(u128), true, output)
    }
}

impl Binary for u8 {
    fn write_binary(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        write_unsigned_binary(self.*'bitvec.as(u128), output)
    }
}

impl Octal for u8 {
    fn write_octal(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        write_unsigned_octal(self.*'bitvec.as(u128), output)
    }
}

