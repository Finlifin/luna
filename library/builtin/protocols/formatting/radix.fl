use primitives.*;
use protocols.formatting.options.{
    FormatOptions,
    compute_pad_counts,
    write_char_repeat,
}
use protocols.formatting.writer.ByteWriter;

{-
    Internal integer formatting helpers used by builtin runtime `Display`
    implementations across decimal, hex, octal, and binary modes.
-}

fn hex_byte(nibble: u8, uppercase: bool) -> u8 {
    if nibble <= 9 {
        48 + nibble
    } else if nibble <= 15 {
        if uppercase { 55 + nibble } else { 87 + nibble }
    } else {
        48
    }
}

fn write_unsigned_decimal_digits(
    value: u128,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 10 {
        write_unsigned_decimal_digits(value / 10, output)!;
    }
    let digit = (value % 10)'bitvec[0..8].as(u8);
    assumes digit <= 9;
    output.write_byte(48 + digit)
}

fn write_unsigned_hex_digits(
    value: u128,
    uppercase: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 16 {
        write_unsigned_hex_digits(value / 16, uppercase, output)!;
    }
    let nibble = (value % 16)'bitvec[0..8].as(u8);
    output.write_byte(hex_byte(nibble, uppercase))
}

fn write_unsigned_octal_digits(
    value: u128,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 8 {
        write_unsigned_octal_digits(value / 8, output)!;
    }
    let digit = (value % 8)'bitvec[0..8].as(u8);
    assumes digit <= 7;
    output.write_byte(48 + digit)
}

fn write_unsigned_binary_digits(
    value: u128,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 2 {
        write_unsigned_binary_digits(value / 2, output)!;
    }
    let bit = (value % 2)'bitvec[0..8].as(u8);
    assumes bit <= 1;
    output.write_byte(48 + bit)
}

pure fn count_digits_in_base(value: u128, base: u128) -> u32 {
    if base < 2 {
        return 1;
    }
    var v = value;
    var count: u32 = 1;
    while v >= base {
        v = v / base;
        if count < 128 {
            count = count + 1;
        }
    }
    count
}

pure fn radix_base_u128(radix: u8) -> u128 {
    if radix == 1 or radix == 2 {
        16
    } else if radix == 3 {
        8
    } else if radix == 4 {
        2
    } else {
        10
    }
}

fn write_radix_prefix(
    radix: u8,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if radix == 1 {
        output.write_str("0x")
    } else if radix == 2 {
        output.write_str("0X")
    } else if radix == 3 {
        output.write_str("0o")
    } else if radix == 4 {
        output.write_str("0b")
    } else {
        return;
    }
}

fn write_digits_in_radix(
    digits: u128,
    radix: u8,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if radix == 1 {
        write_unsigned_hex_digits(digits, false, output)
    } else if radix == 2 {
        write_unsigned_hex_digits(digits, true, output)
    } else if radix == 3 {
        write_unsigned_octal_digits(digits, output)
    } else if radix == 4 {
        write_unsigned_binary_digits(digits, output)
    } else {
        write_unsigned_decimal_digits(digits, output)
    }
}

pub fn write_unsigned_formatted(
    value: u128,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_signed_formatted(false, value, value, opts, output)
}

pub fn write_signed_formatted(
    is_neg: bool,
    abs_magnitude: u128,
    twos_comp: u128,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    let digits = if opts.radix == 0 { abs_magnitude } else { twos_comp };
    let sign_char: u8 = if opts.radix == 0 {
        if is_neg {
            45
        } else if opts.sign == 1 {
            43
        } else if opts.sign == 2 {
            32
        } else {
            0
        }
    } else {
        0
    };
    let has_alt_prefix = opts.radix != 0 and opts.alt;

    if not opts.has_len {
        if sign_char != 0 {
            output.write_byte(sign_char)!;
        }
        if has_alt_prefix {
            write_radix_prefix(opts.radix, output)!;
        }
        return write_digits_in_radix(digits, opts.radix, output);
    }

    let sign_len: u32 = if sign_char != 0 { 1 } else { 0 };
    let alt_len: u32 = if has_alt_prefix { 2 } else { 0 };
    let digit_count = count_digits_in_base(digits, radix_base_u128(opts.radix));
    if digit_count > 128 {
        return;
    }
    let content_chars: u32 = sign_len + alt_len + digit_count;
    let pads = compute_pad_counts(opts, content_chars, true, true);
    if pads.left > 0 {
        write_char_repeat(opts.placeholder, pads.left, output)!;
    }
    if sign_char != 0 {
        output.write_byte(sign_char)!;
    }
    if has_alt_prefix {
        write_radix_prefix(opts.radix, output)!;
    }
    if pads.zero_pad > 0 {
        write_char_repeat('0', pads.zero_pad, output)!;
    }
    write_digits_in_radix(digits, opts.radix, output)!;
    if pads.right > 0 {
        write_char_repeat(opts.placeholder, pads.right, output)!;
    }
}
