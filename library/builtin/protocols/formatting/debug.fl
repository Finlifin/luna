use bindings.{str_byte, str_byte_length}
use primitives.*;
use protocols.formatting.display.Display;
use protocols.formatting.float;
use protocols.formatting.writer.ByteWriter;

{-
    Developer-facing representation formatting. Receivers are borrowed so
    formatting an owned affine value never consumes or destroys it.
-}
pub trait Debug {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter;
}

fn hex_digit(nibble: u8) -> u8 {
    if nibble <= 9 {
        48 + nibble
    } else if nibble <= 15 {
        87 + nibble
    } else {
        48
    }
}

fn write_escaped_byte(
    byte: u8,
    quote_byte: u8,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if byte == 0 {
        output.write_str("\\0")
    } else if byte == 9 {
        output.write_str("\\t")
    } else if byte == 10 {
        output.write_str("\\n")
    } else if byte == 13 {
        output.write_str("\\r")
    } else if byte == 92 {
        output.write_str("\\\\")
    } else if byte == quote_byte {
        if quote_byte == 34 {
            output.write_str("\\\"")
        } else {
            output.write_byte(92)!;
            output.write_byte(quote_byte)
        }
    } else if byte < 32 or byte == 127 {
        output.write_str("\\x")!;
        output.write_byte(hex_digit(byte / 16))!;
        output.write_byte(hex_digit(byte % 16))
    } else {
        output.write_byte(byte)
    }
}

impl Debug for bool {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for void {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        output.write_str("()")
    }
}

impl Debug for u8 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for u16 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for u32 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for u64 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for u128 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for usize {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for i8 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for i16 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for i32 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for i64 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for i128 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for isize {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.*.as(Display).write(output)
    }
}

impl Debug for char {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        output.write_byte(39)!;
        let code = self.*'bitvec.as(u32);
        if code <= 127 {
            write_escaped_byte(code'bitvec[0..8].as(u8), 39, output)!;
        } else {
            self.*.as(Display).write(output)!;
        }
        output.write_byte(39)
    }
}

impl Debug for str {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        output.write_byte(34)!;
        let text = self.*;
        let length = str_byte_length(text);
        var index: u64 = 0;
        while index < length {
            let byte = str_byte(text, index) match {
                found? => found,
                null => break,
            }
            write_escaped_byte(byte, 34, output)!;
            index = index + 1;
        }
        output.write_byte(34)
    }
}

impl Debug for Symbol {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        output.write_byte(46)!;
        self.*.as(Display).write(output)
    }
}

impl Debug for f16 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        float.write_f16(self.*, true, output)
    }
}

impl Debug for bf16 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        float.write_bf16(self.*, true, output)
    }
}

impl Debug for f32 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        float.write_f32(self.*, true, output)
    }
}

impl Debug for f64 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        float.write_f64(self.*, true, output)
    }
}
