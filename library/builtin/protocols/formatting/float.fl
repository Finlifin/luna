use numeric.math_intrinsics;
use primitives.*;
use protocols.formatting.options.{FormatOptions, compute_pad_counts, write_char_repeat}
use protocols.formatting.writer.ByteWriter;
use protocols.resources.{Clone, Copy}

private enum ProbeErr {
    Overflow,
}

private struct ProbeWriter {
    chars: u32,
}

impl ProbeWriter {
    fn new() -> Self {
        ProbeWriter { chars: 0 }
    }
}

impl ByteWriter for ProbeWriter {
    assoc Err: Type = ProbeErr;

    fn write_byte(*self, byte: u8) -> !ProbeErr void {
        if byte < 128 or byte >= 192 {
            let c = self.chars.*;
            if c >= 10000000 {
                return error ProbeErr.Overflow;
            }
            self.chars.* = c + 1;
        }
    }
}

{-
    Zero-allocation IEEE-754 binary-float-to-decimal formatter for f16, bf16,
    f32, and f64. Uses normalized 128-bit binary scaling with inward-shrunk
    midpoint intervals so shortest-representation decimal output is guaranteed
    to round-trip without heap allocation or large power-of-ten tables.
-}
struct Scaled128 {
    mant: u128,
    exp: i32,
}

impl Clone for Scaled128 {
    fn clone(*self) -> Self {
        Scaled128 {
            mant: self.mant.*,
            exp: self.exp.*,
        }
    }
}

impl Copy for Scaled128 {}

struct DecimalDigits {
    digits: u64,
    count: u8,
    dec_exp: i32,
}

impl Clone for DecimalDigits {
    fn clone(*self) -> Self {
        DecimalDigits {
            digits: self.digits.*,
            count: self.count.*,
            dec_exp: self.dec_exp.*,
        }
    }
}

impl Copy for DecimalDigits {}

{- Exact top 128 bits of (a * b) rounded to nearest, using 64-bit limb products. -}
fn mul_hi128(a: u128, b: u128) -> u128 {
    let a_hi = a'bitvec[64..128].as(u128);
    let a_lo = a'bitvec[0..64].as(u128);
    let b_hi = b'bitvec[64..128].as(u128);
    let b_lo = b'bitvec[0..64].as(u128);

    let p0_hi = (a_lo * b_lo)'bitvec[64..128].as(u128);
    let p1 = a_lo * b_hi;
    let p2 = a_hi * b_lo;
    let p3 = a_hi * b_hi;

    let mid = p0_hi + p1'bitvec[0..64].as(u128) + p2'bitvec[0..64].as(u128);
    let carry = mid'bitvec[64..66].as(u128);
    let round_bit = mid'bitvec[63..64].as(u128);

    let p1_hi = p1'bitvec[64..128].as(u128);
    let p2_hi = p2'bitvec[64..128].as(u128);
    -- Each 64-bit limb <= 2^64 - 1: (2^64 - 1)^2 = (2^64 - 2)*2^64 + 1 and mid < 3 * 2^64.
    assumes p3 <= 340282366920938463426481119284349108225;
    assumes p1_hi <= 18446744073709551614;
    assumes p2_hi <= 18446744073709551614;
    assumes carry <= 2;

    let hi = p3 + p1_hi + p2_hi + carry;
    if hi < 340282366920938463463374607431768211455 {
        hi + round_bit
    } else {
        hi
    }
}

fn normalize_u128(mant: u128, exp: i32) -> Scaled128 {
    if mant == 0 or exp < -100000 or exp > 100000 {
        return Scaled128 {
            mant: 0,
            exp: 0,
        };
    }
    let lz = math_intrinsics.leading_zeros(mant);
    if lz >= 128 {
        return Scaled128 {
            mant: 0,
            exp: 0,
        };
    }
    let shifted = math_intrinsics.funnel_shift_left(mant, 0, lz);
    let lz_u8 = lz'bitvec[0..7].as(u8);
    let lz_i32 = lz_u8'bitvec.as(u32)'bitvec.as(i32);
    if lz_i32 < 0 or lz_i32 > 127 {
        return Scaled128 {
            mant: 0,
            exp: 0,
        };
    }
    Scaled128 {
        mant: shifted,
        exp: exp - lz_i32,
    }
}

fn s128_mul(a: Scaled128, b: Scaled128) -> Scaled128 {
    if a.mant == 0 or b.mant == 0 {
        return Scaled128 {
            mant: 0,
            exp: 0,
        };
    }
    if a.exp < -100000 or a.exp > 100000 or b.exp < -100000 or b.exp > 100000 {
        return Scaled128 {
            mant: 0,
            exp: 0,
        };
    }
    let hi = mul_hi128(a.mant, b.mant);
    if hi'bitvec[127..128].as(u8) == 0 {
        Scaled128 {
            mant: math_intrinsics.funnel_shift_left(hi, 0, 1),
            exp: a.exp + b.exp + 127,
        }
    } else {
        Scaled128 {
            mant: hi,
            exp: a.exp + b.exp + 128,
        }
    }
}

fn pow5_scaled(p: i32) -> Scaled128 {
    -- Normalized 2^127 * 2^-127 == 1.
    let one = Scaled128 {
        mant: 170141183460469231731687303715884105728,
        exp: -127,
    };
    if p == 0 or p < -1000 or p > 1000 {
        return one;
    }
    var base = if p > 0 {
        normalize_u128(5, 0)
    } else {
        -- Normalized rounding of 1/5 == 0xcccccccccccccccccccccccccccccccd * 2^-130.
        Scaled128 {
            mant: 272225893536750770770699685945414569165,
            exp: -130,
        }
    }
    let abs_p: i32 = if p > 0 { p } else { -p }
    var exponent: u32 = abs_p'bitvec.as(u32);
    if exponent > 1000 {
        return one;
    }
    var acc = one;
    while exponent > 0 {
        if exponent % 2 == 1 {
            acc = s128_mul(acc, base);
        }
        exponent = exponent / 2;
        if exponent > 0 {
            base = s128_mul(base, base);
        }
    }
    acc
}

fn to_fixed120(mant: u128, exp: i32, scale: Scaled128) -> u128 {
    let prod = s128_mul(normalize_u128(mant, exp), scale);
    if prod.mant == 0 {
        return 0;
    }
    if prod.exp < -100000 or prod.exp > 100000 {
        return 0;
    }
    let pe120 = prod.exp + 120;
    let u128_max: u128 = 340282366920938463463374607431768211455;
    if pe120 >= 0 {
        return u128_max;
    }
    let shift = -pe120;
    if shift >= 128 {
        return 0;
    }
    let shift_u128 = shift'bitvec[0..7].as(u128);
    if shift_u128 == 0 or shift_u128 >= 128 {
        return 0;
    }
    let q = math_intrinsics.funnel_shift_right(0, prod.mant, shift_u128);
    let round_bit = math_intrinsics.funnel_shift_right(0, prod.mant, shift_u128 - 1) % 2;
    if q < u128_max { q + round_bit } else { q }
}

struct FixedInterval {
    slo: u128,
    smid: u128,
    shi: u128,
    dec_exp: i32,
    exact_ten: bool,
}

impl Clone for FixedInterval {
    fn clone(*self) -> Self {
        FixedInterval {
            slo: self.slo.*,
            smid: self.smid.*,
            shi: self.shi.*,
            dec_exp: self.dec_exp.*,
            exact_ten: self.exact_ten.*,
        }
    }
}

impl Copy for FixedInterval {}

fn estimate_dec_exp(mant: u64, exp2: i32) -> i32 {
    if exp2 < -1200 or exp2 > 1200 {
        return 0;
    }
    let lz64 = math_intrinsics.leading_zeros(mant);
    let lz64_u8 = lz64'bitvec[0..7].as(u8);
    let lz64_i32 = lz64_u8'bitvec.as(u32)'bitvec.as(i32);
    let bit_len = if lz64_i32 >= 0 and lz64_i32 < 64 {
        64 - lz64_i32
    } else {
        1
    }
    let n = exp2 + bit_len - 1;
    let abs_n_i32: i32 = if n >= 0 { n } else { -n }
    let abs_n: u32 = abs_n_i32'bitvec.as(u32);
    if abs_n > 2000 {
        return 0;
    }
    let k_mag: u32 = if n >= 0 {
        (abs_n * 78913) / 262144
    } else {
        (abs_n * 78913 + 262143) / 262144
    }
    let k_i32 = k_mag'bitvec.as(i32);
    if k_i32 < 0 or k_i32 > 1000 {
        return 0;
    }
    if n >= 0 { k_i32 } else { -k_i32 }
}

fn compute_scaled_triplet(
    mant_u128: u128,
    b_exp: i32,
    asymmetric: bool,
    k: i32,
) -> FixedInterval {
    if mant_u128 == 0 or mant_u128 > 9007199254740991 or k < -1000 or k > 1000 {
        return FixedInterval {
            slo: 0,
            smid: 0,
            shi: 0,
            dec_exp: k,
            exact_ten: false,
        };
    }
    let mid_m = 4 * mant_u128;
    let hi_m = mid_m + 2;
    let lo_m = if asymmetric { mid_m - 1 } else { mid_m - 2 }
    let p5 = pow5_scaled(-k);
    if p5.exp < -100000 or p5.exp > 100000 {
        return FixedInterval {
            slo: 0,
            smid: 0,
            shi: 0,
            dec_exp: k,
            exact_ten: false,
        };
    }
    let scale = Scaled128 {
        mant: p5.mant,
        exp: p5.exp - k,
    };
    let slo_raw = to_fixed120(lo_m, b_exp, scale);
    let smid = to_fixed120(mid_m, b_exp, scale);
    let shi_raw = to_fixed120(hi_m, b_exp, scale);

    let u128_max: u128 = 340282366920938463463374607431768211455;
    let err_margin: u128 = 256;
    let slo = if slo_raw <= u128_max - err_margin {
        slo_raw + err_margin
    } else {
        u128_max
    };
    let shi = if shi_raw >= err_margin {
        shi_raw - err_margin
    } else {
        0
    };
    FixedInterval {
        slo: slo,
        smid: smid,
        shi: shi,
        dec_exp: k,
        exact_ten: false,
    }
}

fn scale_finite_interval(
    mant_u128: u128,
    b_exp: i32,
    asymmetric: bool,
    init_k: i32,
) -> FixedInterval {
    let one120: u128 = 1329227995784915872903807060280344576;
    let ten120: u128 = 13292279957849158729038070602803445760;
    var k: i32 = init_k;
    var tries: u8 = 0;
    var iv = FixedInterval {
        slo: 0,
        smid: 0,
        shi: 0,
        dec_exp: k,
        exact_ten: false,
    };
    while tries < 6 {
        if k < -1000 or k > 1000 {
            break;
        }
        iv = compute_scaled_triplet(mant_u128, b_exp, asymmetric, k);
        if iv.shi < one120 {
            k = k - 1;
            tries = tries + 1;
        } else if iv.slo >= ten120 {
            k = k + 1;
            tries = tries + 1;
        } else if iv.shi >= ten120 {
            return FixedInterval {
                slo: iv.slo,
                smid: iv.smid,
                shi: iv.shi,
                dec_exp: k + 1,
                exact_ten: true,
            };
        } else {
            break;
        }
    }
    iv
}

fn choose_terminal_digit(d_lo: u8, f_lo: u128, d_mid: u8, f_mid: u128, d_hi: u8) -> u8 {
    let low_ceil: u8 = if f_lo == 0 {
        d_lo
    } else if d_lo < 255 {
        d_lo + 1
    } else {
        255
    }
    if low_ceil > d_hi {
        return 255;
    }
    let half120: u128 = 664613997892457936451903530140172288;
    if d_mid < low_ceil {
        low_ceil
    } else if d_mid > d_hi {
        d_hi
    } else if d_mid < d_hi and (f_mid > half120 or (f_mid == half120 and d_mid % 2 == 1)) {
        d_mid + 1
    } else {
        d_mid
    }
}

fn trim_trailing_zeros(digits_in: u64, count_in: u8, dec_exp: i32) -> DecimalDigits {
    var digits = digits_in;
    var count = count_in;
    while count > 1 and digits % 10 == 0 {
        digits = digits / 10;
        count = count - 1;
    }
    DecimalDigits {
        digits: digits,
        count: count,
        dec_exp: dec_exp,
    }
}

fn append_decimal_digit(digits: u64, digit: u8) -> u64 {
    let d64 = digit'bitvec.as(u64);
    if d64 <= 9 and digits <= 1844674407370955160 {
        digits * 10 + d64
    } else {
        digits
    }
}

fn extract_finite_digits(iv_in: FixedInterval, max_digits: u8) -> DecimalDigits {
    let ten120: u128 = 13292279957849158729038070602803445760;
    var slo = iv_in.slo;
    var smid = iv_in.smid;
    var shi = iv_in.shi;
    if slo > smid {
        slo = smid;
    }
    if shi < smid {
        shi = smid;
    }
    if shi >= ten120 {
        shi = ten120 - 1;
        if smid > shi {
            smid = shi;
        }
        if slo > smid {
            slo = smid;
        }
    }

    var digits: u64 = 0;
    var count: u8 = 0;
    var i: u8 = 0;
    while i < max_digits {
        let d_lo = slo'bitvec[120..128].as(u8);
        let f_lo = slo'bitvec[0..120].as(u128);
        let d_mid = smid'bitvec[120..128].as(u8);
        let f_mid = smid'bitvec[0..120].as(u128);
        let d_hi = shi'bitvec[120..128].as(u8);
        let f_hi = shi'bitvec[0..120].as(u128);

        let term = choose_terminal_digit(d_lo, f_lo, d_mid, f_mid, d_hi);
        if term <= 9 {
            if count < 17 {
                digits = append_decimal_digit(digits, term);
                count = count + 1;
            }
            break;
        } else if i + 1 >= max_digits {
            if count < 17 {
                digits = append_decimal_digit(digits, d_mid);
                count = count + 1;
            }
            break;
        } else {
            if count < 17 {
                digits = append_decimal_digit(digits, d_lo);
                count = count + 1;
            }
            slo = f_lo * 10;
            smid = f_mid * 10;
            shi = f_hi * 10;
            if smid < slo {
                smid = slo;
            }
            if shi < smid {
                shi = smid;
            }
            i = i + 1;
        }
    }
    trim_trailing_zeros(digits, count, iv_in.dec_exp)
}

fn format_finite_digits(mant: u64, exp2: i32, asymmetric: bool, max_digits: u8) -> DecimalDigits {
    if mant == 0
        or mant > 9007199254740991
        or exp2 < -1200
        or exp2 > 1200
        or max_digits == 0
        or max_digits > 17
    {
        return DecimalDigits {
            digits: 0,
            count: 1,
            dec_exp: 0,
        };
    }

    let mant_u128 = mant'bitvec.as(u128);
    let init_k = estimate_dec_exp(mant, exp2);
    let iv = scale_finite_interval(mant_u128, exp2 - 2, asymmetric, init_k);
    if iv.exact_ten {
        return DecimalDigits {
            digits: 1,
            count: 1,
            dec_exp: iv.dec_exp,
        };
    }
    extract_finite_digits(iv, max_digits)
}

fn write_digits_slice(
    digits: u64,
    count: u8,
    start: u8,
    end: u8,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if count == 0 or count > 17 or start >= end or end > count {
        return;
    }
    var divisor: u64 = 1;
    var step: u8 = 1;
    while step < count {
        if divisor > 1844674407370955161 {
            return;
        }
        divisor = divisor * 10;
        step = step + 1;
    }

    var remaining = digits;
    var pos: u8 = 0;
    while pos < end {
        if divisor == 0 or pos >= 17 {
            return;
        }
        let q = remaining / divisor;
        remaining = remaining % divisor;
        if pos >= start {
            let d = (q % 10)'bitvec[0..8].as(u8);
            assumes d <= 9;
            output.write_byte(48 + d)!;
        }
        if divisor >= 10 {
            divisor = divisor / 10;
        }
        pos = pos + 1;
    }
}

fn write_zero_bytes(count: i32, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if count <= 0 or count > 100 {
        return;
    }
    var i: i32 = 0;
    while i < count {
        output.write_byte(48)!;
        i = i + 1;
    }
}

fn write_exp_uint(value: u32, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if value >= 10 {
        write_exp_uint(value / 10, output)!;
    }
    let digit = (value % 10)'bitvec[0..8].as(u8);
    assumes digit <= 9;
    output.write_byte(48 + digit)
}

fn write_decimal_digits(
    sign: bool,
    dec: DecimalDigits,
    require_decimal: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if sign {
        output.write_byte(45)!;
    }
    let digits = dec.digits;
    let count = dec.count;
    let dec_exp = dec.dec_exp;
    if count == 0 or count > 17 {
        output.write_byte(48)!;
        if require_decimal {
            output.write_str(".0")!;
        }
        return;
    }
    let count_i32 = count'bitvec.as(u32)'bitvec.as(i32);
    if count_i32 < 1 or count_i32 > 17 {
        return;
    }
    if dec_exp >= -4 and dec_exp <= 15 {
        if dec_exp >= count_i32 - 1 {
            write_digits_slice(digits, count, 0, count, output)!;
            let trailing_zeros = dec_exp - (count_i32 - 1);
            write_zero_bytes(trailing_zeros, output)!;
            if require_decimal {
                output.write_str(".0")!;
            }
        } else if dec_exp >= 0 {
            let split = (dec_exp + 1)'bitvec[0..5].as(u8);
            write_digits_slice(digits, count, 0, split, output)!;
            output.write_byte(46)!;
            write_digits_slice(digits, count, split, count, output)!;
        } else {
            output.write_str("0.")!;
            write_zero_bytes(-dec_exp - 1, output)!;
            write_digits_slice(digits, count, 0, count, output)!;
        }
    } else {
        write_digits_slice(digits, count, 0, 1, output)!;
        if count > 1 {
            output.write_byte(46)!;
            write_digits_slice(digits, count, 1, count, output)!;
        } else if require_decimal {
            output.write_str(".0")!;
        }
        output.write_byte(101)!;
        if dec_exp < 0 {
            output.write_byte(45)!;
            if dec_exp > -100000 {
                write_exp_uint((-dec_exp)'bitvec.as(u32), output)!;
            }
        } else if dec_exp < 100000 {
            write_exp_uint(dec_exp'bitvec.as(u32), output)!;
        }
    }
}

struct UnpackedFloat {
    sign: bool,
    is_special: bool,
    mant: u64,
    exp2: i32,
    asymmetric: bool,
    max_digits: u8,
}

impl Clone for UnpackedFloat {
    fn clone(*self) -> Self {
        UnpackedFloat {
            sign: self.sign.*,
            is_special: self.is_special.*,
            mant: self.mant.*,
            exp2: self.exp2.*,
            asymmetric: self.asymmetric.*,
            max_digits: self.max_digits.*,
        }
    }
}

impl Copy for UnpackedFloat {}

fn unpack_f64(value: f64) -> UnpackedFloat {
    let bits = value'bitvec.as(u64);
    let sign = bits'bitvec[63..64].as(u8) != 0;
    let raw_exp = bits'bitvec[52..63].as(u16);
    let frac = bits'bitvec[0..52].as(u64);
    if raw_exp == 2047 {
        UnpackedFloat {
            sign: sign,
            is_special: true,
            mant: frac,
            exp2: 0,
            asymmetric: false,
            max_digits: 17,
        }
    } else if raw_exp == 0 {
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: frac,
            exp2: -1074,
            asymmetric: false,
            max_digits: 17,
        }
    } else {
        let mant = 4503599627370496 + frac;
        let raw_i32 = raw_exp'bitvec.as(u32)'bitvec.as(i32);
        let exp2 = if raw_i32 >= 1 and raw_i32 <= 2046 {
            raw_i32 - 1075
        } else {
            0
        }
        let asym = frac == 0 and raw_exp > 1;
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: mant,
            exp2: exp2,
            asymmetric: asym,
            max_digits: 17,
        }
    }
}

fn unpack_f32(value: f32) -> UnpackedFloat {
    let bits = value'bitvec.as(u32);
    let sign = bits'bitvec[31..32].as(u8) != 0;
    let raw_exp = bits'bitvec[23..31].as(u8);
    let frac = bits'bitvec[0..23].as(u64);
    if raw_exp == 255 {
        UnpackedFloat {
            sign: sign,
            is_special: true,
            mant: frac,
            exp2: 0,
            asymmetric: false,
            max_digits: 9,
        }
    } else if raw_exp == 0 {
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: frac,
            exp2: -149,
            asymmetric: false,
            max_digits: 9,
        }
    } else {
        let mant = 8388608 + frac;
        let raw_i32 = raw_exp'bitvec.as(u32)'bitvec.as(i32);
        let exp2 = if raw_i32 >= 1 and raw_i32 <= 254 {
            raw_i32 - 150
        } else {
            0
        }
        let asym = frac == 0 and raw_exp > 1;
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: mant,
            exp2: exp2,
            asymmetric: asym,
            max_digits: 9,
        }
    }
}

fn unpack_f16(value: f16) -> UnpackedFloat {
    let bits = value'bitvec.as(u16);
    let sign = bits'bitvec[15..16].as(u8) != 0;
    let raw_exp = bits'bitvec[10..15].as(u8);
    let frac = bits'bitvec[0..10].as(u64);
    if raw_exp == 31 {
        UnpackedFloat {
            sign: sign,
            is_special: true,
            mant: frac,
            exp2: 0,
            asymmetric: false,
            max_digits: 5,
        }
    } else if raw_exp == 0 {
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: frac,
            exp2: -24,
            asymmetric: false,
            max_digits: 5,
        }
    } else {
        let mant = 1024 + frac;
        let raw_i32 = raw_exp'bitvec.as(u32)'bitvec.as(i32);
        let exp2 = if raw_i32 >= 1 and raw_i32 <= 30 {
            raw_i32 - 25
        } else {
            0
        }
        let asym = frac == 0 and raw_exp > 1;
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: mant,
            exp2: exp2,
            asymmetric: asym,
            max_digits: 5,
        }
    }
}

fn unpack_bf16(value: bf16) -> UnpackedFloat {
    let bits = value'bitvec.as(u16);
    let sign = bits'bitvec[15..16].as(u8) != 0;
    let raw_exp = bits'bitvec[7..15].as(u8);
    let frac = bits'bitvec[0..7].as(u64);
    if raw_exp == 255 {
        UnpackedFloat {
            sign: sign,
            is_special: true,
            mant: frac,
            exp2: 0,
            asymmetric: false,
            max_digits: 4,
        }
    } else if raw_exp == 0 {
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: frac,
            exp2: -133,
            asymmetric: false,
            max_digits: 4,
        }
    } else {
        let mant = 128 + frac;
        let raw_i32 = raw_exp'bitvec.as(u32)'bitvec.as(i32);
        let exp2 = if raw_i32 >= 1 and raw_i32 <= 254 {
            raw_i32 - 134
        } else {
            0
        }
        let asym = frac == 0 and raw_exp > 1;
        UnpackedFloat {
            sign: sign,
            is_special: false,
            mant: mant,
            exp2: exp2,
            asymmetric: asym,
            max_digits: 4,
        }
    }
}

fn write_unpacked_float(
    u: UnpackedFloat,
    require_decimal: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if u.is_special {
        if u.mant != 0 {
            return output.write_str("NaN");
        } else if u.sign {
            return output.write_str("-inf");
        } else {
            return output.write_str("inf");
        }
    }
    if u.mant == 0 {
        if u.sign {
            output.write_byte(45)!;
        }
        output.write_byte(48)!;
        if require_decimal {
            output.write_str(".0")!;
        }
        return;
    }
    let dec = format_finite_digits(u.mant, u.exp2, u.asymmetric, u.max_digits);
    write_decimal_digits(u.sign, dec, require_decimal, output)
}

pub fn write_f64(
    value: f64,
    require_decimal: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float(unpack_f64(value), require_decimal, output)
}

pub fn write_f32(
    value: f32,
    require_decimal: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float(unpack_f32(value), require_decimal, output)
}

pub fn write_f16(
    value: f16,
    require_decimal: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float(unpack_f16(value), require_decimal, output)
}

pub fn write_bf16(
    value: bf16,
    require_decimal: bool,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float(unpack_bf16(value), require_decimal, output)
}

{- ── Zero-allocation fixed-precision & option-aware float formatting ──────── -}

fn write_zero_bytes_u32(count: u32, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    var rem = count;
    while rem >= 8 {
        output.write_str("00000000")!;
        rem = rem - 8;
    }
    while rem > 0 {
        output.write_byte(48)!;
        rem = rem - 1;
    }
}

fn pow5_u128(p: u32) -> u128 {
    if p > 32 {
        return 1;
    }
    var acc: u128 = 1;
    var i: u32 = 0;
    while i < p {
        if acc > 50000000000000000000000 {
            return acc;
        }
        acc = acc * 5;
        i = i + 1;
    }
    acc
}

fn pow10_u128(p: u32) -> u128 {
    if p > 38 {
        return 1;
    }
    var acc: u128 = 1;
    var i: u32 = 0;
    while i < p {
        if acc > 34028236692093846346337460743176821145 {
            return acc;
        }
        acc = acc * 10;
        i = i + 1;
    }
    acc
}

fn pow10_u64(n: u8) -> u64 {
    if n > 19 {
        return 1;
    }
    var acc: u64 = 1;
    var i: u8 = 0;
    while i < n {
        if acc > 1844674407370955161 {
            return acc;
        }
        acc = acc * 10;
        i = i + 1;
    }
    acc
}

fn count_u128_digits(value: u128) -> u32 {
    var v = value;
    var count: u32 = 1;
    while v >= 10 {
        v = v / 10;
        if count < 100 {
            count = count + 1;
        }
    }
    count
}

fn write_u128_decimal(value: u128, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    let digits_count = count_u128_digits(value);
    if digits_count == 0 or digits_count > 39 {
        return;
    }
    let raw_scale = pow10_u128(digits_count - 1);
    var scale: u128 = if raw_scale > 0 { raw_scale } else { 1 };
    var rem = value;
    var pos: u32 = 0;
    while pos < digits_count {
        if scale == 0 or pos >= 39 {
            return;
        }
        let q = rem / scale;
        rem = rem % scale;
        let d = (q % 10)'bitvec[0..8].as(u8);
        assumes d <= 9;
        output.write_byte(48 + d)!;
        scale = if scale >= 10 { scale / 10 } else { 1 };
        pos = pos + 1;
    }
}

fn write_u128_fixed(
    sign: bool,
    q: u128,
    p: u32,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if sign {
        output.write_byte(45)!;
    }
    if p == 0 {
        return write_u128_decimal(q, output);
    }
    let div = pow10_u128(p);
    if div == 0 {
        return write_u128_decimal(q, output);
    }
    write_u128_decimal(q / div, output)!;
    output.write_byte(46)!;
    let frac = q % div;
    let frac_digits = count_u128_digits(frac);
    if p > frac_digits {
        write_zero_bytes_u32(p - frac_digits, output)!;
    }
    write_u128_decimal(frac, output)
}

fn round_decimal_to_keep(dec: DecimalDigits, keep: i32) -> DecimalDigits {
    let count_i32 = dec.count'bitvec.as(u32)'bitvec.as(i32);
    if dec.count == 0 or dec.count > 17 {
        return dec;
    }
    if count_i32 < 1 or count_i32 > 17 {
        return dec;
    }
    if keep <= 0 or keep >= count_i32 {
        return dec;
    }
    let base_exp = dec.dec_exp;
    if base_exp < -10000 or base_exp > 10000 {
        return dec;
    }
    let drop_i32 = count_i32 - keep;
    if drop_i32 < 1 or drop_i32 > 16 {
        return dec;
    }
    let drop_u8 = drop_i32'bitvec[0..5].as(u8);
    let div = pow10_u64(drop_u8);
    if div == 0 {
        return dec;
    }
    let head = dec.digits / div;
    let rem = dec.digits % div;
    let half = div / 2;
    let round_up = rem > half or (rem == half and head % 2 == 1);
    let next_head = if round_up and head < 18446744073709551615 {
        head + 1
    } else {
        head
    };
    let keep_u8 = keep'bitvec[0..5].as(u8);
    let overflow_limit = pow10_u64(keep_u8);
    if next_head == overflow_limit {
        DecimalDigits {
            digits: 1,
            count: 1,
            dec_exp: base_exp + 1,
        }
    } else {
        DecimalDigits {
            digits: next_head,
            count: keep_u8,
            dec_exp: base_exp,
        }
    }
}

fn write_fixed_zero(
    precision: u32,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    output.write_byte(48)!;
    if precision == 0 {
        return;
    }
    output.write_byte(46)!;
    write_zero_bytes_u32(precision, output)
}

struct FixedDecimalPlan {
    kind: u8,
    digits: u64,
    count: u8,
    split: u8,
    frac_end: u8,
    pad_zeros_1: u32,
    pad_zeros_2: u32,
}

impl Clone for FixedDecimalPlan {
    fn clone(*self) -> Self {
        FixedDecimalPlan {
            kind: self.kind.*,
            digits: self.digits.*,
            count: self.count.*,
            split: self.split.*,
            frac_end: self.frac_end.*,
            pad_zeros_1: self.pad_zeros_1.*,
            pad_zeros_2: self.pad_zeros_2.*,
        }
    }
}

impl Copy for FixedDecimalPlan {}

fn empty_fixed_plan(kind: u8) -> FixedDecimalPlan {
    FixedDecimalPlan {
        kind: kind,
        digits: 0,
        count: 0,
        split: 0,
        frac_end: 0,
        pad_zeros_1: 0,
        pad_zeros_2: 0,
    }
}

fn plan_decimal_keep_zero(digits: u64, count: u8) -> FixedDecimalPlan {
    if count == 0 or count > 17 {
        return empty_fixed_plan(255);
    }
    let scale = pow10_u64(count - 1);
    if scale == 0 {
        return empty_fixed_plan(255);
    }
    let lead = digits / scale;
    let tail = digits % scale;
    if lead > 5 or (lead == 5 and tail > 0) {
        return empty_fixed_plan(1);
    }
    empty_fixed_plan(0)
}

fn plan_decimal_sub_one(
    r_digits: u64,
    r_count: u8,
    eff_exp: i32,
    precision: u32,
    p_i32: i32,
) -> FixedDecimalPlan {
    if r_count == 0 or r_count > 17 or eff_exp >= 0 or eff_exp < -10001 {
        return empty_fixed_plan(255);
    }
    if p_i32 < 0 or p_i32 > 65535 {
        return empty_fixed_plan(255);
    }
    if precision == 0 {
        return empty_fixed_plan(0);
    }
    let lead_zeros_i32 = -eff_exp - 1;
    let lz_u32: u32 = if lead_zeros_i32 > 0 {
        if lead_zeros_i32 <= p_i32 {
            lead_zeros_i32'bitvec.as(u32)
        } else {
            precision
        }
    } else {
        0
    };
    let rem_p = if precision > lz_u32 { precision - lz_u32 } else { 0 };
    let rc_u32 = r_count'bitvec.as(u32);
    if rem_p >= rc_u32 {
        return FixedDecimalPlan {
            kind: 2,
            digits: r_digits,
            count: r_count,
            split: 0,
            frac_end: r_count,
            pad_zeros_1: lz_u32,
            pad_zeros_2: rem_p - rc_u32,
        };
    }
    if rem_p == 0 or rem_p > 17 {
        return FixedDecimalPlan {
            kind: 2,
            digits: r_digits,
            count: r_count,
            split: 0,
            frac_end: 0,
            pad_zeros_1: lz_u32,
            pad_zeros_2: 0,
        };
    }
    FixedDecimalPlan {
        kind: 2,
        digits: r_digits,
        count: r_count,
        split: 0,
        frac_end: rem_p'bitvec[0..5].as(u8),
        pad_zeros_1: lz_u32,
        pad_zeros_2: 0,
    }
}

fn plan_decimal_ge_one(
    r_digits: u64,
    r_count: u8,
    eff_exp: i32,
    precision: u32,
) -> FixedDecimalPlan {
    if r_count == 0 or r_count > 17 or eff_exp < 0 or eff_exp > 10001 {
        return empty_fixed_plan(255);
    }
    let rc_i32 = r_count'bitvec.as(u32)'bitvec.as(i32);
    if rc_i32 < 1 or rc_i32 > 17 {
        return empty_fixed_plan(255);
    }
    if eff_exp >= rc_i32 - 1 {
        let trailing_i32 = eff_exp - (rc_i32 - 1);
        let trailing_u32: u32 = if trailing_i32 > 0 { trailing_i32'bitvec.as(u32) } else { 0 };
        return FixedDecimalPlan {
            kind: 3,
            digits: r_digits,
            count: r_count,
            split: 0,
            frac_end: 0,
            pad_zeros_1: trailing_u32,
            pad_zeros_2: 0,
        };
    }
    let split_u8 = (eff_exp + 1)'bitvec[0..5].as(u8);
    if split_u8 > r_count or split_u8 > 17 {
        return empty_fixed_plan(255);
    }
    let avail_frac = r_count - split_u8;
    let avail_u32 = avail_frac'bitvec.as(u32);
    if precision >= avail_u32 {
        return FixedDecimalPlan {
            kind: 4,
            digits: r_digits,
            count: r_count,
            split: split_u8,
            frac_end: r_count,
            pad_zeros_1: 0,
            pad_zeros_2: precision - avail_u32,
        };
    }
    let frac_end: u8 = if precision <= 17 {
        let frac_take = precision'bitvec[0..5].as(u8);
        if frac_take <= 17 and split_u8 + frac_take <= 17 {
            split_u8 + frac_take
        } else {
            split_u8
        }
    } else {
        split_u8
    };
    FixedDecimalPlan {
        kind: 4,
        digits: r_digits,
        count: r_count,
        split: split_u8,
        frac_end: frac_end,
        pad_zeros_1: 0,
        pad_zeros_2: 0,
    }
}

fn plan_decimal_fixed(dec: DecimalDigits, precision: u32) -> FixedDecimalPlan {
    let digits = dec.digits;
    let count = dec.count;
    let dec_exp = dec.dec_exp;
    if count == 0 or count > 17 or dec_exp < -10000 or dec_exp > 10000 {
        return empty_fixed_plan(0);
    }
    let p_i32: i32 = if precision <= 65535 { precision'bitvec.as(i32) } else { 65535 };
    if p_i32 < 0 or p_i32 > 65535 {
        return empty_fixed_plan(255);
    }
    let keep: i32 = dec_exp + 1 + p_i32;
    if keep < 0 {
        return empty_fixed_plan(0);
    }
    if keep == 0 {
        return plan_decimal_keep_zero(digits, count);
    }
    let count_i32 = count'bitvec.as(u32)'bitvec.as(i32);
    if count_i32 < 1 or count_i32 > 17 {
        return empty_fixed_plan(255);
    }
    let rounded = if keep < count_i32 {
        round_decimal_to_keep(dec, keep)
    } else {
        dec
    };
    let r_digits = rounded.digits;
    let r_count = rounded.count;
    let eff_exp = rounded.dec_exp;
    if r_count == 0 or r_count > 17 or eff_exp < -10001 or eff_exp > 10001 {
        return empty_fixed_plan(255);
    }
    if eff_exp < 0 {
        return plan_decimal_sub_one(r_digits, r_count, eff_exp, precision, p_i32);
    }
    plan_decimal_ge_one(r_digits, r_count, eff_exp, precision)
}

fn write_fixed_plan(
    sign: bool,
    plan: FixedDecimalPlan,
    precision: u32,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if sign {
        output.write_byte(45)!;
    }
    if plan.kind == 0 {
        return write_fixed_zero(precision, output);
    }
    if plan.kind == 1 {
        if precision == 0 {
            return output.write_byte(49);
        }
        output.write_str("0.")!;
        write_zero_bytes_u32(precision - 1, output)!;
        return output.write_byte(49);
    }
    if plan.kind == 2 {
        output.write_byte(48)!;
        if precision == 0 {
            return;
        }
        output.write_byte(46)!;
        if plan.pad_zeros_1 > 0 {
            write_zero_bytes_u32(plan.pad_zeros_1, output)!;
        }
        if plan.frac_end > 0 {
            write_digits_slice(plan.digits, plan.count, 0, plan.frac_end, output)!;
        }
        if plan.pad_zeros_2 > 0 {
            write_zero_bytes_u32(plan.pad_zeros_2, output)!;
        }
        return;
    }
    if plan.kind == 3 {
        write_digits_slice(plan.digits, plan.count, 0, plan.count, output)!;
        if plan.pad_zeros_1 > 0 {
            write_zero_bytes_u32(plan.pad_zeros_1, output)!;
        }
        if precision == 0 {
            return;
        }
        output.write_byte(46)!;
        return write_zero_bytes_u32(precision, output);
    }
    if plan.kind == 4 {
        write_digits_slice(plan.digits, plan.count, 0, plan.split, output)!;
        if precision == 0 {
            return;
        }
        output.write_byte(46)!;
        if plan.frac_end > plan.split {
            write_digits_slice(plan.digits, plan.count, plan.split, plan.frac_end, output)!;
        }
        if plan.pad_zeros_2 > 0 {
            write_zero_bytes_u32(plan.pad_zeros_2, output)!;
        }
        return;
    }
}

fn round_shift_right_u128(prod: u128, shift: i32) -> u128 {
    if shift <= 0 {
        return prod;
    }
    if shift == 128 {
        if prod > 170141183460469231731687303715884105728 {
            return 1;
        }
        return 0;
    }
    if shift > 128 {
        return 0;
    }
    let shift_u128 = shift'bitvec[0..7].as(u128);
    if shift_u128 < 1 or shift_u128 > 127 {
        return 0;
    }
    var q = math_intrinsics.funnel_shift_right(0, prod, shift_u128);
    let lo_prod = math_intrinsics.funnel_shift_left(q, 0, shift_u128);
    let rem = if prod >= lo_prod { prod - lo_prod } else { 0 };
    let half = math_intrinsics.funnel_shift_left(1, 0, shift_u128 - 1);
    if rem > half or (rem == half and q % 2 == 1) {
        if q < 340282366920938463463374607431768211455 {
            q = q + 1;
        }
    }
    q
}

fn compute_u128_fixed_fast(mant: u64, exp2: i32, precision: u32) -> ?u128 {
    if precision > 32 or mant > 9007199254740991 or exp2 < -1200 or exp2 > 1200 {
        return null;
    }
    let p5 = pow5_u128(precision);
    let mant_u128 = mant'bitvec.as(u128);
    assumes mant_u128 <= 9007199254740991;
    assumes p5 <= 23283064365386962890625;
    let prod = mant_u128 * p5;
    let p_i32 = precision'bitvec.as(i32);
    assumes p_i32 >= 0;
    assumes p_i32 <= 32;
    let s: i32 = exp2 + p_i32;
    if s <= 0 {
        return round_shift_right_u128(prod, -s);
    }
    if s > 127 {
        return null;
    }
    let lz = math_intrinsics.leading_zeros(prod);
    if lz > 128 {
        return null;
    }
    let lz_u8 = lz'bitvec[0..8].as(u8);
    let lz_i32 = lz_u8'bitvec.as(u32)'bitvec.as(i32);
    if s > lz_i32 {
        return null;
    }
    let s_u128 = s'bitvec[0..7].as(u128);
    math_intrinsics.funnel_shift_left(prod, 0, s_u128)
}

fn write_unpacked_float_fixed(
    u: UnpackedFloat,
    precision: u32,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if u.is_special {
        if u.mant != 0 {
            return output.write_str("NaN");
        } else if u.sign {
            return output.write_str("-inf");
        } else {
            return output.write_str("inf");
        }
    }
    if u.mant == 0 {
        if u.sign {
            output.write_byte(45)!;
        }
        return write_fixed_zero(precision, output);
    }
    compute_u128_fixed_fast(u.mant, u.exp2, precision) match {
        q? => return write_u128_fixed(u.sign, q, precision, output),
        null => {},
    }
    let dec = format_finite_digits(u.mant, u.exp2, u.asymmetric, u.max_digits);
    let plan = plan_decimal_fixed(dec, precision);
    write_fixed_plan(u.sign, plan, precision, output)
}

fn write_float_abs_body(
    u_abs: UnpackedFloat,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if opts.has_precision {
        write_unpacked_float_fixed(u_abs, opts.precision, output)
    } else {
        write_unpacked_float(u_abs, false, output)
    }
}

fn write_unpacked_float_formatted(
    u: UnpackedFloat,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if opts.sign == 0 and not opts.has_len and not opts.has_precision {
        return write_unpacked_float(u, false, output);
    }
    let is_nan = u.is_special and u.mant != 0;
    let sign_byte: u8 = if is_nan {
        0
    } else if u.sign {
        45
    } else if opts.sign == 1 {
        43
    } else if opts.sign == 2 {
        32
    } else {
        0
    };
    let u_abs = UnpackedFloat {
        sign: false,
        is_special: u.is_special,
        mant: u.mant,
        exp2: u.exp2,
        asymmetric: u.asymmetric,
        max_digits: u.max_digits,
    };

    if not opts.has_len {
        if sign_byte != 0 {
            output.write_byte(sign_byte)!;
        }
        return write_float_abs_body(u_abs, opts, output);
    }

    var probe = ProbeWriter.new();
    let probed = write_float_abs_body(u_abs, opts, probe.ref) match {
        _! => true,
        error _ => false,
    }
    assumes probed;
    let sign_len: u32 = if sign_byte != 0 { 1 } else { 0 };
    let probed_chars = probe.chars;
    if probed_chars > 10000000 {
        return;
    }
    let content_chars = sign_len + probed_chars;
    let pads = compute_pad_counts(opts, content_chars, true, not u.is_special);
    if pads.left > 0 {
        write_char_repeat(opts.placeholder, pads.left, output)!;
    }
    if sign_byte != 0 {
        output.write_byte(sign_byte)!;
    }
    if pads.zero_pad > 0 {
        write_char_repeat('0', pads.zero_pad, output)!;
    }
    write_float_abs_body(u_abs, opts, output)!;
    if pads.right > 0 {
        write_char_repeat(opts.placeholder, pads.right, output)!;
    }
}

pub fn write_f64_formatted(
    value: f64,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float_formatted(unpack_f64(value), opts, output)
}

pub fn write_f32_formatted(
    value: f32,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float_formatted(unpack_f32(value), opts, output)
}

pub fn write_f16_formatted(
    value: f16,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float_formatted(unpack_f16(value), opts, output)
}

pub fn write_bf16_formatted(
    value: bf16,
    opts: FormatOptions,
    output: *W,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_unpacked_float_formatted(unpack_bf16(value), opts, output)
}
