use primitives.*;
use protocols.formatting.float;
use protocols.formatting.options.{
    FormatOptions,
    compute_pad_counts,
    parse_float_options,
    parse_int_options,
    parse_plain_options,
    parse_text_options,
    write_char_repeat,
    write_char_utf8,
    write_padded_str,
    write_padded_str_truncated,
}
use protocols.formatting.radix.{write_signed_formatted, write_unsigned_formatted}
use protocols.formatting.writer.ByteWriter;

{-
    Human-facing formatting protocol. Implementations borrow `*self` and
    write into a `ByteWriter` according to `comptime .format: str` property
    options without consuming affine `Once` values.
-}
pub trait Display {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter;
}

impl Display for bool {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter
    {
        let opts: FormatOptions = parse_plain_options(format);
        let text = if self.* { "true" } else { "false" };
        write_padded_str(text, opts, false, output)
    }
}

impl Display for u8 {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter
    {
        let opts: FormatOptions = parse_int_options(format);
        write_unsigned_formatted(self.*'bitvec.as(u128), opts, output)
    }
}

impl Display for u16 {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
