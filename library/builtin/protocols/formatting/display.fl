impl Display for isize {
    fn write(self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        if self < 0 {
            output.write_byte(45)!;
            let magnitude = builtin.compiler.isize_representation(-(self + 1));
            assumes magnitude < 340282366920938463463374607431768211455;
            unsigned_decimal(magnitude + 1, output)
        } else {
            unsigned_decimal(builtin.compiler.isize_representation(self), output)
        }
    }
}

impl Display for char {
    fn write(self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        let code = self'bitvec.as(u32);
        if code <= 127 {
            output.write_byte(code'bitvec[0..8].as(u8))
        } else if code <= 2047 {
            let first = (code / 64) + 192;
            let second = (code % 64) + 128;
            output.write_byte(first'bitvec[0..8].as(u8))!;
            output.write_byte(second'bitvec[0..8].as(u8))
        } else if code <= 65535 {
            let first = (code / 4096) + 224;
            let second = (code / 64 % 64) + 128;
            let third = (code % 64) + 128;
            output.write_byte(first'bitvec[0..8].as(u8))!;
            output.write_byte(second'bitvec[0..8].as(u8))!;
            output.write_byte(third'bitvec[0..8].as(u8))
        } else {
            let first = (code / 262144) + 240;
            let second = (code / 4096 % 64) + 128;
            let third = (code / 64 % 64) + 128;
            let fourth = (code % 64) + 128;
            output.write_byte(first'bitvec[0..8].as(u8))!;
            output.write_byte(second'bitvec[0..8].as(u8))!;
            output.write_byte(third'bitvec[0..8].as(u8))!;
            output.write_byte(fourth'bitvec[0..8].as(u8))
        }
    }
}

impl Display for str {
    fn write(self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        output.write_str(self)
    }
}

impl Display for Symbol {
    fn write(self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        let name = self;
        let length = symbol_byte_length(name);
        var index: u64 = 0;
        while index < length {
            let byte = symbol_byte(name, index) match {
                value? => value,
                null => break,
            }
            output.write_byte(byte)!;
            index = index + 1;
        }
    }
}

impl Display for f16 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        float.write_f16(self, false, output)
    }
}

impl Display for bf16 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        float.write_bf16(self, false, output)
    }
}

impl Display for f32 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
