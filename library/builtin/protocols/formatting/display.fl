impl Display for i8 {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter
    {
        let opts: FormatOptions = parse_int_options(format);
        let v = self.*;
        let twos = v'bitvec.as(u128);
        if v < 0 {
            let inv = (-(v + 1))'bitvec.as(u128);
            assumes inv < 340282366920938463463374607431768211455;
            write_signed_formatted(true, inv + 1, twos, opts, output)
        } else {
            write_signed_formatted(false, twos, twos, opts, output)
        }
    }
}

comptime impl Display for i8 {
    comptime fn comptime_fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_int_options(format);
        let twos = self'bitvec.as(u128);
        if self < 0 {
            let inv = (-(self + 1))'bitvec.as(u128);
            assumes inv < 340282366920938463463374607431768211455;
            format_signed_comptime(true, inv + 1, twos, opts)
        } else {
            format_signed_comptime(false, twos, twos, opts)
        }
    }
}

