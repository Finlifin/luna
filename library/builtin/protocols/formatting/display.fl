impl Display for isize {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter
    {
        let opts: FormatOptions = parse_int_options(format);
        let v = self.*;
        let twos = builtin.compiler.isize_representation(v);
        if v < 0 {
            let inv = builtin.compiler.isize_representation(-(v + 1));
            assumes inv < 340282366920938463463374607431768211455;
            write_signed_formatted(true, inv + 1, twos, opts, output)
        } else {
            write_signed_formatted(false, twos, twos, opts, output)
        }
    }
}

impl Display for char {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter
    {
        let opts: FormatOptions = parse_plain_options(format);
        if not opts.has_len {
            return write_char_utf8(self.*, output);
        }
        let pads = compute_pad_counts(opts, 1, false, false);
        if pads.left > 0 {
            write_char_repeat(opts.placeholder, pads.left, output)!;
        }
        write_char_utf8(self.*, output)!;
        if pads.right > 0 {
            write_char_repeat(opts.placeholder, pads.right, output)!;
        }
    }
}

impl Display for str {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter
    {
        let opts: FormatOptions = parse_text_options(format);
        write_padded_str_truncated(self.*, opts, output)
    }
}

