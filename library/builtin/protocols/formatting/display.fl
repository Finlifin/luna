use protocols.formatting.writer.ByteWriter;

pub trait Display {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter;
}

fn unsigned_decimal(value: u128, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
    if value >= 10 {
        unsigned_decimal(value / 10, output)!;
    }
    let digit = (value % 10)'bitvec[0..8].as(u8);
    assumes digit <= 9;
    output.write_byte(48 + digit)
}

fn signed_decimal(value: i128, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
    if value < 0 {
        output.write_byte(45)!;

        -- -(MIN + 1) fits; add the final unit in the unsigned domain.
        let magnitude = (-(value + 1))'bitvec.as(u128);
        assumes magnitude < 340282366920938463463374607431768211455;
        unsigned_decimal(magnitude + 1, output)
    } else {
        unsigned_decimal(value'bitvec.as(u128), output)
    }
}

impl Display for bool {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
        if self {
            output.write_byte(116)!;
            output.write_byte(114)!;
            output.write_byte(117)!;
            output.write_byte(101)
        } else {
            output.write_byte(102)!;
            output.write_byte(97)!;
            output.write_byte(108)!;
            output.write_byte(115)!;
            output.write_byte(101)
        }
    }
}

impl Display for u8 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
        unsigned_decimal(self'bitvec.as(u128), output)
    }
}

impl Display for u16 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
        unsigned_decimal(self'bitvec.as(u128), output)
    }
}

impl Display for u32 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
