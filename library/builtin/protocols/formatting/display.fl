impl Display for u128 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
        unsigned_decimal(self'bitvec.as(u128), output)
    }
}

impl Display for usize {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
        unsigned_decimal(builtin.compiler.usize_representation(self), output)
    }
}

impl Display for i8 {
    fn write(self, output: *W) -> !W.as(ByteWriter).Error void where W :- ByteWriter {
        if self < 0 {
            output.write_byte(45)!;
            let magnitude = (-(self + 1))'bitvec.as(u128);
            assumes magnitude < 340282366920938463463374607431768211455;
            unsigned_decimal(magnitude + 1, output)
        } else {
            unsigned_decimal(self'bitvec.as(u128), output)
        }
    }
}

