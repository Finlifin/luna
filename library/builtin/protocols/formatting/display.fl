use meta.{
    isize_representation as comptime_isize_representation,
    str_from_char,
    usize_representation as comptime_usize_representation,
}
use primitives.*;
use protocols.formatting.float;
use protocols.formatting.options.{
    FormatOptions,
    compute_pad_counts,
    pad_comptime_str,
    parse_comptime_int_options,
    parse_float_options,
    parse_int_options,
    parse_plain_options,
    parse_text_options,
    truncate_comptime_str,
    write_char_repeat,
    write_char_utf8,
    write_padded_str,
    write_padded_str_truncated,
}
use protocols.formatting.radix.{
    format_integer_comptime,
    format_signed_comptime,
    format_unsigned_comptime,
    write_signed_formatted,
    write_unsigned_formatted,
}
use protocols.formatting.writer.ByteWriter;

{-
    Two-phase human-facing formatting protocol. Runtime implementations borrow
    `*self` and write into a `ByteWriter` according to `comptime .format: str`
    property options without consuming affine `Once` values; comptime phase
    implementations produce a compile-time `str`.
-}
pub trait Display {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter;

    ^attrs.comptime_phase
    comptime fn comptime_fmt(self, .format: str = "") -> str;
}

impl Display for bool {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter
    {
        let opts: FormatOptions = parse_plain_options(format);
        let text = if self.* { "true" } else { "false" };
        write_padded_str(text, opts, false, output)
    }
}

comptime impl Display for bool {
    comptime fn comptime_fmt(self, .format: str = "") -> str {
        let opts: FormatOptions = parse_plain_options(format);
        let text = if self { "true" } else { "false" };
        pad_comptime_str("", text, opts, false, false)
    }
}

