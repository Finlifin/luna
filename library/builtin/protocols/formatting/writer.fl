use bindings.{str_byte, str_byte_length}
use mem_impl.raw.{checked_add_usize, raw_read}
use primitives.{str, u64, u8, usize, void}

{-
    A synchronous byte sink. Success accepts the requested bytes in order.
    Single-byte failure accepts no byte; multi-byte writes stop at the first
    failure without rolling back earlier accepted bytes.
    The receiver is borrowed, so stateful sinks need neither Clone nor Copy.
-}
pub trait ByteWriter {
    assoc Err: Type;

    fn write_byte(*self, byte: u8) -> !Err void;

    {-
        Writes `len` bytes starting at `src` into this sink.

        Safety: `src` must be valid for reading `len` contiguous bytes for the
        duration of the call, and must not alias mutable storage owned by `self`.
    -}
    unsafe fn write_raw_bytes(*self, src: usize, len: usize) -> !Err void {
        var index: usize = 0;
        while index < len {
            let addr = checked_add_usize(src, index) match {
                found? => found,
                null => break,
            }
            let byte = raw_read<u8>(addr);
            self.write_byte(byte)!;
            index = index + 1;
        }
    }

    fn write_str(*self, text: str) -> !Err void {
        let length = str_byte_length(text);
        var index: u64 = 0;
        while index < length {
            let byte = str_byte(text, index) match {
                found? => found,
                null => break,
            }
            self.write_byte(byte)!;
            index = index + 1;
        }
    }
}
