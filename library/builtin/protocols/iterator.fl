{-
    Inline iteration delivers owned items to the consumer's handler. Producing
    an item does not allocate a resumable iterator state. Implementations and
    adapters expose their bodies for joint expansion with the consumer.
-}

use primitives.Type as IterationType;
use primitives.usize as IterationIndex;
use primitives.void as IterationUnit;

pub inline effect emit_item(value: T) where T;

pub trait Iterator {
    assoc Item: IterationType;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit;

    inline fn foreach(self, f: %c fn(Item)) where c: IterationType.vars.Closure {
        self.iterate()# {
            emit_item<Item>(value) => f(value),
        }
    }

    inline fn map(self, f: %c fn(Item) -> U) -> MapIterator<Self, U, c>
        where U, c: IterationType.vars.Closure
    {
        MapIterator<Self, U, c> {iter: self, f: f}
    }

    inline fn intersperse_with(self, make: %c fn() -> Item) -> IntersperseWithIterator<Self, c>
        where c: IterationType.vars.Closure
    {
        IntersperseWithIterator<Self, c> {iter: self, make: make}
    }

    inline fn filter(self, pred: %c fn(*Item) -> bool) -> FilterIterator<Self, c>
        where c: IterationType.vars.Closure
    {
        FilterIterator<Self, c> {iter: self, pred: pred}
    }

    inline fn filter_map(self, f: %c fn(Item) -> ?U) -> FilterMapIterator<Self, U, c>
        where U, c: IterationType.vars.Closure
    {
        FilterMapIterator<Self, U, c> {iter: self, f: f}
    }

    inline fn map_while(self, f: %c fn(Item) -> ?U) -> MapWhileIterator<Self, U, c>
        where U, c: IterationType.vars.Closure
    {
        MapWhileIterator<Self, U, c> {iter: self, f: f}
    }

    inline fn scan(self, initial: A, f: %c fn(*A, Item) -> ?U) -> ScanIterator<Self, A, U, c>
        where A, U, c: IterationType.vars.Closure
    {
        ScanIterator<Self, A, U, c> {iter: self, state: initial, f: f}
    }

    inline fn inspect(self, f: %c fn(*Item)) -> InspectIterator<Self, c>
        where c: IterationType.vars.Closure
    {
        InspectIterator<Self, c> {iter: self, f: f}
    }

    inline fn take_while(self, pred: %c fn(*Item) -> bool) -> TakeWhileIterator<Self, c>
        where c: IterationType.vars.Closure
    {
        TakeWhileIterator<Self, c> {iter: self, pred: pred}
    }

    inline fn skip_while(self, pred: %c fn(*Item) -> bool) -> SkipWhileIterator<Self, c>
        where c: IterationType.vars.Closure
    {
        SkipWhileIterator<Self, c> {iter: self, pred: pred}
    }

    inline fn take(self, count: IterationIndex) -> TakeIterator<Self> {
        TakeIterator<Self> {iter: self, count: count}
    }

    inline fn skip(self, count: IterationIndex) -> SkipIterator<Self> {
        SkipIterator<Self> {iter: self, count: count}
    }

    inline fn flat_map(self, f: %c fn(Item) -> J) -> FlatMapIterator<Self, J, c>
        where J :- Iterator, c: IterationType.vars.Closure
    {
        FlatMapIterator<Self, J, c> {iter: self, f: f}
    }

    inline fn flatten(self) -> FlattenIterator<Self>
        where requires Item :- Iterator
    {
        FlattenIterator<Self> {iter: self}
    }

    inline fn chain(self, next: J) -> ChainIterator<Self, J>
        where J :- Iterator, requires J.as(Iterator).Item == Item
    {
        ChainIterator<Self, J> {first: self, second: next}
    }

    inline fn any(self, pred: %c fn(*Item) -> bool) -> bool
        where c: IterationType.vars.Closure
    {
        self.iterate()# {
            emit_item<Item>(value) => if pred(value.ref) {return true;},
        }
        false
    }

    inline fn all(self, pred: %c fn(*Item) -> bool) -> bool
        where c: IterationType.vars.Closure
    {
        self.iterate()# {
            emit_item<Item>(value) => if not pred(value.ref) {return false;},
        }
        true
    }

    inline fn find(self, pred: %c fn(*Item) -> bool) -> ?Item
        where c: IterationType.vars.Closure
    {
        self.iterate()# {
            emit_item<Item>(value) => if pred(value.ref) {return value;},
        }
        null
    }

    inline fn find_map(self, f: %c fn(Item) -> ?U) -> ?U
        where U, c: IterationType.vars.Closure
    {
        self.iterate()# {
            emit_item<Item>(value) => f(value) match {
                mapped? => {return mapped;},
                null => {},
            },
        }
        null
    }

    inline fn collect(self) -> C where C :- FromIterator<Item> {
        C.from_iter(self)
    }

    {-
        Each callback consumes the accumulator and the next owned item once.
        An error exits this consumer, stopping upstream production and retiring
        the remaining source. Error results retain their ordinary ABI; they
        are not another effect handled by the iteration handler.
    -}
    inline fn try_fold(self, initial: A, f: %c fn(A, Item) -> !E A) -> !E A
        where A, E, c: IterationType.vars.Closure
    {
        var accumulator = initial;
        self.iterate()# {
            emit_item<Item>(value) => {
                accumulator = f(accumulator, value) match {
                    next! => next,
                    error failure => {return error failure;},
                };
            },
        }
        accumulator
    }

    {-
        Use the first item as the accumulator. Empty and singleton streams do
        not call f. Success preserves the optional layer distinguishing an
        empty stream from a present item; the first error stops production and
        transfers its payload while retiring the pending source normally.
    -}
    inline fn try_reduce(self, f: %c fn(Item, Item) -> !E Item) -> !E ?Item
        where E, c: IterationType.vars.Closure
    {
        var accumulator: ?Item = null;
        self.iterate()# {
            emit_item<Item>(value) => {
                accumulator = accumulator match {
                    previous? => f(previous, value) match {
                        next! => next,
                        error failure => {return error failure;},
                    },
                    null => value,
                };
            },
        }
        accumulator
    }

    -- Stop at the first error; empty input succeeds without calling f.
    inline fn try_foreach(self, f: %c fn(Item) -> !E IterationUnit) -> !E IterationUnit
        where E, c: IterationType.vars.Closure
    {
        self.iterate()# {
            emit_item<Item>(value) => f(value) match {
                _! => {},
                error failure => {return error failure;},
            },
        }
    }

    {-
        Select the zero-based item and stop production immediately. Skipped
        items and the unproduced source remainder are retired normally. A
        missing position returns null; a present null payload stays present.
    -}
    inline fn nth(self, index: IterationIndex) -> ?Item {
        var remaining = index;
        self.iterate()# {
            emit_item<Item>(value) => {
                if remaining == 0 {return value;}
                remaining = remaining - 1;
            },
        }
        null
    }

    {-
        Consume the whole stream, retiring each replaced item. The final
        item moves to the caller without requiring Clone or Copy.
    -}
    inline fn last(self) -> ?Item {
        var result: ?Item = null;
        self.iterate()# {
            emit_item<Item>(value) => {result = value;},
        }
        result
    }

    {-
        The first item becomes the accumulator without calling f. Each later
        item and the previous accumulator move into f exactly once. Empty
        input returns null; a null item inside an optional item type remains
        a present result. No identity value or Copy implementation is required.
    -}
    inline fn reduce(self, f: %c fn(Item, Item) -> Item) -> ?Item
        where c: IterationType.vars.Closure
    {
        var accumulator: ?Item = null;
        self.iterate()# {
            emit_item<Item>(value) => {
                accumulator = accumulator match {
                    previous? => f(previous, value),
                    null => value,
                };
            },
        }
        accumulator
    }

    inline fn fold(self, initial: A, f: %c fn(A, Item) -> A) -> A
        where A, c: IterationType.vars.Closure
    {
        var accumulator = initial;
        self.iterate()# {
            emit_item<Item>(value) => {
                accumulator = f(accumulator, value);
            },
        }
        accumulator
    }
}

{-
    An optional contributes its payload exactly once when present. Only this
    optional layer is consumed: a present null payload in ??T is still an item.
-}
impl Iterator for ?T where T {
    assoc Item: IterationType = T;

    inline fn iterate(self) -> #emit_item<T> IterationUnit {
        self match {
            value? => emit_item<T>(value)#,
            null => {},
        };
    }
}

pub struct ChainIterator where I :- Iterator, J :- Iterator,
    requires I.as(Iterator).Item == J.as(Iterator).Item
{
    first: I,
    second: J,
}

impl Iterator for ChainIterator<I, J>
    where I :- Iterator, J :- Iterator,
    requires I.as(Iterator).Item == J.as(Iterator).Item
{
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        self.first.as(Iterator).iterate();
        self.second.as(Iterator).iterate();
    }
}

pub trait FromIterator where T {
    fn from_iter(iter: I) -> Self where I :- Iterator, requires I.as(Iterator).Item == T;
}

{-
    The first rejected item ends this adapter's iteration. The lexical return
    belongs to this iterate method, so an enclosing chain can still continue
    with its next source. Neither rejection nor downstream exit leaks items.
-}
pub struct TakeWhileIterator where I :- Iterator, c: IterationType.vars.Closure {
    iter: I,
    pred: %c fn(*I.as(Iterator).Item) -> bool,
}

impl Iterator for TakeWhileIterator<I, c>
    where I :- Iterator, c: IterationType.vars.Closure
{
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        let pred = self.pred;
        self.iter.as(Iterator).iterate()# {
            emit_item<Item>(value) => {
                if not pred(value.ref) {return;}
                emit_item<Item>(value)#;
            },
        }
    }
}

{-
    Finish each mapped source before requesting the next outer item. The inner
    iterate call propagates its effect to the enclosing consumer; it does not
    request the outer source's emit operation again.
-}
pub struct FlatMapIterator where I :- Iterator, J :- Iterator, c: IterationType.vars.Closure {
    iter: I,
    f: %c fn(I.as(Iterator).Item) -> J,
}

impl Iterator for FlatMapIterator<I, J, c>
    where I :- Iterator, J :- Iterator, c: IterationType.vars.Closure
{
    assoc Item: IterationType = J.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        let f = self.f;
        self.iter.as(Iterator).iterate()# {
            emit_item<I.as(Iterator).Item>(value) => f(value).as(Iterator).iterate(),
        }
    }
}

{-
    Consume one nested iterator layer. Finish each inner source before asking
    the outer source for another item. A downstream exit retires both pending
    inner items and the outer remainder through ordinary resource cleanup.
-}
pub struct FlattenIterator where I :- Iterator,
    requires I.as(Iterator).Item :- Iterator
{
    iter: I,
}

impl Iterator for FlattenIterator<I> where I :- Iterator,
    requires I.as(Iterator).Item :- Iterator
{
    assoc Item: IterationType = I.as(Iterator).Item.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        self.iter.as(Iterator).iterate()# {
            emit_item<I.as(Iterator).Item>(inner) => inner.as(Iterator).iterate(),
        }
    }
}

pub struct MapIterator where I :- Iterator, U, c: IterationType.vars.Closure {
    iter: I,
    f: %c fn(I.as(Iterator).Item) -> U,
}

impl Iterator for MapIterator<I, U, c>
    where I :- Iterator, U, c: IterationType.vars.Closure
{
    assoc Item: IterationType = U;

    inline fn iterate(self) -> #emit_item<U> IterationUnit {
        let f = self.f;
        self.iter.as(Iterator).iterate()# {
            emit_item<I.as(Iterator).Item>(value) => emit_item<U>(f(value))#,
        }
    }
}

pub struct FilterIterator where I :- Iterator, c: IterationType.vars.Closure {
    iter: I,
    pred: %c fn(*I.as(Iterator).Item) -> bool,
}

{-
    Each input is consumed by the mapper once. An absent result emits nothing;
    a present result transfers its payload, preserving any inner optional layer.
-}
pub struct FilterMapIterator where I :- Iterator, U, c: IterationType.vars.Closure {
    iter: I,
    f: %c fn(I.as(Iterator).Item) -> ?U,
}

impl Iterator for FilterMapIterator<I, U, c>
    where I :- Iterator, U, c: IterationType.vars.Closure
{
    assoc Item: IterationType = U;

    inline fn iterate(self) -> #emit_item<U> IterationUnit {
        let f = self.f;
        self.iter.as(Iterator).iterate()# {
            emit_item<I.as(Iterator).Item>(value) => f(value) match {
                mapped? => emit_item<U>(mapped)#,
                null => {},
            },
        }
    }
}

{-
    Observe an item before forwarding ownership to the next handler. The
    callback borrows the item; inspection neither clones nor consumes it.
-}
pub struct InspectIterator where I :- Iterator, c: IterationType.vars.Closure {
    iter: I,
    f: %c fn(*I.as(Iterator).Item),
}

impl Iterator for InspectIterator<I, c>
    where I :- Iterator, c: IterationType.vars.Closure
{
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        let f = self.f;
        self.iter.as(Iterator).iterate()# {
            emit_item<Item>(value) => {
                f(value.ref);
                emit_item<Item>(value)#;
            },
        }
    }
}

impl Iterator for FilterIterator<I, c>
    where I :- Iterator, c: IterationType.vars.Closure
{
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        let pred = self.pred;
        self.iter.as(Iterator).iterate()# {
            emit_item<Item>(value) => if pred(value.ref) {emit_item<Item>(value)#;},
        }
    }
}

{-
    Test only the initial prefix. The first rejected item is forwarded and
    disables the predicate for all later items. Skipped items keep their normal
    cleanup; downstream exit retires the remaining source and environment.
-}
pub struct SkipWhileIterator where I :- Iterator, c: IterationType.vars.Closure {
    iter: I,
    pred: %c fn(*I.as(Iterator).Item) -> bool,
}

impl Iterator for SkipWhileIterator<I, c>
    where I :- Iterator, c: IterationType.vars.Closure
{
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        let pred = self.pred;
        var skipping = true;
        self.iter.as(Iterator).iterate()# {
            emit_item<Item>(value) => {
                if skipping {skipping = pred(value.ref);}
                if not skipping {emit_item<Item>(value)#;}
            },
        }
    }
}

{-
    A zero limit does not start the source. After the last permitted emission,
    return before the source can produce another item. Pending source resources
    are still retired by the ordinary early-exit cleanup.
-}
pub struct TakeIterator where I :- Iterator {
    iter: I,
    count: IterationIndex,
}

impl Iterator for TakeIterator<I> where I :- Iterator {
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        var remaining = self.count;
        if remaining == 0 {return;}
        self.iter.as(Iterator).iterate()# {
            emit_item<Item>(value) => {
                assumes remaining > 0;
                remaining = remaining - 1;
                emit_item<Item>(value)#;
                if remaining == 0 {return;}
            },
        }
    }
}

pub struct SkipIterator where I :- Iterator {
    iter: I,
    count: IterationIndex,
}

impl Iterator for SkipIterator<I> where I :- Iterator {
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        var remaining = self.count;
        self.iter.as(Iterator).iterate()# {
            emit_item<Item>(value) => {
                if remaining > 0 {
                    remaining = remaining - 1;
                } else {
                    emit_item<Item>(value)#;
                }
            },
        }
    }
}

{- Container conversion transfers ownership to the returned iterator. -}
pub trait IntoIterator {
    assoc Iter: IterationType;
    fn into_iter(self) -> Iter;
}


{-
    Produce separators only between items. The next source item is already
    owned when make runs; downstream exit at a separator retires that pending
    item and the remaining source normally. Empty and singleton sources never
    invoke make, and neither item cloning nor buffering the stream is needed.
-}
pub struct IntersperseWithIterator where I :- Iterator, c: IterationType.vars.Closure {
    iter: I,
    make: %c fn() -> I.as(Iterator).Item,
}

impl Iterator for IntersperseWithIterator<I, c>
    where I :- Iterator, c: IterationType.vars.Closure
{
    assoc Item: IterationType = I.as(Iterator).Item;

    inline fn iterate(self) -> #emit_item<Item> IterationUnit {
        let make = self.make;
        var first = true;
        self.iter.as(Iterator).iterate()# {
            emit_item<Item>(value) => {
                if first {first = false;} else {emit_item<Item>(make())#;}
                emit_item<Item>(value)#;
            },
        }
    }
}


{-
    Transfer each item into the mapper once. The first absent result ends this
    adapter, leaving an enclosing chain free to start its next source. A present
    null payload remains an emitted item when U itself is optional.
-}
pub struct MapWhileIterator where I :- Iterator, U, c: IterationType.vars.Closure {
    iter: I,
    f: %c fn(I.as(Iterator).Item) -> ?U,
}

impl Iterator for MapWhileIterator<I, U, c>
    where I :- Iterator, U, c: IterationType.vars.Closure
{
    assoc Item: IterationType = U;

    inline fn iterate(self) -> #emit_item<U> IterationUnit {
        let f = self.f;
        self.iter.as(Iterator).iterate()# {
            emit_item<I.as(Iterator).Item>(value) => f(value) match {
                mapped? => emit_item<U>(mapped)#,
                null => {return;},
            },
        }
    }
}

{-
    State is owned by this traversal. Each callback observes the same state
    location and consumes one item. An absent result ends only this adapter;
    normal cleanup retires the state, callback and unproduced input remainder.
-}
pub struct ScanIterator where I :- Iterator, A, U, c: IterationType.vars.Closure {
    iter: I,
    state: A,
    f: %c fn(*A, I.as(Iterator).Item) -> ?U,
}

impl Iterator for ScanIterator<I, A, U, c>
    where I :- Iterator, A, U, c: IterationType.vars.Closure
{
    assoc Item: IterationType = U;

    inline fn iterate(self) -> #emit_item<U> IterationUnit {
        var state = self.state;
        let state_ref = state.ref;
        let f = self.f;
        self.iter.as(Iterator).iterate()# {
            emit_item<I.as(Iterator).Item>(value) => f(state_ref, value) match {
                mapped? => emit_item<U>(mapped)#,
                null => {return;},
            },
        }
    }
}
