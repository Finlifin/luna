use primitives.{Integer, Symbol, Type, str, u32, usize};
use staging.Splice;

{-
    Compile-time call-site metadata and implicit argument passing protocol.
    Uses only primitive types so `builtin` stays free of `meta` dependencies.
-}
pub struct Context {
    package_name_val: str,
    module_path_val: str,
    callable_name_val: str,
}

impl Context {
    pub pure comptime fn new(
        package_name: str,
        module_path: str,
        callable_name: str,
    ) -> Context {
        Context {
            package_name_val: package_name,
            module_path_val: module_path,
            callable_name_val: callable_name,
        }
    }

    pub pure comptime fn package_name(self) -> str {
        self.package_name_val
    }

    pub pure comptime fn module_path(self) -> str {
        self.module_path_val
    }

    pub pure comptime fn callable_name(self) -> str {
        self.callable_name_val
    }
}

pub struct CallDescription {
    callee_name_val: str,
    param_name_val: Symbol,
    call_file_val: str,
    call_line_val: u32,
    call_column_val: u32,
    call_byte_start_val: usize,
    call_byte_end_val: usize,
    expansion_id_val: Integer,
}

impl CallDescription {
    pub pure comptime fn new(
        callee_name: str,
        param_name: Symbol,
        call_file: str,
        call_line: u32,
        call_column: u32,
        call_byte_start: usize,
        call_byte_end: usize,
        expansion_id: Integer,
    ) -> CallDescription {
        CallDescription {
            callee_name_val: callee_name,
            param_name_val: param_name,
            call_file_val: call_file,
            call_line_val: call_line,
            call_column_val: call_column,
            call_byte_start_val: call_byte_start,
            call_byte_end_val: call_byte_end,
            expansion_id_val: expansion_id,
        }
    }

    pub pure comptime fn callee_name(self) -> str {
        self.callee_name_val
    }

    pub pure comptime fn param_name(self) -> Symbol {
        self.param_name_val
    }

    pub pure comptime fn call_file(self) -> str {
        self.call_file_val
    }

    pub pure comptime fn call_line(self) -> u32 {
        self.call_line_val
    }

    pub pure comptime fn call_column(self) -> u32 {
        self.call_column_val
    }

    pub pure comptime fn call_byte_start(self) -> usize {
        self.call_byte_start_val
    }

    pub pure comptime fn call_byte_end(self) -> usize {
        self.call_byte_end_val
    }

    pub pure comptime fn expansion_id(self) -> Integer {
        self.expansion_id_val
    }
}

pub trait ImplicitPassing
where
    param_name: Symbol,
{
    assoc ArgType: Type;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- ArgType >;
}

impl ImplicitPassing<.__caller__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let caller_name = caller.callable_name();
        '( caller_name )
    }
}

impl ImplicitPassing<.__module__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let mod_path = caller.module_path();
        '( mod_path )
    }
}

impl ImplicitPassing<.__package__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let pkg_name = caller.package_name();
        '( pkg_name )
    }
}

impl ImplicitPassing<.__file__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let file_name = calling.call_file();
        '( file_name )
    }
}

impl ImplicitPassing<.__line__> for u32 {
    assoc ArgType: Type = u32;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- u32 > {
        let line_no = calling.call_line();
        '( line_no )
    }
}
