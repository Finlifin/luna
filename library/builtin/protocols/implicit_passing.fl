use implicit_bindings.{
    implicit_caller,
    implicit_file,
    implicit_line,
    implicit_module,
    implicit_package,
};
use primitives.{Symbol, Type, str, u32};
use staging.Splice;

{-
    Compile-time call-site metadata and implicit argument passing protocol.
    Uses only primitive types so `builtin` stays free of `meta` dependencies.
    `Context` carries only compiler-populated identity fields and exposes no
    public constructors or probing getters; `CallDescription` stays empty.
-}
pub struct Context {
    package_name_val: str,
    module_path_val: str,
    callable_name_val: str,
}

pub struct CallDescription {}

pub trait ImplicitPassing
where
    param_name: Symbol,
{
    assoc ArgType: Type;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- ArgType >;
}

impl ImplicitPassing<.__caller__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let caller_name = implicit_caller(caller);
        '( caller_name )
    }
}

impl ImplicitPassing<.__module__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let mod_path = implicit_module(caller);
        '( mod_path )
    }
}

impl ImplicitPassing<.__package__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let pkg_name = implicit_package(caller);
        '( pkg_name )
    }
}

impl ImplicitPassing<.__file__> for str {
    assoc ArgType: Type = str;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- str > {
        let file_name = implicit_file(calling);
        '( file_name )
    }
}

impl ImplicitPassing<.__line__> for u32 {
    assoc ArgType: Type = u32;

    pure comptime fn pass(
        caller: Context,
        callee: Context,
        calling: CallDescription,
    ) -> < |- u32 > {
        let line_no = implicit_line(calling);
        '( line_no )
    }
}
