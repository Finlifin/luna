use primitives.*;

-- ==========================================================================
-- builtin/ops – operator traits
-- ==========================================================================
--
-- Operator protocol declarations. Compiler language-item binding is explicit;
-- these names alone do not enable operator elaboration.
pub trait Add where .Rhs: Type = Self {
    assoc Output: Type;

    fn add(self, rhs: Rhs) -> Output;
}

pub trait Sub where .Rhs: Type = Self {
    assoc Output: Type;

    fn sub(self, rhs: Rhs) -> Output;
}

pub trait Mul where .Rhs: Type = Self {
    assoc Output: Type;

    fn mul(self, rhs: Rhs) -> Output;
}

pub trait Div where .Rhs: Type = Self {
    assoc Output: Type;

    fn div(self, rhs: Rhs) -> Output;
}

pub trait Rem where .Rhs: Type = Self {
    assoc Output: Type;

    fn rem(self, rhs: Rhs) -> Output;
}

pub trait Neg {
    assoc Output: Type;

    fn neg(self) -> Output;
}

pub trait Not {
    assoc Output: Type;

    fn invert(self) -> Output;
}

pub trait Implies where .Rhs: Type = Self {
    assoc Output: Type;

    fn implies(self, rhs: Rhs) -> Output;
}

pub trait Concat where .Rhs: Type = Self {
    assoc Output: Type;

    fn concat(self, rhs: Rhs) -> Output;
}

-- ── Index & SpaceApply ──────────────────────────────────────────────────────
pub trait Index where Idx {
    assoc Output: Type;

    fn index(*self, idx: Idx) -> *Output;
}

pub trait IndexMut :- Index<Idx> where Idx {
    fn index_mut(*self, idx: Idx) -> *Self.as(Index<Idx>).Output;
}

pub trait SpaceApply {
    assoc CollectTo: Type;
    assoc Target: Type;

    fn space_apply(*self, index: CollectTo) -> Target;
}

-- ── Compound Assignment ────────────────────────────────────────────────────
pub trait AddAssign where .Rhs: Type = Self {
    fn add_assign(*self, rhs: Rhs) -> void;
}

pub trait SubAssign where .Rhs: Type = Self {
    fn sub_assign(*self, rhs: Rhs) -> void;
}

pub trait MulAssign where .Rhs: Type = Self {
    fn mul_assign(*self, rhs: Rhs) -> void;
}

pub trait DivAssign where .Rhs: Type = Self {
    fn div_assign(*self, rhs: Rhs) -> void;
}

pub trait RemAssign where .Rhs: Type = Self {
    fn rem_assign(*self, rhs: Rhs) -> void;
}

-- ── Variadic Collectors ────────────────────────────────────────────────────
pub trait VariadicCollector {
    assoc Tmp: Type = void;

    fn variadic_init() -> Tmp where S;
    fn variadic_collect(tmp: *Tmp, args: S) -> Self where S;

    ^attrs.comptime_phase
    comptime fn comptime_variadic_collect(args: S) -> Self where S;
}

pub trait ExtendedVariadicCollector {
    assoc Tmp: Type = void;

    fn extended_variadic_init() -> Tmp where Ps;
    fn extended_variadic_collect(tmp: *Tmp, properties: Ps) -> Self where Ps;

    ^attrs.comptime_phase
    comptime fn comptime_extended_variadic_collect(properties: Ps) -> Self where Ps;
}

-- ── Deref / DerefMut / Reference ──────────────────────────────────────────
pub trait Deref {
    assoc Target: Type;

    fn deref(*self) -> *Target;
}

pub trait DerefMut :- Deref {
    fn deref_mut(*self) -> *Self.as(Deref).Target;
}

pub trait Reference {
    assoc Target: Type;

    fn reference(*self) -> *Target;
}
