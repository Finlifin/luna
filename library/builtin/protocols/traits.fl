-- ==========================================================================
-- builtin/traits – fundamental traits
-- ==========================================================================
--
-- Fundamental protocols exposed through ordinary trait declarations.

-- Comparison protocols can be loaded without formatting/owned strings.
pub use comparison.{Eq, Ord, Order, TotalFloat, TotalOrd}

-- Resource protocols live separately from formatting and owned strings.
pub use resources.{Clone, Copy, Drop, Once}

-- Streaming hash protocols.
pub use hash.{BuildHasher, Hash, Hasher}

-- ── Conversion ─────────────────────────────────────────────────────────────
pub use conversion.{AsMut, AsRef, ConversionErr, From, InfallibleErr, Into, LiteralInto, TryFrom, TryInto}

-- ── Default ────────────────────────────────────────────────────────────────
pub trait Default {
    fn default() -> Self;
}
