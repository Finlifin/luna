use meta;
use numeric.comparison.Eq;
use primitives.{Symbol, Type, bool, usize};

^{__flurry_derivation_default: true}
pub derive fn by_fields for Eq
where
    requires Type.predicates.is_struct(Self) or Type.predicates.is_enum(Self),
{
    fn eq(*self, other: *Self) -> bool {
        inline if Type.predicates.is_struct(Self) {
            const NAMES = meta.reflection.struct_field_names(Self);
            inline for i in 0..NAMES.length() {
                const sym: Symbol = NAMES[i];
                inline if Type.predicates.has_field(Self, sym) {
                    let lhs = meta.structs.field_ptr(self, sym);
                    let rhs = meta.structs.field_ptr(other, sym);
                    if not lhs.as(Eq).eq(rhs) {
                        return false;
                    }
                }
            }
            true
        } else {
            const VF_TYPES = meta.reflection.enum_variant_field_types(Self);
            let lv = meta.enums.enum_variant_index(self);
            let rv = meta.enums.enum_variant_index(other);
            if lv != rv {
                return false;
            }
            inline for v in 0..VF_TYPES.length() {
                const V_U: usize = meta.enums.to_usize(v);
                if lv == V_U {
                    const FIELD_COUNT = VF_TYPES[v].length();
                    inline if FIELD_COUNT > 0 {
                        inline for f in 0..FIELD_COUNT {
                            const F_U: usize = meta.enums.to_usize(f);
                            let lopt = meta.enums.enum_variant_field_ptr(Self, self, V_U, F_U);
                            let ropt = meta.enums.enum_variant_field_ptr(Self, other, V_U, F_U);
                            let eq_ok = lopt match {
                                lp? =>
                                    ropt match {
                                        rp? => lp.as(Eq).eq(rp),
                                        null => false,
                                    },
                                null => false,
                            };
                            if not eq_ok {
                                return false;
                            }
                        }
                    }
                    return true;
                }
            }
            false
        }
    }
}
