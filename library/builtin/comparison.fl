    }
}

-- false precedes true. Floating types need a separate partial-order contract.
impl Eq for bool {
    fn eq(self, other: Self) -> bool { self == other }
}
impl Ord for bool {
    fn cmp(self, other: Self) -> Ordering {
        if self == other { .Equal } else if self { .Greater } else { .Less }
    }
}

-- Character order follows Unicode scalar values, independent of locale.
impl Eq for .char'builtin {
    fn eq(self, other: Self) -> bool { self == other }
}
impl Ord for .char'builtin {
    fn cmp(self, other: Self) -> Ordering {
        if self < other { .Less } else if self == other { .Equal } else { .Greater }
    }
}

-- Symbol equality compares names, not backing storage addresses.
impl Eq for .Symbol'builtin {
    fn eq(self, other: Self) -> bool { self == other }
}

impl Eq for .usize'builtin {
    fn eq(self, other: Self) -> bool { self == other }
}
impl Ord for .usize'builtin {
    fn cmp(self, other: Self) -> Ordering {
        if self < other { .Less } else if self == other { .Equal } else { .Greater }
    }
}

impl Eq for .isize'builtin {
    fn eq(self, other: Self) -> bool { self == other }
}
impl Ord for .isize'builtin {
    fn cmp(self, other: Self) -> Ordering {
        if self < other { .Less } else if self == other { .Equal } else { .Greater }
    }
}

{-
    Comptime equality shares each primitive implementation relationship with
    runtime equality, while supplying its independently checked phase.
-}
comptime impl Eq for .u8'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .u16'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .u32'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .u64'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .u128'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .i8'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .i16'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .i32'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .i64'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .i128'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for bool {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .char'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .Symbol'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .usize'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .isize'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}

{-
    Text equality observes the complete UTF-8 contents, including embedded
    zero bytes. It neither compares storage identities nor normalizes Unicode.
-}
impl Eq for .str'builtin {
    fn eq(self, other: Self) -> bool { self == other }
}
comptime impl Eq for .str'builtin {
    comptime fn comptime_eq(self, other: Self) -> bool { self == other }
}
