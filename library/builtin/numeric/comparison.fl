-- false precedes true. Floating types use TotalOrd / TotalFloat for total ordering.
impl Eq for bool {
    fn eq(*self, other: *Self) -> bool {
        self.* == other.*
    }
}

impl Ord for bool {
    fn cmp(*self, other: *Self) -> Order {
        if self.* == other.* {
            .equal
        } else if self.* {
            .greater
        } else {
            .less
        }
    }
}

impl TotalOrd for bool {
    fn total_cmp(*self, other: *Self) -> Order {
        self.cmp(other)
    }
}

-- Character order follows Unicode scalar values, independent of locale.
impl Eq for char {
    fn eq(*self, other: *Self) -> bool {
        self.* == other.*
    }
}

impl Ord for char {
    fn cmp(*self, other: *Self) -> Order {
        if self.* < other.* {
            .less
        } else if self.* == other.* {
            .equal
        } else {
            .greater
        }
    }
}

impl TotalOrd for char {
    fn total_cmp(*self, other: *Self) -> Order {
        self.cmp(other)
    }
}

-- Symbol equality compares names, not backing storage addresses.
impl Eq for Symbol {
    fn eq(*self, other: *Self) -> bool {
        self.* == other.*
    }
}

impl Eq for usize {
    fn eq(*self, other: *Self) -> bool {
        self.* == other.*
