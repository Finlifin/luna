use primitives.*;

-- Equality and total ordering, independent of formatting and allocation.

-- ── Equality ───────────────────────────────────────────────────────────────

pub trait Eq {
    fn eq(self, other: Self) -> bool;
    fn ne(self, other: Self) -> bool = not self.eq(other);

    ^attrs.comptime_phase
    comptime fn comptime_eq(self, other: Self) -> bool;
    ^attrs.comptime_phase
    comptime fn comptime_ne(self, other: Self) -> bool = not self.comptime_eq(other);
}

-- ── Order ───────────────────────────────────────────────────────────────

pub trait Ord :- Eq {
    fn cmp(self, other: Self) -> Order;
    fn lt(self, other: Self) -> bool = self.cmp(other) match {
        .less => true,
        _ => false,
    };
    fn le(self, other: Self) -> bool = self.cmp(other) match {
        .greater => false,
        _ => true,
    };
    fn gt(self, other: Self) -> bool = self.cmp(other) match {
        .greater => true,
        _ => false,
    };
    fn ge(self, other: Self) -> bool = self.cmp(other) match {
        .less => false,
        _ => true,
    };
}

pub enum Order {
    less,
    equal,
    greater,
}

impl Eq for u8 {
    fn eq(self, other: Self) -> bool { self == other }
}
impl Ord for u8 {
    fn cmp(self, other: Self) -> Order {
        if self < other { .less } else if self == other { .equal } else { .greater }
    }
}

impl Eq for u16 {
    fn eq(self, other: Self) -> bool { self == other }
}
impl Ord for u16 {
    fn cmp(self, other: Self) -> Order {
        if self < other { .less } else if self == other { .equal } else { .greater }
    }
}

