use bindings.*;
use primitives.*;
use protocols.conversion.{TryFrom, TryInto}

-- Explicit checked machine-integer conversions.
impl TryInto<Target> for Source where Source, Target :- TryFrom<Source> {
    fn try_into(self) -> ?Target {
        Target.as(TryFrom<Source>).try_from(self)
    }
}

impl TryFrom<u8> for u8 {
    fn try_from(source: u8) -> ?Self {
        source
    }
}

impl TryFrom<u16> for u8 {
    fn try_from(source: u16) -> ?Self {
        try_u16_to_u8(source)
    }
}

impl TryFrom<u32> for u8 {
    fn try_from(source: u32) -> ?Self {
        try_u32_to_u8(source)
    }
}

