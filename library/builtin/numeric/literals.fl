use bindings.*;
use primitives.*;
use protocols.conversion.LiteralInto;

-- Built-in suffixed machine-integer literal conversions across runtime and comptime phases.
impl LiteralInto<.u8, u8> for Integer {
    fn literal_into(comptime value: Integer) -> u8 {
        integer_to_u8(value)
    }
}

comptime impl LiteralInto<.u8, u8> for Integer {
    comptime fn comptime_literal_into(comptime value: Integer) -> u8 {
        integer_to_u8(value)
    }
}

