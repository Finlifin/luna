-- ==========================================================================
-- builtin/result – the Result type
-- ==========================================================================

-- #[lang = "result"]
pub enum Result where T, E {
    Ok(T),
    Err(E),
}

impl Result<T, E> where T, E {
    pub fn is_ok(self) -> Bool = self match {
        .Ok(_)  => true,
        .Err(_) => false,
    };

    pub fn is_err(self) -> Bool = not self.is_ok();

    pub fn unwrap(self) -> T = self match {
        .Ok(v)  => v,
        .Err(_) => panic("called Result.unwrap() on an Err value"),
    };

    pub fn unwrap_err(self) -> E = self match {
        .Ok(_)  => panic("called Result.unwrap_err() on an Ok value"),
        .Err(e) => e,
    };

    pub fn map(self, f: fn(T) -> U) -> Result<U, E> where U = self match {
        .Ok(v)  => .Ok(f(v)),
        .Err(e) => .Err(e),
    };

    pub fn map_err(self, f: fn(E) -> F) -> Result<T, F> where F = self match {
        .Ok(v)  => .Ok(v),
        .Err(e) => .Err(f(e)),
    };

    pub fn and_then(self, f: fn(T) -> Result<U, E>) -> Result<U, E> where U = self match {
        .Ok(v)  => f(v),
        .Err(e) => .Err(e),
    };
}
