-- ==========================================================================
-- builtin/option – the Option (?T) type
-- ==========================================================================

-- Panic-dependent unwrap lives in option_unwrap.fl; this module contains
-- the dependency-free value operations.
-- #[lang = "optional"]
pub enum Option where T {
    Some(T),
    None,
}

impl Option<T> where T {
    pub fn is_some(self) -> bool = self match {
        .Some(_) => true,
        .None    => false,
    };

    pub fn is_none(self) -> bool = not self.is_some();

    pub fn unwrap_or(self, fallback: T) -> T = self match {
        .Some(v) => v,
        .None    => fallback,
    };

    -- Construct a fallback only when no value is present.
    pub fn unwrap_or_else(self, fallback: %c fn() -> T) -> T where c: (.Type'builtin).vars.Closure = self match {
        .Some(v) => v,
        .None => fallback(),
    };

    pub fn map(self, f: %c fn(T) -> U) -> ?U where U, c: (.Type'builtin).vars.Closure = self match {
        .Some(v) => .Some(f(v)),
        .None    => .None,
    };

    pub fn and_then(self, f: %c fn(T) -> ?U) -> ?U where U, c: (.Type'builtin).vars.Closure = self match {
        .Some(v) => f(v),
        .None    => .None,
    };
}
