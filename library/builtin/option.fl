-- ==========================================================================
-- builtin/option – the Option (?T) type
-- ==========================================================================

-- #[lang = "optional"]
pub enum Option where T {
    Some(T),
    None,
}

impl Option<T> where T {
    pub fn is_some(self) -> Bool = self match {
        .Some(_) => true,
        .None    => false,
    };

    pub fn is_none(self) -> Bool = not self.is_some();

    pub fn unwrap(self) -> T = self match {
        .Some(v) => v,
        .None    => panic("called Option.unwrap() on a None value"),
    };

    pub fn unwrap_or(self, fallback: T) -> T = self match {
        .Some(v) => v,
        .None    => fallback,
    };

    pub fn map(self, f: fn(T) -> U) -> ?U where U = self match {
        .Some(v) => .Some(f(v)),
        .None    => .None,
    };

    pub fn and_then(self, f: fn(T) -> ?U) -> ?U where U = self match {
        .Some(v) => f(v),
        .None    => .None,
    };
}
