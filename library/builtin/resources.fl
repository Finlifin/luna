-- Affine resource protocols, independent of allocation and formatting.

-- ── Once / Clone / Copy ────────────────────────────────────────────────────

pub trait Once {}

-- Every type has affine transfer; copying and cloning require extra protocols.
impl Once for T where T {}

pub trait Clone :- Once {
    fn clone(*self) -> Self;
}

pub trait Copy :- Clone {}

-- ── Drop ───────────────────────────────────────────────────────────────────

pub trait Drop {
    fn drop(*self);
}

-- Scalar clones read the source value; Copy itself never calls clone.

impl Clone for bool {
    fn clone(*self) -> Self { self.* }
}
impl Copy for bool {}

impl Clone for .Symbol'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .Symbol'builtin {}

impl Clone for .char'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .char'builtin {}

impl Clone for .void'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .void'builtin {}

impl Clone for .u8'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .u8'builtin {}

impl Clone for .u16'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .u16'builtin {}

impl Clone for .u32'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .u32'builtin {}

impl Clone for .u64'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .u64'builtin {}

impl Clone for .u128'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .u128'builtin {}

impl Clone for .usize'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .usize'builtin {}

impl Clone for .i8'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .i8'builtin {}

impl Clone for .i16'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .i16'builtin {}

impl Clone for .i32'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .i32'builtin {}

impl Clone for .i64'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .i64'builtin {}

impl Clone for .i128'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .i128'builtin {}

impl Clone for .isize'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .isize'builtin {}

impl Clone for .f32'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .f32'builtin {}

impl Clone for .f64'builtin {
    fn clone(*self) -> Self { self.* }
}
impl Copy for .f64'builtin {}

-- Cloning a pointer preserves its target dependency, never its ownership.
impl Clone for *T where T {
    fn clone(*self) -> Self { self.* }
}
impl Copy for *T where T {}
