use builtin.fmt.{ByteWriter, Debug}
use mem_impl.allocator.{AllocErr, Allocator, DefaultAllocator, RawBlock}
use mem_impl.layout.Layout;

{-
    Single-owner heap allocation holding one initialized value of T.
    Box<T, .A, .allocator> is affine (Once) and drops T in place before
    releasing the backing RawBlock through its runtime-dependent allocator.
    Zero-sized payloads use a non-zero aligned dangling address with no OS
    allocation while still running T's Drop on destruction.
-}
pub struct Box
where
    T,
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    raw_addr: usize,
    raw_layout: Layout,
}

fn retire_value(value: T) where T {}

impl Drop for Box<T, .A = A, .allocator = alloc>
where
    T,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    fn drop(*self) {
        let addr = self.raw_addr.*;
        if addr != 0 {
            let layout = self.raw_layout.*;
            self.raw_addr.* = 0;
            retire_value(unsafe { builtin.mem.raw_read<T>(addr) });
            if layout.byte_size() != 0 {
                unsafe {
                    alloc
                        .as(Allocator)
                        .deallocate(RawBlock.from_raw_parts(addr, layout));
                }
            }
        }
    }
}

impl Box<T, .A = A, .allocator = alloc>
where
    T,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    fn take_raw(*self) -> RawBlock {
        let addr = self.raw_addr.*;
        let layout = self.raw_layout.*;
        self.raw_addr.* = 0;
        RawBlock.from_raw_parts(addr, layout)
    }

    pub fn new(value: T) -> !AllocErr Self {
        let layout = Layout.of<T>() match {
            found? => found,
            null => return error AllocErr.InvalidLayout,
        }
        let block = alloc.as(Allocator).allocate(layout)!;
        unsafe {
            builtin.mem.raw_write<T>(block.address(), value);
        }
        Box<T, .A = A, .allocator = alloc> {
            raw_addr: block.address(),
            raw_layout: block.layout(),
        }
    }

    pub fn into_inner(self) -> T {
        var this = self;
        let block = this.ref.take_raw();
        let value = unsafe { builtin.mem.raw_read<T>(block.address()) }
        if block.byte_size() != 0 {
            unsafe {
                alloc.as(Allocator).deallocate(block);
            }
        }
        value
    }

    pub fn replace(*self, value: T) -> T {
        let addr = self.raw_addr.*;
        let old = unsafe { builtin.mem.raw_read<T>(addr) }
        unsafe {
            builtin.mem.raw_write<T>(addr, value);
        }
        old
    }

    pub fn set(*self, value: T) {
        let addr = self.raw_addr.*;
        let old = unsafe { builtin.mem.raw_read<T>(addr) }
        unsafe {
            builtin.mem.raw_write<T>(addr, value);
        }
        retire_value(old);
    }

    pub fn address(*self) -> usize {
        self.raw_addr.*
    }

    pub fn layout(*self) -> Layout {
        self.raw_layout.*
    }

    pub fn with_ref(*self, f: %c fn(*T) -> R) -> R where R, c: Type.vars.Closure {
        let addr = self.raw_addr.*;
        var val = unsafe { builtin.mem.raw_read<T>(addr) }
        let res = f(val.ref);
        unsafe {
            builtin.mem.raw_write<T>(addr, val);
        }
        res
    }
}

impl Box<T, .A = A, .allocator = alloc>
where
    T :- Copy,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    pub fn get(*self) -> T {
        unsafe { builtin.mem.raw_read<T>(self.raw_addr.*) }
    }
}

impl Debug for Box<T, .A = A, .allocator = alloc>
where
    T :- Debug,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        let addr = self.raw_addr.*;
        var val = unsafe { builtin.mem.raw_read<T>(addr) }
        let res = val.ref.as(Debug).write_debug(output);
        unsafe {
            builtin.mem.raw_write<T>(addr, val);
        }
        res
    }
}
