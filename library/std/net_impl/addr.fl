use builtin.Array;
use builtin.fmt.{ByteWriter, Debug, Display}
use builtin.hash.{Hash, Hasher}
use collections_impl.vec.Vec;
use io_impl.errors.IoErr;
use mem_impl.allocator.{AllocErr, Allocator, DefaultAllocator}
use sync_impl.marker.{Send, Sync}

{-
    Layer-3 / Layer-4 network address types, RFC-compliant parsing & formatting,
    error types, and allocator-parameterized `ToSocketAddrs`.

    `Ipv4Addr` and `Ipv6Addr` store their octets/hextets in `builtin.Array<u8, 4>`
    and `builtin.Array<u16, 8>`, exposing `octets() -> Array<u8, 4>` and
    `segments() -> Array<u16, 8>` plus `from_bits`/`to_bits`.
-}
pub enum AddrParseErr {
    InvalidIp,
    InvalidPort,
    InvalidSocketAddr,
    EmptyInput,
}

impl Clone for AddrParseErr {
    fn clone(*self) -> Self {
        self.* match {
            .InvalidIp => .InvalidIp,
            .InvalidPort => .InvalidPort,
            .InvalidSocketAddr => .InvalidSocketAddr,
            .EmptyInput => .EmptyInput,
        }
    }
}

impl Copy for AddrParseErr {}

impl Eq for AddrParseErr {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .InvalidIp =>
                other.* match {
                    .InvalidIp => true,
                    _ => false,
                },
            .InvalidPort =>
                other.* match {
                    .InvalidPort => true,
                    _ => false,
                },
            .InvalidSocketAddr =>
                other.* match {
                    .InvalidSocketAddr => true,
                    _ => false,
                },
            .EmptyInput =>
                other.* match {
                    .EmptyInput => true,
                    _ => false,
                },
        }
    }
}

impl Debug for AddrParseErr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.* match {
            .InvalidIp => output.write_str("AddrParseErr.InvalidIp"),
            .InvalidPort => output.write_str("AddrParseErr.InvalidPort"),
            .InvalidSocketAddr => output.write_str("AddrParseErr.InvalidSocketAddr"),
            .EmptyInput => output.write_str("AddrParseErr.EmptyInput"),
        }
    }
}

impl Send for AddrParseErr {}
impl Sync for AddrParseErr {}

pub enum NetErr {
    Io(IoErr),
    AddrParse(AddrParseErr),
    DnsResolutionFailed(i32),
    AddrInUse,
    AddrNotAvailable,
    ConnectionRefused,
    ConnectionReset,
    ConnectionAborted,
    NotConnected,
    TimedOut,
    WouldBlock,
    InvalidInput,
}

impl Clone for NetErr {
    fn clone(*self) -> Self {
        self.* match {
            .Io(e) => .Io(e),
            .AddrParse(e) => .AddrParse(e),
            .DnsResolutionFailed(c) => .DnsResolutionFailed(c),
            .AddrInUse => .AddrInUse,
            .AddrNotAvailable => .AddrNotAvailable,
            .ConnectionRefused => .ConnectionRefused,
            .ConnectionReset => .ConnectionReset,
            .ConnectionAborted => .ConnectionAborted,
            .NotConnected => .NotConnected,
            .TimedOut => .TimedOut,
            .WouldBlock => .WouldBlock,
            .InvalidInput => .InvalidInput,
        }
    }
}

impl Copy for NetErr {}

impl Eq for NetErr {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .Io(a) =>
                other.* match {
                    .Io(b) => a.ref.as(Eq).eq(b.ref),
                    _ => false,
                },
            .AddrParse(a) =>
                other.* match {
                    .AddrParse(b) => a.ref.as(Eq).eq(b.ref),
                    _ => false,
                },
            .DnsResolutionFailed(a) =>
                other.* match {
                    .DnsResolutionFailed(b) => a == b,
                    _ => false,
                },
            .AddrInUse =>
                other.* match {
                    .AddrInUse => true,
                    _ => false,
                },
            .AddrNotAvailable =>
                other.* match {
                    .AddrNotAvailable => true,
                    _ => false,
                },
            .ConnectionRefused =>
                other.* match {
                    .ConnectionRefused => true,
                    _ => false,
                },
            .ConnectionReset =>
                other.* match {
                    .ConnectionReset => true,
                    _ => false,
                },
            .ConnectionAborted =>
                other.* match {
                    .ConnectionAborted => true,
                    _ => false,
                },
            .NotConnected =>
                other.* match {
                    .NotConnected => true,
                    _ => false,
                },
            .TimedOut =>
                other.* match {
                    .TimedOut => true,
                    _ => false,
                },
            .WouldBlock =>
                other.* match {
                    .WouldBlock => true,
                    _ => false,
                },
            .InvalidInput =>
                other.* match {
                    .InvalidInput => true,
                    _ => false,
                },
        }
    }
}

impl Debug for NetErr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.* match {
            .Io(e) => {
                output.write_str("NetErr.Io(")!;
                e.ref.as(Debug).write_debug(output)!;
                output.write_byte(41)
            },
            .AddrParse(e) => {
                output.write_str("NetErr.AddrParse(")!;
                e.ref.as(Debug).write_debug(output)!;
                output.write_byte(41)
            },
            .DnsResolutionFailed(code) => {
                output.write_str("NetErr.DnsResolutionFailed(")!;
                code.ref.as(Display).fmt(output)!;
                output.write_byte(41)
            },
            .AddrInUse => output.write_str("NetErr.AddrInUse"),
            .AddrNotAvailable => output.write_str("NetErr.AddrNotAvailable"),
            .ConnectionRefused => output.write_str("NetErr.ConnectionRefused"),
            .ConnectionReset => output.write_str("NetErr.ConnectionReset"),
            .ConnectionAborted => output.write_str("NetErr.ConnectionAborted"),
            .NotConnected => output.write_str("NetErr.NotConnected"),
            .TimedOut => output.write_str("NetErr.TimedOut"),
            .WouldBlock => output.write_str("NetErr.WouldBlock"),
            .InvalidInput => output.write_str("NetErr.InvalidInput"),
        }
    }
}

impl Send for NetErr {}
impl Sync for NetErr {}

pub enum Shutdown {
    read,
    write,
    both,
}

impl Clone for Shutdown {
    fn clone(*self) -> Self {
        self.* match {
            .read => .read,
            .write => .write,
            .both => .both,
        }
    }
}

impl Copy for Shutdown {}

impl Eq for Shutdown {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .read =>
                other.* match {
                    .read => true,
                    _ => false,
                },
            .write =>
                other.* match {
                    .write => true,
                    _ => false,
                },
            .both =>
                other.* match {
                    .both => true,
                    _ => false,
                },
        }
    }
}

impl Debug for Shutdown {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.* match {
            .read => output.write_str("Shutdown.read"),
            .write => output.write_str("Shutdown.write"),
            .both => output.write_str("Shutdown.both"),
        }
    }
}

impl Send for Shutdown {}
impl Sync for Shutdown {}

-- ── Pure Parsing Helpers ─────────────────────────────────────────────────────

pure fn parse_dec_u8_range(s: str, start: u64, end: u64) -> ?u8 {
    if start >= end {
        return null;
    }
    let len = end - start;
    if len > 3 {
        return null;
    }
    if len > 1 {
        let first = s.byte(start) match {
            b? => b,
            null => return null,
        }
        if first == 48 {
            return null;
        }
    }
    var acc: u16 = 0;
    var idx = start;
    while idx < end {
        let b = s.byte(idx) match {
            c? => c,
            null => return null,
        }
        if b < 48 or b > 57 {
            return null;
        }
        if acc > 255 {
            return null;
        }
        acc = acc * 10 + (b - 48)'bitvec.as(u16);
        idx = idx + 1;
    }
    if acc > 255 {
        return null;
    }
    acc'bitvec[0..8].as(u8)
}

pure fn parse_dec_u16_range(s: str, start: u64, end: u64) -> ?u16 {
    if start >= end {
        return null;
    }
    let len = end - start;
    if len > 5 {
        return null;
    }
    if len > 1 {
        let first = s.byte(start) match {
            b? => b,
            null => return null,
        }
        if first == 48 {
            return null;
        }
    }
    var acc: u32 = 0;
    var idx = start;
    while idx < end {
        let b = s.byte(idx) match {
            c? => c,
            null => return null,
        }
        if b < 48 or b > 57 {
            return null;
        }
        if acc > 65535 {
            return null;
        }
        acc = acc * 10 + (b - 48)'bitvec.as(u32);
        idx = idx + 1;
    }
    if acc > 65535 {
        return null;
    }
    acc'bitvec[0..16].as(u16)
}

pure fn parse_hex_digit(b: u8) -> ?u16 {
    if b >= 48 and b <= 57 {
        (b - 48)'bitvec.as(u16)
    } else if b >= 97 and b <= 102 {
        (b - 87)'bitvec.as(u16)
    } else if b >= 65 and b <= 70 {
        (b - 55)'bitvec.as(u16)
    } else {
        null
    }
}

pure fn parse_hex_u16_range(s: str, start: u64, end: u64) -> ?u16 {
    if start >= end {
        return null;
    }
    if start >= end {
        return null;
    }
    if end - start > 4 {
        return null;
    }
    var acc: u16 = 0;
    var idx = start;
    while idx < end {
        let b = s.byte(idx) match {
            c? => c,
            null => return null,
        }
        let d = parse_hex_digit(b) match {
            v? => v,
            null => return null,
        }
        if acc > 4095 or d > 15 {
            return null;
        }
        acc = acc * 16 + d;
        idx = idx + 1;
    }
    acc
}

pure fn parse_ipv4_octets_range(
    s: str,
    start: u64,
    end: u64,
) -> !AddrParseErr Tuple<u8, u8, u8, u8>
{
    if start >= end {
        return error AddrParseErr.EmptyInput;
    }
    var seg_start = start;
    var count: u8 = 0;
    var b0: u8 = 0;
    var b1: u8 = 0;
    var b2: u8 = 0;
    var b3: u8 = 0;
    var idx = start;
    while idx <= end {
        let at_dot = if idx < end {
            s.byte(idx) match {
                ch? => ch == 46,
                null => false,
            }
        } else {
            true
        }
        if at_dot {
            let oct = parse_dec_u8_range(s, seg_start, idx) match {
                v? => v,
                null => return error AddrParseErr.InvalidIp,
            }
            if count == 0 {
                b0 = oct;
            } else if count == 1 {
                b1 = oct;
            } else if count == 2 {
                b2 = oct;
            } else if count == 3 {
                b3 = oct;
            } else {
                return error AddrParseErr.InvalidIp;
            }
            count = count + 1;
            if idx < end {
                seg_start = idx + 1;
            } else {
                break;
            }
        }
        if idx < end {
            idx = idx + 1;
        } else {
            break;
        }
    }
    if count != 4 {
        return error AddrParseErr.InvalidIp;
    }
    (b0, b1, b2, b3)
}

pure fn parse_ipv4_range(s: str, start: u64, end: u64) -> !AddrParseErr Ipv4Addr {
    let (b0, b1, b2, b3) = parse_ipv4_octets_range(s, start, end)!;
    Ipv4Addr.new(b0, b1, b2, b3)
}

-- ── Ipv4Addr ─────────────────────────────────────────────────────────────────

pub struct Ipv4Addr {
    raw_octets: Array<u8, 4>,
    pub const LOCALHOST: Ipv4Addr = Ipv4Addr { raw_octets: [127, 0, 0, 1] };
    pub const UNSPECIFIED: Ipv4Addr = Ipv4Addr { raw_octets: [0, 0, 0, 0] };
    pub const BROADCAST: Ipv4Addr = Ipv4Addr { raw_octets: [255, 255, 255, 255] };
}

impl Ipv4Addr {
    pub pure fn new(a: u8, b: u8, c: u8, d: u8) -> Self {
        Ipv4Addr { raw_octets: [a, b, c, d] }
    }

    pub pure fn from_bits(bits: u32) -> Self {
        let v = bits'bitvec;
        Ipv4Addr {
            raw_octets: [
                v[24..32].as(u8),
                v[16..24].as(u8),
                v[8..16].as(u8),
                v[0..8].as(u8),
            ],
        }
    }

    pub fn to_bits(self) -> u32 {
        let a = self.raw_octets[0].*'bitvec.as(u32) * 16777216;
        let b = self.raw_octets[1].*'bitvec.as(u32) * 65536;
        let c = self.raw_octets[2].*'bitvec.as(u32) * 256;
        let d = self.raw_octets[3].*'bitvec.as(u32);
        a + b + c + d
    }

    pub pure fn octets(self) -> Array<u8, 4> {
        self.raw_octets
    }

    pub fn is_unspecified(self) -> bool {
        self.raw_octets[0].* == 0
            and self.raw_octets[1].* == 0
            and self.raw_octets[2].* == 0
            and self.raw_octets[3].* == 0
    }

    pub fn is_loopback(self) -> bool {
        self.raw_octets[0].* == 127
    }

    pub fn is_private(self) -> bool {
        let b0 = self.raw_octets[0].*;
        let b1 = self.raw_octets[1].*;
        if b0 == 10 {
            return true;
        }
        if b0 == 172 and b1 >= 16 and b1 <= 31 {
            return true;
        }
        b0 == 192 and b1 == 168
    }

    pub fn is_multicast(self) -> bool {
        let b0 = self.raw_octets[0].*;
        b0 >= 224 and b0 <= 239
    }

    pub fn is_broadcast(self) -> bool {
        self.raw_octets[0].* == 255
            and self.raw_octets[1].* == 255
            and self.raw_octets[2].* == 255
            and self.raw_octets[3].* == 255
    }

    pub pure fn parse(s: str) -> !AddrParseErr Self {
        let len = builtin.compiler.str_byte_length(s);
        parse_ipv4_range(s, 0, len)
    }
}

impl Clone for Ipv4Addr {
    fn clone(*self) -> Self {
        self.*
    }
}

impl Copy for Ipv4Addr {}

impl Eq for Ipv4Addr {
    fn eq(*self, other: *Self) -> bool {
        self.to_bits() == other.to_bits()
    }
}

impl Ord for Ipv4Addr {
    fn cmp(*self, other: *Self) -> Order {
        let l = self.to_bits();
        let r = other.to_bits();
        if l < r {
            .less
        } else if l == r {
            .equal
        } else {
            .greater
        }
    }
}

impl Hash for Ipv4Addr {
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        let bits = self.to_bits();
        bits.ref.as(Hash).hash(state);
    }
}

impl Display for Ipv4Addr {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter,
    {
        let _ = format;
        self.raw_octets[0].*.as(Display).fmt(output)!;
        output.write_byte(46)!;
        self.raw_octets[1].*.as(Display).fmt(output)!;
        output.write_byte(46)!;
        self.raw_octets[2].*.as(Display).fmt(output)!;
        output.write_byte(46)!;
        self.raw_octets[3].*.as(Display).fmt(output)
    }
}

impl Debug for Ipv4Addr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.as(Display).fmt(output)
    }
}

impl Send for Ipv4Addr {}
impl Sync for Ipv4Addr {}

-- ── Ipv6Addr ─────────────────────────────────────────────────────────────────

pub struct Ipv6Addr {
    raw_segments: Array<u16, 8>,
    pub const LOCALHOST: Ipv6Addr = Ipv6Addr {
        raw_segments: [0, 0, 0, 0, 0, 0, 0, 1],
    };
    pub const UNSPECIFIED: Ipv6Addr = Ipv6Addr {
        raw_segments: [0, 0, 0, 0, 0, 0, 0, 0],
    };
}

struct SegmentBuffer {
    a: u16,
    b: u16,
    c: u16,
    d: u16,
    e: u16,
    f: u16,
    g: u16,
    h: u16,
}

impl Clone for SegmentBuffer {
    fn clone(*self) -> Self {
        self.*
    }
}

impl Copy for SegmentBuffer {}

pure fn seg_empty() -> SegmentBuffer {
    SegmentBuffer { a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0 }
}

pure fn seg_get(s: SegmentBuffer, idx: u8) -> u16 {
    if idx == 0 { s.a }
    else if idx == 1 { s.b }
    else if idx == 2 { s.c }
    else if idx == 3 { s.d }
    else if idx == 4 { s.e }
    else if idx == 5 { s.f }
    else if idx == 6 { s.g }
    else { s.h }
}

pure fn seg_set(s: SegmentBuffer, idx: u8, val: u16) -> SegmentBuffer {
    SegmentBuffer {
        a: if idx == 0 { val } else { s.a },
        b: if idx == 1 { val } else { s.b },
        c: if idx == 2 { val } else { s.c },
        d: if idx == 3 { val } else { s.d },
        e: if idx == 4 { val } else { s.e },
        f: if idx == 5 { val } else { s.f },
        g: if idx == 6 { val } else { s.g },
        h: if idx == 7 { val } else { s.h },
    }
}

pure fn combine_ipv6_halves(
    head: SegmentBuffer,
    head_len: u8,
    tail: SegmentBuffer,
    tail_len: u8,
) -> Ipv6Addr
{
    if head_len > 8 or tail_len > 8 or head_len + tail_len >= 8 {
        return Ipv6Addr.UNSPECIFIED;
    }
    let zeros = 8 - head_len - tail_len;
    let tail_start = head_len + zeros;
    var out = seg_empty();
    var i: u8 = 0;
    while i < 8 {
        let v: u16 = if i < head_len {
            seg_get(head, i)
        } else if i >= tail_start {
            seg_get(tail, i - tail_start)
        } else {
            0
        };
        out = seg_set(out, i, v);
        i = i + 1;
    }
    Ipv6Addr.new(out.a, out.b, out.c, out.d, out.e, out.f, out.g, out.h)
}

pure fn parse_ipv6_range(s: str, start: u64, end: u64) -> !AddrParseErr Ipv6Addr {
    if start >= end {
        return error AddrParseErr.EmptyInput;
    }
    var head = seg_empty();
    var head_len: u8 = 0;
    var tail = seg_empty();
    var tail_len: u8 = 0;
    var saw_double_colon = false;
    var pos = start;

    let b_first = s.byte(pos) match {
        b? => b,
        null => return error AddrParseErr.InvalidIp,
    }
    if b_first == 58 {
        if pos + 1 >= end {
            return error AddrParseErr.InvalidIp;
        }
        let b_second = s.byte(pos + 1) match {
            b? => b,
            null => return error AddrParseErr.InvalidIp,
        }
        if b_second != 58 {
            return error AddrParseErr.InvalidIp;
        }
        saw_double_colon = true;
        pos = pos + 2;
    }

    while pos < end {
        -- Find next ':' or end, also check if segment contains '.' (embedded IPv4 tail).
        var sep = pos;
        var has_dot = false;
        while sep < end {
            let ch = s.byte(sep) match {
                b? => b,
                null => return error AddrParseErr.InvalidIp,
            }
            if ch == 58 {
                break;
            }
            if ch == 46 {
                has_dot = true;
            }
            sep = sep + 1;
        }
        if has_dot {
            if sep != end {
                return error AddrParseErr.InvalidIp;
            }
            let (b0, b1, b2, b3) = parse_ipv4_octets_range(s, pos, end)!;
            let hi = b0'bitvec.as(u16) * 256 + b1'bitvec.as(u16);
            let lo = b2'bitvec.as(u16) * 256 + b3'bitvec.as(u16);
            if head_len > 8 or tail_len > 8 {
                return error AddrParseErr.InvalidIp;
            }
            if head_len + tail_len + 2 > 8 {
                return error AddrParseErr.InvalidIp;
            }
            if saw_double_colon {
                tail = seg_set(tail, tail_len, hi);
                tail = seg_set(tail, tail_len + 1, lo);
                tail_len = tail_len + 2;
            } else {
                head = seg_set(head, head_len, hi);
                head = seg_set(head, head_len + 1, lo);
                head_len = head_len + 2;
            }
            pos = end;
            break;
        }
        let val = parse_hex_u16_range(s, pos, sep) match {
            v? => v,
            null => return error AddrParseErr.InvalidIp,
        }
        if head_len > 8 or tail_len > 8 {
            return error AddrParseErr.InvalidIp;
        }
        if head_len + tail_len + 1 > 8 {
            return error AddrParseErr.InvalidIp;
        }
        if saw_double_colon {
            tail = seg_set(tail, tail_len, val);
            tail_len = tail_len + 1;
        } else {
            head = seg_set(head, head_len, val);
            head_len = head_len + 1;
        }
        if sep >= end {
            break;
        }
        -- sep points at ':'
        if sep + 1 >= end {
            -- trailing single ':' is invalid
            return error AddrParseErr.InvalidIp;
        }
        let next_ch = s.byte(sep + 1) match {
            b? => b,
            null => return error AddrParseErr.InvalidIp,
        }
        if next_ch == 58 {
            if saw_double_colon {
                return error AddrParseErr.InvalidIp;
            }
            saw_double_colon = true;
            pos = sep + 2;
        } else {
            pos = sep + 1;
        }
    }

    if not saw_double_colon {
        if head_len != 8 {
            return error AddrParseErr.InvalidIp;
        }
        return Ipv6Addr.new(head.a, head.b, head.c, head.d, head.e, head.f, head.g, head.h);
    }
    if head_len > 8 or tail_len > 8 {
        return error AddrParseErr.InvalidIp;
    }
    if head_len + tail_len >= 8 {
        return error AddrParseErr.InvalidIp;
    }
    combine_ipv6_halves(head, head_len, tail, tail_len)
}

fn write_hex_u16(val: u16, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    if val == 0 {
        return output.write_byte(48);
    }
    var started = false;
    var shift: u16 = 4096;
    while shift >= 1 {
        let nibble = ((val / shift) % 16)'bitvec[0..8].as(u8);
        if nibble != 0 or started {
            started = true;
            let ch: u8 = if nibble < 10 {
                48 + nibble
            } else if nibble < 16 {
                87 + nibble
            } else {
                63
            };
            output.write_byte(ch)!;
        }
        if shift == 1 {
            break;
        }
        shift = shift / 16;
    }
}

impl Ipv6Addr {
    pub pure fn new(
        a: u16,
        b: u16,
        c: u16,
        d: u16,
        e: u16,
        f: u16,
        g: u16,
        h: u16,
    ) -> Self
    {
        Ipv6Addr { raw_segments: [a, b, c, d, e, f, g, h] }
    }

    pub pure fn from_bits(bits: u128) -> Self {
        let v = bits'bitvec;
        Ipv6Addr {
            raw_segments: [
                v[112..128].as(u16),
                v[96..112].as(u16),
                v[80..96].as(u16),
                v[64..80].as(u16),
                v[48..64].as(u16),
                v[32..48].as(u16),
                v[16..32].as(u16),
                v[0..16].as(u16),
            ],
        }
    }

    pub fn to_bits(self) -> u128 {
        var acc: u128 = self.raw_segments[0].*'bitvec.as(u128);
        acc = acc * 65536 + self.raw_segments[1].*'bitvec.as(u128);
        acc = acc * 65536 + self.raw_segments[2].*'bitvec.as(u128);
        acc = acc * 65536 + self.raw_segments[3].*'bitvec.as(u128);
        acc = acc * 65536 + self.raw_segments[4].*'bitvec.as(u128);
        acc = acc * 65536 + self.raw_segments[5].*'bitvec.as(u128);
        acc = acc * 65536 + self.raw_segments[6].*'bitvec.as(u128);
        acc * 65536 + self.raw_segments[7].*'bitvec.as(u128)
    }

    pub pure fn segments(self) -> Array<u16, 8> {
        self.raw_segments
    }

    pub fn is_unspecified(self) -> bool {
        var i: usize = 0;
        while i < 8 {
            if self.raw_segments[i].* != 0 {
                return false;
            }
            i = i + 1;
        }
        true
    }

    pub fn is_loopback(self) -> bool {
        var i: usize = 0;
        while i < 7 {
            if self.raw_segments[i].* != 0 {
                return false;
            }
            i = i + 1;
        }
        self.raw_segments[7].* == 1
    }

    pub fn is_multicast(self) -> bool {
        (self.raw_segments[0].* / 256) == 255
    }

    pub pure fn parse(s: str) -> !AddrParseErr Self {
        let len = builtin.compiler.str_byte_length(s);
        parse_ipv6_range(s, 0, len)
    }
}

impl Clone for Ipv6Addr {
    fn clone(*self) -> Self {
        self.*
    }
}

impl Copy for Ipv6Addr {}

impl Eq for Ipv6Addr {
    fn eq(*self, other: *Self) -> bool {
        self.to_bits() == other.to_bits()
    }
}

impl Ord for Ipv6Addr {
    fn cmp(*self, other: *Self) -> Order {
        let l = self.to_bits();
        let r = other.to_bits();
        if l < r {
            .less
        } else if l == r {
            .equal
        } else {
            .greater
        }
    }
}

impl Hash for Ipv6Addr {
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        let bits = self.to_bits();
        bits.ref.as(Hash).hash(state);
    }
}

impl Display for Ipv6Addr {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter,
    {
        let _ = format;
        -- Find longest run of zeros >= 2 per RFC 5952.
        var best_start: usize = 255;
        var best_len: usize = 0;
        var cur_start: usize = 255;
        var cur_len: usize = 0;
        var i: usize = 0;
        while i < 8 {
            let seg = self.raw_segments[i].*;
            if seg == 0 {
                if cur_start == 255 {
                    cur_start = i;
                    cur_len = 1;
                } else if cur_len < 8 {
                    cur_len = cur_len + 1;
                }
                if cur_len >= 2 and cur_len > best_len {
                    best_start = cur_start;
                    best_len = cur_len;
                }
            } else {
                cur_start = 255;
                cur_len = 0;
            }
            i = i + 1;
        }
        let final_best_start: usize = if best_start <= 7 { best_start } else { 255 };
        let final_best_len: usize = if best_len <= 8 { best_len } else { 8 };
        i = 0;
        while i < 8 {
            if final_best_start <= 7 and final_best_len <= 8 and i == final_best_start {
                output.write_str("::")!;
                i = i + final_best_len;
                continue;
            }
            if i > 0
                and not (
                    final_best_start <= 7
                        and final_best_len <= 8
                        and i == final_best_start + final_best_len
                )
            {
                output.write_byte(58)!;
            }
            let seg = self.raw_segments[i].*;
            write_hex_u16(seg, output)!;
            i = i + 1;
        }
    }
}

impl Debug for Ipv6Addr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.as(Display).fmt(output)
    }
}

impl Send for Ipv6Addr {}
impl Sync for Ipv6Addr {}

-- ── IpAddr ───────────────────────────────────────────────────────────────────

pure fn str_find_byte(s: str, target: u8) -> ?u64 {
    let len = builtin.compiler.str_byte_length(s);
    var i: u64 = 0;
    while i < len {
        let b = s.byte(i) match {
            v? => v,
            null => return null,
        }
        if b == target {
            return i;
        }
        i = i + 1;
    }
    null
}

pure fn str_contains_byte(s: str, target: u8) -> bool {
    str_find_byte(s, target) match {
        _? => true,
        null => false,
    }
}

pub enum IpAddr {
    v4(Ipv4Addr),
    v6(Ipv6Addr),
}

impl IpAddr {
    pub pure fn is_ipv4(self) -> bool {
        self match {
            .v4(_) => true,
            .v6(_) => false,
        }
    }

    pub pure fn is_ipv6(self) -> bool {
        self match {
            .v4(_) => false,
            .v6(_) => true,
        }
    }

    pub fn is_unspecified(self) -> bool {
        self match {
            .v4(a) => a.is_unspecified(),
            .v6(a) => a.is_unspecified(),
        }
    }

    pub fn is_loopback(self) -> bool {
        self match {
            .v4(a) => a.is_loopback(),
            .v6(a) => a.is_loopback(),
        }
    }

    pub fn is_multicast(self) -> bool {
        self match {
            .v4(a) => a.is_multicast(),
            .v6(a) => a.is_multicast(),
        }
    }

    pub pure fn parse(s: str) -> !AddrParseErr Self {
        let len = builtin.compiler.str_byte_length(s);
        if len == 0 {
            return error AddrParseErr.EmptyInput;
        }
        if str_contains_byte(s, 58) {
            IpAddr.v6(Ipv6Addr.parse(s)!)
        } else {
            IpAddr.v4(Ipv4Addr.parse(s)!)
        }
    }
}

impl Clone for IpAddr {
    fn clone(*self) -> Self {
        self.*
    }
}

impl Copy for IpAddr {}

impl Eq for IpAddr {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .v4(a) =>
                other.* match {
                    .v4(b) => a.ref.as(Eq).eq(b.ref),
                    .v6(_) => false,
                },
            .v6(a) =>
                other.* match {
                    .v4(_) => false,
                    .v6(b) => a.ref.as(Eq).eq(b.ref),
                },
        }
    }
}

impl Ord for IpAddr {
    fn cmp(*self, other: *Self) -> Order {
        self.* match {
            .v4(a) =>
                other.* match {
                    .v4(b) => a.ref.as(Ord).cmp(b.ref),
                    .v6(_) => .less,
                },
            .v6(a) =>
                other.* match {
                    .v4(_) => .greater,
                    .v6(b) => a.ref.as(Ord).cmp(b.ref),
                },
        }
    }
}

impl Hash for IpAddr {
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        self.* match {
            .v4(a) => {
                state.as(Hasher).write_u8(4);
                a.ref.as(Hash).hash(state);
            },
            .v6(a) => {
                state.as(Hasher).write_u8(6);
                a.ref.as(Hash).hash(state);
            },
        }
    }
}

impl Display for IpAddr {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter,
    {
        let _ = format;
        self.* match {
            .v4(a) => a.ref.as(Display).fmt(output),
            .v6(a) => a.ref.as(Display).fmt(output),
        }
    }
}

impl Debug for IpAddr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.as(Display).fmt(output)
    }
}

impl Send for IpAddr {}
impl Sync for IpAddr {}

-- ── SocketAddrV4 / SocketAddrV6 / SocketAddr ─────────────────────────────────

pub struct SocketAddrV4 {
    addr_ip: Ipv4Addr,
    addr_port: u16,
}

impl SocketAddrV4 {
    pub pure fn new(ip: Ipv4Addr, port: u16) -> Self {
        SocketAddrV4 { addr_ip: ip, addr_port: port }
    }

    pub pure fn ip(self) -> Ipv4Addr {
        self.addr_ip
    }

    pub pure fn port(self) -> u16 {
        self.addr_port
    }

    pub fn set_ip(*self, new_ip: Ipv4Addr) {
        self.addr_ip.* = new_ip;
    }

    pub fn set_port(*self, new_port: u16) {
        self.addr_port.* = new_port;
    }

    pub pure fn parse(s: str) -> !AddrParseErr Self {
        let len = builtin.compiler.str_byte_length(s);
        if len == 0 {
            return error AddrParseErr.EmptyInput;
        }
        let colon = str_find_byte(s, 58) match {
            idx? => idx,
            null => return error AddrParseErr.InvalidSocketAddr,
        }
        if colon >= len {
            return error AddrParseErr.InvalidSocketAddr;
        }
        let ip = parse_ipv4_range(s, 0, colon)!;
        let port = parse_dec_u16_range(s, colon + 1, len) match {
            p? => p,
            null => return error AddrParseErr.InvalidPort,
        }
        SocketAddrV4.new(ip, port)
    }
}

impl Clone for SocketAddrV4 {
    fn clone(*self) -> Self {
        self.*
    }
}

impl Copy for SocketAddrV4 {}

impl Eq for SocketAddrV4 {
    fn eq(*self, other: *Self) -> bool {
        self.addr_ip.as(Eq).eq(other.addr_ip) and self.addr_port.* == other.addr_port.*
    }
}

impl Ord for SocketAddrV4 {
    fn cmp(*self, other: *Self) -> Order {
        let ip_ord = self.addr_ip.as(Ord).cmp(other.addr_ip);
        ip_ord match {
            .equal => self.addr_port.as(Ord).cmp(other.addr_port),
            _ => ip_ord,
        }
    }
}

impl Hash for SocketAddrV4 {
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        self.addr_ip.as(Hash).hash(state);
        self.addr_port.as(Hash).hash(state);
    }
}

impl Display for SocketAddrV4 {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter,
    {
        let _ = format;
        self.addr_ip.as(Display).fmt(output)!;
        output.write_byte(58)!;
        self.addr_port.as(Display).fmt(output)
    }
}

impl Debug for SocketAddrV4 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.as(Display).fmt(output)
    }
}

impl Send for SocketAddrV4 {}
impl Sync for SocketAddrV4 {}

pub struct SocketAddrV6 {
    addr_ip: Ipv6Addr,
    addr_port: u16,
    addr_flowinfo: u32,
    addr_scope_id: u32,
}

impl SocketAddrV6 {
    pub pure fn new(ip: Ipv6Addr, port: u16, flowinfo: u32, scope_id: u32) -> Self {
        SocketAddrV6 {
            addr_ip: ip,
            addr_port: port,
            addr_flowinfo: flowinfo,
            addr_scope_id: scope_id,
        }
    }

    pub pure fn ip(self) -> Ipv6Addr {
        self.addr_ip
    }

    pub pure fn port(self) -> u16 {
        self.addr_port
    }

    pub pure fn flowinfo(self) -> u32 {
        self.addr_flowinfo
    }

    pub pure fn scope_id(self) -> u32 {
        self.addr_scope_id
    }

    pub fn set_ip(*self, new_ip: Ipv6Addr) {
        self.addr_ip.* = new_ip;
    }

    pub fn set_port(*self, new_port: u16) {
        self.addr_port.* = new_port;
    }

    pub fn set_flowinfo(*self, new_flowinfo: u32) {
        self.addr_flowinfo.* = new_flowinfo;
    }

    pub fn set_scope_id(*self, new_scope_id: u32) {
        self.addr_scope_id.* = new_scope_id;
    }

    pub pure fn parse(s: str) -> !AddrParseErr Self {
        let len = builtin.compiler.str_byte_length(s);
        if len == 0 {
            return error AddrParseErr.EmptyInput;
        }
        let open_b = s.byte(0) match {
            b? => b,
            null => return error AddrParseErr.InvalidSocketAddr,
        }
        if open_b != 91 {
            return error AddrParseErr.InvalidSocketAddr;
        }
        let close_b = str_find_byte(s, 93) match {
            idx? => idx,
            null => return error AddrParseErr.InvalidSocketAddr,
        }
        if close_b >= len or close_b + 1 >= len {
            return error AddrParseErr.InvalidSocketAddr;
        }
        let colon = s.byte(close_b + 1) match {
            b? => b,
            null => return error AddrParseErr.InvalidSocketAddr,
        }
        if colon != 58 {
            return error AddrParseErr.InvalidSocketAddr;
        }
        let ip = parse_ipv6_range(s, 1, close_b)!;
        let port = parse_dec_u16_range(s, close_b + 2, len) match {
            p? => p,
            null => return error AddrParseErr.InvalidPort,
        }
        SocketAddrV6.new(ip, port, 0, 0)
    }
}

impl Clone for SocketAddrV6 {
    fn clone(*self) -> Self {
        self.*
    }
}

impl Copy for SocketAddrV6 {}

impl Eq for SocketAddrV6 {
    fn eq(*self, other: *Self) -> bool {
        self.addr_ip.as(Eq).eq(other.addr_ip)
            and self.addr_port.* == other.addr_port.*
            and self.addr_flowinfo.* == other.addr_flowinfo.*
            and self.addr_scope_id.* == other.addr_scope_id.*
    }
}

impl Ord for SocketAddrV6 {
    fn cmp(*self, other: *Self) -> Order {
        let ip_ord = self.addr_ip.as(Ord).cmp(other.addr_ip);
        ip_ord match {
            .equal => self.addr_port.as(Ord).cmp(other.addr_port),
            _ => ip_ord,
        }
    }
}

impl Hash for SocketAddrV6 {
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        self.addr_ip.as(Hash).hash(state);
        self.addr_port.as(Hash).hash(state);
        self.addr_flowinfo.as(Hash).hash(state);
        self.addr_scope_id.as(Hash).hash(state);
    }
}

impl Display for SocketAddrV6 {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter,
    {
        let _ = format;
        output.write_byte(91)!;
        self.addr_ip.as(Display).fmt(output)!;
        output.write_str("]:")!;
        self.addr_port.as(Display).fmt(output)
    }
}

impl Debug for SocketAddrV6 {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.as(Display).fmt(output)
    }
}

impl Send for SocketAddrV6 {}
impl Sync for SocketAddrV6 {}

pub enum SocketAddr {
    v4(SocketAddrV4),
    v6(SocketAddrV6),
}

impl SocketAddr {
    pub pure fn new(ip: IpAddr, port: u16) -> Self {
        ip match {
            .v4(a) => SocketAddr.v4(SocketAddrV4.new(a, port)),
            .v6(a) => SocketAddr.v6(SocketAddrV6.new(a, port, 0, 0)),
        }
    }

    pub pure fn ip(self) -> IpAddr {
        self match {
            .v4(a) => IpAddr.v4(a.ip()),
            .v6(a) => IpAddr.v6(a.ip()),
        }
    }

    pub pure fn port(self) -> u16 {
        self match {
            .v4(a) => a.port(),
            .v6(a) => a.port(),
        }
    }

    pub fn set_port(*self, new_port: u16) {
        let updated = SocketAddr.new(self.*.ip(), new_port);
        self.* = updated;
    }

    pub pure fn parse(s: str) -> !AddrParseErr Self {
        if builtin.compiler.str_byte_length(s) == 0 {
            return error AddrParseErr.EmptyInput;
        }
        let starts_bracket = s.byte(0) match {
            b? => b == 91,
            null => false,
        }
        if starts_bracket {
            SocketAddr.v6(SocketAddrV6.parse(s)!)
        } else {
            SocketAddr.v4(SocketAddrV4.parse(s)!)
        }
    }
}

impl Clone for SocketAddr {
    fn clone(*self) -> Self {
        self.*
    }
}

impl Copy for SocketAddr {}

impl Eq for SocketAddr {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .v4(a) =>
                other.* match {
                    .v4(b) => a.ref.as(Eq).eq(b.ref),
                    .v6(_) => false,
                },
            .v6(a) =>
                other.* match {
                    .v4(_) => false,
                    .v6(b) => a.ref.as(Eq).eq(b.ref),
                },
        }
    }
}

impl Ord for SocketAddr {
    fn cmp(*self, other: *Self) -> Order {
        self.* match {
            .v4(a) =>
                other.* match {
                    .v4(b) => a.ref.as(Ord).cmp(b.ref),
                    .v6(_) => .less,
                },
            .v6(a) =>
                other.* match {
                    .v4(_) => .greater,
                    .v6(b) => a.ref.as(Ord).cmp(b.ref),
                },
        }
    }
}

impl Hash for SocketAddr {
    fn hash(*self, state: *H) where H: Type, requires H :- Hasher {
        self.* match {
            .v4(a) => a.ref.as(Hash).hash(state),
            .v6(a) => a.ref.as(Hash).hash(state),
        }
    }
}

impl Display for SocketAddr {
    fn fmt(*self, output: *W, comptime .format: str = "") -> !W.as(ByteWriter).Err void
    where
        W :- ByteWriter,
    {
        let _ = format;
        self.* match {
            .v4(a) => a.ref.as(Display).fmt(output),
            .v6(a) => a.ref.as(Display).fmt(output),
        }
    }
}

impl Debug for SocketAddr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.as(Display).fmt(output)
    }
}

impl Send for SocketAddr {}
impl Sync for SocketAddr {}

-- ── ToSocketAddrs (Allocator-Parameterized) ──────────────────────────────────

pub trait ToSocketAddrs {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref;
}

impl ToSocketAddrs for SocketAddr {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
    {
        var out = Vec<SocketAddr, .A = A, .allocator = allocator>.with_capacity(1)!;
        out.ref.push(self.*)!;
        out
    }
}

impl ToSocketAddrs for SocketAddrV4 {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
    {
        var out = Vec<SocketAddr, .A = A, .allocator = allocator>.with_capacity(1)!;
        out.ref.push(SocketAddr.v4(self.*))!;
        out
    }
}

impl ToSocketAddrs for SocketAddrV6 {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
    {
        var out = Vec<SocketAddr, .A = A, .allocator = allocator>.with_capacity(1)!;
        out.ref.push(SocketAddr.v6(self.*))!;
        out
    }
}

impl ToSocketAddrs for Tuple<IpAddr, u16> {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
    {
        var out = Vec<SocketAddr, .A = A, .allocator = allocator>.with_capacity(1)!;
        let (ip, port) = self.*;
        out.ref.push(SocketAddr.new(ip, port))!;
        out
    }
}

impl ToSocketAddrs for Tuple<Ipv4Addr, u16> {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
    {
        var out = Vec<SocketAddr, .A = A, .allocator = allocator>.with_capacity(1)!;
        let (ip, port) = self.*;
        out.ref.push(SocketAddr.v4(SocketAddrV4.new(ip, port)))!;
        out
    }
}

impl ToSocketAddrs for Tuple<Ipv6Addr, u16> {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
    {
        var out = Vec<SocketAddr, .A = A, .allocator = allocator>.with_capacity(1)!;
        let (ip, port) = self.*;
        out.ref.push(SocketAddr.v6(SocketAddrV6.new(ip, port, 0, 0)))!;
        out
    }
}

impl ToSocketAddrs for str {
    fn to_socket_addrs(
        *self,
    ) -> ![NetErr, AllocErr] Vec<SocketAddr, .A = A, .allocator = allocator>
    where
        .A: Type = DefaultAllocator,
        requires A :- Allocator,
        quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
    {
        let parsed = SocketAddr.parse(self.*) match {
            addr! => addr,
            error err => {
                -- HOOK(@llvm-effects): if literal IP:port fails, fall back to
                -- `getaddrinfo` DNS resolution intrinsic once OS net intrinsics land.
                return error NetErr.AddrParse(err);
            },
        }
        var out = Vec<SocketAddr, .A = A, .allocator = allocator>.with_capacity(1)!;
        out.ref.push(parsed)!;
        out
    }
}
