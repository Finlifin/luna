use builtin.fmt.{ByteWriter, Debug, Display}
use collections_impl.vec.Vec;
use fmt_impl.parse.{FormatPlan, Parse}
use io_impl.errors.IoErr;
use io_impl.writer.{stderr, stdout, write_all}
use mem_impl.allocator.{AllocErr, Allocator, DefaultAllocator}
use string_impl.string.String;

pub fn print(comptime text: str) -> !IoErr void {
    write_all<text>(1)
}

{- Emit one unescaped literal segment selected by field position. -}
fn write_segment(
    output: *W,
    index: usize,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter, segments: meta.List<str> {
    inline for i in 0..segments.length() {
        const segment_index: usize = i.to_usize();
        if index == segment_index {
            const segment = segments.get(i) match {
                value? => value,
                null => "",
            }
            return output.write_str(segment);
        }
    }
}

fn write_fmt_tuple(
    output: *W,
    comptime format: str,
    values: defer Parse(format),
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    const segments = FormatPlan.literal_segments_for(format);
    const segment_count: usize = segments.length().to_usize();
    var index: usize = 0;
    inline for value in values'tuple_enumerate {
        write_segment<W, segments>(output, index)!;
        const T = value'type;
        inline if T :- Display {
            value.write(output)!;
        }
        if index < segment_count {
            index = index + 1;
        }
    }
    write_segment<W, segments>(output, index)
}

pub fn write_fmt(
    output: *W,
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_fmt_tuple(output, format, varargs)
}

pub fn format(
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !AllocErr String<.A = A, .allocator = allocator>
where
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    var bytes = Vec<u8, .A = A, .allocator = allocator>.new();
    write_fmt_tuple(bytes.ref, format, varargs)!;
    String<.A = A, .allocator = allocator>.from_utf8_lossy(bytes)
}

pub fn format_into(
    target: *String<.A = A, .allocator = a>,
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !AllocErr void
where
    A: Type,
    requires A :- Allocator,
    quote a: lift *A,
{
    var bytes = Vec<u8, .A = A, .allocator = a>.new();
    write_fmt_tuple(bytes.ref, format, varargs)!;
    var formatted = String<.A = A, .allocator = a>.from_utf8_lossy(bytes)!;
    target.push_string(formatted.ref)
}

pub fn println(comptime format: str, ...varargs: defer Parse(format)) -> !IoErr void {
    var output = stdout();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn eprint(comptime text: str) -> !IoErr void {
    write_all<text>(2)
}

pub fn eprintln(comptime format: str, ...varargs: defer Parse(format)) -> !IoErr void {
    var output = stderr();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn print_value(value: T) -> !IoErr void where T :- Display {
    var output = stdout();
    value.write(output.ref)
}

pub fn println_value(value: T) -> !IoErr void where T :- Display {
    var output = stdout();
    value.write(output.ref)!;
    output.write_byte(10)
}

pub fn format_debug(
    value: *T,
) -> !AllocErr String<.A = A, .allocator = allocator>
where
    T :- Debug,
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    var bytes = Vec<u8, .A = A, .allocator = allocator>.new();
    value.as(Debug).write_debug(bytes.ref)!;
    String<.A = A, .allocator = allocator>.from_utf8_lossy(bytes)
}
