use builtin.fmt.{ByteWriter, Debug, Display}
use builtin.fmt.options.{
    FormatOptions,
    ProbeWriter,
    compute_pad_counts,
    parse_debug_options,
    write_char_repeat,
}
use collections_impl.vec.Vec;
use fmt_impl.parse.{FormatPlan, Parse}
use io_impl.errors.IoErr;
use io_impl.writer.{stderr, stdout, write_all}
use mem_impl.allocator.{AllocErr, Allocator, DefaultAllocator}
use string_impl.string.String;

pub fn print(comptime text: str) -> !IoErr void {
    write_all<text>(1)
}

pure comptime fn str_at(values: meta.List<str>, index: Integer) -> str {
    values.get(index) match {
        value? => value,
        null => "",
    }
}

pure comptime fn bool_at(values: meta.List<bool>, index: Integer) -> bool {
    values.get(index) match {
        value? => value,
        null => false,
    }
}

fn write_debug_with_format(
    value: *T,
    output: *W,
    comptime field_fmt: str,
) -> !W.as(ByteWriter).Err void
where
    T :- Debug,
    W :- ByteWriter,
{
    let opts: FormatOptions = parse_debug_options(field_fmt);
    if not opts.has_len {
        return value.as(Debug).write_debug(output);
    }
    var probe = ProbeWriter.new();
    value.as(Debug).write_debug(probe.ref) match {
        _! => {},
        error _ => return,
    }
    let pads = compute_pad_counts(opts, probe.chars, false, false);
    if pads.left > 0 {
        write_char_repeat(opts.placeholder, pads.left, output)!;
    }
    value.as(Debug).write_debug(output)!;
    if pads.right > 0 {
        write_char_repeat(opts.placeholder, pads.right, output)!;
    }
}

fn write_fmt_tuple(
    output: *W,
    comptime format: str,
    values: defer Parse(format),
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    const segments: meta.List<str> = FormatPlan.literal_segments_for(format);
    const specs: meta.List<str> = FormatPlan.argument_specs_for(format);
    const debug_flags: meta.List<bool> = FormatPlan.argument_is_debug_for(format);
    inline for (i, value) in values'tuple_indexed {
        const segment: str = str_at(segments, i);
        output.write_str(segment)!;
        const field_fmt: str = str_at(specs, i);
        const is_debug: bool = bool_at(debug_flags, i);
        const T = value'type;
        inline if is_debug {
            inline if T :- Debug {
                write_debug_with_format(value.ref, output, field_fmt)!;
            }
        } else {
            inline if T :- Display {
                value.ref.as(Display).fmt(output, .format = field_fmt)!;
            }
        }
    }
    const tail: str = str_at(segments, specs.length());
    output.write_str(tail)
}

pub fn write_fmt(
    output: *W,
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_fmt_tuple(output, format, varargs)
}

pub comptime fn comptime_format(
    comptime format: str,
    ...varargs: defer Parse(format),
) -> str {
    let segments = FormatPlan.literal_segments_for(format);
    let specs = FormatPlan.argument_specs_for(format);
    let debug_flags = FormatPlan.argument_is_debug_for(format);
    var out = "";
    inline for (i, value) in varargs'tuple_indexed {
        let segment = str_at(segments, i);
        out = out.as(ComptimeTextBytes).concat(segment);
        let field_fmt = str_at(specs, i);
        let is_debug = bool_at(debug_flags, i);
        const T = value'type;
        if is_debug {
            assumes false;
        } else {
            inline if T :- Display {
                out = out.as(ComptimeTextBytes).concat(value.as(Display).comptime_fmt(.format = field_fmt));
            }
        }
    }
    let tail = str_at(segments, specs.length());
    out.as(ComptimeTextBytes).concat(tail)
}

pub fn format(
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !AllocErr String<.A = A, .allocator = allocator>
where
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    var bytes = Vec<u8, .A = A, .allocator = allocator>.new();
    write_fmt_tuple(bytes.ref, format, varargs)!;
    String<.A = A, .allocator = allocator>.from_utf8_lossy(bytes)
}

pub fn format_into(
    target: *String<.A = A, .allocator = a>,
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !AllocErr void
where
    A: Type,
    requires A :- Allocator,
    quote a: lift *A,
{
    var bytes = Vec<u8, .A = A, .allocator = a>.new();
    write_fmt_tuple(bytes.ref, format, varargs)!;
    var formatted = String<.A = A, .allocator = a>.from_utf8_lossy(bytes)!;
    target.push_string(formatted.ref)
}

pub fn println(comptime format: str, ...varargs: defer Parse(format)) -> !IoErr void {
    var output = stdout();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn eprint(comptime text: str) -> !IoErr void {
    write_all<text>(2)
}

pub fn eprintln(comptime format: str, ...varargs: defer Parse(format)) -> !IoErr void {
    var output = stderr();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn print_value(value: T) -> !IoErr void where T :- Display {
    var output = stdout();
    value.ref.as(Display).fmt(output.ref)
}

pub fn println_value(value: T) -> !IoErr void where T :- Display {
    var output = stdout();
    value.ref.as(Display).fmt(output.ref)!;
    output.write_byte(10)
}

pub fn format_debug(
    value: *T,
) -> !AllocErr String<.A = A, .allocator = allocator>
where
    T :- Debug,
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    var bytes = Vec<u8, .A = A, .allocator = allocator>.new();
    value.as(Debug).write_debug(bytes.ref)!;
    String<.A = A, .allocator = allocator>.from_utf8_lossy(bytes)
}
