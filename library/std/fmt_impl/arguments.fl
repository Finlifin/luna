use builtin.fmt.{ByteWriter, Display}
use fmt_impl.parse.{FormatPlan, Parse}
use io_impl.errors.Error;
use io_impl.writer.{stderr, stdout, write_all}

pub fn print(comptime text: str) -> !Error void {
    write_all<text>(1)
}

{- Emit one unescaped literal segment selected by field position. -}
fn write_segment(
    output: *std.io.Writer,
    index: usize,
) -> !Error void where segments: meta.List<str> {
    inline for i in 0..segments.length() {
        const segment_index: usize = i.to_usize();
        if index == segment_index {
            const segment = segments.get(i) match {
                value? => value,
                null => "",
            }
            let writer = output.*;
            return writer.write_all<segment>();
        }
    }
}

fn write_fmt_tuple(
    output: *std.io.Writer,
    comptime format: str,
    values: defer Parse(format),
) -> !Error void {
    const segments = FormatPlan.literal_segments_for(format);
    const segment_count: usize = segments.length().to_usize();
    var index: usize = 0;
    inline for value in values'tuple_enumerate {
        write_segment<segments>(output, index)!;
        const T = value'type;
        inline if T :- Display {
            value.write(output)!;
        }
        if index < segment_count {
            index = index + 1;
        }
    }
    write_segment<segments>(output, index)
}

pub fn write_fmt(
    output: *std.io.Writer,
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !Error void {
    write_fmt_tuple(output, format, varargs)
}

pub fn println(comptime format: str, ...varargs: defer Parse(format)) -> !Error void {
    var output = stdout();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn eprint(comptime text: str) -> !Error void {
    write_all<text>(2)
}

pub fn eprintln(comptime format: str, ...varargs: defer Parse(format)) -> !Error void {
    var output = stderr();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn print_value(value: T) -> !Error void where T :- Display {
    var output = stdout();
    value.write(output.ref)
}

pub fn println_value(value: T) -> !Error void where T :- Display {
    var output = stdout();
    value.write(output.ref)!;
    output.write_byte(10)
}
