use builtin.fmt.{Binary, ByteWriter, Debug, Display, LowerHex, Octal, UpperHex}
use collections_impl.vec.Vec;
use fmt_impl.parse.{FormatKind, FormatPlan, Parse}
use io_impl.errors.IoErr;
use io_impl.writer.{stderr, stdout, write_all}
use mem_impl.allocator.{AllocErr, Allocator, DefaultAllocator}
use string_impl.string.String;

pub fn print(comptime text: str) -> !IoErr void {
    write_all<text>(1)
}

{- Emit one unescaped literal segment selected by field position. -}
fn write_segment(
    output: *W,
    index: usize,
) -> !W.as(ByteWriter).Err void where W :- ByteWriter, segments: meta.List<str> {
    inline for i in 0..segments.length() {
        const segment_index: usize = i.to_usize();
        if index == segment_index {
            const segment = segments.get(i) match {
                value? => value,
                null => "",
            }
            return output.write_str(segment);
        }
    }
}

{- Dispatch one argument via Display (`{}`), Debug (`{:?}`), or radix traits. -}
fn write_arg(
    output: *W,
    index: usize,
    value: T,
) -> !W.as(ByteWriter).Err void
where
    W :- ByteWriter,
    T,
    kinds: meta.List<FormatKind>,
{
    inline for i in 0..kinds.length() {
        const arg_index: usize = i.to_usize();
        if index == arg_index {
            const kind: FormatKind = kinds.get(i) match {
                found? => found,
                null => FormatKind.display,
            }
            const is_debug: bool = kind matches FormatKind.debug;
            const is_lower_hex: bool = (kind matches FormatKind.lower_hex)
                or (kind matches FormatKind.lower_hex_alt);
            const is_upper_hex: bool = (kind matches FormatKind.upper_hex)
                or (kind matches FormatKind.upper_hex_alt);
            const is_binary: bool = (kind matches FormatKind.binary)
                or (kind matches FormatKind.binary_alt);
            const is_octal: bool = (kind matches FormatKind.octal)
                or (kind matches FormatKind.octal_alt);
            const is_alt: bool = (kind matches FormatKind.lower_hex_alt)
                or (kind matches FormatKind.upper_hex_alt)
                or (kind matches FormatKind.binary_alt)
                or (kind matches FormatKind.octal_alt);
            inline if is_debug {
                inline if T :- Debug {
                    return value.ref.as(Debug).write_debug(output);
                }
            } else {
                inline if is_lower_hex {
                    inline if is_alt {
                        output.write_str("0x")!;
                    }
                    inline if T :- LowerHex {
                        return value.ref.as(LowerHex).write_lower_hex(output);
                    }
                } else {
                    inline if is_upper_hex {
                        inline if is_alt {
                            output.write_str("0X")!;
                        }
                        inline if T :- UpperHex {
                            return value.ref.as(UpperHex).write_upper_hex(output);
                        }
                    } else {
                        inline if is_binary {
                            inline if is_alt {
                                output.write_str("0b")!;
                            }
                            inline if T :- Binary {
                                return value.ref.as(Binary).write_binary(output);
                            }
                        } else {
                            inline if is_octal {
                                inline if is_alt {
                                    output.write_str("0o")!;
                                }
                                inline if T :- Octal {
                                    return value.ref.as(Octal).write_octal(output);
                                }
                            } else {
                                inline if T :- Display {
                                    return value.write(output);
                                }
                            }
                        }
                    }
                }
            }
            return;
        }
    }
}

fn write_fmt_tuple(
    output: *W,
    comptime format: str,
    values: defer Parse(format),
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    const segments = FormatPlan.literal_segments_for(format);
    const kinds = FormatPlan.argument_kinds_for(format);
    const segment_count: usize = segments.length().to_usize();
    var index: usize = 0;
    inline for value in values'tuple_enumerate {
        write_segment<W, segments>(output, index)!;
        const T = value'type;
        write_arg<W, T, kinds>(output, index, value)!;
        if index < segment_count {
            index = index + 1;
        }
    }
    write_segment<W, segments>(output, index)
}

pub fn write_fmt(
    output: *W,
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
    write_fmt_tuple(output, format, varargs)
}

pub fn format(
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !AllocErr String<.A = A, .allocator = allocator>
where
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    var bytes = Vec<u8, .A = A, .allocator = allocator>.new();
    write_fmt_tuple(bytes.ref, format, varargs)!;
    String<.A = A, .allocator = allocator>.from_utf8_lossy(bytes)
}

pub fn format_into(
    target: *String<.A = A, .allocator = a>,
    comptime format: str,
    ...varargs: defer Parse(format),
) -> !AllocErr void
where
    A: Type,
    requires A :- Allocator,
    quote a: lift *A,
{
    var bytes = Vec<u8, .A = A, .allocator = a>.new();
    write_fmt_tuple(bytes.ref, format, varargs)!;
    var formatted = String<.A = A, .allocator = a>.from_utf8_lossy(bytes)!;
    target.push_string(formatted.ref)
}

pub fn println(comptime format: str, ...varargs: defer Parse(format)) -> !IoErr void {
    var output = stdout();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn eprint(comptime text: str) -> !IoErr void {
    write_all<text>(2)
}

pub fn eprintln(comptime format: str, ...varargs: defer Parse(format)) -> !IoErr void {
    var output = stderr();
    write_fmt_tuple(output.ref, format, varargs)!;
    output.write_byte(10)
}

pub fn print_value(value: T) -> !IoErr void where T :- Display {
    var output = stdout();
    value.write(output.ref)
}

pub fn println_value(value: T) -> !IoErr void where T :- Display {
    var output = stdout();
    value.write(output.ref)!;
    output.write_byte(10)
}

pub fn format_debug(
    value: *T,
) -> !AllocErr String<.A = A, .allocator = allocator>
where
    T :- Debug,
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    var bytes = Vec<u8, .A = A, .allocator = allocator>.new();
    value.as(Debug).write_debug(bytes.ref)!;
    String<.A = A, .allocator = allocator>.from_utf8_lossy(bytes)
}
