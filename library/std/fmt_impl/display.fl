impl Display for i128 {
    fn write(self, output: Writer) -> !Error void { signed_decimal(self'bitvec.as(i128), output) }
}

impl Display for isize {
    fn write(self, output: Writer) -> !Error void {
        if self < 0 {
            output.write_byte(45)!;
            let magnitude = builtin.compiler.isize_representation(-(self + 1));
            assumes magnitude < 340282366920938463463374607431768211455;
            unsigned_decimal(magnitude + 1, output)
        } else { unsigned_decimal(builtin.compiler.isize_representation(self), output) }
    }
}
