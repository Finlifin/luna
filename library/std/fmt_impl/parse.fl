use builtin.fmt.{Debug, Display}
use builtin.fmt.options.{scan_braced_field, validate_property_list}

{-
    Formatting is a comptime library operation. A plan retains byte ranges in
    the original text and ordered argument positions, without copying text or
    constructing runtime storage. `{}` selects Display with empty options,
    `{key: value, ...}` passes raw property options to `Display` (or selects
    `Debug` when `format: .debug` is present), and `{{` / `}}` escape to literal
    braces. Other field syntax is rejected explicitly.

    This scanner is the lexical input to Parse's parameter-domain computation.
    It does not replace the Type description or admit runtime arguments.
-}
pub enum FormatPiece {
    text(u64, u64),
    argument(Integer, u64, u64),
    debug_argument(Integer, u64, u64),
}

pub enum FormatKind {
    display,
    debug,
}

pub enum FormatErr {
    UnclosedField(u64),
    UnmatchedClose(u64),
    UnsupportedField(u64),
}

pub struct FormatPlan {
    pieces: meta.List<FormatPiece>,
    argument_count: Integer,
}

impl FormatPlan {
    pub pure comptime fn parse(format: str) -> !FormatErr Self {
        var pieces: meta.List<FormatPiece> = [];
        var arguments: Integer = 0;
        var cursor: u64 = 0;
        var start: u64 = 0;
        let length = format.byte_length();
        while cursor < length {
            let byte = format.byte(cursor) match {
                value? => value,
                null => return error FormatErr.UnclosedField(cursor),
            }
            if byte == 123 or byte == 125 {
                if start < cursor {
                    pieces = pieces.concat([FormatPiece.text(start, cursor)]);
                }
                let next = cursor + 1;
                let following = format.byte(next);
                if byte == 123 {
                    following match {
                        123? => {
                            pieces = pieces.concat([FormatPiece.text(cursor, next)]);
                            assumes next < length;
                            cursor = next + 1;
                            start = cursor;
                        },
                        null => return error FormatErr.UnclosedField(cursor),
                        _? => {
                            let close_pos = scan_braced_field(format, cursor) match {
                                found? => found,
                                null => return error FormatErr.UnclosedField(cursor),
                            }
                            let body = format.slice(next, close_pos) match {
                                slice_text? => slice_text,
                                null => return error FormatErr.UnsupportedField(cursor),
                            }
                            let is_debug = validate_property_list(body) match {
                                flag? => flag,
                                null => return error FormatErr.UnsupportedField(cursor),
                            }
                            let piece = if is_debug {
                                FormatPiece.debug_argument(arguments, next, close_pos)
                            } else {
                                FormatPiece.argument(arguments, next, close_pos)
                            };
                            pieces = pieces.concat([piece]);
                            arguments = arguments + 1;
                            assumes close_pos < length;
                            cursor = close_pos + 1;
                            start = cursor;
                        },
                    };
                } else {
                    following match {
                        125? => {
                            pieces = pieces.concat([FormatPiece.text(cursor, next)]);
                            assumes next < length;
                            cursor = next + 1;
                            start = cursor;
                        },
                        _ => return error FormatErr.UnmatchedClose(cursor),
                    };
                }
            } else {
                cursor = cursor + 1;
            }
        }
        if start < length {
            pieces = pieces.concat([FormatPiece.text(start, length)]);
        }
        Self {
            pieces: pieces,
            argument_count: arguments,
        }
    }

    {- Each field admits its own concrete runtime type and trait requirement. -}
    pub pure comptime fn argument_domains(self) -> meta.List<Type> {
        let display_field = refines { Itself :- Display } Any;
        let debug_field = refines { Itself :- Debug } Any;
        var domains: meta.List<Type> = [];
        var index: Integer = 0;
        let piece_count = self.pieces.length();
        while index < piece_count {
            let piece = self.pieces.get(index) match {
                value? => value,
                null => {
                    assumes false;
                    return domains;
                },
            }
            piece match {
                FormatPiece.text(_, _) => {},
                FormatPiece.argument(_, _, _) => {
                    domains = domains.concat([display_field]);
                },
                FormatPiece.debug_argument(_, _, _) => {
                    domains = domains.concat([debug_field]);
                },
            }
            index = index + 1;
        }
        domains
    }

    {- Each comptime format field requires `meta.ComptimeDisplay`. -}
    pub pure comptime fn comptime_argument_domains(self) -> meta.List<Type> {
        let display_field = refines { Itself :- meta.ComptimeDisplay } Any;
        var domains: meta.List<Type> = [];
        var index: Integer = 0;
        let piece_count = self.pieces.length();
        while index < piece_count {
            let piece = self.pieces.get(index) match {
                value? => value,
                null => {
                    assumes false;
                    return domains;
                },
            }
            piece match {
                FormatPiece.text(_, _) => {},
                FormatPiece.argument(_, _, _) => {
                    domains = domains.concat([display_field]);
                },
                FormatPiece.debug_argument(_, _, _) => {
                    assumes false;
                    return domains;
                },
            }
            index = index + 1;
        }
        domains
    }

    pub pure comptime fn argument_kinds(self) -> meta.List<FormatKind> {
        var kinds: meta.List<FormatKind> = [];
        var index: Integer = 0;
        let piece_count = self.pieces.length();
        while index < piece_count {
            let piece = self.pieces.get(index) match {
                value? => value,
                null => {
                    assumes false;
                    return kinds;
                },
            }
            piece match {
                FormatPiece.text(_, _) => {},
                FormatPiece.argument(_, _, _) => {
                    kinds = kinds.concat([FormatKind.display]);
                },
                FormatPiece.debug_argument(_, _, _) => {
                    kinds = kinds.concat([FormatKind.debug]);
                },
            }
            index = index + 1;
        }
        kinds
    }

    pub pure comptime fn argument_kinds_for(format: str) -> meta.List<FormatKind> {
        FormatPlan.parse(format) match {
            plan! => plan.argument_kinds(),
            error _ => {
                assumes false;
                []
            },
        }
    }

    pub pure comptime fn argument_is_debug(self) -> meta.List<bool> {
        var flags: meta.List<bool> = [];
        var index: Integer = 0;
        let piece_count = self.pieces.length();
        while index < piece_count {
            let piece = self.pieces.get(index) match {
                value? => value,
                null => {
                    assumes false;
                    return flags;
                },
            }
            piece match {
                FormatPiece.text(_, _) => {},
                FormatPiece.debug_argument(_, _, _) => {
                    flags = flags.concat([true]);
                },
                FormatPiece.argument(_, _, _) => {
                    flags = flags.concat([false]);
                },
            }
            index = index + 1;
        }
        flags
    }

    pub pure comptime fn argument_is_debug_for(format: str) -> meta.List<bool> {
        FormatPlan.parse(format) match {
            plan! => plan.argument_is_debug(),
            error _ => {
                assumes false;
                []
            },
        }
    }

    pub pure comptime fn argument_specs(self, format: str) -> meta.List<str> {
        var specs: meta.List<str> = [];
        var index: Integer = 0;
        let piece_count = self.pieces.length();
        while index < piece_count {
            let piece = self.pieces.get(index) match {
                value? => value,
                null => {
                    assumes false;
                    return specs;
                },
            }
            piece match {
                FormatPiece.text(_, _) => {},
                FormatPiece.argument(_, spec_start, spec_end)
                    or FormatPiece.debug_argument(_, spec_start, spec_end) => {
                    let item_spec = format.slice(spec_start, spec_end) match {
                        value? => value,
                        null => "",
                    }
                    specs = specs.concat([item_spec]);
                },
            }
            index = index + 1;
        }
        specs
    }

    pub pure comptime fn argument_specs_for(format: str) -> meta.List<str> {
        FormatPlan.parse(format) match {
            plan! => plan.argument_specs(format),
            error _ => {
                assumes false;
                []
            },
        }
    }

    pub pure comptime fn literal_segments(self, format: str) -> meta.List<str> {
        var segments: meta.List<str> = [];
        var current = "";
        var index: Integer = 0;
        let piece_count = self.pieces.length();
        while index < piece_count {
            let piece = self.pieces.get(index) match {
                value? => value,
                null => {
                    assumes false;
                    return segments;
                },
            }
            piece match {
                FormatPiece.text(start, end) => {
                    let chunk = format.slice(start, end) match {
                        value? => value,
                        null => "",
                    }
                    current = current.as(ComptimeTextBytes).concat(chunk);
                },
                FormatPiece.argument(_, _, _) or FormatPiece.debug_argument(_, _, _) => {
                    segments = segments.concat([current]);
                    current = "";
                },
            }
            index = index + 1;
        }
        segments.concat([current])
    }

    pub pure comptime fn literal_segments_for(format: str) -> meta.List<str> {
        FormatPlan.parse(format) match {
            plan! => plan.literal_segments(format),
            error _ => {
                assumes false;
                []
            },
        }
    }
}

pub pure comptime fn Parse(format: str) -> R: Type
where
    ensures Type.predicates.is_tuple(R),
{
    let parsed = FormatPlan.parse(format);
    let domains: meta.List<Type> = parsed match {
        plan! => plan.argument_domains(),
        error _ => {
            assumes false;
            []
        },
    }
    Tuple<.Es = domains>
}

pub pure comptime fn ComptimeParse(format: str) -> R: Type
where
    ensures Type.predicates.is_tuple(R),
{
    let parsed = FormatPlan.parse(format);
    let domains: meta.List<Type> = parsed match {
        plan! => plan.comptime_argument_domains(),
        error _ => {
            assumes false;
            []
        },
    }
    Tuple<.Es = domains>
}
