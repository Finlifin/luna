-- ── 3. Oneshot Channel ───────────────────────────────────────────────────────

-- state_tag: 0 = empty, 1 = sent, 2 = sender_closed, 3 = receiver_closed, 4 = taken
struct OneshotShared
where
    T: Type,
{
    state_tag: AtomicUsize,
    refs: AtomicUsize,
    value: ?T,
}

fn retire_opt(v: ?T) where T: Type {}

fn oneshot_drop_shared(alloc: *A, shared_addr: usize)
where
    T: Type,
    A: Type,
    requires A :- Allocator + Sync,
{
    if shared_addr == 0 {
        return;
    }
    let shared = unsafe { builtin.mem.raw_ptr<OneshotShared<T>>(shared_addr) }
    let prev = shared.refs.fetch_sub(1, AtomicOrdering.acq_rel);
    if prev == 1 {
        let owned = unsafe { builtin.mem.raw_read<OneshotShared<T>>(shared_addr) }
        retire_opt(owned.value);
        let layout = Layout.of<OneshotShared<T>>() match {
            l? => l,
            null => return,
        }
        unsafe {
            alloc
                .as(Allocator)
                .deallocate(RawBlock.from_raw_parts(shared_addr, layout));
        }
    }
}

pub struct OneshotSender
where
    T: Type,
    requires T :- Send,
    .A: Type = DefaultAllocator,
    requires A :- Allocator + Sync,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    shared_addr: usize,
}

pub struct OneshotReceiver
where
    T: Type,
    requires T :- Send,
    .A: Type = DefaultAllocator,
    requires A :- Allocator + Sync,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    shared_addr: usize,
}

pub fn oneshot_channel() -> !AllocErr Tuple<OneshotSender<T, .A = A, .allocator = allocator>, OneshotReceiver<T, .A = A, .allocator = allocator>>
where
    T: Type,
    requires T :- Send,
    .A: Type = DefaultAllocator,
    requires A :- Allocator + Sync,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    let layout = Layout.of<OneshotShared<T>>() match {
        l? => l,
        null => return error AllocErr.InvalidLayout,
    }
    let block = alloc_shared_block(allocator, layout)!;
    let shared = OneshotShared<T> {
        state_tag: AtomicUsize.new(0),
        refs: AtomicUsize.new(2),
        value: null,
    }
    unsafe {
        builtin.mem.raw_write<OneshotShared<T>>(block.address(), shared);
    }
    let tx = OneshotSender<T, .A = A, .allocator = allocator> {
        shared_addr: block.address(),
    };
    let rx = OneshotReceiver<T, .A = A, .allocator = allocator> {
        shared_addr: block.address(),
    };
    (tx, rx)
}

impl OneshotSender<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    pub fn is_closed(*self) -> bool {
        let addr = self.shared_addr.*;
        if addr == 0 {
            return true;
        }
        let shared = unsafe { builtin.mem.raw_ptr<OneshotShared<T>>(addr) }
        shared.state_tag.load(AtomicOrdering.acquire) == 3
    }

    pub fn send(self, value: T) -> !SendErr<T> void {
        let addr = self.shared_addr;
        if addr == 0 {
            return error SendErr<T>.new(value);
        }
        let shared = unsafe { builtin.mem.raw_ptr<OneshotShared<T>>(addr) }
        if shared.state_tag.load(AtomicOrdering.acquire) == 3 {
            return error SendErr<T>.new(value);
        }
        let wrapped: ?T = value;
        unsafe {
            builtin.mem.raw_write<?T>(builtin.mem.ptr_addr(shared.value), wrapped);
        }
        shared.state_tag.store(1, AtomicOrdering.release);
    }
}

impl OneshotReceiver<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    pub fn try_recv(*self) -> !TryRecvErr T {
        let addr = self.shared_addr.*;
        if addr == 0 {
            return error TryRecvErr.Disconnected;
        }
        let shared = unsafe { builtin.mem.raw_ptr<OneshotShared<T>>(addr) }
        let tag = shared.state_tag.load(AtomicOrdering.acquire);
        if tag == 0 {
            return error TryRecvErr.Empty;
        }
        if tag != 1 {
            return error TryRecvErr.Disconnected;
        }
        shared.state_tag.store(4, AtomicOrdering.release);
        let taken = unsafe { builtin.mem.raw_read<?T>(builtin.mem.ptr_addr(shared.value)) }
        let empty: ?T = null;
        unsafe {
            builtin.mem.raw_write<?T>(builtin.mem.ptr_addr(shared.value), empty);
        }
        taken match {
            v? => v,
            null => error TryRecvErr.Disconnected,
        }
    }

    pub fn recv(self) -> !RecvErr T {
        while true {
            self.ref.try_recv() match {
                v! => return v,
                error TryRecvErr.Empty => {},
                error TryRecvErr.Disconnected => return error RecvErr.Disconnected,
            }
        }
        error RecvErr.Disconnected
    }

    pub fn recv_async(self) -> #AsyncCore !RecvErr T {
        while true {
            self.ref.try_recv() match {
                v! => return v,
                error TryRecvErr.Empty => {
                    AsyncCore.yield_now()# match {
                        _! => {},
                        error _ => return error RecvErr.Disconnected,
                    }
                },
                error TryRecvErr.Disconnected => return error RecvErr.Disconnected,
            }
        }
        error RecvErr.Disconnected
    }
}

impl Drop for OneshotSender<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    fn drop(*self) {
        let addr = self.shared_addr.*;
        if addr == 0 {
            return;
        }
        self.shared_addr.* = 0;
        let shared = unsafe { builtin.mem.raw_ptr<OneshotShared<T>>(addr) }
        let _ = shared.state_tag.compare_exchange(
            0,
            2,
            AtomicOrdering.acq_rel,
            AtomicOrdering.acquire,
        );
        oneshot_drop_shared<T, A>(alloc, addr);
    }
}

impl Drop for OneshotReceiver<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    fn drop(*self) {
        let addr = self.shared_addr.*;
        if addr == 0 {
            return;
        }
        self.shared_addr.* = 0;
        let shared = unsafe { builtin.mem.raw_ptr<OneshotShared<T>>(addr) }
        let _ = shared.state_tag.compare_exchange(
            0,
            3,
            AtomicOrdering.acq_rel,
            AtomicOrdering.acquire,
        );
        oneshot_drop_shared<T, A>(alloc, addr);
    }
}

