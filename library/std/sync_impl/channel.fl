-- ── 4. Broadcast Channel ─────────────────────────────────────────────────────

struct BroadcastSlot
where
    T: Type,
{
    seq: u64,
    value: ?T,
}

struct BroadcastState
where
    T: Type,
{
    buf_addr: usize,
    cap: usize,
    tail_seq: u64,
    sender_count: usize,
    receiver_count: usize,
}

struct BroadcastShared
where
    T: Type,
    requires T :- Send,
{
    state: Mutex<BroadcastState<T>>,
    refs: AtomicUsize,
}

impl Send for BroadcastSlot<T> where T :- Send {}
impl Send for BroadcastState<T> where T :- Send {}
impl Send for BroadcastShared<T> where T :- Send {}
impl Sync for BroadcastShared<T> where T :- Send {}

fn broadcast_drop_shared(alloc: *A, shared_addr: usize)
where
    T: Type,
    requires T :- Send + Clone,
    A: Type,
    requires A :- Allocator + Sync,
{
    if shared_addr == 0 {
        return;
    }
    let shared = unsafe { builtin.mem.raw_ptr<BroadcastShared<T>>(shared_addr) }
    let prev = shared.refs.fetch_sub(1, AtomicOrdering.acq_rel);
    if prev == 1 {
        let owned = unsafe { builtin.mem.raw_read<BroadcastShared<T>>(shared_addr) }
        let st = owned.state.into_inner() match {
            q! => q,
            error p => p.into_inner(),
        }
        var i: usize = 0;
        while i < st.cap {
            let slot = unsafe {
                builtin.mem.raw_read<BroadcastSlot<T>>(slot_addr_at<BroadcastSlot<T>>(st.buf_addr, i))
            }
            retire_opt(slot.value);
            i = i + 1;
        }
        dealloc_ring_buffer<BroadcastSlot<T>, A>(alloc, st.buf_addr, st.cap);
        let layout = Layout.of<BroadcastShared<T>>() match {
            l? => l,
            null => return,
        }
        unsafe {
            alloc
                .as(Allocator)
                .deallocate(RawBlock.from_raw_parts(shared_addr, layout));
        }
    }
}

pub struct BroadcastSender
where
    T: Type,
    requires T :- Send + Clone,
    .A: Type = DefaultAllocator,
    requires A :- Allocator + Sync,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    shared_addr: usize,
}

pub struct BroadcastReceiver
where
    T: Type,
    requires T :- Send + Clone,
    .A: Type = DefaultAllocator,
    requires A :- Allocator + Sync,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    shared_addr: usize,
    cursor: u64,
}

pub fn broadcast_channel(
    capacity: usize,
) -> !AllocErr Tuple<BroadcastSender<T, .A = A, .allocator = allocator>, BroadcastReceiver<T, .A = A, .allocator = allocator>>
where
    T: Type,
    requires T :- Send + Clone,
    .A: Type = DefaultAllocator,
    requires A :- Allocator + Sync,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    let cap: usize = if capacity == 0 { 1 } else { capacity }
    let buf = alloc_ring_buffer<BroadcastSlot<T>, A>(allocator, cap)!;
    var i: usize = 0;
    while i < cap {
        let empty = BroadcastSlot<T> { seq: 0, value: null }
        unsafe {
            builtin.mem.raw_write<BroadcastSlot<T>>(
                slot_addr_at<BroadcastSlot<T>>(buf, i),
                empty,
            );
        }
        i = i + 1;
    }
    let layout = Layout.of<BroadcastShared<T>>() match {
        l? => l,
        null => {
            dealloc_ring_buffer<BroadcastSlot<T>, A>(allocator, buf, cap);
            return error AllocErr.InvalidLayout;
        },
    }
    let block = alloc_shared_block(allocator, layout) match {
        b! => b,
        error err => {
            dealloc_ring_buffer<BroadcastSlot<T>, A>(allocator, buf, cap);
            return error err;
        },
    }
    let shared = BroadcastShared<T> {
        state: Mutex<BroadcastState<T>>.new(BroadcastState<T> {
            buf_addr: buf,
            cap: cap,
            tail_seq: 0,
            sender_count: 1,
            receiver_count: 1,
        }),
        refs: AtomicUsize.new(2),
    }
    unsafe {
        builtin.mem.raw_write<BroadcastShared<T>>(block.address(), shared);
    }
    let tx = BroadcastSender<T, .A = A, .allocator = allocator> {
        shared_addr: block.address(),
    };
    let rx = BroadcastReceiver<T, .A = A, .allocator = allocator> {
        shared_addr: block.address(),
        cursor: 0,
    };
    (tx, rx)
}

impl BroadcastSender<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send + Clone,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    pub fn send(*self, value: T) -> !SendErr<T> usize {
        let addr = self.shared_addr.*;
        let shared = unsafe { builtin.mem.raw_ptr<BroadcastShared<T>>(addr) }
        let guard = shared.state.lock() match {
            g! => g,
            error p => p.into_inner(),
        }
        let st = guard.ref.as_ptr();
        let receivers = st.receiver_count.*;
        if receivers == 0 {
            return error SendErr<T>.new(value);
        }
        let seq = st.tail_seq.*;
        let cap_u64 = builtin.compiler.try_usize_to_u64(st.cap.*) match {
            c? => c,
            null => 1,
        }
        let slot_u64: u64 = if cap_u64 == 0 { 0 } else { seq % cap_u64 };
        let idx = builtin.compiler.try_u64_to_usize(slot_u64) match {
            i? => i,
            null => 0,
        }
        let slot_addr = slot_addr_at<BroadcastSlot<T>>(st.buf_addr.*, idx);
        let old = unsafe { builtin.mem.raw_read<BroadcastSlot<T>>(slot_addr) }
        retire_opt(old.value);
        let next_slot = BroadcastSlot<T> {
            seq: if seq < 18446744073709551615 { seq + 1 } else { 0 },
            value: value,
        }
        unsafe {
            builtin.mem.raw_write<BroadcastSlot<T>>(slot_addr, next_slot);
        }
        st.tail_seq.* = if seq < 18446744073709551615 { seq + 1 } else { 0 };
        receivers
    }

    pub fn subscribe(*self) -> BroadcastReceiver<T, .A = A, .allocator = alloc> {
        let addr = self.shared_addr.*;
        var start_cursor: u64 = 0;
        if addr != 0 {
            let shared = unsafe { builtin.mem.raw_ptr<BroadcastShared<T>>(addr) }
            let _ = shared.refs.fetch_add(1, AtomicOrdering.relaxed);
            let guard = shared.state.lock() match {
                g! => g,
                error p => p.into_inner(),
            }
            let st = guard.ref.as_ptr();
            st.receiver_count.* = builtin.mem.checked_add_usize(st.receiver_count.*, 1) match {
                v? => v,
                null => st.receiver_count.*,
            };
            start_cursor = st.tail_seq.*;
        }
        BroadcastReceiver<T, .A = A, .allocator = alloc> {
            shared_addr: addr,
            cursor: start_cursor,
        }
    }
}

impl BroadcastReceiver<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send + Clone,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    pub fn try_recv(*self) -> !TryRecvErr T {
        let addr = self.shared_addr.*;
        let shared = unsafe { builtin.mem.raw_ptr<BroadcastShared<T>>(addr) }
        let guard = shared.state.lock() match {
            g! => g,
            error p => p.into_inner(),
        }
        let st = guard.ref.as_ptr();
        let tail = st.tail_seq.*;
        let cap_u64 = builtin.compiler.try_usize_to_u64(st.cap.*) match {
            c? => c,
            null => 1,
        }
        if tail > cap_u64 and self.cursor.* < tail - cap_u64 {
            self.cursor.* = tail - cap_u64;
        }
        if self.cursor.* >= tail {
            if st.sender_count.* == 0 {
                return error TryRecvErr.Disconnected;
            }
            return error TryRecvErr.Empty;
        }
        let slot_u64: u64 = if cap_u64 == 0 { 0 } else { self.cursor.* % cap_u64 };
        let idx = builtin.compiler.try_u64_to_usize(slot_u64) match {
            i? => i,
            null => 0,
        }
        let slot_addr = slot_addr_at<BroadcastSlot<T>>(st.buf_addr.*, idx);
        let slot = unsafe { builtin.mem.raw_read<BroadcastSlot<T>>(slot_addr) }
        let cloned_opt = slot.value match {
            v? => {
                let slot_val = v;
                let copy = T.as(Clone).clone(slot_val.ref);
                let restored = BroadcastSlot<T> { seq: slot.seq, value: slot_val };
                unsafe {
                    builtin.mem.raw_write<BroadcastSlot<T>>(slot_addr, restored);
                }
                copy
            },
            null => {
                let restored = BroadcastSlot<T> { seq: slot.seq, value: null }
                unsafe {
                    builtin.mem.raw_write<BroadcastSlot<T>>(slot_addr, restored);
                }
                return error TryRecvErr.Empty;
            },
        }
        if self.cursor.* < 18446744073709551615 {
        let cur_cursor = self.cursor.*;
        if cur_cursor < 18446744073709551615 {
            self.cursor.* = cur_cursor + 1;
        }
        }
        cloned_opt
    }

    pub fn recv(*self) -> !RecvErr T {
        while true {
            self.try_recv() match {
                v! => return v,
                error TryRecvErr.Empty => {},
                error TryRecvErr.Disconnected => return error RecvErr.Disconnected,
            }
        }
        error RecvErr.Disconnected
    }

    pub fn recv_async(*self) -> #AsyncCore !RecvErr T {
        while true {
            self.try_recv() match {
                v! => return v,
                error TryRecvErr.Empty => {
                    AsyncCore.yield_now()# match {
                        _! => {},
                        error _ => return error RecvErr.Disconnected,
                    }
                },
                error TryRecvErr.Disconnected => return error RecvErr.Disconnected,
            }
        }
        error RecvErr.Disconnected
    }
}

impl Drop for BroadcastSender<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send + Clone,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    fn drop(*self) {
        let addr = self.shared_addr.*;
        if addr == 0 {
            return;
        }
        self.shared_addr.* = 0;
        let shared = unsafe { builtin.mem.raw_ptr<BroadcastShared<T>>(addr) };
        do {
            let guard = shared.state.lock() match {
                g! => g,
                error p => p.into_inner(),
            };
            let st = guard.ref.as_ptr();
            let cur_sc = st.sender_count.*;
            if cur_sc > 0 {
                st.sender_count.* = cur_sc - 1;
            }
        }
        broadcast_drop_shared<T, A>(alloc, addr);
    }
}

impl Drop for BroadcastReceiver<T, .A = A, .allocator = alloc>
where
    T: Type,
    requires T :- Send + Clone,
    A: Type,
    requires A :- Allocator + Sync,
    quote alloc: lift *A,
{
    fn drop(*self) {
        let addr = self.shared_addr.*;
        if addr == 0 {
            return;
        }
        self.shared_addr.* = 0;
        let shared = unsafe { builtin.mem.raw_ptr<BroadcastShared<T>>(addr) };
        do {
            let guard = shared.state.lock() match {
                g! => g,
                error p => p.into_inner(),
            };
            let st = guard.ref.as_ptr();
            let cur_rc = st.receiver_count.*;
            if cur_rc > 0 {
                st.receiver_count.* = cur_rc - 1;
            }
        }
        broadcast_drop_shared<T, A>(alloc, addr);
    }
}

