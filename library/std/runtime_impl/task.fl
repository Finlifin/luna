use builtin.fmt.{ByteWriter, Debug}
use collections_impl.vec.Vec;
use io_impl.errors.IoErr;
use mem_impl.allocator.{AllocErr, Allocator, DefaultAllocator, RawBlock}
use mem_impl.layout.Layout;
use process_impl.process.panic;
use sync_impl.atomics.{AtomicBool, AtomicOrdering, AtomicU64, AtomicUsize, static_atomic_u64}
use sync_impl.marker.{Send, Sync}
use time_impl.duration.Duration;

{-
    Structured async effect core, task context, cancellation tokens,
    futures, join handles, task scopes, and structured concurrency combinators.

    HOOK(@llvm-effects / async lowering):
    - `TaskContext` layout (`cancel_flag: AtomicBool`, `pool_ptr: usize`)
      matches `compiler/luna/src/host/llvm/task_context.ll`.
    - `AsyncCore` declares the Tier 1 `async effect` operations. Because HIR
      lowering for `.await` and `async` handler arms is not yet merged in `HEAD`,
      `yield_now`, `sleep`, and `JoinHandle.join` currently invoke `AsyncCore`
      directly and document where `.await` attaches once async lowering lands.
-}
pub newtype TaskId = u64;

impl TaskId {
    pub pure fn new(raw: u64) -> Self {
        raw.as(TaskId)
    }

    pub pure fn as_u64(self) -> u64 {
        self.as(u64)
    }
}

impl Clone for TaskId {
    fn clone(*self) -> Self {
        self.*.as(u64).as(TaskId)
    }
}

impl Copy for TaskId {}

impl Eq for TaskId {
    fn eq(*self, other: *Self) -> bool {
        self.*.as(u64) == other.*.as(u64)
    }
}

impl Debug for TaskId {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        output.write_str("TaskId(")!;
        let raw = self.*.as(u64);
        raw.ref.as(Debug).write_debug(output)!;
        output.write_byte(41)
    }
}

impl Send for TaskId {}
impl Sync for TaskId {}

pub enum CancelErr {
    Cancelled,
    TimedOut,
    ScopeClosed,
}

impl Clone for CancelErr {
    fn clone(*self) -> Self {
        self.* match {
            .Cancelled => .Cancelled,
            .TimedOut => .TimedOut,
            .ScopeClosed => .ScopeClosed,
        }
    }
}

impl Copy for CancelErr {}

impl Eq for CancelErr {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .Cancelled =>
                other.* match {
                    .Cancelled => true,
                    _ => false,
                },
            .TimedOut =>
                other.* match {
                    .TimedOut => true,
                    _ => false,
                },
            .ScopeClosed =>
                other.* match {
                    .ScopeClosed => true,
                    _ => false,
                },
        }
    }
}

impl Debug for CancelErr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.* match {
            .Cancelled => output.write_str("CancelErr.Cancelled"),
            .TimedOut => output.write_str("CancelErr.TimedOut"),
            .ScopeClosed => output.write_str("CancelErr.ScopeClosed"),
        }
    }
}

impl Send for CancelErr {}
impl Sync for CancelErr {}

pub enum TaskErr {
    Cancelled,
    Panicked,
    RuntimeShutdown,
    Pool(runtime_impl.stack_pool.StackPoolErr),
    Alloc(AllocErr),
}

impl Clone for TaskErr {
    fn clone(*self) -> Self {
        self.* match {
            .Cancelled => .Cancelled,
            .Panicked => .Panicked,
            .RuntimeShutdown => .RuntimeShutdown,
            .Pool(err) => .Pool(err),
            .Alloc(err) => .Alloc(err),
        }
    }
}

impl Copy for TaskErr {}

impl Eq for TaskErr {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .Cancelled =>
                other.* match {
                    .Cancelled => true,
                    _ => false,
                },
            .Panicked =>
                other.* match {
                    .Panicked => true,
                    _ => false,
                },
            .RuntimeShutdown =>
                other.* match {
                    .RuntimeShutdown => true,
                    _ => false,
                },
            .Pool(e1) =>
                other.* match {
                    .Pool(e2) => e1.ref.as(Eq).eq(e2.ref),
                    _ => false,
                },
            .Alloc(e1) =>
                other.* match {
                    .Alloc(e2) => e1.ref.as(Eq).eq(e2.ref),
                    _ => false,
                },
        }
    }
}

impl Debug for TaskErr {
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.* match {
            .Cancelled => output.write_str("TaskErr.Cancelled"),
            .Panicked => output.write_str("TaskErr.Panicked"),
            .RuntimeShutdown => output.write_str("TaskErr.RuntimeShutdown"),
            .Pool(err) => {
                output.write_str("TaskErr.Pool(")!;
                err.ref.as(Debug).write_debug(output)!;
                output.write_byte(41)
            },
            .Alloc(err) => {
                output.write_str("TaskErr.Alloc(")!;
                err.ref.as(Debug).write_debug(output)!;
                output.write_byte(41)
            },
        }
    }
}

impl Send for TaskErr {}
impl Sync for TaskErr {}

