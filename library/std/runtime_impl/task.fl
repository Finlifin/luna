}

impl Copy for FutureState {}

impl Eq for FutureState {
    fn eq(*self, other: *Self) -> bool {
        self.* match {
            .pending =>
                other.* match {
                    .pending => true,
                    _ => false,
                },
            .completed =>
                other.* match {
                    .completed => true,
                    _ => false,
                },
