use builtin.mem.{MaybeUninit, TypeMarker, make_type_marker}
use process_impl.process.panic;

{-
    Typed delimited continuation wrapper `TypedContinuation<Y, B>`.

    `TypedContinuation<Y, B>` is affine (`Once`) and intentionally does NOT
    implement `Copy`, `Clone`, `Send`, or `Sync` (a captured continuation must
    be consumed at most once on its origin thread). Delegates raw control and
    query operations directly to `builtin.Continuation`.
-}
pub struct TypedContinuation
where
    Y: Type,
    B: Type,
{
    inner: builtin.Continuation,
    yield_marker: TypeMarker<Y>,
    resume_marker: TypeMarker<B>,
}

impl TypedContinuation<Y, B>
where
    Y: Type,
    B: Type,
{
    pub unsafe fn from_raw(inner: builtin.Continuation) -> Self {
        TypedContinuation<Y, B> {
            inner: inner,
            yield_marker: make_type_marker<Y>(),
            resume_marker: make_type_marker<B>(),
        }
    }

    pub fn into_raw(self) -> builtin.Continuation {
        self.inner
    }

    pub fn crosses_c_frame(*self) -> bool {
        self.inner.crosses_c_frame()
    }

    pub fn origin_thread_id(*self) -> u64 {
        self.inner.origin_thread_id()
    }

    pub fn resume_with(self, value: Y) -> B {
        var in_slot = MaybeUninit<Y>.new(value);
        var out_slot: MaybeUninit<B> = unsafe { MaybeUninit<B>.uninit() };
        let in_addr = unsafe { builtin.mem.ptr_addr<Y>(in_slot.as_mut_ptr()) };
        let out_addr = unsafe { builtin.mem.ptr_addr<B>(out_slot.as_mut_ptr()) };
        let k = self.into_raw();
        let ctrl = unsafe { k.resume_raw(in_addr, out_addr) };
        if ctrl != 0 {
            panic("suspended continuation terminated abnormally");
        }
        unsafe { out_slot.assume_init() }
    }

    pub fn abort(self) {
        let k = self.into_raw();
        unsafe {
            k.abort_raw();
        }
    }
}
