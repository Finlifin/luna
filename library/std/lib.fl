{- Runtime host facilities. std.prelude is imported explicitly. -}
pub use builtin.*;
use collections_impl.{hash_map, hash_set, vec, vec_deque}
use fmt_impl.arguments;
use fmt_impl.parse;
use fs_impl.file;
use io_impl.{buffered, errors, reader, writer}
use mem_impl.{allocator, arena, boxed, layout}
use platform.{linux as linux_impl, unix as unix_impl}
use string_impl.string as string_mod;

pub mod os {
    pub mod linux {
        pub use linux_impl.*;
    }

    pub mod unix {
        pub use unix_impl.*;
    }
}

pub mod io {
    pub use buffered.{BufReader, BufWriter}
    pub use builtin.fmt.ByteWriter;
    pub use errors.IoErr;
    pub use reader.{Cursor, Reader, Stdin, stdin}
    pub use unix_impl.read_byte;
    pub use writer.{Write, Writer, stderr, stdout, write_all, write_all_raw, write_all_str}
}

pub mod fs {
    pub use file.{File, remove_file}
}

pub mod mem {
    pub use allocator.*;
    pub use arena.{ArenaAllocator, FixedBufferAllocator}
    pub use boxed.Box;
    pub use layout.Layout;
}

pub mod collections {
    pub use hash_map.{HashMap, HashMapIter}
    pub use hash_set.{HashSet, HashSetIter}
    pub use vec.{Vec, VecIter}
    pub use vec_deque.{VecDeque, VecDequeIter}
}

pub mod string {
    pub use string_mod.{String, Utf8Err}
}

pub mod fmt {
    pub use arguments.{
        eprint,
        eprintln,
        format,
        format_debug,
        format_into,
        print,
        print_value,
        println,
        println_value,
        write_fmt,
    }
    pub use builtin.fmt.{Debug, Display}
    pub use parse.{FormatErr, FormatPiece, FormatPlan, Parse}
}

pub mod prelude {
    pub use arguments.{
        eprint,
        eprintln,
        format,
        format_debug,
        format_into,
        print,
        print_value,
        println,
        println_value,
        write_fmt,
    }
    pub use boxed.Box;
    pub use builtin.fmt.{Debug, Display}
    pub use builtin.prelude.*;
    pub use string_mod.String;
    pub use vec.Vec;
}
