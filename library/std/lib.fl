{- Runtime host facilities. std.prelude is imported explicitly. -}
pub use builtin.*;
use collections_impl.{hash_map, hash_set, slice, vec, vec_deque}
use fmt_impl.arguments;
use fmt_impl.parse;
use fs_impl.file;
use hash_impl.sip;
use io_impl.{buffered, errors, reader, writer}
use mem_impl.{allocator, arena, boxed, layout}
use platform.{linux as linux_impl, unix as unix_impl}
use process_impl.process as process_mod;
use string_impl.string as string_mod;
use time_impl.duration;

pub mod os {
    pub mod linux {
        pub use linux_impl.*;
    }

    pub mod unix {
        pub use unix_impl.*;
    }
}

pub mod io {
    pub use buffered.{BufReader, BufWriter}
    pub use builtin.fmt.ByteWriter;
    pub use errors.IoErr;
    pub use reader.{Cursor, Reader, Stdin, stdin}
    pub use unix_impl.read_byte;
    pub use writer.{Write, Writer, stderr, stdout, write_all, write_all_raw, write_all_str}
}

pub mod fs {
    pub use file.{File, read, read_to_string, remove_file, write_bytes, write_str}
}

pub mod time {
    pub use duration.*;
}

pub mod process {
    pub use process_mod.*;
}

pub mod mem {
    use builtin.mem as builtin_mem;

    pub use allocator.*;
    pub use arena.{ArenaAllocator, FixedBufferAllocator}
    pub use boxed.Box;
    pub use builtin_mem.{
        Align,
        ManuallyDrop,
        MaybeUninit,
        NonNull,
        TypeMarker,
        compare_bytes,
        copy,
        copy_bytes,
        copy_bytes_nonoverlapping,
        copy_nonoverlapping,
        drop_in_place,
        forget,
        make_type_marker,
        null_ptr,
        ptr_add,
        ptr_addr,
        ptr_cast,
        ptr_is_null,
        ptr_sub,
        raw_ptr,
        raw_read,
        raw_write,
        read,
        replace,
        set_bytes,
        swap,
        write,
        write_bytes,
        zeroed,
    }
    pub use layout.Layout;
}

pub mod collections {
    pub use hash_map.{HashMap, HashMapIter}
    pub use hash_set.{HashSet, HashSetIter}
    pub use slice.{Slice, SliceBounds};
    pub use vec.{Vec, VecIter}
    pub use vec_deque.{VecDeque, VecDequeIter, VecDequeSlice}
}

pub mod hash {
    pub use sip.{DefaultHasher, RandomState}
}

pub mod string {
    pub use string_mod.{String, Utf8Err}
}

pub mod fmt {
    pub use arguments.{
        comptime_format,
        eprint,
        eprintln,
        format,
        format_debug,
        format_into,
        print,
        print_value,
        println,
        println_value,
        write_fmt,
    }
    pub use builtin.fmt.{Debug, Display, FormatOptions, options}
    pub use meta.ComptimeDisplay;
    pub use parse.{ComptimeParse, FormatErr, FormatKind, FormatPiece, FormatPlan, Parse}
}

pub mod prelude {
    pub use arguments.{
        comptime_format,
        eprint,
        eprintln,
        format,
        format_debug,
        format_into,
        print,
        print_value,
        println,
        println_value,
        write_fmt,
    }
    pub use boxed.Box;
    pub use builtin.fmt.{Debug, Display}
    pub use meta.ComptimeDisplay;
    pub use builtin.prelude.*;
    pub use string_mod.String;
    pub use slice.{Slice, SliceBounds};
    pub use vec.Vec;
}
