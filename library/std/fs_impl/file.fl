use builtin.fmt.ByteWriter;
use collections_impl.vec.Vec;
use io_impl.errors.{IoErr, check}
use io_impl.reader.Reader;
use io_impl.writer.Write;
use mem_impl.allocator.Allocator;
use std.os.{linux, unix}
use string_impl.string.String;

{- File owns one descriptor. Drop closes it once; close reports errors and
   retires ownership even on failure. Borrowed operations cannot export a
   descriptor or a writer which outlives this owner. -}
const create_flags: i32 = linux.write_only + linux.create + linux.truncate + linux.close_on_exec;

pub struct File {
    descriptor: i32,
}

impl Drop for File {
    fn drop(*self) {
        if self.descriptor.* >= 0 {
            let result = linux.close(self.descriptor.*);
            self.descriptor.* = -1;
        }
    }
}

impl File {
    pub fn open() -> !IoErr Self where path: str {
        let result = check(linux.open<path>(linux.close_on_exec, 0))!;
        File {
            descriptor: result'bitvec[0..32].as(i32),
        }
    }

    pub fn create() -> !IoErr Self where path: str {
        let result = check(linux.open<path>(create_flags, 438))!;
        File {
            descriptor: result'bitvec[0..32].as(i32),
        }
    }

    pub fn write_all(*self) -> !IoErr void where text: str {
        io_impl.writer.write_all<text>(self.descriptor.*)
    }

    pub fn write_bytes(
        *self,
        bytes: *Vec<u8, .A = A, .allocator = a>,
    ) -> !IoErr void
    where
        A: Type,
        requires A :- Allocator,
        quote a: lift *A,
    {
        let len = bytes.len();
        if len == 0 {
            return;
        }
        unsafe { io_impl.writer.write_all_raw(self.descriptor.*, bytes.as_addr(), len) }
    }

    pub fn write_string(
        *self,
        text: *String<.A = A, .allocator = a>,
    ) -> !IoErr void
    where
        A: Type,
        requires A :- Allocator,
        quote a: lift *A,
    {
        let len = text.len();
        if len == 0 {
            return;
        }
        unsafe {
            io_impl.writer.write_all_raw(self.descriptor.*, text.as_bytes_addr(), len)
        }
    }

    pub fn read_byte(*self) -> !IoErr ?u8 {
        unix.read_byte(self.descriptor.*)
    }

    pub fn close(*self) -> !IoErr void {
        let fd = self.descriptor.*;
        self.descriptor.* = -1;
        unix.close(fd)
    }
}

pub fn remove_file(comptime path: str) -> !IoErr void {
    let result = check(linux.unlink<path>())!;
}

impl ByteWriter for File {
    assoc Err: Type = io_impl.errors.IoErr;

    fn write_byte(*self, byte: u8) -> !IoErr void {
        unix.write_byte(self.descriptor.*, byte)
    }

    fn write_str(*self, text: str) -> !IoErr void {
        io_impl.writer.write_all_str(self.descriptor.*, text)
    }
}

impl Reader for File {
    assoc Err: Type = IoErr;

    unsafe fn read_raw(*self, dst: usize, len: usize) -> !IoErr usize {
        if len == 0 {
            return 0;
        }
        let len_u64 = builtin.compiler.try_usize_to_u64(len) match {
            v? => v,
            null => return error IoErr.Os(22),
        }
        let n = unix.read_raw(self.descriptor.*, dst, len_u64)!;
        let n_usize = builtin.compiler.try_u64_to_usize(n) match {
            v? => v,
            null => return error IoErr.Os(5),
        }
        if n_usize > len {
            return error IoErr.Os(5);
        }
        n_usize
    }

    fn read_byte(*self) -> !IoErr ?u8 {
        unix.read_byte(self.descriptor.*)
    }
}

impl Write for File {
    assoc Err: Type = IoErr;

    unsafe fn write_raw(*self, src: usize, len: usize) -> !IoErr usize {
        if len == 0 {
            return 0;
        }
        let len_u64 = builtin.compiler.try_usize_to_u64(len) match {
            v? => v,
            null => return error IoErr.Os(22),
        }
        let n = unix.write_raw(self.descriptor.*, src, len_u64)!;
        let n_usize = builtin.compiler.try_u64_to_usize(n) match {
            v? => v,
            null => return error IoErr.Os(5),
        }
        if n_usize > len {
            return error IoErr.Os(5);
        }
        n_usize
    }

    unsafe fn write_all_raw(*self, src: usize, len: usize) -> !IoErr void {
        io_impl.writer.write_all_raw(self.descriptor.*, src, len)
    }
}
