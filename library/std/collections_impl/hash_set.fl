use builtin.fmt.{ByteWriter, Debug}
use collections_impl.hash_map.{HashMap, HashMapIter}
use hash_impl.sip.RandomState;
use mem_impl.allocator.{AllocErr, Allocator, DefaultAllocator}

{-
    Hash-indexed set HashSet<T, .S, .A, .allocator> and consuming iterator
    HashSetIter<T, .A, .allocator>, structurally backed by
    HashMap<T, void, .S = S, .A = A, .allocator = allocator>.

    Inherits structural affine Drop, zero-sized value array optimization, and
    runtime-dependent allocator delivery with zero overhead for globals.
-}
pub struct HashSet
where
    T,
    .S: Type = RandomState,
    requires S :- BuildHasher,
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    raw_map: HashMap<T, void, .S = S, .A = A, .allocator = allocator>,
}

impl HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T,
    S: Type,
    requires S :- BuildHasher + Default,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    pub fn new() -> Self {
        HashSet<T, .S = S, .A = A, .allocator = alloc> {
            raw_map: HashMap<T, void, .S = S, .A = A, .allocator = alloc>.new(),
        }
    }

    pub fn with_capacity(capacity: usize) -> !AllocErr Self {
        let map = HashMap<T, void, .S = S, .A = A, .allocator = alloc>.with_capacity(capacity)!;
        HashSet<T, .S = S, .A = A, .allocator = alloc> { raw_map: map }
    }
}

impl Default for HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T,
    S: Type,
    requires S :- BuildHasher + Default,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    fn default() -> Self {
        HashSet<T, .S = S, .A = A, .allocator = alloc>.new()
    }
}

impl HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T,
    S: Type,
    requires S :- BuildHasher,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    pub fn with_hasher(hash_builder: S) -> Self {
        HashSet<T, .S = S, .A = A, .allocator = alloc> {
            raw_map: HashMap<T, void, .S = S, .A = A, .allocator = alloc>.with_hasher(hash_builder),
        }
    }

    pub fn with_capacity_and_hasher(capacity: usize, hash_builder: S) -> !AllocErr Self {
        let map = HashMap<T, void, .S = S, .A = A, .allocator = alloc>.with_capacity_and_hasher(
            capacity,
            hash_builder,
        )!;
        HashSet<T, .S = S, .A = A, .allocator = alloc> { raw_map: map }
    }

    pub fn hasher(*self) -> *S {
        self.raw_map.hasher()
    }

    pub fn len(*self) -> usize {
        self.raw_map.len()
    }

    pub fn capacity(*self) -> usize {
        self.raw_map.capacity()
    }

    pub fn is_empty(*self) -> bool {
        self.raw_map.is_empty()
    }

    pub fn clear(*self) {
        self.raw_map.clear();
    }

    pub fn reserve(*self, additional: usize) -> !AllocErr void {
        self.raw_map.reserve(additional)
    }
}

impl HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T :- Eq + Hash,
    S: Type,
    requires S :- BuildHasher,
    requires S.as(BuildHasher).HasherTy :- Hasher,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    pub fn insert(*self, value: T) -> !AllocErr bool {
        let prev = self.raw_map.insert(value, ())!;
        prev.is_none()
    }

    pub fn remove(*self, value: T) -> bool {
        self.raw_map.remove(value).is_some()
    }

    pub fn contains_ref(*self, value: *T) -> bool {
        self.raw_map.contains_key_ref(value)
    }

    pub fn contains(*self, value: T) -> bool {
        self.raw_map.contains_key(value)
    }
}

impl HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T :- Eq + Hash + Clone,
    S: Type,
    requires S :- BuildHasher,
    requires S.as(BuildHasher).HasherTy :- Hasher,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    pub fn is_subset(*self, other: *HashSet<T, .S = OS, .A = B, .allocator = other_alloc>) -> bool
    where
        OS: Type,
        requires OS :- BuildHasher,
        requires OS.as(BuildHasher).HasherTy :- Hasher,
        B: Type,
        requires B :- Allocator,
        quote other_alloc: lift *B,
    {
        if self.raw_map.len() > other.raw_map.len() {
            return false;
        }
        let cap = self.raw_map.bucket_count();
        var i: usize = 0;
        while i < cap {
            self.raw_map.clone_key_at(i) match {
                elem? => {
                    if not other.raw_map.contains_key(elem) {
                        return false;
                    }
                },
                null => {},
            }
            i = i + 1;
        }
        true
    }

    pub fn is_disjoint(*self, other: *HashSet<T, .S = OS, .A = B, .allocator = other_alloc>) -> bool
    where
        OS: Type,
        requires OS :- BuildHasher,
        requires OS.as(BuildHasher).HasherTy :- Hasher,
        B: Type,
        requires B :- Allocator,
        quote other_alloc: lift *B,
    {
        let cap = self.raw_map.bucket_count();
        var i: usize = 0;
        while i < cap {
            self.raw_map.clone_key_at(i) match {
                elem? => {
                    if other.raw_map.contains_key(elem) {
                        return false;
                    }
                },
                null => {},
            }
            i = i + 1;
        }
        true
    }
}

impl HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T :- Clone,
    S: Type,
    requires S :- BuildHasher + Clone,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    pub fn try_clone(*self) -> !AllocErr Self {
        let cloned = self.raw_map.try_clone()!;
        HashSet<T, .S = S, .A = A, .allocator = alloc> { raw_map: cloned }
    }
}

pub struct HashSetIter
where
    T,
    .A: Type = DefaultAllocator,
    requires A :- Allocator,
    quote .allocator: lift *A = DefaultAllocator.GLOBAL.ref,
{
    raw_iter: HashMapIter<T, void, .A = A, .allocator = allocator>,
}

impl Iterator for HashSetIter<T, .A = A, .allocator = alloc>
where
    T,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    assoc Item: Type = T;

    inline fn iterate(self) -> #emit_item<T> void {
        var iter = self;
        while true {
            let (elem, _) = iter.raw_iter.ref.next_entry() match {
                found? => found,
                null => break,
            }
            emit_item<T>(elem)#;
        }
    }
}

impl IntoIterator for HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T,
    S: Type,
    requires S :- BuildHasher,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    assoc Iter: Type = HashSetIter<T, .A = A, .allocator = alloc>;

    fn into_iter(self) -> HashSetIter<T, .A = A, .allocator = alloc> {
        HashSetIter<T, .A = A, .allocator = alloc> {
            raw_iter: self.raw_map.into_iter(),
        }
    }
}

impl Debug for HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T :- Debug,
    S: Type,
    requires S :- BuildHasher,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    fn write_debug(*self, output: *W) -> !W.as(ByteWriter).Err void where W :- ByteWriter {
        self.raw_map.write_debug_keys(output)
    }
}

impl AsRef<HashMap<T, void, .S = S, .A = A, .allocator = alloc>> for HashSet<T, .S = S, .A = A, .allocator = alloc>
where
    T,
    S: Type,
    requires S :- BuildHasher,
    A: Type,
    requires A :- Allocator,
    quote alloc: lift *A,
{
    fn as_ref(*self) -> *HashMap<T, void, .S = S, .A = A, .allocator = alloc> {
        self.raw_map
    }
}
